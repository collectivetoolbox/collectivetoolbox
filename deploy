unset global_setup_payload GLOBAL_GRAPH_PASS NEW_GLOBAL_GRAPH_PASS PASS SERVER_USER_PASS SUDOER_USER_PASS SUDO_PASS

# Clean up older deployed binaries and resource bundles ONLY after the new service is healthy
echo "Cleaning up superseded deployed binaries..."
remote_ssh "$user" bash -s "$commit" "$server_user" <<'REMOTE_CLEANUP'
commit="$1"
server_user="$2"

cd /home/"$server_user"/deploy || exit 1
find . -maxdepth 1 -type f \( -name "ctoolbox-*" -o -name "system_graph_history-*" \) \
	! -name "ctoolbox-$commit" \
	! -name "ctoolbox-$commit.rsrc" \
	! -name "system_graph_history-$commit.rsrc" \
	-exec rm {} \; || true
REMOTE_CLEANUP

if [[ "$dry_run" -eq 0 ]]; then
	echo "$version" > VERSION
	echo "$commit" > COMMIT

	git add VERSION COMMIT
	git commit -m 'chore: Increase version after deploy'

	timestamp="$(date -u +"%Y-%m-%d %H:%M:%S UTC")"
	git tag -a "v$version" -m "Version $version - $timestamp"
else
	echo "[Dry Run] Skipping VERSION/COMMIT git commit and tag creation."
fi

echo
echo
echo "Deploy done! If you use a CDN, don't forget to purge the cache."
