set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" || exit 1

repository="$(pwd)"
source "$repository/scripts/run-dev-ctb"

usage() {
	cat <<'USAGE'
Usage:
	./deploy [quick|all] [options]

Modes:
	quick     Build + deploy the server binary target (linux-x64).
	all       Build + deploy all targets (linux-x64 and linux-x86). This is the
              default.

Build Options:
	--clean           Run cargo clean before building.
	--skip-clean      Skip cargo clean before building.
	--no-clean        Alias for --skip-clean.
	--no-build        Skip build completely; require existing, up-to-date binaries matching current git commit.
	--reuse-built     Reuse binaries matching current git commit; only build missing or stale targets.
	--mock-artifacts  Generate minimal mock tarballs for rapid deploy testing.

Deployment Target & Credentials:
	--target <live|vm|DIR>  Target environment: 'live' (default), 'vm' (local QEMU Linux VM on 127.0.0.1:2224),
	                        or a directory path containing ctb-deploy.* configuration files.
	--config-dir <DIR>      Directory containing ctb-deploy.* files.
	--ssh-key <PATH>        Use explicit SSH private key file instead of password/sshpass.
	--dry-run               Skip version bump, git commits, and git tag creation.
	--no-git-bump           Alias for --dry-run.
	--allow-dirty           Allow deploying with unstaged or uncommitted changes.

Notes:
	- Releases are uploaded into the server user's storage directory so the
	  update server can serve them from /releases/...
	- SSH key authentication is supported via --ssh-key or VM profile.
USAGE
}

read_secret() {
	local prompt="$1"
	local secret
	read -r -s -p "$prompt" secret
	echo >&2
	printf '%s' "$secret"
}

mode_quick=0
skip_clean=""
target_env="live"
config_dir=""
no_build=0
reuse_built=0
dry_run=0
mock_artifacts=0
ssh_key=""
allow_dirty=0

while [[ $# -gt 0 ]]; do
	case "$1" in
		"quick"|"--quick")
			mode_quick=1
			;;
		"all")
			mode_quick=0
			;;
		"--clean")
			skip_clean=0
			;;
		"--skip-clean"|"--no-clean")
			skip_clean=1
			;;
		"--no-build")
			no_build=1
			if [[ "$skip_clean" == "" ]]; then
				skip_clean=1
			fi
			;;
		"--reuse-built")
			reuse_built=1
			if [[ "$skip_clean" == "" ]]; then
				skip_clean=1
			fi
			;;
		"--mock-artifacts")
			mock_artifacts=1
			;;
		"--dry-run"|"--no-git-bump")
			dry_run=1
			;;
		"--allow-dirty")
			allow_dirty=1
			;;
		"--target")
			shift
			target_env="${1:-live}"
			;;
		"--config-dir")
			shift
			config_dir="${1:-}"
			;;
		"--ssh-key")
			shift
			ssh_key="${1:-}"
			;;
		"-h"|"--help"|"help")
			usage
			exit 0
			;;
		*)
			echo "Unknown option/argument: $1" >&2
			usage >&2
			exit 1
			;;
	esac
	shift
done

if [[ "$allow_dirty" -ne 1 ]]; then
	if ! git diff-index --quiet HEAD -- 2>/dev/null || [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
		echo "Error: Working directory has unstaged or uncommitted changes." >&2
		echo "Please commit or stash your changes before deploying, or pass --allow-dirty for test runs." >&2
		exit 1
	fi
fi

if [[ "$target_env" == "vm" ]]; then
	if [[ -z "$dry_run" || "$dry_run" -eq 0 ]]; then
		echo "Note: Automatically enabling --dry-run for VM deployment target."
		dry_run=1
	fi
	if [[ "$skip_clean" == "" ]]; then
		skip_clean=1
	fi
fi

if [[ "$skip_clean" == "" && "$no_build" -eq 0 ]]; then
    echo "Please choose whether to --clean (will make sure docs are up to date) or to --skip-clean (which will build faster)."
    exit 1
fi

# Configure target credentials & endpoint
PASS=""
SERVER_USER_PASS=""
SUDOER_USER_PASS=""
GLOBAL_GRAPH_PASS=""

if [[ "$target_env" == "vm" ]]; then
	user="ctb-deployer"
	sudoer_user="ctb-sudoer"
	server_user="ctb-server"
	server="127.0.0.1"
	port="2224"
	if [[ -z "$ssh_key" ]]; then
		ssh_key="$repository/ci-logs/VMs/Linux/id_ed25519"
	fi
	GLOBAL_GRAPH_PASS="test_global_graph_pass_123"
	if [[ ! -f "$ssh_key" ]]; then
		echo "Error: VM SSH key not found at $ssh_key." >&2
		echo "Please run ./scripts/setup-linux-vm-image to provision the VM and key, or pass --ssh-key <path>." >&2
		exit 1
	fi
elif [[ -n "$config_dir" && -d "$config_dir" ]]; then
	user="$(<"$config_dir/ctb-deploy.username")" || exit 1
	sudoer_user="$(<"$config_dir/ctb-deploy.sudoer-username")" || exit 1
	server_user="$(<"$config_dir/ctb-deploy.server-username")" || exit 1
	server="$(<"$config_dir/ctb-deploy.ip")" || exit 1
	port="$(<"$config_dir/ctb-deploy.port")" || exit 1
	if [[ -f "$config_dir/ctb-deploy.key" ]]; then
		ssh_key="$config_dir/ctb-deploy.key"
	fi
	if [[ -f "$config_dir/ctb-deploy.global-graph-pass" ]]; then
		GLOBAL_GRAPH_PASS="$(<"$config_dir/ctb-deploy.global-graph-pass")"
	fi
else
	# Read live deployment targets
	user="$(<~/ctb-deploy.username)" || exit 1
	sudoer_user="$(<~/ctb-deploy.sudoer-username)" || exit 1
	server_user="$(<~/ctb-deploy.server-username)" || exit 1
	server="$(<~/ctb-deploy.ip)" || exit 1
	port="$(<~/ctb-deploy.port)" || exit 1
	if [[ -f ~/ctb-deploy.key ]]; then
		ssh_key=~/ctb-deploy.key
	fi
	if [[ -f ~/ctb-deploy.global-graph-pass ]]; then
		GLOBAL_GRAPH_PASS="$(<~/ctb-deploy.global-graph-pass)"
	fi
fi

if [[ -n "$ssh_key" && ! -f "$ssh_key" ]]; then
	echo "Warning: SSH key specified at $ssh_key not found. Falling back to password authentication." >&2
	ssh_key=""
fi

if [[ -z "$ssh_key" ]]; then
	# Ensure sshpass is available to supply passwords non-interactively
	if ! command -v sshpass >/dev/null 2>&1; then
		echo "sshpass is required for password-based SSH but not installed. Please install sshpass or provide --ssh-key." >&2
		exit 1
	fi
	PASS="${PASS:-$(read_secret "Password for ${user}@${server}: ")}"
	SERVER_USER_PASS="${SERVER_USER_PASS:-$(read_secret "Password for ${server_user}@${server}: ")}"
	SUDOER_USER_PASS="${SUDOER_USER_PASS:-$(read_secret "Password for ${sudoer_user}@${server}: ")}"
	if [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
		GLOBAL_GRAPH_PASS="$(read_secret "Password for global graph server user: ")"
	fi
elif [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
	GLOBAL_GRAPH_PASS="$(read_secret "Password for global graph server user: ")"
fi

# Remote SSH and Rsync abstractions
remote_ssh() {
	local target_user="$1"
	shift
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		ssh -i "$ssh_key" -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
			-o BatchMode=yes -o LogLevel=ERROR "${target_user}@${server}" "$@"
	else
		SSHPASS="$PASS" sshpass -e ssh -p "${port}" "${target_user}@${server}" "$@"
	fi
}

remote_rsync() {
	local target_user="$1"
	local src="$2"
	local dst="$3"
	shift 3
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		rsync -e "ssh -i $ssh_key -p $port -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR" \
			"$@" "$src" "${target_user}@${server}:$dst"
	else
		SSHPASS="$PASS" sshpass -e rsync -e "ssh -p ${port}" "$@" "$src" "${target_user}@${server}:$dst"
	fi
}

remote_sudo() {
	local cmd="$1"
	if [[ -n "${SUDOER_USER_PASS:-}" ]]; then
		printf '%s\n' "$SUDOER_USER_PASS" | remote_ssh "$sudoer_user" "sudo -S -p '' $cmd"
	else
		remote_ssh "$sudoer_user" "sudo $cmd"
	fi
}

cd "$repository" || exit 1

# Automatically bump version if not in dry-run/reuse mode
if [[ "$dry_run" -eq 0 && "$no_build" -eq 0 && "$reuse_built" -eq 0 ]]; then
	current_pkg_version="$(grep -m1 -E '^version\s*=\s*"[0-9]+\.[0-9]+\.[0-9]+"' Cargo.toml | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')"
	if [[ -n "$current_pkg_version" ]]; then
		IFS='.' read -r v_major v_minor v_patch <<< "$current_pkg_version"
		v_patch=$((v_patch + 1))
		next_pkg_version="${v_major}.${v_minor}.${v_patch}"
		sed -i "0,/^version\s*=\s*\"[^\"]*\"/s/^version\s*=\s*\"[^\"]*\"/version = \"${next_pkg_version}\"/" Cargo.toml
	fi

	# Trigger cargo to update Cargo.lock with the new version.
	cargo metadata --format-version=1 --no-deps >/dev/null

	# Automatically commit the version bump if there are changes.
	if ! git diff --quiet Cargo.toml Cargo.lock; then
		git commit -m "chore: Automatically bump package version on deploy" Cargo.toml Cargo.lock
	fi
fi

version="$(cargo metadata --format-version=1 --no-deps | jq -r '.packages[] | select(.name == "ctoolbox") | .version')"
commit="$(git rev-parse HEAD)"
commitAndVersion="$version-$commit"

host_platform() {
	local os arch
	os="$(uname -s)"
	arch="$(uname -m)"
	if [[ "$os" != "Linux" ]]; then
		echo "Unsupported host OS: $os" >&2
		exit 1
	fi
	case "$arch" in
		x86_64|amd64)
			printf '%s' "linux-x64"
			;;
		i386|i486|i586|i686)
			printf '%s' "linux-x86"
			;;
		*)
			echo "Unsupported host arch: $arch" >&2
			exit 1
			;;
	esac
}

storage_dir_linux() {
	printf '%s' ".local/share/collectivetoolbox"
}

release_targets() {
    if [[ "$mode_quick" -eq 1 ]]; then
	    printf '%s\n' "linux-x64"
    else
	    printf '%s\n' "linux-x64" "linux-x86"
    fi
}

base_input_dir="$repository/../ctb_release/input"
[[ -d "$base_input_dir" ]] && rm -r "$base_input_dir"
mkdir -p "$base_input_dir" || exit 1

cd "$repository" || exit 1

mapfile -t targets < <(release_targets)
if [[ "${#targets[@]}" -eq 0 ]]; then
    echo "No release targets configured" >&2
    exit 1
fi

# Check binaries and decide what needs building
targets_to_build=()
for target in "${targets[@]}"; do
	bin_path="$repository/built/$target/ctoolbox"
	if [[ -x "$bin_path" ]]; then
		bin_commit=""
		if bin_commit="$(ctb_binary_commit "$bin_path")" && [[ "$bin_commit" == "$commit" ]]; then
			echo "Target '$target' binary is current (matches HEAD commit $commit)."
			if [[ "$reuse_built" -eq 1 || "$no_build" -eq 1 ]]; then
				continue
			fi
		else
			if [[ "$no_build" -eq 1 ]]; then
				echo "Error: Binary for target '$target' is stale (commit '$bin_commit' != HEAD '$commit'). Cannot use --no-build." >&2
				exit 1
			fi
			echo "Target '$target' binary is stale (commit '$bin_commit' != HEAD '$commit'). Rebuilding required."
		fi
	else
		if [[ "$no_build" -eq 1 ]]; then
			echo "Error: Binary for target '$target' not found at $bin_path. Cannot use --no-build." >&2
			exit 1
		fi
	fi
	targets_to_build+=("$target")
done

if [[ "${#targets_to_build[@]}" -gt 0 ]]; then
	if [[ "$skip_clean" == "0" ]]; then
		cargo clean
	fi
	echo "Building targets: ${targets_to_build[*]}..."
	./build --release --docs "${targets_to_build[@]}"
else
	echo "All release targets (${targets[*]}) are already built and match HEAD ($commit). Skipping compilation."
fi

# Package source and dependencies
if [[ "$mock_artifacts" -eq 1 ]]; then
	echo "Packaging mock dependency and source tarballs for rapid deploy testing..."
	tar -cf "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar" -T /dev/null
	tar -cf "$base_input_dir/ctoolbox-src-$commitAndVersion.tar" -T /dev/null
else
	cd "$repository/vendor/ctb-vendored" || exit 1
	"$repository/scripts/vendor-dependencies"

	git archive --format=tar HEAD -o "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar"

	cd "$repository" || exit 1

	# Archive application source code (including vendored code).
	cd "$repository/vendor" || exit 1
	git archive --format=tar HEAD -o vendor.tar
	cp vendor.tar "$base_input_dir/vendor.tar"

	cd "$repository/packaging/homebrew-tap" || exit 1
	git archive --format=tar HEAD -o "$repository/packaging/homebrew-tap/homebrew-tap.tar"

	cd "$repository" || exit 1
	git archive --format=tar --add-file=vendor/vendor.tar --add-file="$repository/packaging/homebrew-tap/homebrew-tap.tar" HEAD -o \
		"$base_input_dir/ctoolbox-src-$commitAndVersion.tar"
fi

cd "$repository" || exit 1

# Prepare release input directories.
output_dir="$repository/../ctb_release/releases"
mkdir -p "$output_dir" || exit 1

for target in "${targets[@]}"; do
    input_dir="$base_input_dir/$target"
    mkdir "$input_dir" || exit 1
    cp "built/$target/ctoolbox" "$input_dir/ctoolbox" || exit 1
    if [[ -e "$input_dir/ctoolbox.rsrc" || -L "$input_dir/ctoolbox.rsrc" ]]; then
        rm "$input_dir/ctoolbox.rsrc"
    fi
    ln "$repository/built/$target/ctoolbox.rsrc" "$input_dir/ctoolbox.rsrc" 2>/dev/null || \
        cp "$repository/built/$target/ctoolbox.rsrc" "$input_dir/ctoolbox.rsrc" || exit 1
    if [[ -f "$repository/built/$target/v86_images.rsrc" ]]; then
        if [[ -e "$input_dir/v86_images.rsrc" || -L "$input_dir/v86_images.rsrc" ]]; then
            rm "$input_dir/v86_images.rsrc"
        fi
        ln "$repository/built/$target/v86_images.rsrc" "$input_dir/v86_images.rsrc" 2>/dev/null || \
            cp "$repository/built/$target/v86_images.rsrc" "$input_dir/v86_images.rsrc" || exit 1
    fi
    if [[ -f "built/$target/ctoolbox-installer" ]]; then
        cp "built/$target/ctoolbox-installer" "$input_dir/ctoolbox-installer" || exit 1
    fi
    cp "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar" \
        "$input_dir/ctoolbox-dependencies-$commitAndVersion.tar" || exit 1
    cp "$base_input_dir/ctoolbox-src-$commitAndVersion.tar" \
        "$input_dir/ctoolbox-src-$commitAndVersion.tar" || exit 1
done

# Run dev-sign for each target and update local latest symlinks.
host="$(host_platform)"
devsign_bin="$repository/built/$host/ctoolbox"
if [[ ! -x "$devsign_bin" && -x "$repository/built/linux-x64/ctoolbox" ]]; then
    devsign_bin="$repository/built/linux-x64/ctoolbox"
fi

if [[ ! -x "$devsign_bin" ]]; then
    echo "Expected dev-sign binary not found: $devsign_bin" >&2
    echo "Try building the host target: ./build --release" >&2
    exit 1
fi

echo "Updating Guix packaging..."
cd "$repository" || exit 1
cp packaging/guix/rust-crates.tmpl packaging/guix/generated/ctb-workspace-rust-crates.scm
if command -v guix >/dev/null 2>&1; then
    guix import --insert=packaging/guix/generated/ctb-workspace-rust-crates.scm crate --lockfile=Cargo.lock ctb-workspace || true
fi

# Calculate deterministic gzip SHA256 hashes for Homebrew formula.
echo "Calculating Homebrew release hashes..."
deps_sha="$("$devsign_bin" ctb-dev-gz-sha256 "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar")"
src_sha="$("$devsign_bin" ctb-dev-gz-sha256 "$base_input_dir/ctoolbox-src-$commitAndVersion.tar")"

echo "Updating Homebrew formula..."
cat <<EOF > "$repository/packaging/homebrew-tap/Formula/ctoolbox.rb"
# GENERATED! Do not edit directly. This file is automatically generated by the deploy script.
class Ctoolbox < Formula
  desc "Collective Toolbox: A graph‑based workspace for linking documents and data"
  homepage "https://collectivetoolbox.com/"
  url "https://collectivetoolbox.com/releases/src/ctoolbox-src-$version-$commit.tar.gz"
  sha256 "$src_sha"

  env :userpaths

  depends_on "cargo-deny" => :build
  depends_on "pkg-config" => :build
  depends_on "rust" => :build

  resource "dependencies" do
    url "https://collectivetoolbox.com/releases/src/ctoolbox-dependencies-$version-$commit.tar.gz"
    sha256 "$deps_sha"
  end

  def install
    mkdir "-p", "vendor"
    system "tar", "-xf", "vendor.tar", "-C", "vendor"

    (buildpath/"vendor/ctb-vendored").mkpath
    resource("dependencies").stage(buildpath/"vendor/ctb-vendored")

    File.open(".cargo/config.toml", "a") do |f|
      f.write <<~EOS

        [source.crates-io]
        replace-with = "vendored-sources"

        [source.vendored-sources]
        directory = "vendor/ctb-vendored/vendor"

        [source."https://github.com/boa-dev/boa.git"]
        git = "https://github.com/boa-dev/boa.git"
        rev = "ffec9244d4267406d66aef8b3c8a1d89730df5b4"
        replace-with = "vendored-sources"

        [source."https://github.com/rust-dark-light/dark-light.git"]
        git = "https://github.com/rust-dark-light/dark-light.git"
        rev = "0f18d2fbcaa5d1c175db8aae7d53428988d7e961"
        replace-with = "vendored-sources"
      EOS
    end

    rm "./vendor/TypeScript-built.tar"

    system "./scripts/run-without-network", "./build", "--release", "--no-tests", "--no-docs", "linux-x64"
    system "./build", "--release", "--no-tests", "--no-docs", "linux-x64"

    bin.install "built/linux-x64/ctoolbox"
    bin.install "built/ctoolbox.rsrc"
  end

  test do
    assert_match "Collective Toolbox", shell_output("#{bin}/ctoolbox help")
  end
end
EOF

if [[ "$dry_run" -eq 0 ]]; then
    cd "$repository" || exit 1
    git add packaging || exit 1
    git commit -m "chore: Automatically update packaging for version $version" || true

    if [[ -d "$repository/packaging/homebrew-tap/.git" ]]; then
        echo "Committing Homebrew formula updates..."
        cd "$repository/packaging/homebrew-tap" || exit 1
        git add Formula/ctoolbox.rb || exit 1
        git commit -m "chore: Automatically update Formula for version $version" || true
        cd "$repository" || exit 1
    fi
else
    echo "[Dry Run] Skipping packaging git commits."
fi

for target in "${targets[@]}"; do
    "$devsign_bin" ctb-dev-sign \
        --input-dir "$base_input_dir/$target" \
        --output-dir "$output_dir" \
        --platform "$target"

    latest_manifest="$(ls -1t "$output_dir/ctb-$target-"*-*.json | head -n 1)"
    ln -sfn "$(basename "$latest_manifest")" "$output_dir/ctb-$target-latest.json"
    ln -sfn "$(basename "$latest_manifest").sig" "$output_dir/ctb-$target-latest.json.sig"
done

# Upload releases into server storage directory
remote_storage="/home/$server_user/$(storage_dir_linux)"
remote_releases="$remote_storage/releases"

echo "Creating remote release directory $remote_releases..."
remote_ssh "$user" "mkdir -p '$remote_releases'" || exit 1

echo "Uploading release artifacts to $remote_releases..."
remote_rsync "$user" "$output_dir/" "$remote_releases/" -avz || exit 1

# Remote check of uploaded manifests and chunks
echo "Verifying remote manifest and chunk structure..."
remote_ssh "$user" bash -s "$remote_releases" "${targets[@]}" <<'REMOTE_CHECK'
set -euo pipefail

releases_dir="$1"
shift

test -d "$releases_dir"
test -d "$releases_dir/bh"

for target in "$@"; do
    test -f "$releases_dir/ctb-$target-latest.json"
done
REMOTE_CHECK

# Update server-side latest symlinks
echo "Updating server-side latest release symlinks..."
remote_ssh "$user" bash -s "$server_user" "$(storage_dir_linux)" "${targets[@]}" <<'REMOTE_SCRIPT'
set -euo pipefail

server_user="$1"
storage_rel="$2"
shift 2

releases_dir="/home/$server_user/$storage_rel/releases"
cd "$releases_dir" || exit 1

for target in "$@"; do
    latest="$(ls -1t "ctb-$target-"*-*.json | head -n 1)"
    ln -sfn "$latest" "ctb-$target-latest.json"
    ln -sfn "$latest.sig" "ctb-$target-latest.json.sig"
done
REMOTE_SCRIPT

# Verify uploaded releases with ctb-dev-release-check
remote_verify_bin="/home/${server_user}/deploy/ctoolbox"
if remote_ssh "$server_user" test -x "$remote_verify_bin"; then
    for target in "${targets[@]}"; do
        echo "Running remote release verification for $target..."
        remote_ssh "$server_user" "$remote_verify_bin ctb-dev-release-check --platform '$target'" || exit 1
    done
else
    echo "Skipping remote release verification; not found: $remote_verify_bin" >&2
fi

for target in "${targets[@]}"; do
    input_dir="$base_input_dir/$target"
    rm "$input_dir/ctoolbox-dependencies-$commitAndVersion.tar" || exit 1
    rm "$input_dir/ctoolbox-src-$commitAndVersion.tar" || exit 1
done

# Apply setup-permissions-groups
echo "Applying remote permissions and group configuration..."
remote_rsync "$sudoer_user" "$repository/scripts/setup-permissions-groups" "/tmp/ctb-setup-permissions-groups" -avz
remote_ssh "$sudoer_user" chmod 0700 /tmp/ctb-setup-permissions-groups
remote_sudo "USER_SERVER='$server_user' USER_DEPLOYER='$user' /tmp/ctb-setup-permissions-groups"
remote_ssh "$sudoer_user" rm -f /tmp/ctb-setup-permissions-groups

# Upload binary and resources
echo "Uploading ctoolbox binary and resources..."
remote_rsync "$user" "$base_input_dir/linux-x64/ctoolbox" "/home/${server_user}/deploy/ctoolbox-${commit}" -avz --chmod=0750
remote_rsync "$user" "$repository/built/ctoolbox.rsrc" "/home/${server_user}/deploy/ctoolbox-${commit}.rsrc" -avz

if [[ "$dry_run" -eq 0 && "$target_env" != "vm" ]]; then
    today="$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$repository/../ctb-deploys"
    7z a "$repository"/../ctb-deploys/"$today".7z "$base_input_dir" || true
fi

# Upload systemd service unit
echo "Uploading systemd unit file..."
remote_rsync "$user" "$repository/scripts/ctoolbox.service" "/home/${server_user}/.config/systemd/user/ctoolbox.service" -avz

# Gracefully restart service
echo "Stopping existing service..."
remote_ssh "$server_user" bash -s "$commit" "$server_user" <<'REMOTE_SCRIPT'
commit="$1"
server_user="$2"
systemctl --user stop ctoolbox || true
timeout 30 bash -c 'while systemctl --user is-active --quiet ctoolbox; do sleep 0.5; done' || true
REMOTE_SCRIPT

echo "Updating active binary symlinks..."
remote_ssh "$user" bash -s "$commit" "$server_user" <<'REMOTE_SCRIPT'
commit="$1"
server_user="$2"
ln -sfn "/home/$server_user/deploy/ctoolbox-$commit" "/home/$server_user/deploy/ctoolbox"
ln -sfn "/home/$server_user/deploy/ctoolbox-$commit.rsrc" "/home/$server_user/deploy/ctoolbox.rsrc"
REMOTE_SCRIPT

echo "Applying network binding capabilities..."
remote_sudo "bash -c 'setcap '\''cap_net_bind_service=+ep'\'' \"\$(readlink /home/\"\$0\"/deploy/ctoolbox)\"' '$server_user'"

# Clean up older deployed binaries
remote_ssh "$user" bash -s "$commit" "$server_user" <<'REMOTE_SCRIPT'
commit="$1"
server_user="$2"

cd /home/"$server_user"/deploy || exit 1
find . -maxdepth 1 -type f -name "ctoolbox-*" \
	! -name "ctoolbox-$commit" \
	! -name "ctoolbox-$commit.rsrc" \
	! -name "ctoolbox-dependencies-$commit.tar.gz" \
	! -name "ctoolbox-src-$commit.tar.gz" \
	-exec rm {} \; || true
REMOTE_SCRIPT

# Start service and poll health status
echo "Starting ctoolbox systemd user service..."
remote_ssh "$server_user" bash -s "${commit@Q}" "${server_user@Q}" "${GLOBAL_GRAPH_PASS@Q}" "${version@Q}" <<'REMOTE_SCRIPT'
commit="$1"
server_user="$2"
GLOBAL_GRAPH_PASS="$3"
version="$4"

systemctl --user daemon-reload
systemctl --user start ctoolbox
systemctl --user status ctoolbox

settings_file="/home/${server_user}/.local/share/collectivetoolbox/config/pc_settings.json"
web_port=8080
proto="http"
domain_name=""

if [ -f "$settings_file" ]; then
    https_port=$(/home/${server_user}/deploy/ctoolbox jq -r '.fixed_https_port // empty' "$settings_file" 2>/dev/null || true)
    http_port=$(/home/${server_user}/deploy/ctoolbox jq -r '.fixed_http_port // empty' "$settings_file" 2>/dev/null || true)
    domain_name=$(/home/${server_user}/deploy/ctoolbox jq -r '.domain_name // empty' "$settings_file" 2>/dev/null || true)

    if [ -n "$https_port" ]; then
        web_port="$https_port"
        proto="https"
    elif [ -n "$http_port" ]; then
        web_port="$http_port"
        proto="http"
    fi
fi

if [ -n "$domain_name" ]; then
    host_target="$domain_name"
else
    host_target="127.0.0.1"
fi

url="${proto}://${host_target}:${web_port}"

echo "Polling ${url}/api/update-status until server is responsive and reporting version ${version}..."
responsive=0
for i in {1..60}; do
    response=$(curl -s -k "${url}/api/update-status" 2>/dev/null || true)
    if [ -n "$response" ]; then
        reported_version=$(echo "$response" | /home/${server_user}/deploy/ctoolbox jq -r '.server_version // empty' 2>/dev/null || true)
        if [ "$reported_version" = "$version" ]; then
            echo "Server is responsive and reporting version ${version}!"
            responsive=1
            break
        fi
    fi
    sleep 1
done

if [[ "$responsive" -eq 0 ]]; then
    echo "Error: Server failed to become responsive and report version ${version} on ${url} within 60 seconds." >&2
    echo "--- Systemd journal output for ctoolbox.service (last 50 lines) ---" >&2
    journalctl --user -u ctoolbox -n 50 --no-pager 2>/dev/null || true
    echo "--- Systemd service status ---" >&2
    systemctl --user status ctoolbox 2>/dev/null || true
    exit 1
fi

token_dir="/home/${server_user}/.local/share/collectivetoolbox"
token_file="${token_dir}/setup_token"

if [ -f "$token_file" ]; then
    rm "$token_file"
fi

setup_token=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
mkdir -p "$token_dir"
echo "$setup_token" > "$token_file"
chmod 600 "$token_file"

echo "Setting up global user database..."
escaped_pass=$(/home/${server_user}/deploy/ctoolbox json-escape "$GLOBAL_GRAPH_PASS")
response=$(curl -s -k -X POST -H 'Content-Type: application/json' -H "X-Ctb-Setup-Token: $setup_token" -d "{\"password\":$escaped_pass}" "${url}/api/sync/setup-global-user" 2>/dev/null || true)

if [ -f "$token_file" ]; then
    rm "$token_file"
fi

if echo "$response" | grep -q '"success":true'; then
    echo "Global user setup successful!"
else
    echo "Global user setup failed: $response" >&2
    exit 1
fi

sleep 2
systemctl --user status ctoolbox
REMOTE_SCRIPT

unset PASS SERVER_USER_PASS SUDOER_USER_PASS

if [[ "$dry_run" -eq 0 ]]; then
    echo "$version" > VERSION
    echo "$commit" > COMMIT

    git add VERSION COMMIT
    git commit -m 'chore: Increase version after deploy'

    timestamp="$(date -u +"%Y-%m-%d %H:%M:%S UTC")"
    git tag -a "v$version" -m "Version $version - $timestamp"
else
    echo "[Dry Run] Skipping git version bump commit and tag creation."
fi

echo
echo
echo "Deploy done! If you use a CDN, don't forget to purge the cache."
