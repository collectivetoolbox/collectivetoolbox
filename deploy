set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" || exit 1

repository="$(pwd)"
source "$repository/scripts/run-dev-ctb"

usage() {
	cat <<'USAGE'
Usage:
	./deploy [quick|all] [options]

Modes:
	quick     Build + sign + deploy the server & release target (linux-x64).
	all       Build + sign + deploy all release targets (linux-x64, linux-x86,
	          windows-x64, and freebsd-x64) plus update the server binary
	          (linux-x64). This is the default.

Build Options:
	--clean           Run cargo clean before building and clean each target after staging.
	--skip-clean      Skip cargo clean before building.
	--no-clean        Alias for --skip-clean.
	--no-build        Skip build completely; require existing, up-to-date binaries matching current git commit.
	--reuse-built     Reuse binaries matching current git commit; only build missing or stale targets.
	--mock-artifacts  Generate minimal mock tarballs for rapid deploy testing.

Deployment Target & Credentials:
	--target <live|vm|DIR>        Target environment: 'live' (default), 'vm' (local QEMU Linux VM on 127.0.0.1:2224),
	                              or a directory path containing ctb-deploy.* configuration files.
	--config-dir <DIR>            Directory containing ctb-deploy.* files.
	--ssh-key <PATH>              Use explicit SSH private key file instead of password/sshpass.
	--rotate-global-pass          Prompt for a new global graph password and rotate it non-destructively.
	--new-global-pass-file <PATH> Read a new global graph password from PATH and rotate it non-destructively.
	--dry-run                     Skip version bump, packaging mutations, git commits, and git tag creation.
	--no-git-bump                 Alias for --dry-run.
	--allow-dirty                 Allow deploying with unstaged or uncommitted changes.

Notes:
	- Lints and tests are skipped during ./deploy builds (handled by CI).
	- Releases are uploaded into the server user's storage directory so the
	  update server can serve them from /releases/...
	- SSH key authentication is supported via --ssh-key, ctb-deploy.key, or VM profile.
USAGE
}

read_secret() {
	local prompt="$1"
	local secret
	read -r -s -p "$prompt" secret
	echo >&2
	printf '%s' "$secret"
}

read_config_value() {
	local file_path="$1"
	if [[ ! -r "$file_path" ]]; then
		echo "Error: Required deployment configuration file not found or unreadable: $file_path" >&2
		exit 1
	fi
	local val
	val="$(<"$file_path")"
	val="${val%$'\r'}"
	val="${val%$'\n'}"
	if [[ -z "$val" ]]; then
		echo "Error: Deployment configuration file is empty: $file_path" >&2
		exit 1
	fi
	printf '%s' "$val"
}

replace_symlink() {
	local link_target="$1"
	local link_path="$2"
	local tmp_link="${link_path}.tmp.$$"
	if [[ -L "$tmp_link" || -e "$tmp_link" ]]; then
		rm "$tmp_link"
	fi
	ln -s "$link_target" "$tmp_link"
	mv -T "$tmp_link" "$link_path"
}

mode_quick=0
skip_clean=""
target_env="live"
config_dir=""
no_build=0
reuse_built=0
dry_run=0
mock_artifacts=0
ssh_key=""
explicit_ssh_key=0
allow_dirty=0
rotate_global_pass=0
new_global_pass_file=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		"quick"|"--quick")
			mode_quick=1
			;;
		"all")
			mode_quick=0
			;;
		"--clean")
			skip_clean=0
			;;
		"--skip-clean"|"--no-clean")
			skip_clean=1
			;;
		"--no-build")
			no_build=1
			if [[ "$skip_clean" == "" ]]; then
				skip_clean=1
			fi
			;;
		"--reuse-built")
			reuse_built=1
			if [[ "$skip_clean" == "" ]]; then
				skip_clean=1
			fi
			;;
		"--mock-artifacts")
			mock_artifacts=1
			;;
		"--dry-run"|"--no-git-bump")
			dry_run=1
			;;
		"--allow-dirty")
			allow_dirty=1
			;;
		"--rotate-global-pass")
			rotate_global_pass=1
			;;
		"--new-global-pass-file")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --new-global-pass-file requires a file path argument." >&2
				usage >&2
				exit 1
			fi
			shift
			new_global_pass_file="$1"
			rotate_global_pass=1
			;;
		"--target")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --target requires an argument (<live|vm|DIR>)." >&2
				usage >&2
				exit 1
			fi
			shift
			target_env="$1"
			;;
		"--config-dir")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --config-dir requires a directory argument." >&2
				usage >&2
				exit 1
			fi
			shift
			config_dir="$1"
			;;
		"--ssh-key")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --ssh-key requires a key file path argument." >&2
				usage >&2
				exit 1
			fi
			shift
			ssh_key="$1"
			explicit_ssh_key=1
			;;
		"-h"|"--help"|"help")
			usage
			exit 0
			;;
		*)
			echo "Unknown option/argument: $1" >&2
			usage >&2
			exit 1
			;;
	esac
	shift
done

if [[ "$allow_dirty" -ne 1 ]]; then
	if ! git diff-index --quiet HEAD -- 2>/dev/null || [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
		echo "Error: Working directory has unstaged or uncommitted changes." >&2
		echo "Please commit or stash your changes before deploying, or pass --allow-dirty for test runs." >&2
		exit 1
	fi
fi

if [[ "$target_env" == "vm" ]]; then
	if [[ -z "$dry_run" || "$dry_run" -eq 0 ]]; then
		echo "Note: Automatically enabling --dry-run for VM deployment target."
		dry_run=1
	fi
	if [[ "$skip_clean" == "" ]]; then
		skip_clean=1
	fi
fi

# Resolve --target <DIR> and validate --config-dir before prompting or building
if [[ -n "$config_dir" ]]; then
	if [[ ! -d "$config_dir" ]]; then
		echo "Error: Configuration directory not found: $config_dir" >&2
		exit 1
	fi
elif [[ "$target_env" != "live" && "$target_env" != "vm" ]]; then
	if [[ -d "$target_env" ]]; then
		config_dir="$target_env"
	else
		echo "Error: Invalid --target '$target_env'. Expected 'live', 'vm', or an existing configuration directory." >&2
		exit 1
	fi
fi

if [[ "$skip_clean" == "" && "$no_build" -eq 0 ]]; then
	echo "Please choose whether to --clean (full rebuild from scratch) or to --skip-clean (incremental build)." >&2
	exit 1
fi

# Configure target credentials & endpoint
PASS=""
SERVER_USER_PASS=""
SUDOER_USER_PASS=""
SUDO_PASS=""
GLOBAL_GRAPH_PASS=""
NEW_GLOBAL_GRAPH_PASS=""
sudo_nopasswd_checked=0
sudo_nopasswd=0

if [[ -n "$new_global_pass_file" ]]; then
	NEW_GLOBAL_GRAPH_PASS="$(read_config_value "$new_global_pass_file")"
fi

if [[ "$target_env" == "vm" ]]; then
	user="ctb-deployer"
	sudoer_user="ctb-sudoer"
	server_user="ctb-server"
	server="127.0.0.1"
	port="2224"
	if [[ -z "$ssh_key" ]]; then
		ssh_key="$repository/ci-logs/VMs/Linux/id_ed25519"
	fi
	GLOBAL_GRAPH_PASS="test_global_graph_pass_123"
	if [[ ! -f "$ssh_key" ]]; then
		echo "Error: VM SSH key not found at $ssh_key." >&2
		echo "Please run ./scripts/setup-linux-vm-image to provision the VM and key, or pass --ssh-key <path>." >&2
		exit 1
	fi
elif [[ -n "$config_dir" ]]; then
	user="$(read_config_value "$config_dir/ctb-deploy.username")"
	sudoer_user="$(read_config_value "$config_dir/ctb-deploy.sudoer-username")"
	server_user="$(read_config_value "$config_dir/ctb-deploy.server-username")"
	server="$(read_config_value "$config_dir/ctb-deploy.ip")"
	port="$(read_config_value "$config_dir/ctb-deploy.port")"
	if [[ "$explicit_ssh_key" -eq 0 && -f "$config_dir/ctb-deploy.key" ]]; then
		ssh_key="$config_dir/ctb-deploy.key"
	fi
	if [[ -f "$config_dir/ctb-deploy.global-graph-pass" ]]; then
		GLOBAL_GRAPH_PASS="$(read_config_value "$config_dir/ctb-deploy.global-graph-pass")"
	fi
	if [[ -f "$config_dir/ctb-deploy.sudo-pass" ]]; then
		SUDO_PASS="$(read_config_value "$config_dir/ctb-deploy.sudo-pass")"
	fi
else
	# Read live deployment targets from ~/ctb-deploy.*
	user="$(read_config_value ~/ctb-deploy.username)"
	sudoer_user="$(read_config_value ~/ctb-deploy.sudoer-username)"
	server_user="$(read_config_value ~/ctb-deploy.server-username)"
	server="$(read_config_value ~/ctb-deploy.ip)"
	port="$(read_config_value ~/ctb-deploy.port)"
	if [[ "$explicit_ssh_key" -eq 0 && -f ~/ctb-deploy.key ]]; then
		ssh_key=~/ctb-deploy.key
	fi
	if [[ -f ~/ctb-deploy.global-graph-pass ]]; then
		GLOBAL_GRAPH_PASS="$(read_config_value ~/ctb-deploy.global-graph-pass)"
	fi
	if [[ -f ~/ctb-deploy.sudo-pass ]]; then
		SUDO_PASS="$(read_config_value ~/ctb-deploy.sudo-pass)"
	fi
fi

if [[ -n "$ssh_key" && ! -f "$ssh_key" ]]; then
	echo "Error: SSH key specified at $ssh_key not found." >&2
	exit 1
fi

if [[ -z "$ssh_key" ]]; then
	# Ensure sshpass is available to supply passwords non-interactively
	if ! command -v sshpass >/dev/null 2>&1; then
		echo "sshpass is required for password-based SSH but not installed. Please install sshpass or provide --ssh-key." >&2
		exit 1
	fi
	PASS="${PASS:-$(read_secret "Password for ${user}@${server}: ")}"
	if [[ "$server_user" == "$user" ]]; then
		SERVER_USER_PASS="$PASS"
	else
		SERVER_USER_PASS="${SERVER_USER_PASS:-$(read_secret "Password for ${server_user}@${server}: ")}"
	fi
	if [[ "$sudoer_user" == "$user" ]]; then
		SUDOER_USER_PASS="$PASS"
	elif [[ "$sudoer_user" == "$server_user" ]]; then
		SUDOER_USER_PASS="$SERVER_USER_PASS"
	else
		SUDOER_USER_PASS="${SUDOER_USER_PASS:-$(read_secret "Password for ${sudoer_user}@${server}: ")}"
	fi
	if [[ -z "$SUDO_PASS" ]]; then
		SUDO_PASS="$SUDOER_USER_PASS"
	fi
	if [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
		GLOBAL_GRAPH_PASS="$(read_secret "Password for global graph server user: ")"
	fi
elif [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
	GLOBAL_GRAPH_PASS="$(read_secret "Password for global graph server user: ")"
fi

if [[ "$rotate_global_pass" -eq 1 && -z "$NEW_GLOBAL_GRAPH_PASS" ]]; then
	NEW_GLOBAL_GRAPH_PASS="$(read_secret "New password for global graph server user: ")"
	if [[ -z "$NEW_GLOBAL_GRAPH_PASS" ]]; then
		echo "Error: New password for global graph server user cannot be empty." >&2
		exit 1
	fi
fi

password_for_user() {
	local target_user="$1"
	if [[ "$target_user" == "$user" ]]; then
		printf '%s' "$PASS"
	elif [[ "$target_user" == "$server_user" ]]; then
		printf '%s' "$SERVER_USER_PASS"
	elif [[ "$target_user" == "$sudoer_user" ]]; then
		printf '%s' "$SUDOER_USER_PASS"
	else
		echo "Error: Unknown remote user '$target_user' for password lookup." >&2
		exit 1
	fi
}

# Remote SSH and Rsync abstractions
remote_ssh() {
	local target_user="$1"
	shift
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		ssh -i "$ssh_key" -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
			-o BatchMode=yes -o LogLevel=ERROR "${target_user}@${server}" "$@"
	else
		local ssh_pass
		ssh_pass="$(password_for_user "$target_user")"
		SSHPASS="$ssh_pass" sshpass -e ssh -p "${port}" "${target_user}@${server}" "$@"
	fi
}

remote_rsync() {
	local target_user="$1"
	local src="$2"
	local dst="$3"
	shift 3
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		local escaped_key="${ssh_key//\'/\'\\\'\'}"
		rsync -e "ssh -i '${escaped_key}' -p ${port} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR" \
			"$@" "$src" "${target_user}@${server}:$dst"
	else
		local ssh_pass
		ssh_pass="$(password_for_user "$target_user")"
		SSHPASS="$ssh_pass" sshpass -e rsync -e "ssh -p ${port}" "$@" "$src" "${target_user}@${server}:$dst"
	fi
}

remote_sudo() {
	local cmd="$1"
	if [[ "$sudo_nopasswd_checked" -eq 0 ]]; then
		if remote_ssh "$sudoer_user" "sudo -n true" >/dev/null 2>&1; then
			sudo_nopasswd=1
		else
			sudo_nopasswd=0
		fi
		sudo_nopasswd_checked=1
	fi

	if [[ "$sudo_nopasswd" -eq 1 ]]; then
		remote_ssh "$sudoer_user" "sudo -n $cmd"
	else
		if [[ -z "${SUDO_PASS:-}" ]]; then
			SUDO_PASS="$(read_secret "Sudo password for ${sudoer_user}@${server}: ")"
		fi
		printf '%s\n' "$SUDO_PASS" | remote_ssh "$sudoer_user" "sudo -S -p '' $cmd"
	fi
}

cd "$repository" || exit 1

# Automatically bump version if not in dry-run/reuse mode
if [[ "$dry_run" -eq 0 && "$no_build" -eq 0 && "$reuse_built" -eq 0 ]]; then
	current_pkg_version="$(grep -m1 -E '^version\s*=\s*"[0-9]+\.[0-9]+\.[0-9]+"' Cargo.toml | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')"
	if [[ -n "$current_pkg_version" ]]; then
		IFS='.' read -r v_major v_minor v_patch <<< "$current_pkg_version"
		v_patch=$((v_patch + 1))
		next_pkg_version="${v_major}.${v_minor}.${v_patch}"
		sed -i "0,/^version\s*=\s*\"[^\"]*\"/s/^version\s*=\s*\"[^\"]*\"/version = \"${next_pkg_version}\"/" Cargo.toml
	fi

	# Trigger cargo to update Cargo.lock with the new version.
	cargo metadata --format-version=1 --offline >/dev/null 2>&1 \
		|| cargo metadata --format-version=1 >/dev/null

	# Automatically commit the version bump if there are changes.
	if ! git diff --quiet Cargo.toml Cargo.lock; then
		git commit -m "chore: Automatically bump package version on deploy" Cargo.toml Cargo.lock
	fi
fi

version="$(cargo metadata --format-version=1 --no-deps | jq -r '.packages[] | select(.name == "ctoolbox") | .version')"
commit="$(git rev-parse HEAD)"
commitAndVersion="$version-$commit"

if [[ "$dry_run" -eq 0 ]] && git rev-parse -q --verify "refs/tags/v$version" >/dev/null 2>&1; then
	echo "Error: Git tag 'v$version' already exists." >&2
	echo "Bump the version in Cargo.toml, delete the local tag if retrying an aborted release, or pass --dry-run." >&2
	exit 1
fi

host_platform() {
	local os arch
	os="$(uname -s)"
	arch="$(uname -m)"
	if [[ "$os" != "Linux" ]]; then
		echo "Unsupported host OS: $os" >&2
		exit 1
	fi
	case "$arch" in
		x86_64|amd64)
			printf '%s' "linux-x64"
			;;
		i386|i486|i586|i686)
			printf '%s' "linux-x86"
			;;
		*)
			echo "Unsupported host arch: $arch" >&2
			exit 1
			;;
	esac
}

storage_dir_linux() {
	printf '%s' ".local/share/collectivetoolbox"
}

release_targets() {
	if [[ "$mode_quick" -eq 1 ]]; then
		printf '%s\n' "linux-x64"
	else
		printf '%s\n' "linux-x64" "linux-x86" "windows-x64" "freebsd-x64"
	fi
}

exe_suffix_for_target() {
	case "$1" in
		windows-*)
			printf '%s' ".exe"
			;;
		*)
			printf '%s' ""
			;;
	esac
}

base_input_dir="$repository/../ctb_release/input"
if [[ -d "$base_input_dir" ]]; then
	rm -r "$base_input_dir"
fi
mkdir -p "$base_input_dir" || exit 1

cd "$repository" || exit 1

mapfile -t targets < <(release_targets)
if [[ "${#targets[@]}" -eq 0 ]]; then
	echo "No release targets configured" >&2
	exit 1
fi

# Check binaries (both ctoolbox and ctoolbox-installer) and decide what needs building
targets_to_build=()
reused_targets=()
has_docs_built=0
if [[ -f "$repository/built/docs/help.html" || -f "$repository/built/docs/index.html" ]]; then
	has_docs_built=1
fi

if [[ "$reuse_built" -eq 1 || "$no_build" -eq 1 ]]; then
	for target in "${targets[@]}"; do
		exe_suffix="$(exe_suffix_for_target "$target")"
		bin_path="$repository/built/$target/ctoolbox${exe_suffix}"
		installer_path="$repository/built/$target/ctoolbox-installer${exe_suffix}"
		rsrc_exists=0
		if [[ -f "$repository/built/$target/ctoolbox.rsrc" || -f "$repository/built/ctoolbox.rsrc" ]]; then
			rsrc_exists=1
		fi

		if [[ -f "$bin_path" && -f "$installer_path" && "$rsrc_exists" -eq 1 ]]; then
			bin_commit=""
			inst_commit=""
			bin_ok=0
			inst_ok=0
			if [[ "$reuse_built" -eq 1 && "$no_build" -eq 0 ]]; then
				if bin_commit="$(ctb_binary_commit "$bin_path" 2>/dev/null)" && [[ "$bin_commit" == "$commit" ]]; then
					bin_ok=1
				fi
				if inst_commit="$(ctb_binary_commit "$installer_path" 2>/dev/null)" && [[ "$inst_commit" == "$commit" ]]; then
					inst_ok=1
				fi
			else
				if bin_commit="$(ctb_binary_commit "$bin_path")" && [[ "$bin_commit" == "$commit" ]]; then
					bin_ok=1
				fi
				if inst_commit="$(ctb_binary_commit "$installer_path")" && [[ "$inst_commit" == "$commit" ]]; then
					inst_ok=1
				fi
			fi

			if [[ "$bin_ok" -eq 1 && "$inst_ok" -eq 1 ]]; then
				if [[ "$no_build" -eq 1 ]]; then
					echo "Target '$target' binaries (ctoolbox + ctoolbox-installer) match HEAD ($commit)."
					reused_targets+=("$target")
					continue
				fi
				if [[ "$reuse_built" -eq 1 && "$has_docs_built" -eq 1 ]]; then
					echo "Target '$target' binaries and docs are current (match HEAD $commit)."
					reused_targets+=("$target")
					continue
				elif [[ "$reuse_built" -eq 1 && "$has_docs_built" -eq 0 ]]; then
					echo "Target '$target' binaries match HEAD ($commit), but built/docs is missing (likely a --quick build); rebuilding with --docs."
				fi
			else
				if [[ "$no_build" -eq 1 ]]; then
					echo "Error: Binary or installer for target '$target' is stale (ctoolbox='$bin_commit', installer='$inst_commit', HEAD='$commit'). Cannot use --no-build." >&2
					exit 1
				fi
				echo "Target '$target' binaries are stale (ctoolbox='$bin_commit', installer='$inst_commit', HEAD='$commit'). Rebuilding required."
			fi
		else
			if [[ "$no_build" -eq 1 ]]; then
				echo "Error: Binary, installer, or ctoolbox.rsrc for target '$target' not found ($bin_path, $installer_path). Cannot use --no-build." >&2
				exit 1
			fi
		fi
		targets_to_build+=("$target")
	done
else
	targets_to_build=("${targets[@]}")
fi

if [[ "${#targets_to_build[@]}" -gt 0 ]]; then
	build_clean_flags=()
	if [[ "$skip_clean" == "0" ]]; then
		cargo clean
		build_clean_flags=(--clean-targets)
	fi
	rsrc_sha_before=""
	if [[ -f "$repository/built/ctoolbox.rsrc" ]]; then
		rsrc_sha_before="$(sha256sum "$repository/built/ctoolbox.rsrc" | cut -d' ' -f1)"
	fi
	echo "Building targets (skipping lints and tests): ${targets_to_build[*]}..."
	./build --release --docs --no-lints --no-tests "${build_clean_flags[@]}" "${targets_to_build[@]}"
	if [[ "${#reused_targets[@]}" -gt 0 && -f "$repository/built/ctoolbox.rsrc" ]]; then
		rsrc_sha_after="$(sha256sum "$repository/built/ctoolbox.rsrc" | cut -d' ' -f1)"
		if [[ "$rsrc_sha_after" != "$rsrc_sha_before" ]]; then
			echo "Runtime bundle built/ctoolbox.rsrc changed during build; rebuilding reused targets (${reused_targets[*]}) to align embedded bundle SHA-256..."
			./build --release --no-docs --skip-codegen --no-lints --no-tests "${build_clean_flags[@]}" "${reused_targets[@]}"
		fi
	fi
else
	echo "All release targets (${targets[*]}) are already built and match HEAD ($commit). Skipping compilation."
fi

# Package source and dependencies
if [[ "$mock_artifacts" -eq 1 ]]; then
	echo "Packaging mock dependency and source tarballs for rapid deploy testing..."
	tar -cf "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar" -T /dev/null
	tar -cf "$base_input_dir/ctoolbox-src-$commitAndVersion.tar" -T /dev/null
else
	cd "$repository/vendor/ctb-vendored" || exit 1
	if [[ "$dry_run" -eq 0 ]]; then
		"$repository/scripts/vendor-dependencies"
	else
		echo "[Dry Run] Skipping vendor-dependencies submodule commits; archiving current HEAD."
	fi

	cd "$repository/vendor/ctb-vendored" || exit 1
	git archive --format=tar --prefix=ctoolbox-dependencies/ HEAD \
		-o "$base_input_dir/ctoolbox-dependencies-$commitAndVersion.tar"

	# Archive application source code (including vendored code) without leaving temporary tarballs in git dirs.
	cd "$repository/vendor" || exit 1
	git archive --format=tar HEAD -o "$base_input_dir/vendor.tar"

	cd "$repository/packaging/homebrew-tap" || exit 1
	git archive --format=tar HEAD -o "$base_input_dir/homebrew-tap.tar"

	cd "$repository" || exit 1
	git archive --format=tar \
		--prefix=ctoolbox-src/ \
		--add-file="$base_input_dir/vendor.tar" \
		--add-file="$base_input_dir/homebrew-tap.tar" \
		HEAD -o "$base_input_dir/ctoolbox-src-$commitAndVersion.tar"

	rm "$base_input_dir/vendor.tar" "$base_input_dir/homebrew-tap.tar"
fi

cd "$repository" || exit 1

# Prepare release input directories.
output_dir="$repository/../ctb_release/releases"
mkdir -p "$output_dir" || exit 1

link_or_copy() {
	local src_file="$1"
	local dst_file="$2"
	if [[ -e "$dst_file" || -L "$dst_file" ]]; then
		rm "$dst_file"
	fi
