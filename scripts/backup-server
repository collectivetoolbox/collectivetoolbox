# Incrementally back up the remote server's /home directory tree (including
# application databases, user graphs, configuration, systemd user units, and
# release artifacts, while excluding /var and all other OS directories) to a
# local folder over SSH + rsync.

set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1
repository="$(pwd)"

usage() {
	cat <<'USAGE'
Usage:
	./scripts/backup-server [options] [DEST_DIR]

Description:
	Incrementally backs up the server's /home directory tree to a local folder
	using SSH + rsync. OS directories (/var, /etc, /usr, /proc, /sys, /tmp, etc.)
	are never included.

Options:
	--dest <DIR>            Local destination directory (default: ../ctb-server-backup).
	--target <live|vm|DIR>  Target environment: 'live' (default), 'vm' (local QEMU Linux VM
	                        on 127.0.0.1:2224), or a directory containing ctb-deploy.* files.
	--config-dir <DIR>      Directory containing ctb-deploy.* configuration files.
	--ssh-key <PATH>        Use explicit SSH private key file instead of password/sshpass.
	--exclude-releases      Skip .local/share/collectivetoolbox/releases/ (faster user-data-only backup).
	--stop-service          Temporarily stop ctoolbox.service during the backup for a cold DB snapshot
	                        (restarts and re-unlocks the global graph user automatically on exit).
	                        Without this flag, the service stays up and the second --checksum pass
	                        narrows live DB/WAL skew with zero downtime.
	--global-pass-file <P>  Read global graph user password from P (used with --stop-service).
	--mirror                Delete files in DEST_DIR/home that no longer exist on the server
	                        (rsync --delete-after). Off by default so accidental remote deletions
	                        do not erase previously backed-up local files.
	--dry-run               Preview files that would be transferred without modifying DEST_DIR.
	-h, --help              Show this help message and exit.
USAGE
}

read_secret() {
	local prompt="$1"
	local secret
	read -r -s -p "$prompt" secret
	echo >&2
	printf '%s' "$secret"
}

read_config_value() {
	local file_path="$1"
	if [[ ! -r "$file_path" ]]; then
		echo "Error: Required deployment configuration file not found or unreadable: $file_path" >&2
		exit 1
	fi
	local val
	val="$(<"$file_path")"
	val="${val%$'\r'}"
	val="${val%$'\n'}"
	if [[ -z "$val" ]]; then
		echo "Error: Deployment configuration file is empty: $file_path" >&2
		exit 1
	fi
	printf '%s' "$val"
}

dest_dir=""
target_env="live"
config_dir=""
ssh_key=""
explicit_ssh_key=0
exclude_releases=0
stop_service=0
global_pass_file=""
mirror_delete=0
dry_run=0

while [[ $# -gt 0 ]]; do
	case "$1" in
		"--dest")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --dest requires a directory argument." >&2
				usage >&2
				exit 1
			fi
			shift
			dest_dir="$1"
			;;
		"--target")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --target requires an argument (<live|vm|DIR>)." >&2
				usage >&2
				exit 1
			fi
			shift
			target_env="$1"
			;;
		"--config-dir")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --config-dir requires a directory argument." >&2
				usage >&2
				exit 1
			fi
			shift
			config_dir="$1"
			;;
		"--ssh-key")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --ssh-key requires a key file path argument." >&2
				usage >&2
				exit 1
			fi
			shift
			ssh_key="$1"
			explicit_ssh_key=1
			;;
		"--exclude-releases")
			exclude_releases=1
			;;
		"--stop-service")
			stop_service=1
			;;
		"--global-pass-file")
			if [[ $# -lt 2 || -z "${2:-}" ]]; then
				echo "Error: --global-pass-file requires a file path argument." >&2
				usage >&2
				exit 1
			fi
			shift
			global_pass_file="$1"
			;;
		"--mirror")
			mirror_delete=1
			;;
		"--dry-run")
			dry_run=1
			;;
		"-h"|"--help"|"help")
			usage
			exit 0
			;;
		--*)
			echo "Unknown option: $1" >&2
			usage >&2
			exit 1
			;;
		*)
			if [[ -n "$dest_dir" ]]; then
				echo "Error: Multiple destination directories specified ('$dest_dir' and '$1')." >&2
				usage >&2
				exit 1
			fi
			dest_dir="$1"
			;;
	esac
	shift
done

if [[ -z "$dest_dir" ]]; then
	dest_dir="$repository/../ctb-server-backup"
fi

if ! command -v rsync >/dev/null 2>&1; then
	echo "Error: rsync is required locally to run scripts/backup-server." >&2
	exit 1
fi

if [[ -n "$config_dir" ]]; then
	if [[ ! -d "$config_dir" ]]; then
		echo "Error: Configuration directory not found: $config_dir" >&2
		exit 1
	fi
elif [[ "$target_env" != "live" && "$target_env" != "vm" ]]; then
	if [[ -d "$target_env" ]]; then
		config_dir="$target_env"
	else
		echo "Error: Invalid --target '$target_env'. Expected 'live', 'vm', or an existing configuration directory." >&2
		exit 1
	fi
fi

PASS=""
SERVER_USER_PASS=""
SUDOER_USER_PASS=""
GLOBAL_GRAPH_PASS=""

if [[ -n "$global_pass_file" ]]; then
	GLOBAL_GRAPH_PASS="$(read_config_value "$global_pass_file")"
fi

if [[ "$target_env" == "vm" ]]; then
	user="ctb-deployer"
	sudoer_user="ctb-sudoer"
	server_user="ctb-server"
	server="127.0.0.1"
	port="2224"
	if [[ -z "$ssh_key" ]]; then
		ssh_key="$repository/ci-logs/VMs/Linux/id_ed25519"
	fi
	if [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
		GLOBAL_GRAPH_PASS="test_global_graph_pass_123"
	fi
	if [[ ! -f "$ssh_key" ]]; then
		echo "Error: VM SSH key not found at $ssh_key." >&2
		echo "Please run ./scripts/setup-linux-vm-image to provision the VM and key, or pass --ssh-key <path>." >&2
		exit 1
	fi
elif [[ -n "$config_dir" ]]; then
	user="$(read_config_value "$config_dir/ctb-deploy.username")"
	sudoer_user="$(read_config_value "$config_dir/ctb-deploy.sudoer-username")"
	server_user="$(read_config_value "$config_dir/ctb-deploy.server-username")"
	server="$(read_config_value "$config_dir/ctb-deploy.ip")"
	port="$(read_config_value "$config_dir/ctb-deploy.port")"
	if [[ "$explicit_ssh_key" -eq 0 && -f "$config_dir/ctb-deploy.key" ]]; then
		ssh_key="$config_dir/ctb-deploy.key"
	fi
	if [[ -z "$GLOBAL_GRAPH_PASS" && -f "$config_dir/ctb-deploy.global-graph-pass" ]]; then
		GLOBAL_GRAPH_PASS="$(read_config_value "$config_dir/ctb-deploy.global-graph-pass")"
	fi
else
	user="$(read_config_value ~/ctb-deploy.username)"
	sudoer_user="$(read_config_value ~/ctb-deploy.sudoer-username)"
	server_user="$(read_config_value ~/ctb-deploy.server-username)"
	server="$(read_config_value ~/ctb-deploy.ip)"
	port="$(read_config_value ~/ctb-deploy.port)"
	if [[ "$explicit_ssh_key" -eq 0 && -f ~/ctb-deploy.key ]]; then
		ssh_key=~/ctb-deploy.key
	fi
	if [[ -z "$GLOBAL_GRAPH_PASS" && -f ~/ctb-deploy.global-graph-pass ]]; then
		GLOBAL_GRAPH_PASS="$(read_config_value ~/ctb-deploy.global-graph-pass)"
	fi
fi

if [[ -n "$ssh_key" && ! -f "$ssh_key" ]]; then
	echo "Error: SSH key specified at $ssh_key not found." >&2
	exit 1
fi

# Reject backing up directly into the git repository working tree before creating any directories
resolved_dest="$(readlink -m "$dest_dir")"
resolved_repo="$(readlink -f "$repository")"
if [[ "$resolved_dest" == "$resolved_repo" || "$resolved_dest" == "$resolved_repo/"* ]]; then
	echo "Error: Destination directory ($resolved_dest) must be outside the git repository ($resolved_repo)." >&2
	exit 1
fi

if [[ -z "$ssh_key" ]]; then
	if ! command -v sshpass >/dev/null 2>&1; then
		echo "Error: sshpass is required for password-based SSH but not installed. Install sshpass or provide --ssh-key." >&2
		exit 1
	fi
	PASS="${PASS:-$(read_secret "Password for ${user}@${server}: ")}"
	if [[ "$server_user" == "$user" ]]; then
		SERVER_USER_PASS="$PASS"
	else
		SERVER_USER_PASS="${SERVER_USER_PASS:-$(read_secret "Password for ${server_user}@${server}: ")}"
	fi
	if [[ "$sudoer_user" == "$user" ]]; then
		SUDOER_USER_PASS="$PASS"
	elif [[ "$sudoer_user" == "$server_user" ]]; then
		SUDOER_USER_PASS="$SERVER_USER_PASS"
	else
		SUDOER_USER_PASS="${SUDOER_USER_PASS:-$(read_secret "Password for ${sudoer_user}@${server}: ")}"
	fi
fi

if [[ "$stop_service" -eq 1 && "$dry_run" -eq 0 && -z "$GLOBAL_GRAPH_PASS" ]]; then
	GLOBAL_GRAPH_PASS="$(read_secret "Password for global graph server user (to unlock global graph on service restart): ")"
	if [[ -z "$GLOBAL_GRAPH_PASS" ]]; then
		echo "Error: Global graph password is required when using --stop-service so the global graph can be unlocked after restarting ctoolbox.service." >&2
		exit 1
	fi
fi

json_escape_stdin() {
	if command -v jq >/dev/null 2>&1; then
		jq -Rs .
	elif command -v python3 >/dev/null 2>&1; then
		python3 -c 'import json, sys; sys.stdout.write(json.dumps(sys.stdin.read()))'
	else
		echo "Error: jq or python3 is required locally to JSON-escape credentials." >&2
		return 1
	fi
}

password_for_user() {
	local target_user="$1"
	if [[ "$target_user" == "$user" ]]; then
		printf '%s' "$PASS"
	elif [[ "$target_user" == "$server_user" ]]; then
		printf '%s' "$SERVER_USER_PASS"
	elif [[ "$target_user" == "$sudoer_user" ]]; then
		printf '%s' "$SUDOER_USER_PASS"
	else
		echo "Error: Unknown remote user '$target_user' for password lookup." >&2
		exit 1
	fi
}

remote_ssh() {
	local target_user="$1"
	shift
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		ssh -i "$ssh_key" -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
			-o BatchMode=yes -o LogLevel=ERROR "${target_user}@${server}" "$@"
	else
		local ssh_pass
		ssh_pass="$(password_for_user "$target_user")"
		SSHPASS="$ssh_pass" sshpass -e ssh -p "${port}" "${target_user}@${server}" "$@"
	fi
}

pull_rsync() {
	local target_user="$1"
	local remote_src="$2"
	local local_dst="$3"
	shift 3
	local rc=0
	if [[ -n "${ssh_key:-}" && -f "${ssh_key:-}" ]]; then
		local escaped_key="${ssh_key//\'/\'\\\'\'}"
		rsync -e "ssh -i '${escaped_key}' -p ${port} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR" \
			"$@" "${target_user}@${server}:${remote_src}" "$local_dst" || rc=$?
	else
		local ssh_pass
		ssh_pass="$(password_for_user "$target_user")"
		SSHPASS="$ssh_pass" sshpass -e rsync -e "ssh -p ${port}" \
			"$@" "${target_user}@${server}:${remote_src}" "$local_dst" || rc=$?
	fi
	# During live backups (without --stop-service), transient lock/WAL/temp files
	# may be unlinked between rsync's file-list scan and file open, which rsync
	# reports as exit code 24 (RERR_VANISHED). Allow exit 24 when live so Pass 1
	# still proceeds to Pass 2 and transient deletions do not abort the backup.
	if [[ "$rc" -eq 24 && "$stop_service" -eq 0 ]]; then
		echo "Note: some transient remote files vanished during live rsync (exit 24); continuing." >&2
		return 0
	fi
	return "$rc"
}

restart_and_unlock_service() {
	echo "Restarting ctoolbox.service on ${server} and re-unlocking global graph user..."
	local escaped_global_pass payload
	escaped_global_pass="$(printf '%s' "$GLOBAL_GRAPH_PASS" | json_escape_stdin)" || return 1
	payload="{\"password\":${escaped_global_pass}}"
	unset escaped_global_pass

	if ! printf '%s' "$payload" | remote_ssh "$server_user" bash -c '
set -euo pipefail
server_user="$1"
payload="$(cat)"

systemctl --user start ctoolbox

settings_file="/home/${server_user}/.local/share/collectivetoolbox/config/pc_settings.json"
web_port=8080
proto="http"
domain_name=""
bind_to_ip=""

if [ -f "$settings_file" ]; then
	tls_cert=$(/home/${server_user}/deploy/ctoolbox jq -r ".tls_certificate // empty" "$settings_file" 2>/dev/null || true)
	https_port=$(/home/${server_user}/deploy/ctoolbox jq -r ".fixed_https_port // empty" "$settings_file" 2>/dev/null || true)
	http_port=$(/home/${server_user}/deploy/ctoolbox jq -r ".fixed_http_port // empty" "$settings_file" 2>/dev/null || true)
	domain_name=$(/home/${server_user}/deploy/ctoolbox jq -r ".domain_name // empty" "$settings_file" 2>/dev/null || true)
	bind_to_ip=$(/home/${server_user}/deploy/ctoolbox jq -r ".bind_to_ip // empty" "$settings_file" 2>/dev/null || true)

	if [ -n "$tls_cert" ]; then
		proto="https"
		web_port="${https_port:-8443}"
	else
		proto="http"
		web_port="${http_port:-8080}"
	fi
fi

if [ -z "$bind_to_ip" ] || [ "$bind_to_ip" = "0.0.0.0" ] || [ "$bind_to_ip" = "::" ] || [ "$bind_to_ip" = "127.0.0.1" ]; then
	connect_ip="127.0.0.1"
else
	connect_ip="$bind_to_ip"
fi

curl_resolve_args=()
if [ "$proto" = "https" ] && [ -n "$domain_name" ]; then
	url="https://${domain_name}:${web_port}"
	curl_resolve_args=(--resolve "${domain_name}:${web_port}:${connect_ip}")
else
	url="${proto}://${connect_ip}:${web_port}"
fi

responsive=0
for _ in {1..60}; do
	if curl -fsS "${curl_resolve_args[@]}" "${url}/api/update-status" >/dev/null 2>&1; then
		responsive=1
		break
	fi
	sleep 1
done

if [ "$responsive" -eq 0 ]; then
	unset payload
	echo "Error: ctoolbox.service did not become responsive on ${url} within 60s after restart." >&2
	exit 1
fi

token_dir="/home/${server_user}/.local/share/collectivetoolbox"
token_file="${token_dir}/setup_token"
if [ -f "$token_file" ]; then
	rm "$token_file"
fi
setup_token=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d " \n")
mkdir -p "$token_dir"
printf "%s\n" "$setup_token" > "$token_file"
chmod 600 "$token_file"

resp_file="$(mktemp)"
http_code=$(printf "%s" "$payload" | curl -sS -o "$resp_file" -w "%{http_code}" "${curl_resolve_args[@]}" -X POST -H "Content-Type: application/json" -H "X-Ctb-Setup-Token: $setup_token" --data-binary @- "${url}/api/sync/setup-global-user" || true)
unset payload
response="$(cat "$resp_file" 2>/dev/null || true)"
rm "$resp_file"

if [ -f "$token_file" ]; then
	rm "$token_file"
fi

if [ "$http_code" = "200" ] && printf "%s" "$response" | grep -q "\"success\":true"; then
	echo "ctoolbox.service restarted and global graph user re-unlocked successfully."
else
	echo "Error: Failed to re-unlock global graph user after restart (HTTP ${http_code:-error}): ${response}" >&2
	exit 1
fi
' _ "$server_user"; then
		unset payload
		return 1
	fi
	unset payload
	return 0
}

service_was_stopped=0
cleanup_on_exit() {
	local exit_rc=$?
	if [[ "$service_was_stopped" -eq 1 ]]; then
		if ! restart_and_unlock_service; then
			echo "Error: Failed to cleanly restart and re-unlock ctoolbox.service on ${server}; check 'systemctl --user status ctoolbox' or re-run ./deploy." >&2
			if [[ "$exit_rc" -eq 0 ]]; then
				exit_rc=1
			fi
		fi
	fi
	unset GLOBAL_GRAPH_PASS PASS SERVER_USER_PASS SUDOER_USER_PASS
	exit "$exit_rc"
}
trap cleanup_on_exit EXIT

rsync_common_args=(
	-rlptDzv
	--progress
	--safe-links
	--chmod=u+rwX
	--exclude=/.cache/collectivetoolbox/downloads_cache/
	--exclude=/*/.cache/collectivetoolbox/downloads_cache/
	--exclude=/.local/share/collectivetoolbox/releases/downloads_cache/
	--exclude=/*/.local/share/collectivetoolbox/releases/downloads_cache/
	--exclude=/.local/share/collectivetoolbox/setup_token
	--exclude=/*/.local/share/collectivetoolbox/setup_token
)

if [[ "$exclude_releases" -eq 1 ]]; then
	rsync_common_args+=(
		--exclude=/.local/share/collectivetoolbox/releases/
		--exclude=/*/.local/share/collectivetoolbox/releases/
	)
fi

if [[ "$mirror_delete" -eq 1 ]]; then
	rsync_common_args+=(--delete-after)
fi

if [[ "$dry_run" -eq 1 ]]; then
	rsync_common_args+=(--dry-run)
fi

if [[ "$dry_run" -eq 0 ]]; then
	mkdir -p "$resolved_dest/home"
fi

if [[ "$stop_service" -eq 1 && "$dry_run" -eq 0 ]]; then
	echo "Stopping ctoolbox.service on ${server} for cold snapshot..."
	remote_ssh "$server_user" bash <<'REMOTE_STOP'
systemctl --user stop ctoolbox || true
timeout 30 bash -c 'while systemctl --user is-active --quiet ctoolbox; do sleep 0.5; done' || true
REMOTE_STOP
	service_was_stopped=1
fi

use_sudo_rsync=0
if remote_ssh "$sudoer_user" "sudo -n true" >/dev/null 2>&1; then
	use_sudo_rsync=1
	echo "Using passwordless sudo rsync via ${sudoer_user} to back up all /home accounts..."
else
	echo "Note: Passwordless sudo is not enabled for ${sudoer_user}; backing up each configured user's /home directory directly..."
fi

sync_all_home() {
	if [[ "$use_sudo_rsync" -eq 1 ]]; then
		pull_rsync "$sudoer_user" "/home/" "$resolved_dest/home/" \
			--rsync-path="sudo rsync" "${rsync_common_args[@]}" "$@"
	else
		declare -A synced_users=()
		local acct
		for acct in "$server_user" "$user" "$sudoer_user"; do
			if [[ -n "${synced_users[$acct]:-}" ]]; then
				continue
			fi
			synced_users["$acct"]=1
			if ! remote_ssh "$acct" "test -d '/home/${acct}'" >/dev/null 2>&1; then
				echo "Skipping /home/${acct} (directory not present on ${server})."
				continue
			fi
			echo "Syncing /home/${acct}..."
			if [[ "$dry_run" -eq 0 ]]; then
				mkdir -p "$resolved_dest/home/$acct"
			fi
			pull_rsync "$acct" "/home/${acct}/" "$resolved_dest/home/$acct/" \
				"${rsync_common_args[@]}" "$@"
		done
	fi
}

echo "Pass 1/2: Syncing /home from ${server}:${port} to ${resolved_dest}/home (excluding /var and all other OS directories)..."
sync_all_home

echo "Pass 2/2: Re-reading and verifying all /home files with --checksum..."
sync_all_home --checksum

if [[ "$dry_run" -eq 0 ]]; then
	timestamp_utc="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
	if command -v jq >/dev/null 2>&1; then
		jq -n \
			--arg timestamp_utc "$timestamp_utc" \
			--arg target "$target_env" \
			--arg server "$server" \
			--arg port "$port" \
			--arg server_user "$server_user" \
			--argjson exclude_releases "$exclude_releases" \
			--argjson stopped_service "$stop_service" \
			--argjson mirror "$mirror_delete" \
			'{
				timestamp_utc: $timestamp_utc,
				scope: "/home",
				excluded_os_dirs: ["/var", "/etc", "/usr", "/proc", "/sys", "/dev", "/run", "/tmp", "/boot", "/opt", "/root"],
				target: $target,
				server: $server,
				port: $port,
				server_user: $server_user,
				exclude_releases: ($exclude_releases == 1),
				stopped_service: ($stopped_service == 1),
				mirror: ($mirror == 1)
			}' > "$resolved_dest/backup-metadata.json"
	elif command -v python3 >/dev/null 2>&1; then
		python3 - "$timestamp_utc" "$target_env" "$server" "$port" "$server_user" "$exclude_releases" "$stop_service" "$mirror_delete" "$resolved_dest/backup-metadata.json" <<'PYMETA'
import json, sys
ts, target, server, port, s_user, excl, stopped, mirror, out_path = sys.argv[1:]
meta = {
    "timestamp_utc": ts,
    "scope": "/home",
    "excluded_os_dirs": ["/var", "/etc", "/usr", "/proc", "/sys", "/dev", "/run", "/tmp", "/boot", "/opt", "/root"],
    "target": target,
    "server": server,
    "port": port,
    "server_user": s_user,
    "exclude_releases": excl == "1",
    "stopped_service": stopped == "1",
    "mirror": mirror == "1",
}
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(meta, f, indent=2)
    f.write("\n")
PYMETA
	fi
	echo "Backup completed successfully at: ${resolved_dest}"
else
	echo "[Dry Run] Backup preview completed (no local files modified in ${resolved_dest})."
fi
