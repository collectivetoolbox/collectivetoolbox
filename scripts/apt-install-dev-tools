set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

export DEBIAN_FRONTEND=noninteractive

# Essential base utilities installed alongside dev tools (preserved on --remove)
base_packages=(
    acl
    coreutils
    locales
    # tar is only preserved because apt will try to install tar:i386 on trying to remove it. It gets deleted subsequently by `SKIP_BINS` instead.
    tar
)

# Developer utilities and convenience tools (purged in CI via --remove)
dev_packages=(
    brotli
    libbz2-dev
    liblzo2-dev
    lz4
    lzip
    ncdu
    genisoimage
    librsvg2-bin
    lld
    nodejs
    npm
    perl
    proot
    qemu-system-ppc
    qemu-system-x86
    ovmf
    ripgrep
    shellcheck
    tmux
    vim-common
    xxd
    xz-utils
    zstd
)

if [[ "${1:-}" == "--remove" || "${1:-}" == "--purge" ]]; then
    if [[ "${PLEASE_BREAK_MY_SYSTEM:-}" != "y" ]]; then
        echo "Refusing to purge essential packages unless PLEASE_BREAK_MY_SYSTEM=y is set." >&2
        exit 1
    fi
    echo "Purging developer utilities..."
    apt-get purge -y --no-install-recommends --allow-remove-essential "${dev_packages[@]}" corepack "libnode*" "node-*" "liblzma-dev*" 2>/dev/null || true
else
    echo "Installing developer utilities..."
    apt-get update
    apt-get install -y --no-install-recommends "${base_packages[@]}" "${dev_packages[@]}"

    # Set up MinGW ld.lld symlinks so -fuse-ld=lld resolves properly
    if command -v ld.lld >/dev/null 2>&1; then
        mkdir -p /usr/x86_64-w64-mingw32/bin
        ln -sf "$(command -v ld.lld)" /usr/bin/x86_64-w64-mingw32-ld.lld
        ln -sf "$(command -v ld.lld)" /usr/x86_64-w64-mingw32/bin/ld.lld
        for gcc_dir in /usr/lib/gcc/x86_64-w64-mingw32/*; do
            if [[ -d "$gcc_dir" ]]; then
                ln -sf "$(command -v ld.lld)" "$gcc_dir/ld.lld"
            fi
        done
    fi
fi

apt-get clean
