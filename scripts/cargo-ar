set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1
workspace_root="$(pwd)"
cd - >/dev/null || exit 1

# Repair any non-writable files left in $OUT_DIR (such as root-owned 0644 headers
# from zstd-sys/build.rs) immediately before cc::Build archives static libraries
# and copies headers into $OUT_DIR/include.
if [[ -n "${OUT_DIR:-}" && -d "$OUT_DIR" ]]; then
    "$workspace_root/scripts/fix-target-permissions" "$OUT_DIR"
fi

case "${TARGET:-}" in
    *-windows-gnu)
        ar_bin="x86_64-w64-mingw32-gcc-ar"
        ;;
    *)
        ar_bin="ar"
        ;;
esac

rc=0
"$ar_bin" "$@" || rc=$?

if [[ "$rc" -eq 0 && -n "${OUT_DIR:-}" && -d "$OUT_DIR" ]]; then
    "$workspace_root/scripts/fix-target-permissions" "$OUT_DIR"
fi

exit "$rc"
