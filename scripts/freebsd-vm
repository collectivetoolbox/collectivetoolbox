# Helper script to manage, snapshot, and run tests/commands in the FreeBSD VM in QEMU.
set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(pwd)"

source "$SCRIPT_DIR/vm-common.sh"

DEFAULT_IMAGE="$REPO_ROOT/ci-logs/VMs/FreeBSD/freebsd.qcow2"
SSH_KEY="$REPO_ROOT/ci-logs/VMs/FreeBSD/id_ed25519"
SOCKET_DIR="/tmp/ctb-freebsd-vm"
MONITOR_SOCK="$SOCKET_DIR/monitor.sock"
VNC_SOCK="$SOCKET_DIR/vnc.sock"
PID_FILE="$SOCKET_DIR/qemu.pid"
SERIAL_LOG="$SOCKET_DIR/serial.log"
SERIAL_SOCK="$SOCKET_DIR/serial.sock"
EXCHANGE_DIR="/tmp/ctb-freebsd-exchange"
EXCHANGE_ISO="/tmp/ctb-freebsd-exchange.iso"
DEFAULT_SSH_PORT="2223"

mkdir -p "$SOCKET_DIR"

usage() {
    cat <<EOF
Usage: ./scripts/freebsd-vm <command> [options]

VM Lifecycle:
  start          Start the FreeBSD VM in the background (QEMU)
                 Options:
                   --persist        Write changes directly to the qcow2 image
                                    (default: runs with -snapshot to protect image)
                   --net            Attach an isolated local loopback NIC (restrict=on,
                                    guest cannot access external LAN or internet; forwards
                                    localhost:2223 -> guest:22 for SSH)
                   --ssh-port PORT  Custom forwarded SSH port (default: 2223)
                   --vnc-port P     Also listen on TCP port P for VNC (e.g. 5902)
                   --image PATH     Use a custom qcow2 image (default: ci-logs/VMs/FreeBSD/freebsd.qcow2)
                   --iso PATH       Attach a custom CD-ROM ISO (default: /tmp/ctb-freebsd-exchange.iso)
                   --mem MB         Memory in MB (default: 4096)
                   --smp CORES      CPU cores (default: 4)

  stop           Stop the running VM (graceful ACPI shutdown, or --force)
  status         Check if the VM is running and display resource usage

Snapshot Management:
  snapshot list             List snapshots present in the qcow2 disk image
  snapshot create <name>    Create a snapshot (live if running, offline if stopped)
  snapshot revert <name>    Revert disk image to a snapshot (stops VM if running)
  snapshot delete <name>    Delete a snapshot from the qcow2 disk image

Execution & Testing:
  run <command...>          Execute a command in the VM (via SSH or serial) and stream output
  ssh [command...]          Connect directly to the VM via SSH or run an SSH command
  sync-binaries             Package binaries and fixtures into exchange ISO and hot-swap
  test [options]            Run the FreeBSD & ZFS validation smoke test suite in the VM
                            Options:
                              --release        (default) Use release mode ctoolbox binary
                              --debug          Use debug mode ctoolbox binary
                              --reset          Revert to base-state snapshot first
  test-suite [options]      Compile, package, and execute the full test suite in VM
                            Options:
                              --release        (default) Compile and package tests in release mode
                              --debug          Compile and package tests in debug mode
                              --reset          Revert to base-state snapshot first
                              --crate <name>   Test only a specific package/crate
                              --filter <pat>   Test filter pattern
                              --no-build       Skip build; use existing binaries
                              --timeout <sec>  Timeout waiting for test suite (default: 14400)

Interactive / Inspection:
  screenshot [path]         Capture the VM display buffer to a PNG image (default: /tmp/freebsd-screen.png)
  send-keys <key>...        Send QEMU monitor keys (e.g. "ret", "down", "ctrl-c")
  type <text>               Type arbitrary text into the VM console via simulated key events
  monitor <cmd>             Execute an arbitrary command on the QEMU monitor

Examples:
  ./scripts/freebsd-vm start --net
  ./scripts/freebsd-vm test
  ./scripts/freebsd-vm test-suite --release
  ./scripts/freebsd-vm run zpool status
  ./scripts/freebsd-vm screenshot
  ./scripts/freebsd-vm stop
EOF
}

is_running() {
    vm_is_running "$PID_FILE"
}

cmd_start() {
    if is_running; then
        echo "VM is already running with PID $(cat "$PID_FILE")."
        return 0
    fi

    local snapshot_flag="-snapshot"
    local net_flags=()
    local vnc_args=("-vnc" "unix:$VNC_SOCK")
    local image="$DEFAULT_IMAGE"
    local iso="$EXCHANGE_ISO"
    local mem="4096"
    local smp="4"
    local ssh_port="$DEFAULT_SSH_PORT"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --persist)
                snapshot_flag=""
                ;;
            --net)
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --ssh-port)
                shift
                ssh_port="${1:-$DEFAULT_SSH_PORT}"
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --vnc-port)
                shift
                vnc_args=("-vnc" "127.0.0.1:${1:-2},websocket=off")
                ;;
            --image)
                shift
                image="$1"
                ;;
            --iso)
                shift
                iso="$1"
                ;;
            --mem)
                shift
                mem="$1"
                ;;
            --smp)
                shift
                smp="$1"
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ ! -f "$image" ]]; then
        echo "Error: VM disk image not found at $image" >&2
        return 1
    fi

    if [[ ! -f "$iso" ]]; then
        mkdir -p /tmp/ctb-empty-iso
        genisoimage -J -r -o "$iso" /tmp/ctb-empty-iso >/dev/null 2>&1 || true
        remove_if_exists /tmp/ctb-empty-iso
    fi

    remove_if_exists "$MONITOR_SOCK" "$VNC_SOCK" "$PID_FILE" "$SERIAL_SOCK"

    echo "Starting FreeBSD VM..."
    echo "  Image:    $image"
    echo "  ISO:      $iso"
    echo "  Memory:   ${mem}MB | SMP: $smp"
    echo "  Snapshot: $(if [[ -n "$snapshot_flag" ]]; then echo "Enabled (read-only mode)"; else echo "Disabled (writes persist)"; fi)"
    echo "  Network:  $(if [[ ${#net_flags[@]} -gt 0 ]]; then echo "Isolated loopback port-forward (127.0.0.1:${ssh_port} -> guest:22, restrict=on)"; else echo "Air-gapped (no NIC)"; fi)"

    local qemu_cmd=(
        qemu-system-x86_64
        -nodefaults
        -M pc
        -cpu max
        -m "$mem"
        -smp "$smp,cores=$smp,sockets=1"
        -device ahci,id=ahci0
        -drive "file=$image,if=none,id=drive0,format=qcow2"
        -device ide-hd,bus=ahci0.0,drive=drive0
        -drive "file=$iso,if=none,id=cdrom0,media=cdrom,readonly=on"
        -device ide-cd,bus=ahci0.1,drive=cdrom0
        -chardev "socket,id=serial0,path=$SERIAL_SOCK,server=on,wait=off,logfile=$SERIAL_LOG"
        -serial "chardev:serial0"
        -vga std
        -usb -device usb-tablet
        "${vnc_args[@]}"
        -monitor "unix:$MONITOR_SOCK,server,nowait"
        -pidfile "$PID_FILE"
        -daemonize
    )

    if [[ -n "$snapshot_flag" ]]; then
        qemu_cmd+=("$snapshot_flag")
    fi

    if [[ ${#net_flags[@]} -gt 0 ]]; then
        qemu_cmd+=("${net_flags[@]}")
    fi

    "${qemu_cmd[@]}"
    sleep 1

    if is_running; then
        echo "VM successfully started (PID: $(cat "$PID_FILE"))."
    else
        echo "Failed to start VM. Check logs or permissions." >&2
        return 1
    fi
}

cmd_stop() {
    local force="false"
    if [[ "${1:-}" == "--force" ]]; then
        force="true"
    fi
    vm_cmd_stop "$PID_FILE" "$MONITOR_SOCK" "$VNC_SOCK" "$force" "FreeBSD VM"
}

cmd_status() {
    vm_cmd_status "$PID_FILE" "FreeBSD VM"
}

cmd_monitor() {
    vm_cmd_monitor "$MONITOR_SOCK" "$@"
}

cmd_screenshot() {
    local out_path="${1:-/tmp/freebsd-screen.png}"
    vm_cmd_screenshot "$MONITOR_SOCK" "$out_path"
}

cmd_send_keys() {
    vm_cmd_send_keys "$MONITOR_SOCK" "$@"
}

cmd_type() {
    vm_cmd_type "$MONITOR_SOCK" "$*"
}

cmd_snapshot() {
    local subcmd="${1:-list}"
    shift || true
    local image="$DEFAULT_IMAGE"
    vm_cmd_snapshot "$MONITOR_SOCK" "$PID_FILE" "$image" "$subcmd" "$@"
}

cmd_sync_binaries() {
    local release="true"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                release="true"
                ;;
            --debug)
                release="false"
                ;;
            *)
                ;;
        esac
        shift
    done

    mkdir -p "$EXCHANGE_DIR"

    local build_profile="release"
    if [[ "$release" != "true" ]]; then
        build_profile="debug"
    fi

    local ctb_bin="target/x86_64-unknown-freebsd/$build_profile/ctoolbox"
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-unknown-freebsd/release/ctoolbox"
    fi
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-unknown-freebsd/debug/ctoolbox"
    fi

    if [[ -f "$ctb_bin" ]]; then
        echo "Copying $ctb_bin to exchange image..."
        cp "$ctb_bin" "$EXCHANGE_DIR/ctoolbox"
        chmod +x "$EXCHANGE_DIR/ctoolbox"
    fi

    vm_package_fixtures "$EXCHANGE_DIR" "$REPO_ROOT"

    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 1.5
    fi
    echo "Synchronized binaries to $EXCHANGE_ISO."
}

is_ssh_available() {
    local port="${1:-$DEFAULT_SSH_PORT}"
    ssh -q -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes -o ConnectTimeout=2 -p "$port" root@127.0.0.1 "true" 2>/dev/null
}

wait_for_ssh() {
    local port="${1:-$DEFAULT_SSH_PORT}"
    local max_wait="${2:-45}"
    local elapsed=0
    echo -n "Waiting for FreeBSD SSH on port $port..."
    while [[ $elapsed -lt $max_wait ]]; do
        if is_ssh_available "$port"; then
            echo " ready."
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
        echo -n "."
    done
    echo " timed out waiting for SSH."
    return 1
}

cmd_ssh() {
    if ! is_running; then
        echo "VM is not running. Starting with network..."
        cmd_start --net
        wait_for_ssh "$DEFAULT_SSH_PORT" 45
    elif ! is_ssh_available "$DEFAULT_SSH_PORT"; then
        wait_for_ssh "$DEFAULT_SSH_PORT" 30 || true
    fi

    local ssh_opts=(
        -i "$SSH_KEY"
        -o StrictHostKeyChecking=no
        -o UserKnownHostsFile=/dev/null
        -o BatchMode=yes
        -o LogLevel=ERROR
        -p "$DEFAULT_SSH_PORT"
    )

    if [[ $# -gt 0 ]]; then
        ssh "${ssh_opts[@]}" root@127.0.0.1 "$@"
    else
        ssh "${ssh_opts[@]}" root@127.0.0.1
    fi
}

cmd_run() {
    if ! is_running; then
        echo "VM is not running. Starting VM..."
        cmd_start --net
        wait_for_ssh "$DEFAULT_SSH_PORT" 45
    elif ! is_ssh_available "$DEFAULT_SSH_PORT"; then
        wait_for_ssh "$DEFAULT_SSH_PORT" 30 || true
    fi

    local user_cmd="$*"
    if [[ -z "$user_cmd" ]]; then
        echo "Usage: ./scripts/freebsd-vm run <command...>" >&2
        return 1
    fi

    if is_ssh_available "$DEFAULT_SSH_PORT"; then
        cmd_ssh "$user_cmd"
        return $?
    fi

    # Fallback to serial / console execution when network is disabled
    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    cmd_type "$user_cmd; echo ---CTB_EXIT:\$?---\n"

    python3 -c "
import sys, time

log_path = '$SERIAL_LOG'
start_offset = int(sys.argv[1])
timeout = 180

start_time = time.time()
started = False
exit_code = None

with open(log_path, 'r', errors='replace') as f:
    f.seek(start_offset)
    while True:
        line = f.readline()
        if line:
            clean_line = line.strip()
            if '---CTB_EXIT:' in clean_line:
                part = clean_line.split('---CTB_EXIT:')[1].split('---')[0]
                try:
                    exit_code = int(part)
                except ValueError:
                    exit_code = 1
                break
            sys.stdout.write(line)
            sys.stdout.flush()
        else:
            if time.time() - start_time > timeout:
                sys.stderr.write('Timeout waiting for command to finish in VM.\n')
                sys.exit(124)
            time.sleep(0.2)

sys.exit(exit_code if exit_code is not None else 1)
" "$start_offset"
}

_run_smoke_tests() {
    local release="$1"
    local build_profile="release"
    if [[ "$release" != "true" ]]; then
        build_profile="debug"
    fi

    echo "1. Checking FreeBSD version and kernel..."
    cmd_run "uname -a && freebsd-version -k -u"
    echo ""

    echo "2. Checking ZFS pool status..."
    cmd_run "zpool status zroot"
    echo ""

    echo "3. Checking ZFS datasets and compression..."
    cmd_run "zfs list -o name,used,avail,refer,mountpoint,compression"
    echo ""

    echo "4. Validating ZFS filesystem operations (create, compress, write, snapshot, rollback, destroy)..."
    cmd_run '
        set -e
        TEST_DS="zroot/test-zfs-validation"
        echo "Creating dataset: $TEST_DS with lz4 compression..."
        zfs create -o compression=lz4 "$TEST_DS"
        
        echo "Writing test file with repetitive data to test compression..."
        jot -b "CollectiveToolbox ZFS Validation Test Payload Line" 20000 > "/$TEST_DS/payload.txt"
        ls -lh "/$TEST_DS/payload.txt"
        
        echo "Verifying ZFS compression ratio..."
        zfs get used,logicalused,compressratio "$TEST_DS"
        
        echo "Testing ZFS snapshot..."
        zfs snapshot "${TEST_DS}@test-snap"
        zfs list -t snapshot -r "$TEST_DS"
        
        echo "Modifying file and rolling back..."
        echo "corrupted data" >> "/$TEST_DS/payload.txt"
        zfs rollback "${TEST_DS}@test-snap"
        
        echo "Destroying test dataset..."
        zfs destroy -r "$TEST_DS"
        echo "ZFS validation succeeded!"
    '
    echo ""

    local ctb_bin="target/x86_64-unknown-freebsd/$build_profile/ctoolbox"
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-unknown-freebsd/release/ctoolbox"
    fi
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-unknown-freebsd/debug/ctoolbox"
    fi
    if [[ -f "$ctb_bin" ]]; then
        echo "5. Verifying ctoolbox binary execution in FreeBSD VM (from $ctb_bin)..."
        scp -q -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
            -P "$DEFAULT_SSH_PORT" "$ctb_bin" root@127.0.0.1:/tmp/ctoolbox-test
        cmd_run 'chmod +x /tmp/ctoolbox-test && /tmp/ctoolbox-test --version && /tmp/ctoolbox-test hex2dec ff && rm /tmp/ctoolbox-test'
        echo ""
    else
        echo "Warning: No ctoolbox binary found at target/x86_64-unknown-freebsd/$build_profile/ctoolbox."
    fi

    echo "=== FreeBSD & ZFS VM Tests Completed Successfully ==="
}

cmd_test() {
    local reset="false"
    local release="true"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                release="true"
                ;;
            --debug)
                release="false"
                ;;
            --reset)
                reset="true"
                ;;
            *)
                ;;
        esac
        shift
    done

    local log_dir="$REPO_ROOT/ci-logs/FreeBSD"
    mkdir -p "$log_dir"
    local log_ts
    log_ts="$(date +%Y%m%d-%H%M%S)"
    local test_log="$log_dir/FreeBSD-${log_ts}.log"

    echo "=== Running FreeBSD & ZFS Smoke Tests in VM ==="
    echo "Streaming VM test output to $test_log..."

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    if ! is_running; then
        cmd_start --net
        wait_for_ssh "$DEFAULT_SSH_PORT" 45
    fi

    local test_exit=0
    _run_smoke_tests "$release" 2>&1 | tee -a "$test_log" || test_exit=$?

    if [[ "$test_exit" -ne 0 ]]; then
        vm_capture_failure_artifacts "$MONITOR_SOCK" "$SERIAL_LOG" "$log_dir" "FreeBSD"
    fi

    return "$test_exit"
}

cmd_test_suite() {
    local reset="false"
    local release="true"
    local crate_filter=""
    local test_filter=""
    local no_build="false"
    local timeout="14400"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                release="true"
                ;;
            --debug)
                release="false"
                ;;
            --reset)
                reset="true"
                ;;
            --crate)
                shift
                crate_filter="${1:-}"
                ;;
            --filter)
                shift
                test_filter="${1:-}"
                ;;
            --no-build)
                no_build="true"
                ;;
            --timeout)
                shift
                timeout="${1:-14400}"
                ;;
            *)
                echo "Unknown option for test-suite: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    trap 'if is_running; then cmd_stop; fi' EXIT INT TERM

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    if ! is_running; then
        cmd_start --net
        wait_for_ssh "$DEFAULT_SSH_PORT" 45
    fi

    local target="x86_64-unknown-freebsd"
    local build_profile="debug"
    if [[ "$release" == "true" ]]; then
        build_profile="release"
    fi

    if [[ "$no_build" != "true" ]]; then
        if [[ ! -f "built/freebsd-sysroot/usr/lib/crt1.o" && ! -f "vendor/freebsd-sysroot/usr/lib/crt1.o" ]]; then
            echo "=== Compiling FreeBSD sysroot using Python interpreter ==="
            ./scripts/compile-freebsd-sysroot || exit 1
        fi

        echo "=== Compiling Test Binaries for $target (profile: $build_profile) ==="
        local cargo_args=(test --no-run --target "$target" --jobs 4)
        if [[ "$release" == "true" ]]; then
            cargo_args+=(--release)
        fi
        if [[ -n "$crate_filter" ]]; then
            cargo_args+=(-p "$crate_filter")
        else
            cargo_args+=(--workspace --exclude ctb-nopersonality --exclude yaxi --exclude ctb-workspace-x11-client --exclude ctb-workspace-x11-client-egui)
        fi
        cargo "${cargo_args[@]}"
    fi

    echo "=== Packaging Tests and Fixtures for FreeBSD VM Exchange ==="
    remove_if_exists "$EXCHANGE_DIR"
    mkdir -p "$EXCHANGE_DIR/tests"

    local binary_count=0
    binary_count=$(python3 -c "
import glob, os, re, shutil, subprocess, sys

target = '$target'
build_profile = '$build_profile'
crate_filter = '$crate_filter'
crate_prefix = crate_filter.replace('-', '_') if crate_filter else None
exchange_dir = '$EXCHANGE_DIR/tests'

fingerprints = glob.glob(f'target/{target}/{build_profile}/.fingerprint/*')
test_hashes = set()
for fp in fingerprints:
    m = re.search(r'-([0-9a-f]{16})$', fp)
    if not m:
        continue
    h = m.group(1)
    for fname in os.listdir(fp):
        if fname.startswith('test-') and not fname.endswith('.json'):
            test_hashes.add(h)
            break

import concurrent.futures

all_exes = [
    exe for exe in glob.glob(f'target/{target}/{build_profile}/deps/*')
    if not exe.endswith('.d') and not exe.endswith('.rlib') and not exe.endswith('.rmeta') and not exe.endswith('.so') and os.path.isfile(exe)
]

valid_exes = {}
for exe in sorted(all_exes):
    bname = os.path.basename(exe)
    if crate_prefix and not bname.startswith(f'{crate_prefix}-'):
        continue
    m = re.search(r'^(.*)-([0-9a-f]{16})$', bname)
    if not m or m.group(2) not in test_hashes:
        continue
    base = m.group(1)
    mtime = os.path.getmtime(exe)
    if base not in valid_exes or mtime > valid_exes[base][1]:
        valid_exes[base] = (exe, mtime)

def process_exe(item):
    base, (exe, _) = item
    bname = os.path.basename(exe)
    dest = os.path.join(exchange_dir, bname)
    shutil.copyfile(exe, dest)
    shutil.copymode(exe, dest)
    subprocess.run(['strip', dest], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
    count = sum(1 for ok in executor.map(process_exe, sorted(valid_exes.items())) if ok)

print(count)
")

    if [[ "$binary_count" -eq 0 ]]; then
        echo "No test binaries found in target/$target/$build_profile/deps/!" >&2
        return 1
    fi

    vm_package_fixtures "$EXCHANGE_DIR" "$REPO_ROOT"

    echo "Generating in-VM test runner script..."
    local filter_arg=""
    if [[ -n "$test_filter" ]]; then
        filter_arg="$test_filter "
    fi

    cat <<EOF > "$EXCHANGE_DIR/run_suite.sh"
#!/bin/sh
set -u
TEST_ROOT="\$(dirname "\$0")"
[ -d "\$TEST_ROOT/tests" ] || TEST_ROOT="/mnt"
cd "\$TEST_ROOT"
export CTB_HOST_WORKSPACE_ROOT="\$TEST_ROOT"
export RUST_BACKTRACE=1
echo "---SUITE_START---"
TOTAL=0
PASSED=0
FAILED=0
for f in "\$TEST_ROOT"/tests/*; do
    [ -f "\$f" ] && [ -x "\$f" ] || continue
    bname="\$(basename "\$f")"
    TOTAL=\$((TOTAL + 1))
    echo "=== RUN \$bname ==="
    if "\$f" ${filter_arg}--nocapture; then
        PASSED=\$((PASSED + 1))
        echo "=== PASS \$bname ==="
    else
        code=\$?
        FAILED=\$((FAILED + 1))
        echo "=== FAIL \$bname [EXIT:\$code] ==="
    fi
    echo ""
done
echo "---SUITE_END:TOTAL=\$TOTAL,PASSED=\$PASSED,FAILED=\$FAILED---"
EOF
    chmod +x "$EXCHANGE_DIR/run_suite.sh"

    echo "Creating exchange ISO with $binary_count test binaries and fixtures..."
    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 2.0
    fi

    local log_dir="$REPO_ROOT/ci-logs/FreeBSD"
    mkdir -p "$log_dir"
    local log_ts
    log_ts="$(date +%Y%m%d-%H%M%S)"
    local suite_log="$log_dir/FreeBSD-${log_ts}.log"

    echo "=== Executing Test Suite in FreeBSD VM ==="
    echo "Streaming VM test output to $suite_log..."
    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    if is_ssh_available "$DEFAULT_SSH_PORT"; then
        cmd_ssh "mount -t cd9660 /dev/cd0 /mnt 2>/dev/null || true; /mnt/run_suite.sh" >> "$SERIAL_LOG" 2>&1 &
    else
        cmd_type "mount -t cd9660 /dev/cd0 /mnt 2>/dev/null || true; /mnt/run_suite.sh\n"
    fi

    local py_exit=0
    vm_stream_suite_output "$SERIAL_LOG" "$start_offset" "$timeout" "$suite_log" "FreeBSD" || py_exit=$?

    trap - EXIT INT TERM
    if is_running; then
        if [[ "${py_exit:-0}" -ne 0 ]]; then
            vm_capture_failure_artifacts "$MONITOR_SOCK" "$SERIAL_LOG" "$log_dir" "FreeBSD"
        fi
        echo "Stopping FreeBSD VM..."
        cmd_stop
    fi
    return ${py_exit:-0}
}

action="${1:-}"
shift || true

case "$action" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    status)
        cmd_status
        ;;
    screenshot)
        cmd_screenshot "$@"
        ;;
    send-keys)
        cmd_send_keys "$@"
        ;;
    type)
        cmd_type "$@"
        ;;
    monitor)
        cmd_monitor "$@"
        ;;
    snapshot)
        cmd_snapshot "$@"
        ;;
    sync-binaries)
        cmd_sync_binaries "$@"
        ;;
    ssh)
        cmd_ssh "$@"
        ;;
    run)
        cmd_run "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    test-suite)
        cmd_test_suite "$@"
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 1
        ;;
esac
