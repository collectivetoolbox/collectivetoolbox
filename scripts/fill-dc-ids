#!/usr/bin/env python3
"""
One-off script to populate Column A ('Dc') with the new global graph Dc ID
calculated from the short Dc ID in Column B ('Short'):
    Dc ID = Short ID + 1114112 (0x110000)

Operates on all CSV files in src/formats/dctext/data/categories/*.csv.
"""

import argparse
import csv
import os
import sys
import tempfile
from pathlib import Path
from typing import List, Optional, Tuple

DC_OFFSET = 1114112  # 0x110000


def find_repo_root(start_path: Path) -> Path:
    """Find repository root by looking for .git or src/formats directory."""
    curr = start_path.resolve()
    for parent in [curr] + list(curr.parents):
        if (parent / ".git").exists() or (parent / "src" / "formats").exists():
            return parent
    return start_path.resolve()


def process_file(path: Path, dry_run: bool = False, backup: bool = False) -> Tuple[int, int]:
    """
    Update Column A with Column B + 1114112 for all data rows.
    Returns (total_rows, updated_rows).
    """
    with open(path, "r", encoding="utf-8", newline="") as f:
        reader = csv.reader(f)
        try:
            header = next(reader)
        except StopIteration:
            return 0, 0
        rows = [row for row in reader if any(field.strip() for field in row) or row]

    # Verify column layout (Column A should be 'Dc', Column B should be 'Short')
    col_a_idx = 0
    col_b_idx = 1

    updated_rows = 0
    new_rows = []

    for row in rows:
        r = list(row)
        # Ensure row has at least 2 columns
        while len(r) < 2:
            r.append("")

        short_str = r[col_b_idx].strip()
        if short_str.isdigit():
            short_id = int(short_str)
            new_dc_id = str(short_id + DC_OFFSET)
            if r[col_a_idx] != new_dc_id:
                r[col_a_idx] = new_dc_id
                updated_rows += 1
        new_rows.append(r)

    if not dry_run and updated_rows > 0:
        if backup:
            bak_path = path.with_suffix(path.suffix + ".bak")
            with open(bak_path, "w", encoding="utf-8", newline="") as f_bak:
                writer = csv.writer(f_bak, lineterminator="\n")
                writer.writerow(header)
                writer.writerows(rows)

        with tempfile.NamedTemporaryFile("w", encoding="utf-8", newline="", dir=path.parent, delete=False) as tmp:
            writer = csv.writer(tmp, lineterminator="\n")
            writer.writerow(header)
            writer.writerows(new_rows)
            tmp_path = Path(tmp.name)
        tmp_path.replace(path)

    return len(rows), updated_rows


def main():
    parser = argparse.ArgumentParser(
        description="Fill column A ('Dc') with new global graph Dc ID (Short ID + 1114112)."
    )
    parser.add_argument(
        "--root",
        type=Path,
        help="Repository root directory (auto-detected if omitted).",
    )
    parser.add_argument(
        "--files",
        nargs="+",
        type=Path,
        help="Explicit list of CSV files to process (defaults to src/formats/dctext/data/categories/*.csv).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Preview changes without modifying files on disk.",
    )
    parser.add_argument(
        "--backup",
        action="store_true",
        help="Create .bak backup files before modifying.",
    )

    args = parser.parse_args()

    script_dir = Path(__file__).resolve().parent
    repo_root = args.root if args.root else find_repo_root(script_dir)

    if args.files:
        files = [f.resolve() for f in args.files if f.is_file() and f.suffix == ".csv"]
    else:
        categories_dir = repo_root / "src" / "formats" / "dctext" / "data" / "categories"
        if not categories_dir.exists():
            print(f"Error: Categories directory not found at {categories_dir}", file=sys.stderr)
            sys.exit(1)
        files = sorted(categories_dir.glob("*.csv"))

    if not files:
        print("No CSV files found to process.")
        sys.exit(1)

    print(f"Processing {len(files)} CSV files (Offset: +{DC_OFFSET}):")
    if args.dry_run:
        print("Mode: DRY RUN (no files will be modified)\n")

    total_all_rows = 0
    total_all_updated = 0

    for path in files:
        rel_path = path.relative_to(repo_root) if path.is_relative_to(repo_root) else path
        total_rows, updated_rows = process_file(path, dry_run=args.dry_run, backup=args.backup)
        total_all_rows += total_rows
        total_all_updated += updated_rows

        status = "WILL UPDATE" if (args.dry_run and updated_rows > 0) else ("UPDATED" if updated_rows > 0 else "UP TO DATE")
        print(f"  [{status:11}] {str(rel_path):<55} ({updated_rows}/{total_rows} rows)")

    print(f"\nSummary:")
    print(f"  Total files: {len(files)}")
    print(f"  Total rows: {total_all_rows}")
    print(f"  Rows {'needing update' if args.dry_run else 'updated'}: {total_all_updated}")


if __name__ == "__main__":
    main()
