FROM mcr.microsoft.com/devcontainers/base:debian

ENV HOME=/root
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV GUIX_LOCPATH=/var/guix/profiles/per-user/root/current-profile/lib/locale:/root/.guix-profile/lib/locale
ENV PATH=/root/.cargo/bin:/root/.config/guix/current/bin:/var/guix/profiles/per-user/root/current-profile/bin:${PATH}
ENV PLAYWRIGHT_CHROMIUM_ARGS="--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu"
ENV CHROMIUM_FLAGS="--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu"
ENV BASH_ENV="/etc/profile.d/umask.sh"
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse
ENV GUILE_AUTO_COMPILE=0
ENV GUILE_WARN_DEPRECATED=no
ENV container=docker

RUN set -eux; \
    dpkg --add-architecture i386; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        acl \
        binutils \
        brotli \
        build-essential \
        ca-certificates \
        clang \
        coreutils \
        curl \
        file \
        git \
        locales \
        mingw-w64 \
        musl-tools \
        nodejs \
        npm \
        patch \
        perl \
        pkg-config \
        proot \
        tar \
        wine \
        wine32:i386 \
        wine64 \
        xz-utils \
        xxd; \
    locale-gen en_US.UTF-8; \
    npm install -g typescript playwright; \
    npx playwright install-deps chromium; \
    npx playwright install chromium; \
    apt-get clean

# Ensure system-wide umask is 0000 so files created inside container are readable/writable by host users
RUN set -eux; \
    echo "umask 0000" >> /etc/bash.bashrc; \
    echo "umask 0000" >> /etc/profile; \
    echo "umask 0000" > /etc/profile.d/umask.sh; \
    chmod +x /etc/profile.d/umask.sh; \
    chmod 755 /root; \
    sed -i 's/UMASK\s*022/UMASK 0000/' /etc/login.defs

RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.92; \
    rustup default 1.92; \
    rustup target add x86_64-unknown-linux-musl; \
    rustup target add i586-unknown-linux-musl; \
    rustup target add i586-unknown-linux-gnu; \
    rustup target add wasm32-unknown-unknown; \
    rustup target add x86_64-pc-windows-gnu; \
    cargo install --locked cargo-deny

ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_DIR=/etc/ssl/certs

# Copy pre-extracted Guix keys and installation script
COPY scripts/docker/keys /tmp/guix-keys
COPY scripts/docker/install-guix.sh /tmp/install-guix.sh

RUN set -eux; \
    /tmp/install-guix.sh /tmp/guix-keys; \
    if [ -f /tmp/install-guix.sh ]; then \
        rm /tmp/install-guix.sh; \
    fi

# Copy pre-built Guix v86 rootfs chunks and fs index generated by full Dockerfile.
# Chunks are split into 4 layers ([0-3]*, [4-7]*, [8-9a-b]*, [c-f]*) so each layer
# is between 2GB and 4GB, safely below GHCR's 10GB per-layer upload limit.
RUN set -eux; \
    mkdir -p /var/cache/ctoolbox/v86_images/guix/guix-rootfs-flat; \
    mkdir -p /workspaces/ctoolbox/vendor; \
    ln -s /var/cache/ctoolbox/v86_images /workspaces/ctoolbox/vendor/v86_images

COPY vendor/v86_images/guix/guix-fs.json /var/cache/ctoolbox/v86_images/guix/guix-fs.json
COPY vendor/v86_images/guix/guix_posix_initrd.cpio.gz /var/cache/ctoolbox/v86_images/guix/guix_posix_initrd.cpio.gz
COPY vendor/v86_images/guix/guix_posix_initrd.cpio.gz /var/cache/ctoolbox/guix_posix_initrd.cpio.gz
COPY vendor/v86_images/guix/guix-rootfs-flat/[0-3]* /var/cache/ctoolbox/v86_images/guix/guix-rootfs-flat/
COPY vendor/v86_images/guix/guix-rootfs-flat/[4-7]* /var/cache/ctoolbox/v86_images/guix/guix-rootfs-flat/
COPY vendor/v86_images/guix/guix-rootfs-flat/[8-9a-b]* /var/cache/ctoolbox/v86_images/guix/guix-rootfs-flat/
COPY vendor/v86_images/guix/guix-rootfs-flat/[c-f]* /var/cache/ctoolbox/v86_images/guix/guix-rootfs-flat/

RUN set -eux; \
    dpkg --add-architecture i386; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        tmux \
        ncdu \
        ripgrep \
        # autoconf \
        # automake \
        # bison \
        build-essential \
        gcc-i686-linux-gnu \
        # libexpat1-dev \
        # libexpat1-dev:i386 \
        # libffi-dev \
        # libffi-dev:i386 \
        # libssl-dev \
        # libssl-dev:i386 \
        # libwayland-dev \
        # libwayland-dev:i386 \
        mingw-w64 \
        musl-dev:i386; \
    apt-get clean

# Copy pre-built TypeScript compiler tarball to container cache (avoids 15GB layer and full Rust rebuild)
COPY vendor/TypeScript-built.tar /var/cache/ctoolbox/TypeScript-built.tar

# Install virtual framebuffer, X server, window manager, and GUI capture/interaction tools
COPY scripts/docker/install-gui-tools.sh /tmp/install-gui-tools.sh
RUN set -eux; \
    chmod +x /tmp/install-gui-tools.sh; \
    /tmp/install-gui-tools.sh; \
    if [ -f /tmp/install-gui-tools.sh ]; then \
        rm /tmp/install-gui-tools.sh; \
    fi

ENV DISPLAY=:99

WORKDIR /workspaces/ctoolbox

LABEL org.opencontainers.image.source="https://github.com/collectivetoolbox/collectivetoolbox"
LABEL org.opencontainers.image.description="Collective Toolbox CI and development image"
