# Helper script to manage, snapshot, and run tests/commands in the Linux VM in QEMU.
set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(pwd)"

source "$SCRIPT_DIR/vm-common.sh"

DEFAULT_IMAGE="$REPO_ROOT/ci-logs/VMs/Linux/linux.qcow2"
SSH_KEY="$REPO_ROOT/ci-logs/VMs/Linux/id_ed25519"
SOCKET_DIR="/tmp/ctb-linux-vm"
MONITOR_SOCK="$SOCKET_DIR/monitor.sock"
VNC_SOCK="$SOCKET_DIR/vnc.sock"
PID_FILE="$SOCKET_DIR/qemu.pid"
SERIAL_LOG="$SOCKET_DIR/serial.log"
SERIAL_SOCK="$SOCKET_DIR/serial.sock"
DEFAULT_SSH_PORT="2224"
DEFAULT_WEB_PORT="8080"

mkdir -p "$SOCKET_DIR"

usage() {
    cat <<EOF
Usage: ./scripts/linux-vm <command> [options]

VM Lifecycle:
  start          Start the Linux VM in the background (QEMU)
                 Options:
                   --persist        Write changes directly to the qcow2 image
                                    (default: runs with -snapshot to protect image)
                   --net            Attach an isolated local loopback NIC (restrict=on;
                                    forwards localhost:2224 -> guest:22,
                                             localhost:8080 -> guest:8080)
                   --ssh-port PORT  Custom forwarded SSH port (default: 2224)
                   --web-port PORT  Custom forwarded Web UI port (default: 8080)
                   --vnc-port P     Listen on TCP port P for VNC (e.g. 5903)
                   --image PATH     Use a custom qcow2 image (default: ci-logs/VMs/Linux/linux.qcow2)
                   --mem MB         Memory in MB (default: 2048)
                   --smp CORES      CPU cores (default: 2)

  stop           Stop the running VM (graceful ACPI shutdown, or --force)
  status         Check if the VM is running and display resource usage

Snapshot Management:
  snapshot list             List snapshots present in the qcow2 disk image
  snapshot create <name>    Create a snapshot (live if running, offline if stopped)
  snapshot revert <name>    Revert disk image to a snapshot (stops VM if running)
  snapshot delete <name>    Delete a snapshot from the qcow2 disk image

Execution & Deploy Testing:
  ssh [options] [command]   Connect directly to the VM via SSH or run a remote command
                            Options:
                              --user <name>   User to SSH as (root, ctb-deployer, ctb-server, ctb-sudoer; default: ctb-deployer)
  run <command...>          Execute a command in the VM (via SSH or serial console)
  test-deploy [options]     Test the deployment pipeline against this VM in a safe sandbox
                            Options:
                              --no-build       Skip build; reuse existing built binaries
                              --reuse-built    Reuse current binaries if matching HEAD, build otherwise
                              --mock-artifacts Use lightweight test tarballs for rapid validation
                              --reset          Revert to 'base-state' snapshot before running

Interactive / Inspection:
  screenshot [path]         Capture the VM display buffer to a PNG image (default: /tmp/linux-screen.png)
  send-keys <key>...        Send QEMU monitor keys (e.g. "ret", "down", "ctrl-c")
  type <text>               Type arbitrary text into the VM console
  monitor <cmd>             Execute an arbitrary command on the QEMU monitor

Examples:
  ./scripts/linux-vm start --net
  ./scripts/linux-vm ssh uptime
  ./scripts/linux-vm test-deploy --reuse-built
  ./scripts/linux-vm snapshot list
  ./scripts/linux-vm stop
EOF
}

is_running() {
    vm_is_running "$PID_FILE"
}

cmd_start() {
    if is_running; then
        echo "Linux VM is already running with PID $(cat "$PID_FILE")."
        return 0
    fi

    local snapshot_flag="-snapshot"
    local net_flags=()
    local vnc_args=("-vnc" "unix:$VNC_SOCK")
    local image="$DEFAULT_IMAGE"
    local mem="2048"
    local smp="2"
    local ssh_port="$DEFAULT_SSH_PORT"
    local web_port="$DEFAULT_WEB_PORT"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --persist)
                snapshot_flag=""
                ;;
            --net)
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22,hostfwd=tcp:127.0.0.1:${web_port}-:8080"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --ssh-port)
                shift
                ssh_port="${1:-$DEFAULT_SSH_PORT}"
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22,hostfwd=tcp:127.0.0.1:${web_port}-:8080"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --web-port)
                shift
                web_port="${1:-$DEFAULT_WEB_PORT}"
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22,hostfwd=tcp:127.0.0.1:${web_port}-:8080"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --vnc-port)
                shift
                vnc_args=("-vnc" "127.0.0.1:${1:-3},websocket=off")
                ;;
            --image)
                shift
                image="$1"
                ;;
            --mem)
                shift
                mem="$1"
                ;;
            --smp)
                shift
                smp="$1"
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ ! -f "$image" ]]; then
        echo "Error: VM disk image not found at $image" >&2
        echo "Run ./scripts/setup-linux-vm-image to provision the Debian 13 VM." >&2
        return 1
    fi

    remove_if_exists "$MONITOR_SOCK" "$VNC_SOCK" "$PID_FILE" "$SERIAL_SOCK"

    echo "Starting Linux VM..."
    echo "  Image:    $image"
    echo "  Memory:   ${mem}MB | SMP: $smp"
    echo "  Snapshot: $(if [[ -n "$snapshot_flag" ]]; then echo "Enabled (read-only mode, safe rollback)"; else echo "Disabled (writes persist)"; fi)"
    echo "  Network:  $(if [[ ${#net_flags[@]} -gt 0 ]]; then echo "Port-forward (SSH 127.0.0.1:${ssh_port}, Web 127.0.0.1:${web_port})"; else echo "Air-gapped"; fi)"

    local qemu_cmd=(
        qemu-system-x86_64
        -nodefaults
        -M pc
        -cpu max
        -m "$mem"
        -smp "$smp,cores=$smp,sockets=1"
        -device ahci,id=ahci0
        -drive "file=$image,if=none,id=drive0,format=qcow2"
        -device ide-hd,bus=ahci0.0,drive=drive0
        -chardev "socket,id=serial0,path=$SERIAL_SOCK,server=on,wait=off,logfile=$SERIAL_LOG"
        -serial "chardev:serial0"
        -vga std
        -usb -device usb-tablet
        "${vnc_args[@]}"
        -monitor "unix:$MONITOR_SOCK,server,nowait"
        -pidfile "$PID_FILE"
        -daemonize
    )

    if [[ -n "$snapshot_flag" ]]; then
        qemu_cmd+=("$snapshot_flag")
    fi

    if [[ ${#net_flags[@]} -gt 0 ]]; then
        qemu_cmd+=("${net_flags[@]}")
    fi

    "${qemu_cmd[@]}"
    sleep 1

    if is_running; then
        echo "Linux VM successfully started (PID: $(cat "$PID_FILE"))."
    else
        echo "Failed to start Linux VM. Check logs or permissions." >&2
        return 1
    fi
}

cmd_stop() {
    local force="false"
    if [[ "${1:-}" == "--force" ]]; then
        force="true"
    fi
    vm_cmd_stop "$PID_FILE" "$MONITOR_SOCK" "$VNC_SOCK" "$force" "Linux VM"
}

cmd_status() {
    vm_cmd_status "$PID_FILE" "Linux VM"
}

cmd_monitor() {
    vm_cmd_monitor "$MONITOR_SOCK" "$@"
}

cmd_screenshot() {
    local out_path="${1:-/tmp/linux-screen.png}"
    vm_cmd_screenshot "$MONITOR_SOCK" "$out_path"
}

cmd_send_keys() {
    vm_cmd_send_keys "$MONITOR_SOCK" "$@"
}

cmd_type() {
    vm_cmd_type "$MONITOR_SOCK" "$*"
}

cmd_snapshot() {
    local subcmd="${1:-list}"
    shift || true
    local image="$DEFAULT_IMAGE"
    vm_cmd_snapshot "$MONITOR_SOCK" "$PID_FILE" "$image" "$subcmd" "$@"
}

is_ssh_available() {
    local port="${1:-$DEFAULT_SSH_PORT}"
    local user="${2:-ctb-deployer}"
    ssh -q -i "$SSH_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o BatchMode=yes -o ConnectTimeout=2 -p "$port" "${user}@127.0.0.1" "true" 2>/dev/null
}

wait_for_ssh() {
    local port="${1:-$DEFAULT_SSH_PORT}"
    local user="${2:-ctb-deployer}"
    local max_wait="${3:-45}"
    local elapsed=0
    echo -n "Waiting for Linux SSH on port $port ($user)..."
    while [[ $elapsed -lt $max_wait ]]; do
        if is_ssh_available "$port" "$user"; then
            echo " ready."
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
        echo -n "."
    done
    echo " timed out waiting for SSH."
    return 1
}

cmd_ssh() {
    local ssh_user="ctb-deployer"
    local ssh_port="$DEFAULT_SSH_PORT"
    local remaining_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user)
                shift
                ssh_user="${1:-ctb-deployer}"
                ;;
            --port)
                shift
                ssh_port="${1:-$DEFAULT_SSH_PORT}"
                ;;
            *)
                remaining_args+=("$1")
                ;;
        esac
        shift
    done

    if ! is_running; then
        echo "VM is not running. Starting with network..."
        cmd_start --net --ssh-port "$ssh_port"
        wait_for_ssh "$ssh_port" "$ssh_user" 45
    elif ! is_ssh_available "$ssh_port" "$ssh_user"; then
        wait_for_ssh "$ssh_port" "$ssh_user" 30 || true
    fi

    local ssh_opts=(
        -i "$SSH_KEY"
        -o StrictHostKeyChecking=no
        -o UserKnownHostsFile=/dev/null
        -o BatchMode=yes
        -o LogLevel=ERROR
        -p "$ssh_port"
    )

    if [[ "${#remaining_args[@]}" -gt 0 ]]; then
        ssh "${ssh_opts[@]}" "${ssh_user}@127.0.0.1" "${remaining_args[@]}"
    else
        ssh "${ssh_opts[@]}" "${ssh_user}@127.0.0.1"
    fi
}

cmd_run() {
    local user_cmd="$*"
    if [[ -z "$user_cmd" ]]; then
        echo "Usage: ./scripts/linux-vm run <command...>" >&2
        return 1
    fi
    cmd_ssh "$user_cmd"
}

cmd_test_deploy() {
    local deploy_args=()
    local reset_snapshot=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reset)
                reset_snapshot=1
                ;;
            *)
                deploy_args+=("$1")
                ;;
        esac
        shift
    done

    echo "=================================================="
    echo "      LINUX VM DEPLOY INTEGRATION TEST"
    echo "=================================================="

    if [[ "$reset_snapshot" -eq 1 ]]; then
        echo "Resetting VM to 'base-state' snapshot..."
        cmd_snapshot revert base-state || echo "Warning: Could not revert to base-state snapshot"
    fi

    if ! is_running; then
        echo "Starting Linux VM in isolated snapshot mode..."
        cmd_start --net
    fi

    echo "Verifying SSH connectivity to all test user accounts..."
    wait_for_ssh "$DEFAULT_SSH_PORT" "ctb-deployer" 60 || {
        echo "Error: Could not reach ctb-deployer via SSH." >&2
        return 1
    }
    wait_for_ssh "$DEFAULT_SSH_PORT" "ctb-sudoer" 30 || {
        echo "Error: Could not reach ctb-sudoer via SSH." >&2
        return 1
    }
    wait_for_ssh "$DEFAULT_SSH_PORT" "ctb-server" 30 || {
        echo "Error: Could not reach ctb-server via SSH." >&2
        return 1
    }

    echo "Running deploy pipeline targeting VM..."
    local deploy_cmd=(
        ./deploy
        --target vm
        "${deploy_args[@]}"
    )

    echo "Command: ${deploy_cmd[*]}"
    if ! "${deploy_cmd[@]}"; then
        echo "[DEPLOY TEST FAILED] Deploy script exited with an error." >&2
        echo "--- Remote journalctl error logs (last 50 lines) ---" >&2
        cmd_ssh --user ctb-server "journalctl --user -u ctoolbox -n 50 --no-pager" 2>/dev/null || true
        return 1
    fi

    echo "Validating deployed service health..."
    local status_url="http://127.0.0.1:${DEFAULT_WEB_PORT}/api/update-status"
    echo "Testing update status on $status_url..."
    local resp
    resp="$(curl -s -k "$status_url" 2>/dev/null || true)"
    if [[ -z "$resp" ]]; then
        echo "[DEPLOY TEST FAILED] Server did not respond on $status_url" >&2
        return 1
    fi

    echo "Response: $resp"
    echo "Checking permissions on remote /home/ctb-server/deploy..."
    cmd_ssh --user ctb-sudoer "ls -la /home/ctb-server/deploy"

    echo "=================================================="
    echo "   DEPLOY TEST SUCCEEDED AGAINST LINUX VM!"
    echo "=================================================="
    return 0
}

# Subcommand dispatch
cmd="${1:-}"
if [[ -z "$cmd" ]]; then
    usage
    exit 0
fi
shift

case "$cmd" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    status)
        cmd_status
        ;;
    snapshot)
        cmd_snapshot "$@"
        ;;
    ssh)
        cmd_ssh "$@"
        ;;
    run)
        cmd_run "$@"
        ;;
    screenshot)
        cmd_screenshot "$@"
        ;;
    send-keys)
        cmd_send_keys "$@"
        ;;
    type)
        cmd_type "$@"
        ;;
    monitor)
        cmd_monitor "$@"
        ;;
    test-deploy)
        cmd_test_deploy "$@"
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
