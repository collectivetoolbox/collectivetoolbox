set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

export DEBIAN_FRONTEND=noninteractive

# ==============================================================================
# Build Dependencies (Compilers, linkers, headers, and build tools)
# ==============================================================================
# NOTE: mingw-w64 is required for *building* x86_64-pc-windows-gnu (provides
# the x86_64-w64-mingw32-gcc cross-compiler and linker for Windows targets).
BUILD_DEPS=(
    binutils
    build-essential
    ca-certificates
    clang
    curl
    file
    gcc
    gcc-i686-linux-gnu
    git
    make
    mingw-w64
    musl-dev:i386
    musl-tools
    patch
    pkg-config
)

# ==============================================================================
# Test-Only Dependencies (Emulation/execution runners for foreign binaries)
# ==============================================================================
# NOTE: Wine is NOT required for building Windows binaries; it is only used
# as a test runner to execute Windows test executables under Linux.
TEST_DEPS=(
    wine
    wine32:i386
    wine64
)

install_test_deps=true
for arg in "$@"; do
    case "$arg" in
        --no-test-deps|--build-only)
            install_test_deps=false
            ;;
    esac
done

dpkg --add-architecture i386 || true
apt-get update

echo "Installing build dependencies..."
apt-get install -y --no-install-recommends "${BUILD_DEPS[@]}"

if [[ "$install_test_deps" == "true" ]]; then
    echo "Installing test runner dependencies (Wine)..."
    apt-get install -y --no-install-recommends "${TEST_DEPS[@]}"
fi

apt-get clean
