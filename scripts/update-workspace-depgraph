set -euo pipefail

# Change directory to the repository root
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

offline=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --offline)
            offline="--offline"
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
    shift
done

echo "Updating workspace dependency diagram..."
if python3 -c "" >/dev/null 2>&1; then
    python3 scripts/workspace-depgraph.py -o docs/workspace-dependencies.generated.svg
elif command -v ctb >/dev/null 2>&1; then
    ctb python scripts/workspace-depgraph.py -o docs/workspace-dependencies.generated.svg
else
    target_flag=""
    if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]]; then
        target_flag="--target=x86_64-unknown-linux-musl"
    elif [[ "$(uname -s)" == "Linux" && "$(uname -m)" =~ i[3-6]86 ]]; then
        target_flag="--target=i586-unknown-linux-musl"
    fi
    cargo run ${offline} ${target_flag} --quiet -p ctb-formats-python --bin ctb-python -- scripts/workspace-depgraph.py -o docs/workspace-dependencies.generated.svg
fi
