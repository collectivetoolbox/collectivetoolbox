set -euo pipefail
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

REPO_ROOT="$(git rev-parse --show-toplevel)"

while IFS= read -r rel_path; do
    if [ -z "${rel_path}" ]; then
        continue
    fi
    work_file="${REPO_ROOT}/${rel_path}"
    if [ ! -f "${work_file}" ]; then
        echo "FATAL [pre-commit]: Append-only graph chunk '${rel_path}' from HEAD is missing in the working tree!" >&2
        exit 1
    fi
    head_tmp="$(mktemp)"
    git show "HEAD:${rel_path}" > "${head_tmp}"
    head_size="$(wc -c < "${head_tmp}" | tr -d '[:space:]')"
    work_size="$(wc -c < "${work_file}" | tr -d '[:space:]')"
    if [ "${work_size}" -lt "${head_size}" ]; then
        rm "${head_tmp}"
        echo "FATAL [pre-commit]: Append-only graph chunk '${rel_path}' shrank (${work_size} < ${head_size} bytes in HEAD)!" >&2
        exit 1
    fi
    if ! cmp -n "${head_size}" -s "${head_tmp}" "${work_file}"; then
        rm "${head_tmp}"
        echo "FATAL [pre-commit]: Existing lines in append-only graph chunk '${rel_path}' were modified relative to HEAD!" >&2
        exit 1
    fi
    rm "${head_tmp}"
done < <(git ls-tree -r --name-only HEAD -- assets/data/graph/ | grep '\.ctbnodes$' || true)

JOURNAL_PATH="${REPO_ROOT}/src/formats/dcdata/data-src/nodes/allocated/ledger-journal.jsonl"
if [ -f "${JOURNAL_PATH}" ]; then
    python3 - "${REPO_ROOT}/assets/data/graph" "${JOURNAL_PATH}" << 'PY'
import json, os, sys
graph_dir, journal_path = sys.argv[1], sys.argv[2]
max_node_id = 0
ctbnodes_paths = []
for root, dirs, files in os.walk(graph_dir):
    dirs[:] = [d for d in dirs if d.replace("_", "").isdigit()]
    for fname in files:
        if fname.endswith(".ctbnodes"):
            ctbnodes_paths.append(os.path.join(root, fname))
for path in sorted(ctbnodes_paths):
    with open(path, "rb") as f:
        for raw in f:
            line = raw.strip()
            if line:
                nid_s = line.split(b":", 1)[0]
                if nid_s.startswith(b"l"):
                    nid = int(nid_s[1:])
                    if nid > max_node_id:
                        max_node_id = nid
with open(journal_path, "r", encoding="utf-8") as jf:
    lines = [ln.strip() for ln in jf if ln.strip()]
if not lines:
    print("FATAL [pre-commit]: ledger-journal.jsonl is empty!", file=sys.stderr)
    sys.exit(1)
last = json.loads(lines[-1])
if last.get("state") != "BATCH_COMMITTED" or last.get("final_last_id") != max_node_id:
    print(
        f"FATAL [pre-commit]: ledger-journal.jsonl ({last.get('state')}, final_last_id=l{last.get('final_last_id')}) "
        f"is out of sync with assets/data/graph/*.ctbnodes (max=l{max_node_id})! "
        "Run `ctb-lint recover-ledger-journal` before committing.",
        file=sys.stderr,
    )
    sys.exit(1)
PY
fi
