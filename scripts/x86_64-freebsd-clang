set -euo pipefail

script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
workspace_root="$(readlink -f "$script_dir/..")"

pick_first_dir() {
    for candidate in "$@"; do
        if [ -d "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

sysroot="${CTB_FREEBSD_SYSROOT:-}"
if [ -z "$sysroot" ]; then
    sysroot="$(pick_first_dir \
        "$workspace_root/ci-logs/VMs/FreeBSD/sysroot" \
        /usr/local/freebsd-sysroot \
        /opt/freebsd-sysroot \
        /usr/x86_64-unknown-freebsd \
        2>/dev/null || true)"
fi

if [ -z "$sysroot" ] || [ ! -d "$sysroot" ]; then
    base_txz="$workspace_root/ci-logs/VMs/FreeBSD/base.txz"
    if [ -f "$base_txz" ]; then
        target_dir="$workspace_root/ci-logs/VMs/FreeBSD/sysroot"
        mkdir -p "$target_dir"
        tar -xf "$base_txz" -C "$target_dir" ./lib ./usr/lib ./usr/include
        sysroot="$target_dir"
    fi
fi

if [ -z "$sysroot" ] || [ ! -d "$sysroot" ]; then
    cat >&2 <<EOF
error: FreeBSD sysroot not found for x86_64-unknown-freebsd.
Please ensure FreeBSD sysroot is present at:
  $workspace_root/ci-logs/VMs/FreeBSD/sysroot
or set CTB_FREEBSD_SYSROOT=/path/to/sysroot
EOF
    exit 1
fi

cmd="clang"
if [[ "$(basename "$0")" == *"++"* ]] || [[ "${1:-}" == "--cxx" ]]; then
    if [[ "${1:-}" == "--cxx" ]]; then
        shift
    fi
    cmd="clang++"
fi

exec "$cmd" \
    --target=x86_64-unknown-freebsd \
    --sysroot="$sysroot" \
    -fuse-ld=lld \
    -Qunused-arguments \
    "$@"
