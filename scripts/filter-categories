#!/usr/bin/env python3
"""
Filter category CSV files based on their filename:
1. src/formats/dctext/data/categories/*.csv
   Filtered by Column G ('Script') matching the file basename.
   Note: "EL" and "DCE" are grouped together.
2. src/formats/utilities/data/formats/*.csv
   Filtered by Column D ('Category') matching the file basename.
"""

import argparse
import csv
import os
import sys
import tempfile
from pathlib import Path


def find_repo_root(start_path: Path) -> Path:
    """Find repository root by looking for .git or src/formats directory."""
    curr = start_path.resolve()
    for parent in [curr] + list(curr.parents):
        if (parent / ".git").exists() or (parent / "src" / "formats").exists():
            return parent
    return start_path.resolve()


def normalize_name(name: str) -> str:
    """Normalize string for fuzzy comparison (lowercase, alphanumeric only)."""
    return "".join(ch.lower() for ch in name if ch.isalnum())


def script_matches_dctext_file(filename: str, script_val: str) -> bool:
    """
    Check if a row's Script column value matches the dctext category filename.
    EL and DCE scripts are grouped together in dce.csv / el.csv / el_dce.csv.
    """
    base = os.path.splitext(filename)[0].lower()
    val = script_val.strip()

    # EL and DCE grouped together
    if base in ("dce", "el", "el_dce", "dce_el", "el-dce", "dce-el"):
        return val.startswith("DCE") or val.startswith("EL")

    norm_base = normalize_name(base)
    norm_val = normalize_name(val)

    if norm_base == norm_val:
        return True

    # e.g., 'variant_selectors' matches 'Variant selectors'
    if norm_val.startswith(norm_base):
        return True

    return False


def category_matches_formats_file(filename: str, category_val: str) -> bool:
    """
    Check if a row's Category column value matches the formats category filename.
    Handles 'v.lineEndings' -> 'v:lineEndings', 'transformations' -> 'transformation', etc.
    """
    base = os.path.splitext(filename)[0]
    cat = category_val.strip()

    norm_base = normalize_name(base)
    norm_cat = normalize_name(cat)

    if norm_base == norm_cat:
        return True

    # Handle singular/plural mismatch (e.g. transformations vs transformation)
    if norm_base == norm_cat + "s" or norm_cat == norm_base + "s":
        return True

    return False


def process_dctext_categories(
    repo_root: Path,
    dry_run: bool = False,
    check_only: bool = False,
    verbose: bool = False,
) -> tuple[int, int, bool]:
    """Process src/formats/dctext/data/categories directory."""
    categories_dir = repo_root / "src" / "formats" / "dctext" / "data" / "categories"
    master_file = repo_root / "src" / "formats" / "dctext" / "data" / "dc_data.csv"

    if not categories_dir.exists():
        print(f"[dctext] Categories directory not found: {categories_dir}", file=sys.stderr)
        return 0, 0, True

    # Load master rows if available, else read from each individual file
    master_rows: list[list[str]] | None = None
    header: list[str] | None = None

    if master_file.exists():
        with open(master_file, "r", encoding="utf-8", newline="") as f:
            reader = csv.reader(f)
            header = next(reader)
            master_rows = [row for row in reader if row]

    total_files = 0
    modified_files = 0
    all_clean = True

    csv_files = sorted(
        f for f in os.listdir(categories_dir)
        if f.endswith(".csv") and not f.startswith(".")
    )

    print(f"\nProcessing {len(csv_files)} dctext category files in {categories_dir.relative_to(repo_root)}:")

    for filename in csv_files:
        filepath = categories_dir / filename
        total_files += 1

        # Read existing file content
        with open(filepath, "r", encoding="utf-8", newline="") as f:
            reader = csv.reader(f)
            try:
                curr_header = next(reader)
            except StopIteration:
                curr_header = header or []
            existing_rows = [row for row in reader if row]

        source_header = header if header is not None else curr_header
        source_rows = master_rows if master_rows is not None else existing_rows

        # Filter rows by Column G (index 6, 'Script')
        matching_rows = [
            row for row in source_rows
            if len(row) > 6 and script_matches_dctext_file(filename, row[6])
        ]

        is_already_filtered = (existing_rows == matching_rows)

        if not is_already_filtered:
            all_clean = False
            modified_files += 1
            status = "NEEDS UPDATE" if (dry_run or check_only) else "UPDATED"
        else:
            status = "OK (already filtered)"

        print(f"  [{status:12}] {filename:25} -> {len(matching_rows):3} rows (was {len(existing_rows):3} rows)")

        if not is_already_filtered and not dry_run and not check_only:
            # Write atomically to destination
            with tempfile.NamedTemporaryFile("w", encoding="utf-8", newline="", dir=categories_dir, delete=False) as tmp:
                writer = csv.writer(tmp, lineterminator="\n")
                writer.writerow(source_header)
                writer.writerows(matching_rows)
                tmp_path = Path(tmp.name)
            tmp_path.replace(filepath)

    return total_files, modified_files, all_clean


def process_formats_categories(
    repo_root: Path,
    dry_run: bool = False,
    check_only: bool = False,
    verbose: bool = False,
) -> tuple[int, int, bool]:
    """Process src/formats/utilities/data/formats directory."""
    formats_dir = repo_root / "src" / "formats" / "utilities" / "data" / "formats"
    master_file = repo_root / "src" / "formats" / "utilities" / "data" / "formats.csv"

    if not formats_dir.exists():
        print(f"[formats] Formats directory not found: {formats_dir}", file=sys.stderr)
        return 0, 0, True

    master_rows: list[list[str]] | None = None
    header: list[str] | None = None

    if master_file.exists():
        with open(master_file, "r", encoding="utf-8", newline="") as f:
            reader = csv.reader(f)
            header = next(reader)
            master_rows = [row for row in reader if row]

    total_files = 0
    modified_files = 0
    all_clean = True

    csv_files = sorted(
        f for f in os.listdir(formats_dir)
        if f.endswith(".csv") and not f.startswith(".")
    )

    print(f"\nProcessing {len(csv_files)} format category files in {formats_dir.relative_to(repo_root)}:")

    for filename in csv_files:
        filepath = formats_dir / filename
        total_files += 1

        with open(filepath, "r", encoding="utf-8", newline="") as f:
            reader = csv.reader(f)
            try:
                curr_header = next(reader)
            except StopIteration:
                curr_header = header or []
            existing_rows = [row for row in reader if row]

        source_header = header if header is not None else curr_header
        source_rows = master_rows if master_rows is not None else existing_rows

        # Filter rows by Column D (index 3, 'Category')
        matching_rows = [
            row for row in source_rows
            if len(row) > 3 and category_matches_formats_file(filename, row[3])
        ]

        is_already_filtered = (existing_rows == matching_rows)

        if not is_already_filtered:
            all_clean = False
            modified_files += 1
            status = "NEEDS UPDATE" if (dry_run or check_only) else "UPDATED"
        else:
            status = "OK (already filtered)"

        print(f"  [{status:12}] {filename:25} -> {len(matching_rows):3} rows (was {len(existing_rows):3} rows)")

        if not is_already_filtered and not dry_run and not check_only:
            with tempfile.NamedTemporaryFile("w", encoding="utf-8", newline="", dir=formats_dir, delete=False) as tmp:
                writer = csv.writer(tmp, lineterminator="\n")
                writer.writerow(source_header)
                writer.writerows(matching_rows)
                tmp_path = Path(tmp.name)
            tmp_path.replace(filepath)

    return total_files, modified_files, all_clean


def main():
    parser = argparse.ArgumentParser(
        description="Filter category CSV files by column G (Script) for dctext and column D (Category) for formats."
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=None,
        help="Repository root directory (defaults to auto-detect from script location).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simulate filtering without writing changes to disk.",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check if files are already filtered and exit with code 0 if all clean, 1 if updates needed.",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Enable verbose output.",
    )

    args = parser.parse_args()

    script_dir = Path(__file__).resolve().parent
    repo_root = args.root if args.root else find_repo_root(script_dir)

    print(f"Repository root: {repo_root}")
    if args.dry_run:
        print("Mode: DRY RUN (no files will be modified)")
    elif args.check:
        print("Mode: CHECK ONLY")

    t1, m1, clean1 = process_dctext_categories(
        repo_root, dry_run=args.dry_run, check_only=args.check, verbose=args.verbose
    )
    t2, m2, clean2 = process_formats_categories(
        repo_root, dry_run=args.dry_run, check_only=args.check, verbose=args.verbose
    )

    total_files = t1 + t2
    modified_files = m1 + m2
    is_clean = clean1 and clean2

    print("\nSummary:")
    print(f"  Total files checked: {total_files}")
    if args.check or args.dry_run:
        print(f"  Files needing update: {modified_files}")
    else:
        print(f"  Files updated: {modified_files}")

    if args.check and not is_clean:
        sys.exit(1)


if __name__ == "__main__":
    main()
