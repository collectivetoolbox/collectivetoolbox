set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1
REPO_ROOT="$(pwd)"

export RUSTFLAGS="${RUSTFLAGS:--Awarnings -Aunfulfilled_lint_expectations}"
export CARGO_HOST_RUSTFLAGS="${CARGO_HOST_RUSTFLAGS:--Awarnings -Aunfulfilled_lint_expectations}"

offline=""
args=()
for arg in "$@"; do
    if [[ "$arg" == "--offline" ]]; then
        offline="--offline"
    else
        args+=("$arg")
    fi
done

target_flag=""
if [[ "$(uname -s)" == "Linux" && "$(uname -m)" == "x86_64" ]]; then
    target_flag="--target=x86_64-unknown-linux-musl"
elif [[ "$(uname -s)" == "Linux" && "$(uname -m)" =~ i[3-6]86 ]]; then
    target_flag="--target=i586-unknown-linux-musl"
fi

cargo run \
    ${offline} \
    ${target_flag} \
    --quiet \
    --manifest-path "${REPO_ROOT}/src/formats/wasm_substitutes_gen/Cargo.toml" \
    --bin generate-wasm-substitutes \
    -- \
    ${args[@]+"${args[@]}"}
