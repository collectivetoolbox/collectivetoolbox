# Copyright (C) 2026 Collective Toolbox Developers
# Contact: info@collectivetoolbox.com
#
# This program is free software: you can redistribute it and/or modify it under
# the terms of the GNU Affero General Public License as published by the Free
# Software Foundation, either version 3 of the License, or (at your option) any
# later version.
#
# This program is distributed in the hope that it will be useful, but WITHOUT ANY
# WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR
# A PARTICULAR PURPOSE.  See the GNU Affero General Public License for more details.
#
# You should have received a copy of the GNU Affero General Public License along
# with this program.  If not, see <https://www.gnu.org/licenses/>.
set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1


# Ensure robust DNS resolution inside the container
echo "nameserver 8.8.8.8" >> /etc/resolv.conf
echo "nameserver 1.1.1.1" >> /etc/resolv.conf

mode="dev"
if [[ $# -gt 0 ]]; then
    if [[ "$1" == "--deploy" ]]; then
        mode="deploy"
    elif [[ "$1" == "--dev" ]]; then
        mode="dev"
    else
        echo "Unknown option: $1" >&2
        exit 1
    fi
fi

echo "Installing system dependencies..."

if command -v npx >/dev/null 2>&1; then
    npx playwright uninstall --all 2>/dev/null || true
fi
if command -v npm >/dev/null 2>&1; then
    npm uninstall -g typescript playwright 2>/dev/null || true
fi

dpkg --add-architecture i386 || true
apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    clang \
    musl-tools \
    binutils \
    patch \
    pkg-config \
    ca-certificates \
    file \
    mingw-w64 \
    wine \
    wine32:i386 \
    wine64 \
    xz-utils

apt-get remove -y nodejs npm python3 python3-minimal python2 perl perl-base java-common default-jre default-jdk 2>/dev/null || true
apt-get purge -y nodejs npm corepack node-corepack "node-*" python3 python3-minimal "python3.*" python2 "python2.*" perl perl-base "openjdk-*" default-jre default-jdk java-common 2>/dev/null || true
apt-get autoremove --purge -y 2>/dev/null || true
apt-get clean 2>/dev/null || true
rm -rf /var/lib/apt/lists/*

if [[ -d /usr/local/share/nvm ]]; then
    rm -r /usr/local/share/nvm
fi
if [[ -d /root/.nvm ]]; then
    rm -r /root/.nvm
fi
if [[ -d /home ]]; then
    for nvm_dir in /home/*/.nvm; do
        if [[ -d "$nvm_dir" ]]; then
            rm -r "$nvm_dir"
        fi
    done
fi

SKIP_BINS=(
  node npm npx corepack
  python python3 python2
  java javac
  pip pip3 pipx
  perl
)

for bin_name in "${SKIP_BINS[@]}"; do
    for bin_dir in /usr/local/bin /usr/bin /bin /usr/local/sbin /usr/sbin /sbin; do
        if [[ -e "$bin_dir/$bin_name" || -L "$bin_dir/$bin_name" ]]; then
            rm -f "$bin_dir/$bin_name" 2>/dev/null || true
        fi
    done

    cat <<EOF > "/usr/local/bin/$bin_name"
#!/bin/sh
echo "ERROR: $bin_name is prohibited as a build dependency." >&2
exit 1
EOF
    chmod +x "/usr/local/bin/$bin_name"
done

export PATH="$(echo "$PATH" | tr ':' '\n' | grep -v "nvm" | paste -sd: -)"
unset NVM_DIR NVM_BIN NVM_INC NVM_CD_FLAGS

for prohibited in "${SKIP_BINS[@]}"; do
    if "$prohibited" >/dev/null 2>&1; then
        echo "$prohibited is not a permitted dependency, but it succeeded." >&2
        found_bin="$(command -v "$prohibited" || true)"
        if [[ -n "$found_bin" && -e "$found_bin" ]]; then
            echo "Found remaining binary at: $found_bin" >&2
            dpkg -S "$found_bin" || true
        fi
        exit 1
    fi
done

need_guix=true
if [[ -f "/var/cache/ctoolbox/guix_posix_initrd.cpio.gz" || -f "built/guix_posix_initrd.cpio.gz" ]]; then
    need_guix=false
fi

if [[ "$need_guix" == "true" ]]; then
    if ! command -v guix >/dev/null 2>&1; then
        echo "Installing GNU Guix..."
        curl -sSL -o /tmp/guix-install.sh https://git.savannah.gnu.org/cgit/guix.git/plain/etc/guix-install.sh
        chmod +x /tmp/guix-install.sh
        # `sed` is to work around a 502 error. Likely transient; try commenting that out next rebuild.
        sed -i 's|https://ftpmirror.gnu.org/gnu/guix/|https://ftp.gnu.org/gnu/guix/|g' /tmp/guix-install.sh
        yes | /tmp/guix-install.sh || true
        if [[ -f /tmp/guix-install.sh ]]; then
            rm /tmp/guix-install.sh
        fi
        mkdir -p /etc/guix
        for key in /root/.config/guix/current/share/guix/*.pub; do
            /root/.config/guix/current/bin/guix archive --authorize < "$key" || true
        done
    fi

    export PATH="/root/.config/guix/current/bin:/var/guix/profiles/per-user/root/current-profile/bin:$PATH"

    if ! ps aux | grep -q "[g]uix-daemon"; then
        echo "Starting guix-daemon..."
        chown -R root:guixbuild /var/guix /gnu/store 2>/dev/null || true
        chmod 1775 /gnu/store /var/guix 2>/dev/null || true
        if command -v proot >/dev/null 2>&1; then
            nohup proot -0 /root/.config/guix/current/bin/guix-daemon --build-users-group=guixbuild > /tmp/guix-daemon.log 2>&1 &
        else
            nohup /root/.config/guix/current/bin/guix-daemon --disable-chroot --build-users-group=guixbuild > /tmp/guix-daemon.log 2>&1 &
        fi
        sleep 2
    fi
else
    echo "Prebuilt Guix assets are available; skipping Guix installation and daemon startup..."
fi


if [[ "$mode" == "deploy" ]]; then
    version_file="/VERSION"
    if [[ ! -f "$version_file" && -f VERSION ]]; then
        version_file="VERSION"
    fi
    commit_file="/COMMIT"
    if [[ ! -f "$commit_file" && -f COMMIT ]]; then
        commit_file="COMMIT"
    fi

    if [[ ! -f "$version_file" || ! -f "$commit_file" ]]; then
        echo "Error: VERSION or COMMIT file not found (needed for --deploy)." >&2
        exit 1
    fi
    VERSION=$(cat "$version_file")
    COMMIT=$(cat "$commit_file")
    echo "=== Running CI Deploy Verification for version ${VERSION}, commit ${COMMIT} ==="

    BUILD_DIR="/tmp/ctb-ci-build"
    if [[ -d "$BUILD_DIR" ]]; then
        rm -r "$BUILD_DIR"
    fi
    mkdir -p "$BUILD_DIR"
    cd "$BUILD_DIR"

    echo "Downloading source and dependencies tarballs..."
    curl --proto '=https' --tlsv1.2 -sSfL -o ctoolbox-src.tar.gz "https://collectivetoolbox.com/releases/src/ctoolbox-src-${VERSION}-${COMMIT}.tar.gz"
    curl --proto '=https' --tlsv1.2 -sSfL -o ctoolbox-dependencies.tar.gz "https://collectivetoolbox.com/releases/src/ctoolbox-dependencies-${VERSION}-${COMMIT}.tar.gz"

    echo "Extracting source tarball..."
    tar -xf ctoolbox-src.tar.gz --strip-components=1

    echo "Extracting dependencies tarball..."
    mkdir -p vendor/ctb-vendored
    tar -xf ctoolbox-dependencies.tar.gz -C vendor/ctb-vendored --strip-components=1

    echo "Extracting vendor.tar..."
    mkdir -p vendor
    if [[ -f vendor/vendor.tar ]]; then
        tar -xf vendor/vendor.tar -C vendor
    elif [[ -f vendor.tar ]]; then
        tar -xf vendor.tar -C vendor
    else
        echo "Warning: vendor.tar not found" >&2
    fi
else
    echo "=== Running CI Development Check ==="
    # In dev mode, the workspace is already extracted in the current directory.
    if [[ ! -f vendor/warcat/Cargo.toml ]]; then
        echo "Vendor submodule contents not found. Initializing vendor submodule..."
        git config --global --add safe.directory '*' || true
        git config submodule.vendor.url https://github.com/collectivetoolbox/ctb-c-vendored.git || true
        git submodule update --init --recursive vendor || git submodule update --init --recursive || true
    fi
fi

echo "Restoring moved .gitignore files for Cargo checksum validation..."
find vendor -name '*.gitignore-2528979c-1cdc-49a3-83ec-a1cdea2ed741.moved' | while read -r file; do
    mv "$file" "${file%-2528979c-1cdc-49a3-83ec-a1cdea2ed741.moved}"
done

if [[ ! -f "vendor/TypeScript-built.tar" && -f "/var/cache/ctoolbox/TypeScript-built.tar" ]]; then
    echo "Restoring prebuilt TypeScript-built.tar from container cache..."
    mkdir -p vendor
    cp /var/cache/ctoolbox/TypeScript-built.tar vendor/TypeScript-built.tar
fi

if [[ ! -d "vendor/v86_images" && -d "/var/cache/ctoolbox/v86_images" ]]; then
    echo "Restoring prebuilt vendor/v86_images from container cache..."
    mkdir -p vendor
    ln -s /var/cache/ctoolbox/v86_images vendor/v86_images
fi

if [[ ! -f "built/guix_posix_initrd.cpio.gz" && -f "/var/cache/ctoolbox/guix_posix_initrd.cpio.gz" ]]; then
    echo "Restoring prebuilt guix_posix_initrd.cpio.gz from container cache..."
    mkdir -p built
    cp /var/cache/ctoolbox/guix_posix_initrd.cpio.gz built/guix_posix_initrd.cpio.gz
fi

echo "Configuring Cargo concurrency..."
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"

echo "Installing Rust..."
if ! command -v cargo; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.92
fi
export PATH="$HOME/.cargo/bin:$PATH"
rustup default 1.92

# Ensure cargo-deny uses sparse protocol for crates.io to check for yanked crates
export CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Reduce size of test artifacts in CI by stripping full debuginfo from tests
export CARGO_PROFILE_TEST_DEBUG="line-tables-only"

echo "Adding musl target..."
rustup target add x86_64-unknown-linux-musl
rustup target add i586-unknown-linux-musl
rustup target add i586-unknown-linux-gnu
rustup target add wasm32-unknown-unknown
rustup target add x86_64-pc-windows-gnu

echo "Installing cargo-deny..."
cargo install --locked cargo-deny

advisory_dir=""
if [[ -d /advisory-db ]]; then
    advisory_dir="/advisory-db"
elif [[ -d .advisory-db ]]; then
    advisory_dir=".advisory-db"
fi

cargo_home="${CARGO_HOME:-$HOME/.cargo}"
if [[ -n "$advisory_dir" ]]; then
    echo "Setting up pre-cloned RustSec advisory database from ${advisory_dir}..."
    mkdir -p "${cargo_home}/advisory-dbs"
    if [[ -d "${cargo_home}/advisory-dbs/advisory-db-3157b0e258782691" ]]; then
        rm -r "${cargo_home}/advisory-dbs/advisory-db-3157b0e258782691"
    fi
    cp -r "$advisory_dir" "${cargo_home}/advisory-dbs/advisory-db-3157b0e258782691"
fi

echo "Backing up generated files for offline regeneration and drift check..."
gen_backup_dir="$(mktemp -d)"
# FIXME Guix
while IFS= read -r f; do
    mkdir -p "$gen_backup_dir/$(dirname "$f")"
    cp "$f" "$gen_backup_dir/$f"
done < <(find src docs -type f \( -name '*.generated.*' -o -name '*.dtos.generated.rs' -o -name 'generated.rs' \) \
    ! -path '*/packaging/guix/generated/*' \
    ! -path '*/vendor/*')

echo "Cleaning generated files to verify offline regeneration..."
./scripts/clean-generated

echo "Running offline build..."
# Cargo deny produces an enormous amount of output when running in Docker, due
# to being unable to check for yanked crates for some reason. It does finish
# eventually though.
./build --release --offline --clean-targets all

echo "Verifying that all cleaned generated files were regenerated without drift..."
drift_count=0
while IFS= read -r backup_file; do
    rel_path="${backup_file#$gen_backup_dir/}"
    if [[ ! -f "$rel_path" ]]; then
        echo "ERROR: Generated file $rel_path was not regenerated during build!" >&2
        drift_count=$((drift_count + 1))
    elif ! diff -u "$backup_file" "$rel_path"; then
        echo "ERROR: Generated file $rel_path drifted from expected version!" >&2
        drift_count=$((drift_count + 1))
    fi
done < <(find "$gen_backup_dir" -type f)

if [[ $drift_count -gt 0 ]]; then
    echo "ERROR: $drift_count generated file(s) failed regeneration or drifted." >&2
    rm -rf "$gen_backup_dir"
    exit 1
fi
rm -rf "$gen_backup_dir"
echo "All generated files successfully regenerated offline with zero drift!"

echo "CI Build Inner completed successfully!"
