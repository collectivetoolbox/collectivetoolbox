set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1


read_secret() {
	local prompt="$1"
	local secret
	read -r -s -p "$prompt" secret
	echo >&2
	printf '%s' "$secret"
}

cleanup() {
	if [[ -n "${DOCKER_CONFIG:-}" && -d "$DOCKER_CONFIG" ]]; then
		rm -rf -- "$DOCKER_CONFIG"
	fi
	unset PASS
}

trap cleanup EXIT

mydate="$1"

PASS="$(read_secret "Personal access token (classic) for collectivetoolbox@github: ")"
DOCKER_CONFIG="$(mktemp -d)"

printf '%s\n' "$PASS" | docker --config "$DOCKER_CONFIG" login ghcr.io -u collectivetoolbox --password-stdin
unset PASS

set -x
docker --config "$DOCKER_CONFIG" push "ghcr.io/collectivetoolbox/collectivetoolbox-$mydate:latest"
