# Helper script to manage, snapshot, and run tests/commands in the Windows (7 / 11) VM in QEMU.
set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(pwd)"

source "$SCRIPT_DIR/vm-common.sh"

SCRIPT_INVOCATION_NAME="$(basename "${BASH_SOURCE[0]}")"
VARIANT="${CTB_WIN_VARIANT:-}"

if [[ "${1:-}" == "--win11" ]]; then
    VARIANT="win11"
    shift
elif [[ "${1:-}" == "--win7" ]]; then
    VARIANT="win7"
    shift
elif [[ -z "$VARIANT" ]]; then
    if [[ "$SCRIPT_INVOCATION_NAME" == *"11"* ]]; then
        VARIANT="win11"
    else
        VARIANT="win7"
    fi
fi

if [[ "$VARIANT" == "win11" ]]; then
    OS_TITLE="Windows 11"
    SCRIPT_NAME="win11-vm"
    DEFAULT_IMAGE="$REPO_ROOT/ci-logs/VMs/Win11/win11.qcow2"
    SOCKET_DIR="/tmp/ctb-win11-vm"
    EXCHANGE_DIR="/tmp/ctb-win11-exchange"
    EXCHANGE_ISO="/tmp/ctb-win11-exchange.iso"
    SCREENSHOT_DEFAULT="/tmp/win11-screen.png"
    LOG_DIR="$REPO_ROOT/ci-logs/Win11"
    DEFAULT_SSH_PORT="2225"
    DEFAULT_VNC_PORT="4"
    DEFAULT_BIOS=""
    for cand in /usr/share/ovmf/OVMF.fd /usr/share/qemu/OVMF.fd /usr/share/OVMF/OVMF.fd; do
        if [[ -f "$cand" ]]; then
            DEFAULT_BIOS="$cand"
            break
        fi
    done
else
    OS_TITLE="Windows 7"
    SCRIPT_NAME="win-vm"
    DEFAULT_IMAGE="$REPO_ROOT/ci-logs/VMs/Windows/win7.qcow2"
    SOCKET_DIR="/tmp/ctb-win7-vm"
    EXCHANGE_DIR="/tmp/ctb-win7-exchange"
    EXCHANGE_ISO="/tmp/ctb-exchange.iso"
    SCREENSHOT_DEFAULT="/tmp/win7-screen.png"
    LOG_DIR="$REPO_ROOT/ci-logs/Windows"
    DEFAULT_SSH_PORT="2222"
    DEFAULT_VNC_PORT="1"
    DEFAULT_BIOS=""
fi

MONITOR_SOCK="$SOCKET_DIR/monitor.sock"
VNC_SOCK="$SOCKET_DIR/vnc.sock"
PID_FILE="$SOCKET_DIR/qemu.pid"
SERIAL_LOG="$SOCKET_DIR/serial.log"

mkdir -p "$SOCKET_DIR"

usage() {
    cat <<EOF
Usage: ./scripts/$SCRIPT_NAME <command> [options]

VM Lifecycle:
  start          Start the $OS_TITLE VM in the background (QEMU)
                 Options:
                   --persist      Write changes directly to the qcow2 image
                                  (default: runs with -snapshot to protect image)
                   --net          Attach an isolated local loopback NIC (restrict=on,
                                  guest cannot access external LAN or internet; forwards
                                  localhost:$DEFAULT_SSH_PORT -> guest:22 for SSH)
                   --ssh-port P   Custom SSH forward port (default: $DEFAULT_SSH_PORT)
                   --vnc-port P   Also listen on TCP port P for VNC (e.g. 590$DEFAULT_VNC_PORT)
                   --bios PATH    Custom UEFI/BIOS firmware file (default: ${DEFAULT_BIOS:-none})
                   --image PATH   Use a custom qcow2 image (default: $DEFAULT_IMAGE)
                   --iso PATH     Attach a custom CD-ROM ISO (default: $EXCHANGE_ISO)
                   --mem MB       Memory in MB (default: 4096)
                   --smp CORES    CPU cores (default: 4)

  stop           Stop the running VM (graceful ACPI shutdown, or --force)
  status         Check if the VM is running and display resource usage

Snapshot Management:
  snapshot list             List snapshots present in the qcow2 disk image
  snapshot create <name>    Create a snapshot (live if running, offline if stopped)
  snapshot revert <name>    Revert disk image to a snapshot (stops VM if running)
  snapshot delete <name>    Delete a snapshot from the qcow2 disk image

Execution & Testing:
  sync-binaries             Package Windows binaries into exchange ISO and hot-swap
  run <command...>          Execute a command in the VM and stream output to terminal
  test [--reset]            Run the Windows smoke tests in the VM
  test-suite [options]      Compile, package, and execute the full test suite in VM
                            Options:
                              --release        (default) Compile and package tests in release mode
                              --debug          Compile and package tests in debug mode
                              --reset          Revert to base-state snapshot first
                              --crate <name>   Test only a specific package/crate
                              --filter <pat>   Test filter pattern
                              --no-build       Skip build; use existing binaries
                              --standalone-tests-dir <dir>  Include precompiled standalone tests
                              --timeout <sec>  Timeout waiting for test suite (default: 14400)

Interactive / Inspection:
  screenshot [path]         Capture the VM display buffer to a PNG image (default: $SCREENSHOT_DEFAULT)
  send-keys <key>...        Send QEMU monitor keys (e.g. "ret", "down", "ctrl-alt-delete", "meta_l-r")
  type <text>               Type arbitrary text into the VM via simulated key events
  monitor <cmd>             Execute an arbitrary command on the QEMU monitor

Examples:
  ./scripts/$SCRIPT_NAME start
  ./scripts/$SCRIPT_NAME test
  ./scripts/$SCRIPT_NAME run ctoolbox.exe --version
  ./scripts/$SCRIPT_NAME screenshot
  ./scripts/$SCRIPT_NAME stop
EOF
}

is_running() {
    vm_is_running "$PID_FILE"
}

cmd_start() {
    if is_running; then
        echo "VM is already running with PID $(cat "$PID_FILE")."
        return 0
    fi

    local snapshot_flag="-snapshot"
    local net_flags=()
    local vnc_args=("-vnc" "unix:$VNC_SOCK")
    local image="$DEFAULT_IMAGE"
    local iso="$EXCHANGE_ISO"
    local mem="4096"
    local smp="4"
    local ssh_port="$DEFAULT_SSH_PORT"
    local bios="$DEFAULT_BIOS"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --persist)
                snapshot_flag=""
                ;;
            --net)
                # restrict=on isolates guest completely from the internet and external network.
                # Only explicitly forwarded ports are reachable.
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --ssh-port)
                shift
                ssh_port="${1:-$DEFAULT_SSH_PORT}"
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:${ssh_port}-:22"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --vnc-port)
                shift
                vnc_args=("-vnc" "127.0.0.1:${1:-$DEFAULT_VNC_PORT},websocket=off")
                ;;
            --bios)
                shift
                bios="$1"
                ;;
            --image)
                shift
                image="$1"
                ;;
            --iso)
                shift
                iso="$1"
                ;;
            --mem)
                shift
                mem="$1"
                ;;
            --smp)
                shift
                smp="$1"
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ ! -f "$image" ]]; then
        echo "Error: VM disk image not found at $image" >&2
        return 1
    fi

    if [[ ! -f "$iso" ]]; then
        mkdir -p /tmp/ctb-empty-iso
        genisoimage -J -r -o "$iso" /tmp/ctb-empty-iso >/dev/null 2>&1 || true
        remove_if_exists /tmp/ctb-empty-iso
    fi

    remove_if_exists "$MONITOR_SOCK" "$VNC_SOCK" "$PID_FILE"

    echo "Starting $OS_TITLE VM..."
    echo "  Image:    $image"
    echo "  ISO:      $iso"
    echo "  Memory:   ${mem}MB | SMP: $smp"
    if [[ -n "$bios" ]]; then
        echo "  Firmware: $bios"
    fi
    echo "  Snapshot: $(if [[ -n "$snapshot_flag" ]]; then echo "Enabled (read-only mode)"; else echo "Disabled (writes persist)"; fi)"
    echo "  Network:  $(if [[ ${#net_flags[@]} -gt 0 ]]; then echo "Isolated loopback port-forward (127.0.0.1:${ssh_port} -> guest:22, restrict=on)"; else echo "Air-gapped (no NIC)"; fi)"

    local qemu_cmd=(
        qemu-system-x86_64
        -nodefaults
        -M pc
        -cpu max
        -m "$mem"
        -smp "$smp,cores=$smp,sockets=1"
    )

    if [[ -n "$bios" ]]; then
        qemu_cmd+=("-bios" "$bios")
    fi

    qemu_cmd+=(
        -device ahci,id=ahci0
        -drive "file=$image,if=none,id=drive0,format=qcow2"
        -device ide-hd,bus=ahci0.0,drive=drive0
        -drive "file=$iso,if=none,id=cdrom0,media=cdrom,readonly=on"
        -device ide-cd,bus=ahci0.1,drive=cdrom0
        -serial "file:$SERIAL_LOG"
        -vga std
        -usb -device usb-tablet
        "${vnc_args[@]}"
        -monitor "unix:$MONITOR_SOCK,server,nowait"
        -pidfile "$PID_FILE"
        -daemonize
    )

    if [[ -n "$snapshot_flag" ]]; then
        qemu_cmd+=("$snapshot_flag")
    fi

    if [[ ${#net_flags[@]} -gt 0 ]]; then
        qemu_cmd+=("${net_flags[@]}")
    fi

    "${qemu_cmd[@]}"
    sleep 1

    if is_running; then
        echo "VM successfully started (PID: $(cat "$PID_FILE"))."
    else
        echo "Failed to start VM. Check logs or permissions." >&2
        return 1
    fi
}

cmd_stop() {
    local force="false"
    if [[ "${1:-}" == "--force" ]]; then
        force="true"
    fi
    vm_cmd_stop "$PID_FILE" "$MONITOR_SOCK" "$VNC_SOCK" "$force" "$OS_TITLE VM"
}

cmd_status() {
    vm_cmd_status "$PID_FILE" "$OS_TITLE VM"
}

cmd_monitor() {
    vm_cmd_monitor "$MONITOR_SOCK" "$@"
}

cmd_screenshot() {
    local out_path="${1:-$SCREENSHOT_DEFAULT}"
    vm_cmd_screenshot "$MONITOR_SOCK" "$out_path"
}

cmd_send_keys() {
    vm_cmd_send_keys "$MONITOR_SOCK" "$@"
}

cmd_type() {
    vm_cmd_type "$MONITOR_SOCK" "$*"
}

cmd_snapshot() {
    local subcmd="${1:-list}"
    shift || true
    local image="$DEFAULT_IMAGE"
    vm_cmd_snapshot "$MONITOR_SOCK" "$PID_FILE" "$image" "$subcmd" "$@"
}

cmd_sync_binaries() {
    mkdir -p "$EXCHANGE_DIR"

    local ctb_bin="target/x86_64-win7-windows-gnu/release/ctoolbox.exe"
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-win7-windows-gnu/debug/ctoolbox.exe"
    fi
    if [[ -f "$ctb_bin" ]]; then
        cp "$ctb_bin" "$EXCHANGE_DIR/ctoolbox.exe"
    fi

    local installer_bin="target/x86_64-win7-windows-gnu/release/ctoolbox-installer.exe"
    if [[ ! -f "$installer_bin" ]]; then
        installer_bin="target/x86_64-win7-windows-gnu/debug/ctoolbox-installer.exe"
    fi
    if [[ -f "$installer_bin" ]]; then
        cp "$installer_bin" "$EXCHANGE_DIR/ctoolbox-installer.exe"
    fi

    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 1.5
    fi
    echo "Synchronized binaries to $EXCHANGE_ISO."
}

cmd_run() {
    if ! is_running; then
        echo "VM is not running. Starting VM..."
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    local user_cmd="$*"
    if [[ -z "$user_cmd" ]]; then
        echo "Usage: ./scripts/$SCRIPT_NAME run <command...>" >&2
        return 1
    fi

    mkdir -p "$EXCHANGE_DIR"
    cat <<EOF > "$EXCHANGE_DIR/run.bat"
@echo off
set "TEST_DRIVE=%~dp0"
if "%CTB_WIN_TEST_ROOT%"=="" set "CTB_WIN_TEST_ROOT=%TEST_DRIVE%"
set "PATH=%CTB_WIN_TEST_ROOT%;%PATH%"
cd /d "%TEMP%"
echo ---CTB_START--- > COM1
$user_cmd >> COM1 2>&1
echo. >> COM1
echo ---CTB_EXIT:%ERRORLEVEL%--- >> COM1
EOF

    cmd_sync_binaries

    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    # Dismiss any stray dialogs or AutoPlay popups before invoking Run
    cmd_send_keys "esc"
    sleep 0.5

    cmd_send_keys "meta_l-r"
    sleep 1.2
    cmd_type "cmd /c for %d in (D E F G) do @if exist %d:\\run.bat %d:\\run.bat"
    sleep 0.8
    cmd_send_keys "ret"

    python3 -c "
import sys, time

log_path = '$SERIAL_LOG'
start_offset = int(sys.argv[1])
timeout = 180

start_time = time.time()
started = False
exit_code = None

with open(log_path, 'r', errors='replace') as f:
    f.seek(start_offset)
    while True:
        line = f.readline()
        if line:
            clean_line = line.strip()
            if '---CTB_START---' in clean_line:
                started = True
                continue
            if '---CTB_EXIT:' in clean_line:
                part = clean_line.split('---CTB_EXIT:')[1].split('---')[0]
                try:
                    exit_code = int(part)
                except ValueError:
                    exit_code = 1
                break
            if started:
                sys.stdout.write(line)
                sys.stdout.flush()
        else:
            if time.time() - start_time > timeout:
                sys.stderr.write('Timeout waiting for command to finish in VM.\n')
                sys.exit(124)
            time.sleep(0.2)

sys.exit(exit_code if exit_code is not None else 1)
" "$start_offset"
}

cmd_test() {
    local reset="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reset)
                reset="true"
                ;;
            *)
                ;;
        esac
        shift
    done

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    if ! is_running; then
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    echo "=== Running $OS_TITLE Smoke Tests in VM ==="
    echo "1. Testing ctoolbox-installer.exe --version..."
    cmd_run "ctoolbox-installer.exe --version"
    echo ""
    echo "2. Testing ctoolbox-installer.exe --help..."
    cmd_run "ctoolbox-installer.exe --help"
    echo ""
    if [[ -f "target/x86_64-win7-windows-gnu/release/ctoolbox.exe" || -f "target/x86_64-win7-windows-gnu/debug/ctoolbox.exe" ]]; then
        echo "3. Testing ctoolbox.exe --version..."
        cmd_run "ctoolbox.exe --version"
        echo ""
        echo "4. Testing ctoolbox.exe --help..."
        cmd_run "ctoolbox.exe --help"
        echo ""
    fi
    echo "=== $OS_TITLE VM Tests Completed Successfully ==="
}

cmd_test_suite() {
    local reset="false"
    local release="false"
    local crate_filter=""
    local test_filter=""
    local no_build="false"
    local standalone_tests_dir=""
    local timeout="14400"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --release)
                release="true"
                ;;
            --debug)
                release="false"
                ;;
            --reset)
                reset="true"
                ;;
            --crate)
                shift
                crate_filter="${1:-}"
                ;;
            --filter)
                shift
                test_filter="${1:-}"
                ;;
            --no-build)
                no_build="true"
                ;;
            --standalone-tests-dir)
                shift
                standalone_tests_dir="${1:-}"
                if [[ ! -d "$standalone_tests_dir" ]]; then
                    echo "Missing standalone test directory: $standalone_tests_dir" >&2
                    return 1
                fi
                ;;
            --timeout)
                shift
                timeout="${1:-14400}"
                ;;
            *)
                echo "Unknown option for test-suite: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    trap 'if is_running; then cmd_stop; fi' EXIT INT TERM

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    local target="x86_64-win7-windows-gnu"
    local shim_obj="$REPO_ROOT/target/$target/combase_shim.o"

    if [[ "$no_build" != "true" ]]; then
        if ! command -v clang >/dev/null || ! command -v ld.lld >/dev/null; then
            echo "Windows VM test builds require clang and LLD." >&2
            return 1
        fi
        echo "=== Compiling Windows 7 Compatibility Shim ==="
        mkdir -p "$REPO_ROOT/target/$target"
        x86_64-w64-mingw32-gcc -Wall -Wextra -Wno-attributes -O2 -c \
            src/build_support/windows/combase_shim.c -o "$shim_obj"
        x86_64-w64-mingw32-ar crs \
            "$REPO_ROOT/target/$target/libctb_win7_shim.a" "$shim_obj"

        echo "=== Compiling Test Binaries for $target (profile: $(if [[ "$release" == "true" ]]; then echo "release"; else echo "debug"; fi)) ==="
        export RUSTC_BOOTSTRAP=1
        export CTB_HOST_WORKSPACE_ROOT="$REPO_ROOT"
        local gcc_lib_dir
        gcc_lib_dir="$(dirname "$(x86_64-w64-mingw32-gcc -print-file-name=libgcc.a)")"
        local rustflags="${RUSTFLAGS-} -C linker=clang -C link-arg=--target=x86_64-w64-windows-gnu -C link-arg=-fuse-ld=lld -C link-arg=-Wl,--allow-multiple-definition -L native=$gcc_lib_dir -L native=$REPO_ROOT/target/$target -l static=ctb_win7_shim"

        if [[ "$release" != "true" && ( -z "$crate_filter" || "$crate_filter" == ctb-formats-javascript* || "$crate_filter" == "ctb-formats-compression" ) ]]; then
            echo "=== Compiling JavaScript and compression tests in release mode ==="
            local optimized_packages=(-p ctb-formats-javascript -p ctb-formats-javascript-boa-host -p ctb-formats-javascript-bootstrap-ts -p ctb-formats-compression)
            if [[ -n "$crate_filter" ]]; then
                optimized_packages=(-p "$crate_filter")
            fi
            RUSTFLAGS="$rustflags" cargo test --no-run --target "$target" -Z "build-std=std,panic_abort" --jobs 4 --release "${optimized_packages[@]}"
        fi

        local cargo_args=(test --no-run --target "$target" -Z "build-std=std,panic_abort" --jobs 4)
        if [[ "$release" == "true" ]]; then
            cargo_args+=(--release)
        fi
        if [[ -n "$crate_filter" ]]; then
            if [[ ( "$crate_filter" != ctb-formats-javascript* && "$crate_filter" != "ctb-formats-compression" ) || "$release" == "true" ]]; then
                cargo_args+=(-p "$crate_filter")
                RUSTFLAGS="$rustflags" cargo "${cargo_args[@]}"
            fi
        else
            cargo_args+=(--workspace --exclude ctb-nopersonality --exclude yaxi --exclude ctb-workspace-x11-client --exclude ctb-workspace-x11-client-egui)
            if [[ "$release" != "true" ]]; then
                cargo_args+=(--exclude ctb-formats-javascript --exclude ctb-formats-javascript-boa-host --exclude ctb-formats-javascript-bootstrap-ts --exclude ctb-formats-compression)
            fi
            RUSTFLAGS="$rustflags" cargo "${cargo_args[@]}"
        fi
    fi

    echo "=== Packaging Tests and Fixtures for VM Exchange ==="
    remove_if_exists "$EXCHANGE_DIR"
    mkdir -p "$EXCHANGE_DIR/tests"

    local build_profile="debug"
    if [[ "$release" == "true" ]]; then
        build_profile="release"
    fi

    local binary_count=0
    binary_count=$(python3 -c "
import glob, os, re, shutil, subprocess, sys

target = '$target'
build_profile = '$build_profile'
crate_filter = '$crate_filter'
crate_prefix = crate_filter.replace('-', '_') if crate_filter else None
exchange_dir = '$EXCHANGE_DIR/tests'

def get_test_hashes(profile):
    fps = glob.glob(f'target/{target}/{profile}/.fingerprint/*')
    hashes = set()
    for fp in fps:
        m = re.search(r'-([0-9a-f]{16})$', fp)
        if not m:
            continue
        h = m.group(1)
        for fname in os.listdir(fp):
            if fname.startswith('test-') and not fname.endswith('.json'):
                hashes.add(h)
                break
    return hashes

debug_hashes = get_test_hashes('debug') if build_profile == 'debug' else set()
release_hashes = get_test_hashes('release')

import concurrent.futures

candidate_files = []
if build_profile == 'debug':
    for exe in glob.glob(f'target/{target}/debug/deps/*.exe'):
        bname = os.path.basename(exe)
        optimized_binaries = ('ctb_formats_javascript', 'js_lint', 'js_test', 'ts_check', 'ctb_formats_compression-')
        if not any(bname.startswith(p) for p in optimized_binaries):
            candidate_files.append((exe, debug_hashes))
    for exe in glob.glob(f'target/{target}/release/deps/*.exe'):
        bname = os.path.basename(exe)
        if any(bname.startswith(p) for p in optimized_binaries):
            candidate_files.append((exe, release_hashes))
else:
    for exe in glob.glob(f'target/{target}/release/deps/*.exe'):
        candidate_files.append((exe, release_hashes))

valid_exes = {}
for exe, hashes in candidate_files:
    bname = os.path.basename(exe)
    if crate_prefix and not bname.startswith(f'{crate_prefix}-'):
        continue
    m = re.search(r'^(.*)-([0-9a-f]{16})\.exe$', bname)
    if not m or m.group(2) not in hashes:
        continue
    base = m.group(1)
    mtime = os.path.getmtime(exe)
    if base not in valid_exes or mtime > valid_exes[base][1]:
        valid_exes[base] = (exe, mtime)

def process_exe(item):
    base, (exe, _) = item
    bname = os.path.basename(exe)
    dest = os.path.join(exchange_dir, bname)
    shutil.copyfile(exe, dest)
    shutil.copymode(exe, dest)
    subprocess.run(['x86_64-w64-mingw32-strip', dest], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
    count = sum(1 for ok in executor.map(process_exe, sorted(valid_exes.items())) if ok)

print(count)
")

    if [[ -n "$standalone_tests_dir" ]]; then
        local standalone_count=0
        while IFS= read -r -d '' executable; do
            local name="standalone_$(basename "$(dirname "$executable")").exe"
            if [[ -e "$EXCHANGE_DIR/tests/$name" ]]; then
                echo "Duplicate standalone test executable: $name" >&2
                return 1
            fi
            cp "$executable" "$EXCHANGE_DIR/tests/$name"
            standalone_count=$((standalone_count + 1))
        done < <(find "$standalone_tests_dir" -type f -name '*.exe' -print0)
        if [[ "$standalone_count" -eq 0 ]]; then
            echo "No standalone Windows test executables found in $standalone_tests_dir" >&2
            return 1
        fi
        binary_count=$((binary_count + standalone_count))
    fi

    if [[ "$binary_count" -eq 0 ]]; then
        echo "No test binaries found in target/$target/$build_profile/deps/!" >&2
        return 1
    fi

    vm_package_fixtures "$EXCHANGE_DIR" "$REPO_ROOT"

    echo "Generating in-VM test runner scripts..."
    local filter_arg=""
    local bootstrap_test_args="--skip tests::test_bootstrap_ts_compilation"
    if [[ -n "$test_filter" ]]; then
        filter_arg="$test_filter "
        bootstrap_test_args=""
    fi

    cat <<EOF > "$EXCHANGE_DIR/run_suite.bat"
@echo off
setlocal enabledelayedexpansion
set "RUST_LOG=info"
set "TEST_DRIVE=%~dp0"
if "%CTB_WIN_TEST_ROOT%"=="" set "CTB_WIN_TEST_ROOT=%TEST_DRIVE%"
set "PATH=%CTB_WIN_TEST_ROOT%;%PATH%"
mkdir "C:\workspaces" >nul 2>&1
rmdir "C:\workspaces\ctoolbox" >nul 2>&1
mklink /J "C:\workspaces\ctoolbox" "%CTB_WIN_TEST_ROOT%" >nul 2>&1
cd /d "%TEMP%"
reg add "HKCU\Software\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Policies\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Policies\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Windows" /v ErrorMode /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v "NoDriveTypeAutoRun" /t REG_DWORD /d 255 /f >nul 2>&1

:: Disable Windows Firewall to prevent interactive popups blocking network tests
netsh advfirewall set allprofiles state off >nul 2>&1

:: Background watchdog to kill any WerFault crash dialogs immediately
echo 1 > "%TEMP%\watchdog.run"
start /B cmd /Q /c "for /L %%i in () do (if not exist "%TEMP%\watchdog.run" exit & taskkill /F /IM WerFault.exe /IM WerFaultSecure.exe >nul 2>&1 & ping -n 2 127.0.0.1 >nul)"

echo ---SUITE_START--- > COM1
set TOTAL=0
set PASSED=0
set FAILED=0

for %%F in ("%CTB_WIN_TEST_ROOT%tests\*.exe") do (
    set /a TOTAL+=1
    echo === RUN %%~nF === >> COM1
    set TEST_NAME=%%~nF
    set TEST_ARGS=$test_filter --include-ignored $bootstrap_test_args --nocapture --test-threads 3
    if "!TEST_NAME:~0,22!"=="ctb_formats_javascript" set TEST_ARGS=$test_filter --include-ignored $bootstrap_test_args --nocapture --test-threads 1
    if "!TEST_NAME:~0,11!"=="standalone_" set TEST_ARGS=
    "%%F" !TEST_ARGS! >> COM1 2>&1
    set TEST_EXIT=!ERRORLEVEL!
    if !TEST_EXIT! EQU 0 (
        set /a PASSED+=1
        echo === PASS %%~nF === >> COM1
    ) else (
        set /a FAILED+=1
        echo === FAIL %%~nF [EXIT:!TEST_EXIT!] === >> COM1
    )
    echo. >> COM1
)

del /f /q "%TEMP%\watchdog.run" >nul 2>&1
echo ---SUITE_END:TOTAL=!TOTAL!,PASSED=!PASSED!,FAILED=!FAILED!--- >> COM1
EOF

    echo "Creating exchange ISO with $binary_count test binaries and fixtures..."
    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 3.0
    else
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    local log_dir="$LOG_DIR"
    mkdir -p "$log_dir"
    local log_ts
    log_ts="$(date +%Y%m%d-%H%M%S)"
    local suite_log="$log_dir/${OS_TITLE// /-}-${log_ts}.log"

    echo "=== Executing Test Suite in $OS_TITLE VM ==="
    echo "Streaming VM test output to $suite_log..."
    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    local launch_attempt
    for launch_attempt in 1 2 3; do
        cmd_send_keys "esc"
        sleep 0.5
        cmd_send_keys "esc"
        sleep 0.5
        cmd_send_keys "meta_l-r"
        sleep 1.5
        cmd_send_keys "ctrl-a"
        cmd_type "cmd /c for %d in (D E F G) do @if exist %d:\\run_suite.bat %d:\\run_suite.bat"
        sleep 1.0
        cmd_send_keys "ret"
        if vm_wait_for_marker "$SERIAL_LOG" "$start_offset" "---SUITE_START---" 90; then
            break
        fi
        echo "VM suite startup marker missing after launch attempt $launch_attempt." >&2
    done

    vm_stream_suite_output "$SERIAL_LOG" "$start_offset" "$timeout" "$suite_log" "$OS_TITLE" "$binary_count" || py_exit=$?

    trap - EXIT INT TERM
    if is_running; then
        if [[ "${py_exit:-0}" -ne 0 ]]; then
            vm_capture_failure_artifacts "$MONITOR_SOCK" "$SERIAL_LOG" "$log_dir" "$OS_TITLE"
        fi
        echo "Stopping $OS_TITLE VM..."
        cmd_stop
    fi
    return ${py_exit:-0}
}

action="${1:-}"
shift || true

case "$action" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    status)
        cmd_status
        ;;
    screenshot)
        cmd_screenshot "$@"
        ;;
    send-keys)
        cmd_send_keys "$@"
        ;;
    type)
        cmd_type "$@"
        ;;
    monitor)
        cmd_monitor "$@"
        ;;
    snapshot)
        cmd_snapshot "$@"
        ;;
    sync-binaries)
        cmd_sync_binaries
        ;;
    run)
        cmd_run "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    test-suite)
        cmd_test_suite "$@"
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 1
        ;;
esac
