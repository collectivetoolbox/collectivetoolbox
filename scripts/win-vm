# Helper script to manage, snapshot, and run tests/commands in the Windows 7 VM in QEMU.
set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(pwd)"
DEFAULT_IMAGE="$REPO_ROOT/ci-logs/VMs/Windows/win7.qcow2"
SOCKET_DIR="/tmp/ctb-win7-vm"
MONITOR_SOCK="$SOCKET_DIR/monitor.sock"
VNC_SOCK="$SOCKET_DIR/vnc.sock"
PID_FILE="$SOCKET_DIR/qemu.pid"
SERIAL_LOG="$SOCKET_DIR/serial.log"
EXCHANGE_DIR="/tmp/ctb-win7-exchange"
EXCHANGE_ISO="/tmp/ctb-exchange.iso"

mkdir -p "$SOCKET_DIR"

remove_if_exists() {
    for path in "$@"; do
        if [[ -e "$path" || -L "$path" || -S "$path" ]]; then
            rm -r "$path"
        fi
    done
}

usage() {
    cat <<EOF
Usage: ./scripts/win-vm <command> [options]

VM Lifecycle:
  start          Start the Windows 7 VM in the background (QEMU)
                 Options:
                   --persist      Write changes directly to the qcow2 image
                                  (default: runs with -snapshot to protect image)
                   --net          Attach an isolated local loopback NIC (restrict=on,
                                  guest cannot access external LAN or internet; forwards
                                  localhost:2222 -> guest:22 for SSH)
                   --vnc-port P   Also listen on TCP port P for VNC (e.g. 5901)
                   --image PATH   Use a custom qcow2 image (default: ci-logs/VMs/Windows/win7.qcow2)
                   --iso PATH     Attach a custom CD-ROM ISO (default: /tmp/ctb-exchange.iso)
                   --mem MB       Memory in MB (default: 2048)
                   --smp CORES    CPU cores (default: 2)

  stop           Stop the running VM (graceful ACPI shutdown, or --force)
  status         Check if the VM is running and display resource usage

Snapshot Management:
  snapshot list             List snapshots present in the qcow2 disk image
  snapshot create <name>    Create a snapshot (live if running, offline if stopped)
  snapshot revert <name>    Revert disk image to a snapshot (stops VM if running)
  snapshot delete <name>    Delete a snapshot from the qcow2 disk image

Execution & Testing:
  sync-binaries             Package Windows binaries into exchange ISO and hot-swap
  run <command...>          Execute a command in the VM and stream output to terminal
  test [--reset]            Run the Windows smoke tests in the VM
  test-suite [options]      Compile, package, and execute the full test suite in VM
                            Options:
                              --reset          Revert to base-state snapshot first
                              --crate <name>   Test only a specific package/crate
                              --filter <pat>   Test filter pattern
                              --no-build       Skip build; use existing binaries
                              --timeout <sec>  Timeout waiting for test suite (default: 1800)

Interactive / Inspection:
  screenshot [path]         Capture the VM display buffer to a PNG image (default: /tmp/win7-screen.png)
  send-keys <key>...        Send QEMU monitor keys (e.g. "ret", "down", "ctrl-alt-delete", "meta_l-r")
  type <text>               Type arbitrary text into the VM via simulated key events
  monitor <cmd>             Execute an arbitrary command on the QEMU monitor

Examples:
  ./scripts/win-vm start
  ./scripts/win-vm test
  ./scripts/win-vm run ctoolbox.exe --version
  ./scripts/win-vm screenshot
  ./scripts/win-vm stop
EOF
}

is_running() {
    if [[ -f "$PID_FILE" ]]; then
        local pid
        pid="$(cat "$PID_FILE")"
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

cmd_start() {
    if is_running; then
        echo "VM is already running with PID $(cat "$PID_FILE")."
        return 0
    fi

    local snapshot_flag="-snapshot"
    local net_flags=()
    local vnc_args=("-vnc" "unix:$VNC_SOCK")
    local image="$DEFAULT_IMAGE"
    local iso="$EXCHANGE_ISO"
    local mem="4096"
    local smp="4"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --persist)
                snapshot_flag=""
                ;;
            --net)
                # restrict=on isolates guest completely from the internet and external network.
                # Only explicitly forwarded ports (127.0.0.1:2222 -> guest:22) are reachable.
                net_flags=(
                    "-netdev" "user,id=net0,restrict=on,hostfwd=tcp:127.0.0.1:2222-:22"
                    "-device" "e1000,netdev=net0"
                )
                ;;
            --vnc-port)
                shift
                vnc_args=("-vnc" "127.0.0.1:${1:-1},websocket=off")
                ;;
            --image)
                shift
                image="$1"
                ;;
            --iso)
                shift
                iso="$1"
                ;;
            --mem)
                shift
                mem="$1"
                ;;
            --smp)
                shift
                smp="$1"
                ;;
            -h|--help)
                usage
                return 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    if [[ ! -f "$image" ]]; then
        echo "Error: VM disk image not found at $image" >&2
        return 1
    fi

    if [[ ! -f "$iso" ]]; then
        mkdir -p /tmp/ctb-empty-iso
        genisoimage -J -r -o "$iso" /tmp/ctb-empty-iso >/dev/null 2>&1 || true
        remove_if_exists /tmp/ctb-empty-iso
    fi

    remove_if_exists "$MONITOR_SOCK" "$VNC_SOCK" "$PID_FILE"

    echo "Starting Windows 7 VM..."
    echo "  Image:    $image"
    echo "  ISO:      $iso"
    echo "  Memory:   ${mem}MB | SMP: $smp"
    echo "  Snapshot: $(if [[ -n "$snapshot_flag" ]]; then echo "Enabled (read-only mode)"; else echo "Disabled (writes persist)"; fi)"
    echo "  Network:  $(if [[ ${#net_flags[@]} -gt 0 ]]; then echo "Isolated loopback port-forward (restrict=on)"; else echo "Air-gapped (no NIC)"; fi)"

    local qemu_cmd=(
        qemu-system-x86_64
        -nodefaults
        -M pc
        -cpu max
        -m "$mem"
        -smp "$smp,cores=$smp,sockets=1"
        -device ahci,id=ahci0
        -drive "file=$image,if=none,id=drive0,format=qcow2"
        -device ide-hd,bus=ahci0.0,drive=drive0
        -drive "file=$iso,if=none,id=cdrom0,media=cdrom,readonly=on"
        -device ide-cd,bus=ahci0.1,drive=cdrom0
        -serial "file:$SERIAL_LOG"
        -vga std
        -usb -device usb-tablet
        "${vnc_args[@]}"
        -monitor "unix:$MONITOR_SOCK,server,nowait"
        -pidfile "$PID_FILE"
        -daemonize
    )

    if [[ -n "$snapshot_flag" ]]; then
        qemu_cmd+=("$snapshot_flag")
    fi

    if [[ ${#net_flags[@]} -gt 0 ]]; then
        qemu_cmd+=("${net_flags[@]}")
    fi

    "${qemu_cmd[@]}"
    sleep 1

    if is_running; then
        echo "VM successfully started (PID: $(cat "$PID_FILE"))."
    else
        echo "Failed to start VM. Check logs or permissions." >&2
        return 1
    fi
}

cmd_stop() {
    if ! is_running; then
        echo "VM is not running."
        remove_if_exists "$PID_FILE" "$MONITOR_SOCK" "$VNC_SOCK"
        return 0
    fi

    local force="false"
    if [[ "${1:-}" == "--force" ]]; then
        force="true"
    fi

    local pid
    pid="$(cat "$PID_FILE")"

    if [[ "$force" == "true" ]]; then
        echo "Terminating VM (PID $pid)..."
        kill -9 "$pid" 2>/dev/null || true
    else
        echo "Sending ACPI shutdown to VM (PID $pid)..."
        cmd_monitor "system_powerdown" >/dev/null 2>&1 || kill -15 "$pid" 2>/dev/null || true
        for _ in $(seq 1 15); do
            if ! kill -0 "$pid" 2>/dev/null; then
                break
            fi
            sleep 1
        done
        if kill -0 "$pid" 2>/dev/null; then
            echo "VM did not shut down gracefully; stopping forcefully..."
            kill -9 "$pid" 2>/dev/null || true
            while kill -0 "$pid" 2>/dev/null; do
                sleep 0.2
            done
            sleep 1
        fi
    fi

    remove_if_exists "$PID_FILE" "$MONITOR_SOCK" "$VNC_SOCK"
    echo "VM stopped."
}

cmd_status() {
    if is_running; then
        local pid
        pid="$(cat "$PID_FILE")"
        echo "VM is running (PID: $pid)"
        ps -o pid,user,%cpu,%mem,rss,cmd -p "$pid"
    else
        echo "VM is not running."
    fi
}

cmd_monitor() {
    local cmd="$*"
    if [[ ! -S "$MONITOR_SOCK" ]]; then
        echo "Error: Monitor socket $MONITOR_SOCK not found or VM not running." >&2
        return 1
    fi
    python3 -c "
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect('$MONITOR_SOCK')
s.recv(1024)
s.sendall(sys.argv[1].encode() + b'\n')
import time; time.sleep(0.3)
print(s.recv(4096).decode(errors='replace').strip())
s.close()
" "$cmd"
}

cmd_screenshot() {
    local out_path="${1:-/tmp/win7-screen.png}"
    local tmp_ppm="/tmp/win7-screen-tmp-$$.ppm"

    if [[ ! -S "$MONITOR_SOCK" ]]; then
        echo "Error: Monitor socket not found or VM not running." >&2
        return 1
    fi

    cmd_monitor "screendump $tmp_ppm" >/dev/null
    sleep 0.5

    if [[ -f "$tmp_ppm" ]]; then
        ffmpeg -y -i "$tmp_ppm" "$out_path" 2>/dev/null || convert "$tmp_ppm" "$out_path"
        remove_if_exists "$tmp_ppm"
        echo "Screenshot saved to $out_path"
    else
        echo "Error: Failed to capture screen dump." >&2
        return 1
    fi
}

cmd_send_keys() {
    for key in "$@"; do
        cmd_monitor "sendkey $key" >/dev/null
        sleep 0.2
    done
}

cmd_type() {
    local text="$*"
    if [[ ! -S "$MONITOR_SOCK" ]]; then
        echo "Error: Monitor socket not found or VM not running." >&2
        return 1
    fi
    python3 -c "
import socket, sys, time

monitor_sock = '$MONITOR_SOCK'
text = sys.argv[1]

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(monitor_sock)
s.recv(1024)

def send(key):
    s.sendall(f'sendkey {key}\n'.encode())
    time.sleep(0.04)

key_map = {
    ':': 'shift-semicolon',
    ';': 'semicolon',
    '\\\\': 'backslash',
    '/': 'slash',
    '.': 'dot',
    ',': 'comma',
    '-': 'minus',
    '_': 'shift-minus',
    '=': 'equal',
    '+': 'shift-equal',
    ' ': 'spc',
    '>': 'shift-dot',
    '<': 'shift-comma',
    '*': 'shift-8',
    '\"': 'shift-apostrophe',
    \"'\": 'apostrophe',
    '|': 'shift-backslash',
    '[': 'bracket_left',
    ']': 'bracket_right',
    '{': 'shift-bracket_left',
    '}': 'shift-bracket_right',
    '(': 'shift-9',
    ')': 'shift-0',
    '&': 'shift-7',
    '%': 'shift-5',
    '$': 'shift-4',
    '#': 'shift-3',
    '@': 'shift-2',
    '!': 'shift-1',
    '?': 'shift-slash',
    '~': 'shift-grave_accent',
    '\`': 'grave_accent',
    '\n': 'ret',
}

for ch in text:
    if ch in key_map:
        send(key_map[ch])
    elif ch.isupper():
        send(f'shift-{ch.lower()}')
    elif ch.isdigit() or ch.islower():
        send(ch)
    else:
        send(ch)

s.close()
" "$text"
}

cmd_snapshot() {
    local subcmd="${1:-list}"
    shift || true

    local image="$DEFAULT_IMAGE"

    case "$subcmd" in
        list)
            qemu-img snapshot -l "$image"
            ;;
        create)
            local name="${1:-}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./scripts/win-vm snapshot create <name>" >&2
                return 1
            fi
            if is_running; then
                echo "VM is currently running. Creating live snapshot '$name'..."
                cmd_monitor "savevm $name"
            else
                echo "Creating disk snapshot '$name' on $image..."
                qemu-img snapshot -c "$name" "$image"
            fi
            echo "Snapshot '$name' created."
            ;;
        revert)
            local name="${1:-}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./scripts/win-vm snapshot revert <name>" >&2
                return 1
            fi
            if is_running; then
                echo "Stopping VM before reverting snapshot..."
                cmd_stop
            fi
            echo "Reverting $image to snapshot '$name'..."
            qemu-img snapshot -a "$name" "$image"
            echo "Successfully reverted to snapshot '$name'."
            ;;
        delete)
            local name="${1:-}"
            if [[ -z "$name" ]]; then
                echo "Usage: ./scripts/win-vm snapshot delete <name>" >&2
                return 1
            fi
            echo "Deleting snapshot '$name' from $image..."
            qemu-img snapshot -d "$name" "$image"
            echo "Snapshot '$name' deleted."
            ;;
        *)
            echo "Unknown snapshot subcommand: $subcmd" >&2
            echo "Supported: list, create, revert, delete" >&2
            return 1
            ;;
    esac
}

cmd_sync_binaries() {
    mkdir -p "$EXCHANGE_DIR"

    local ctb_bin="target/x86_64-win7-windows-gnu/release/ctoolbox.exe"
    if [[ ! -f "$ctb_bin" ]]; then
        ctb_bin="target/x86_64-win7-windows-gnu/debug/ctoolbox.exe"
    fi
    if [[ -f "$ctb_bin" ]]; then
        cp "$ctb_bin" "$EXCHANGE_DIR/ctoolbox.exe"
    fi

    local installer_bin="target/x86_64-win7-windows-gnu/release/ctoolbox-installer.exe"
    if [[ ! -f "$installer_bin" ]]; then
        installer_bin="target/x86_64-win7-windows-gnu/debug/ctoolbox-installer.exe"
    fi
    if [[ -f "$installer_bin" ]]; then
        cp "$installer_bin" "$EXCHANGE_DIR/ctoolbox-installer.exe"
    fi

    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 1.5
    fi
    echo "Synchronized binaries to $EXCHANGE_ISO."
}

cmd_run() {
    if ! is_running; then
        echo "VM is not running. Starting VM..."
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    local user_cmd="$*"
    if [[ -z "$user_cmd" ]]; then
        echo "Usage: ./scripts/win-vm run <command...>" >&2
        return 1
    fi

    mkdir -p "$EXCHANGE_DIR"
    cat <<EOF > "$EXCHANGE_DIR/run.bat"
@echo off
set "TEST_DRIVE=%~dp0"
if "%CTB_WIN_TEST_ROOT%"=="" set "CTB_WIN_TEST_ROOT=%TEST_DRIVE%"
set "PATH=%CTB_WIN_TEST_ROOT%;%PATH%"
cd /d "%TEMP%"
echo ---CTB_START--- > COM1
$user_cmd >> COM1 2>&1
echo. >> COM1
echo ---CTB_EXIT:%ERRORLEVEL%--- >> COM1
EOF

    cmd_sync_binaries

    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    # Dismiss any stray dialogs or AutoPlay popups before invoking Run
    cmd_send_keys "esc"
    sleep 0.5

    cmd_send_keys "ctrl-esc"
    sleep 1.2
    cmd_type "cmd /c for %d in (D E F G) do @if exist %d:\\run.bat %d:\\run.bat"
    sleep 0.8
    cmd_send_keys "ret"

    python3 -c "
import sys, time

log_path = '$SERIAL_LOG'
start_offset = int(sys.argv[1])
timeout = 180

start_time = time.time()
started = False
exit_code = None

with open(log_path, 'r', errors='replace') as f:
    f.seek(start_offset)
    while True:
        line = f.readline()
        if line:
            clean_line = line.strip()
            if '---CTB_START---' in clean_line:
                started = True
                continue
            if '---CTB_EXIT:' in clean_line:
                part = clean_line.split('---CTB_EXIT:')[1].split('---')[0]
                try:
                    exit_code = int(part)
                except ValueError:
                    exit_code = 1
                break
            if started:
                sys.stdout.write(line)
                sys.stdout.flush()
        else:
            if time.time() - start_time > timeout:
                sys.stderr.write('Timeout waiting for command to finish in VM.\n')
                sys.exit(124)
            time.sleep(0.2)

sys.exit(exit_code if exit_code is not None else 1)
" "$start_offset"
}

cmd_test() {
    local reset="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reset)
                reset="true"
                ;;
            *)
                ;;
        esac
        shift
    done

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    if ! is_running; then
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    echo "=== Running Windows Smoke Tests in VM ==="
    echo "1. Testing ctoolbox-installer.exe --version..."
    cmd_run "ctoolbox-installer.exe --version"
    echo ""
    echo "2. Testing ctoolbox-installer.exe --help..."
    cmd_run "ctoolbox-installer.exe --help"
    echo ""
    if [[ -f "target/x86_64-win7-windows-gnu/release/ctoolbox.exe" || -f "target/x86_64-win7-windows-gnu/debug/ctoolbox.exe" ]]; then
        echo "3. Testing ctoolbox.exe --version..."
        cmd_run "ctoolbox.exe --version"
        echo ""
        echo "4. Testing ctoolbox.exe --help..."
        cmd_run "ctoolbox.exe --help"
        echo ""
    fi
    echo "=== Windows VM Tests Completed Successfully ==="
}

cmd_test_suite() {
    local reset="false"
    local crate_filter=""
    local test_filter=""
    local no_build="false"
    local timeout="14400"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --reset)
                reset="true"
                ;;
            --crate)
                shift
                crate_filter="${1:-}"
                ;;
            --filter)
                shift
                test_filter="${1:-}"
                ;;
            --no-build)
                no_build="true"
                ;;
            --timeout)
                shift
                timeout="${1:-14400}"
                ;;
            *)
                echo "Unknown option for test-suite: $1" >&2
                return 1
                ;;
        esac
        shift
    done

    trap 'if is_running; then cmd_stop; fi' EXIT INT TERM

    if [[ "$reset" == "true" ]]; then
        if is_running; then
            cmd_stop
        fi
        cmd_snapshot revert "base-state"
    fi

    if ! is_running; then
        cmd_start
        echo "Waiting for VM to reach desktop..."
        sleep 25
    fi

    local target="x86_64-win7-windows-gnu"
    local shim_obj="$REPO_ROOT/target/$target/combase_shim.o"

    if [[ "$no_build" != "true" ]]; then
        echo "=== Compiling Windows 7 Compatibility Shim ==="
        mkdir -p "$REPO_ROOT/target/$target"
        x86_64-w64-mingw32-gcc -Wall -Wextra -Wno-attributes -O2 -c \
            src/build_support/windows/combase_shim.c -o "$shim_obj"

        echo "=== Compiling Test Binaries for $target ==="
        export RUSTC_BOOTSTRAP=1
        export CTB_HOST_WORKSPACE_ROOT="$REPO_ROOT"
        local rustflags="${RUSTFLAGS-} -C link-arg=-fuse-ld=lld -C link-arg=-Wl,--allow-multiple-definition -C link-arg=$shim_obj"

        local cargo_args=(test --no-run --target "$target" -Z "build-std=std,panic_abort" --jobs 4)
        if [[ -n "$crate_filter" ]]; then
            cargo_args+=(-p "$crate_filter")
        else
            cargo_args+=(--workspace --exclude ctb-nopersonality --exclude yaxi --exclude ctb-workspace-x11-client --exclude ctb-workspace-x11-client-egui)
        fi

        RUSTFLAGS="$rustflags" cargo "${cargo_args[@]}"
    fi

    echo "=== Packaging Tests and Fixtures for VM Exchange ==="
    remove_if_exists "$EXCHANGE_DIR"
    mkdir -p "$EXCHANGE_DIR/tests"

    local binary_count=0
    binary_count=$(python3 -c "
import glob, os, re, shutil, subprocess, sys

target = '$target'
crate_filter = '$crate_filter'
crate_prefix = crate_filter.replace('-', '_') if crate_filter else None
exchange_dir = '$EXCHANGE_DIR/tests'

fingerprints = glob.glob(f'target/{target}/debug/.fingerprint/*')
test_hashes = set()
for fp in fingerprints:
    m = re.search(r'-([0-9a-f]{16})$', fp)
    if not m:
        continue
    h = m.group(1)
    for fname in os.listdir(fp):
        if fname.startswith('test-') and not fname.endswith('.json'):
            test_hashes.add(h)
            break

import concurrent.futures

all_exes = glob.glob(f'target/{target}/debug/deps/*.exe')

def process_exe(exe):
    bname = os.path.basename(exe)
    if crate_prefix and not bname.startswith(f'{crate_prefix}-'):
        return False
    m = re.search(r'-([0-9a-f]{16})\.exe$', bname)
    if not m or m.group(1) not in test_hashes:
        return False
    dest = os.path.join(exchange_dir, bname)
    shutil.copyfile(exe, dest)
    shutil.copymode(exe, dest)
    subprocess.run(['x86_64-w64-mingw32-strip', dest], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True

with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
    count = sum(1 for ok in executor.map(process_exe, sorted(all_exes)) if ok)

print(count)
")

    if [[ "$binary_count" -eq 0 ]]; then
        echo "No test binaries found in target/$target/debug/deps/!" >&2
        return 1
    fi

    echo "Packaging repository fixtures..."
    find src -type d -name "fixtures" -print0 | tar --null -cf - --files-from=- | (cd "$EXCHANGE_DIR" && tar -xf -)

    echo "Packaging workspace markers, dcdata, and kaitai fixtures..."
    touch "$EXCHANGE_DIR/.ctoolbox_workspace_root"
    cp "$REPO_ROOT/Cargo.toml" "$EXCHANGE_DIR/Cargo.toml"
    mkdir -p "$EXCHANGE_DIR/src/formats/dcdata"
    cp -r "$REPO_ROOT/src/formats/dcdata/data" "$EXCHANGE_DIR/src/formats/dcdata/"
    mkdir -p "$EXCHANGE_DIR/src/formats/kaitai"
    cp -r "$REPO_ROOT/src/formats/kaitai/kaitai_struct_tests" "$EXCHANGE_DIR/src/formats/kaitai/"
    mkdir -p "$EXCHANGE_DIR/scripts/guix"
    cp -r "$REPO_ROOT/scripts/guix/patches" "$EXCHANGE_DIR/scripts/guix/"
    mkdir -p "$EXCHANGE_DIR/src/storage/minimal" "$EXCHANGE_DIR/storage/minimal"
    cp -r "$REPO_ROOT/src/storage/minimal/data" "$EXCHANGE_DIR/src/storage/minimal/"
    cp -r "$REPO_ROOT/src/storage/minimal/data" "$EXCHANGE_DIR/storage/minimal/"
    mkdir -p "$EXCHANGE_DIR/src/utilities"
    cp "$REPO_ROOT/src/utilities/format_id.generated.rs" "$EXCHANGE_DIR/src/utilities/"

    if [[ -f "$REPO_ROOT/built/ctoolbox.rsrc" ]]; then
        echo "Packaging runtime resource bundle (built/ctoolbox.rsrc)..."
        mkdir -p "$EXCHANGE_DIR/built" "$EXCHANGE_DIR/tests"
        cp "$REPO_ROOT/built/ctoolbox.rsrc" "$EXCHANGE_DIR/built/ctoolbox.rsrc"
        cp "$REPO_ROOT/built/ctoolbox.rsrc" "$EXCHANGE_DIR/tests/ctoolbox.rsrc"
        cp "$REPO_ROOT/built/ctoolbox.rsrc" "$EXCHANGE_DIR/ctoolbox.rsrc"
    fi

    if [[ -d "$REPO_ROOT/vendor/v86/gen" ]]; then
        echo "Packaging vendor/v86/gen for v86 tests..."
        mkdir -p "$EXCHANGE_DIR/vendor/v86"
        cp -r "$REPO_ROOT/vendor/v86/gen" "$EXCHANGE_DIR/vendor/v86/"
    fi

    echo "Generating in-VM test runner scripts..."
    local filter_arg=""
    if [[ -n "$test_filter" ]]; then
        filter_arg="$test_filter "
    fi

    cat <<EOF > "$EXCHANGE_DIR/run_js.bat"
@echo off
"%~1" ${filter_arg}--nocapture --test-threads 2 > "%TEMP%\js_test.log" 2>&1
echo %ERRORLEVEL% > "%TEMP%\js_test.done"
EOF

    cat <<EOF > "$EXCHANGE_DIR/run_suite.bat"
@echo off
setlocal enabledelayedexpansion
set "TEST_DRIVE=%~dp0"
if "%CTB_WIN_TEST_ROOT%"=="" set "CTB_WIN_TEST_ROOT=%TEST_DRIVE%"
set "PATH=%CTB_WIN_TEST_ROOT%;%PATH%"
mkdir "C:\workspaces" >nul 2>&1
rmdir "C:\workspaces\ctoolbox" >nul 2>&1
mklink /J "C:\workspaces\ctoolbox" "%CTB_WIN_TEST_ROOT%" >nul 2>&1
cd /d "%TEMP%"
reg add "HKCU\Software\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Policies\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKCU\Software\Policies\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting" /v Disabled /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting" /v DontShowUI /t REG_DWORD /d 1 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Windows" /v ErrorMode /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer" /v "NoDriveTypeAutoRun" /t REG_DWORD /d 255 /f >nul 2>&1

:: Disable Windows Firewall to prevent interactive popups blocking network tests
netsh advfirewall set allprofiles state off >nul 2>&1

:: Background watchdog to kill any WerFault crash dialogs immediately
echo 1 > "%TEMP%\watchdog.run"
start /B cmd /c "for /L %%i in () do (if not exist "%TEMP%\watchdog.run" exit & taskkill /F /IM WerFault.exe /IM WerFaultSecure.exe >nul 2>&1 & ping -n 2 127.0.0.1 >nul)"

:: Look for ctb_formats_javascript to run in parallel in the background
set "JS_EXE="
set "JS_NAME="
for %%J in ("%CTB_WIN_TEST_ROOT%tests\ctb_formats_javascript-*.exe") do (
    set "JS_EXE=%%J"
    set "JS_NAME=%%~nJ"
)

if defined JS_EXE (
    del /f /q "%TEMP%\js_test.done" "%TEMP%\js_test.log" >nul 2>&1
    echo === SPAWNING BACKGROUND !JS_NAME! === >> COM1
    start "ctb_formats_javascript" /B cmd /c "%CTB_WIN_TEST_ROOT%run_js.bat" "!JS_EXE!"
)

echo ---SUITE_START--- > COM1
set TOTAL=0
set PASSED=0
set FAILED=0

for %%F in ("%CTB_WIN_TEST_ROOT%tests\*.exe") do (
    if "%%~nF" NEQ "!JS_NAME!" (
        set /a TOTAL+=1
        echo === RUN %%~nF === >> COM1
        "%%F" $test_filter --nocapture --test-threads 3 >> COM1 2>&1
        if !ERRORLEVEL! EQU 0 (
            set /a PASSED+=1
            echo === PASS %%~nF === >> COM1
        ) else (
            set /a FAILED+=1
            echo === FAIL %%~nF [EXIT:!ERRORLEVEL!] === >> COM1
        )
        echo. >> COM1
    )
)

if defined JS_EXE (
    echo === AWAITING BACKGROUND !JS_NAME! === >> COM1
    :wait_js
    if not exist "%TEMP%\js_test.done" (
        ping -n 15 127.0.0.1 >nul
        echo [Waiting for !JS_NAME! to complete...] >> COM1
        goto wait_js
    )
    set /p JS_EXIT=<"%TEMP%\js_test.done"
    set /a TOTAL+=1
    echo === RUN !JS_NAME! === >> COM1
    type "%TEMP%\js_test.log" >> COM1
    echo. >> COM1
    if "!JS_EXIT!" EQU "0" (
        set /a PASSED+=1
        echo === PASS !JS_NAME! === >> COM1
    ) else (
        set /a FAILED+=1
        echo === FAIL !JS_NAME! [EXIT:!JS_EXIT!] === >> COM1
    )
    echo. >> COM1
)

del /f /q "%TEMP%\watchdog.run" >nul 2>&1
del /f /q "%TEMP%\js_test.done" >nul 2>&1
del /f /q "%TEMP%\js_test.log" >nul 2>&1
echo ---SUITE_END:TOTAL=!TOTAL!,PASSED=!PASSED!,FAILED=!FAILED!--- >> COM1
EOF

    echo "Creating exchange ISO with $binary_count test binaries and fixtures..."
    genisoimage -iso-level 3 -J -joliet-long -r -o "$EXCHANGE_ISO" "$EXCHANGE_DIR" >/dev/null 2>&1

    if is_running; then
        cmd_monitor "eject -f cdrom0" >/dev/null 2>&1 || true
        sleep 0.5
        cmd_monitor "change cdrom0 $EXCHANGE_ISO raw" >/dev/null 2>&1 || true
        sleep 3.0
    fi

    echo "=== Executing Test Suite in Windows 7 VM ==="
    local start_offset=0
    if [[ -f "$SERIAL_LOG" ]]; then
        start_offset=$(stat -c%s "$SERIAL_LOG")
    else
        touch "$SERIAL_LOG"
    fi

    cmd_send_keys "esc"
    sleep 0.5
    cmd_send_keys "esc"
    sleep 0.5
    cmd_send_keys "ctrl-esc"
    sleep 1.5
    cmd_type "cmd /c for %d in (D E F G) do @if exist %d:\\run_suite.bat %d:\\run_suite.bat"
    sleep 1.0
    cmd_send_keys "ret"

    python3 -c "
import sys, time, re

log_path = sys.argv[1]
start_offset = int(sys.argv[2])
timeout = int(sys.argv[3])

start_time = time.time()
last_output_time = start_time
last_heartbeat_time = start_time
started = False
suite_total = 0
suite_passed = 0
suite_failed = 0
failing_binaries = []
passing_binaries = []
current_binary = ''

with open(log_path, 'r', errors='replace') as f:
    f.seek(start_offset)
    while True:
        line = f.readline()
        if line:
            last_output_time = time.time()
            clean = line.strip()
            if '---SUITE_START---' in clean:
                started = True
                print('>>> Windows 7 VM Test Suite Started <<<', flush=True)
                continue
            if '---SUITE_END:' in clean:
                m = re.search(r'TOTAL=(\d+),PASSED=(\d+),FAILED=(\d+)', clean)
                if m:
                    suite_total = int(m.group(1))
                    suite_passed = int(m.group(2))
                    suite_failed = int(m.group(3))
                break
            if started:
                m_run = re.search(r'=== RUN (\S+) ===', clean)
                if m_run:
                    current_binary = m_run.group(1)
                m_pass = re.search(r'=== PASS (\S+) ===', clean)
                if m_pass:
                    passing_binaries.append(m_pass.group(1))
                m_fail = re.search(r'=== FAIL (\S+)(?: \[EXIT:(-?\d+)\])?', clean)
                if m_fail:
                    failing_binaries.append((m_fail.group(1), m_fail.group(2) or 'unknown'))

                sys.stdout.write(line)
                sys.stdout.flush()
        else:
            now = time.time()
            if now - start_time > timeout:
                sys.stderr.write(f'\n[TIMEOUT] Test suite exceeded {timeout} seconds in VM.\n')
                sys.exit(124)
            if started and now - last_heartbeat_time >= 30:
                elapsed_min = int((now - start_time) / 60)
                elapsed_sec = int((now - start_time) % 60)
                silence_sec = int(now - last_output_time)
                print(f'[Heartbeat {elapsed_min:02d}:{elapsed_sec:02d}] Active: {current_binary} (no output for {silence_sec}s | passed: {len(passing_binaries)}, failed: {len(failing_binaries)})', flush=True)
                last_heartbeat_time = now
            time.sleep(0.2)

print('\n' + '=' * 60)
print('             WINDOWS 7 VM TEST SUITE SUMMARY')
print('=' * 60)
if failing_binaries:
    print(f'FAILED TEST BINARIES ({len(failing_binaries)}):')
    for name, code in failing_binaries:
        print(f'  [X] {name} (exit code: {code})')
else:
    print('NO TEST FAILURES DETECTED!')

print(f'PASSED TEST BINARIES: {len(passing_binaries)}')
print(f'TOTAL: {suite_total} | PASSED: {suite_passed} | FAILED: {suite_failed}')
print('=' * 60)

sys.exit(0 if suite_failed == 0 and len(failing_binaries) == 0 else 1)
" "$SERIAL_LOG" "$start_offset" "$timeout" || py_exit=$?

    trap - EXIT INT TERM
    if is_running; then
        echo "Stopping Windows VM..."
        cmd_stop
    fi
    return ${py_exit:-0}
}

action="${1:-}"
shift || true

case "$action" in
    start)
        cmd_start "$@"
        ;;
    stop)
        cmd_stop "$@"
        ;;
    status)
        cmd_status
        ;;
    screenshot)
        cmd_screenshot "$@"
        ;;
    send-keys)
        cmd_send_keys "$@"
        ;;
    type)
        cmd_type "$@"
        ;;
    monitor)
        cmd_monitor "$@"
        ;;
    snapshot)
        cmd_snapshot "$@"
        ;;
    sync-binaries)
        cmd_sync_binaries
        ;;
    run)
        cmd_run "$@"
        ;;
    test)
        cmd_test "$@"
        ;;
    test-suite)
        cmd_test_suite "$@"
        ;;
    *)
        usage
        exit 1
        ;;
esac
