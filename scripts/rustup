# For some reason rustup seems to lose my targets every time I update.
set -euo pipefail

export PATH="${HOME}/.cargo/bin:${PATH}"

required_rust_version="1.92"
targets=(
    x86_64-pc-windows-gnu
    x86_64-unknown-linux-musl
    i586-unknown-linux-musl
    wasm32-unknown-unknown
)
components=(
    rust-analyzer
    rust-src
)

if ! command -v rustc >/dev/null 2>&1 || ! rustc --version | grep -q " ${required_rust_version}\."; then
    echo "Rust ${required_rust_version} not found or version mismatch. Setting up Rust ${required_rust_version}..."
    if ! command -v rustup >/dev/null 2>&1; then
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${required_rust_version}"
        export PATH="${HOME}/.cargo/bin:${PATH}"
    else
        rustup default "${required_rust_version}"
    fi
    echo "Adding targets..."
    for target in "${targets[@]}"; do
        rustup target add "$target"
    done
    echo "Adding components..."
    for component in "${components[@]}"; do
        rustup component add "$component"
    done
else
    echo "Rust ${required_rust_version} is already installed, checking targets..."
    installed_targets="$(rustup target list --installed 2>/dev/null || true)"
    for target in "${targets[@]}"; do
        if ! echo "$installed_targets" | grep -q "^$target$"; then
            echo "Adding missing target $target..."
            rustup target add "$target"
        fi
    done

    echo "Checking components..."
    installed_components="$(rustup component list --installed 2>/dev/null || true)"
    for component in "${components[@]}"; do
        if ! echo "$installed_components" | grep -q "^$component"; then
            echo "Adding missing component $component..."
            rustup component add "$component"
        fi
    done
fi

if ! command -v cargo-deny >/dev/null 2>&1; then
    echo "Installing cargo-deny..."
    cargo install --locked cargo-deny
else
    echo "cargo-deny is already installed, skipping..."
fi
