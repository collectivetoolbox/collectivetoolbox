#!/usr/bin/env bash

set -euo pipefail

# 1. Clear previous instances
docker buildx rm buildkit >/dev/null 2>&1 || true

# 2. Create the builder with host networking allowed for the daemon container itself
docker buildx create --bootstrap --use --name buildkit \
  --driver-opt network=host \
  --buildkitd-flags '--allow-insecure-entitlement network.host' \
  --driver-opt env.BUILDKIT_STEP_LOG_MAX_SIZE=-1 \
  --driver-opt env.BUILDKIT_STEP_LOG_MAX_SPEED=-1

# 3. Execute your build
docker buildx build -f scripts/docker/Dockerfile . \
  --network=host \
  --allow network.host \
  --load \
  --progress plain
