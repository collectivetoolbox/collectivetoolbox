#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

recreate_builder=false
clean_cache=false
cache_dir="${CTOOLBOX_DOCKER_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ctoolbox-docker-cache}"

dockerfile="scripts/docker/Dockerfile"
image_tag=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --recreate|--clean|--reset)
      recreate_builder=true
      shift
      ;;
    --clean-cache|--reset-cache)
      clean_cache=true
      shift
      ;;
    --use-built|--small)
      dockerfile="scripts/docker/Dockerfile-use-built"
      shift
      ;;
    --full)
      dockerfile="scripts/docker/Dockerfile"
      shift
      ;;
    -t|--tag)
      if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires an argument" >&2
        exit 1
      fi
      image_tag="$2"
      shift 2
      ;;
    -f|--file)
      if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires an argument" >&2
        exit 1
      fi
      dockerfile="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: $0 [--recreate] [--clean-cache] [--use-built|--small] [--full] [-t <tag>] [-f <dockerfile>]"
      echo "Options:"
      echo "  --recreate, --clean, --reset  Remove and recreate the buildkit builder"
      echo "  --clean-cache, --reset-cache  Clear host cache directory ($cache_dir)"
      echo "  --use-built, --small          Build small Docker image using prebuilt bundles (Dockerfile-use-built)"
      echo "  --full                        Build full Docker image from scratch (Dockerfile)"
      echo "  -t, --tag <tag>               Tag the resulting image"
      echo "  -f, --file <dockerfile>       Specify a custom Dockerfile"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [ "$recreate_builder" = true ] && docker buildx inspect buildkit >/dev/null 2>&1; then
  echo "Removing existing buildkit builder..."
  docker buildx rm buildkit >/dev/null 2>&1
fi

if [ "$clean_cache" = true ] && [ -d "$cache_dir" ]; then
  echo "Clearing host docker build cache..."
  rm -r "$cache_dir"
fi

if [ ! -d "$cache_dir" ]; then
  mkdir -p "$cache_dir"
fi

if docker buildx inspect buildkit >/dev/null 2>&1; then
  echo "Reusing existing buildkit builder..."
  docker buildx use buildkit
else
  echo "Creating buildkit builder..."
  docker buildx create --use --name buildkit \
    --config "$script_dir/docker/buildkitd.toml" \
    --driver-opt network=host \
    --buildkitd-flags '--allow-insecure-entitlement network.host --allow-insecure-entitlement security.insecure' \
    --driver-opt env.BUILDKIT_STEP_LOG_MAX_SIZE=-1 \
    --driver-opt env.BUILDKIT_STEP_LOG_MAX_SPEED=-1

  docker buildx inspect --bootstrap buildkit
fi

if [ "$dockerfile" = "scripts/docker/Dockerfile-use-built" ]; then
  if [ ! -f "vendor/TypeScript-built.tar" ]; then
    echo "vendor/TypeScript-built.tar not found. Prebuilding..."
    cargo run -p ctb-formats-javascript-bootstrap-ts --bin bootstrap_ts --release -- ./vendor/TypeScript
  fi
  if [ ! -f "vendor/v86_images/guix/guix-fs.json" ] || [ ! -d "vendor/v86_images/guix/guix-rootfs-flat" ]; then
    echo "Error: vendor/v86_images/guix assets not found." >&2
    echo "Please extract them first using ./scripts/extract-v86-images <builder-tag>" >&2
    exit 1
  fi
  if [ ! -f "vendor/v86_images/guix/guix_posix_initrd.cpio.gz" ]; then
    if [ -f "built/guix_posix_initrd.cpio.gz" ]; then
      cp built/guix_posix_initrd.cpio.gz vendor/v86_images/guix/guix_posix_initrd.cpio.gz
    else
      echo "Error: vendor/v86_images/guix/guix_posix_initrd.cpio.gz not found." >&2
      exit 1
    fi
  fi
fi

# Execute build
echo "Building Docker image using $dockerfile..."
docker buildx build -f "$dockerfile" . \
  --network=host \
  --allow network.host \
  --allow security.insecure \
  --cache-from "type=local,src=$cache_dir" \
  ${image_tag:+-t "$image_tag"} \
  --load \
  --progress plain

  # --cache-to "type=local,dest=$cache_dir,mode=max" \