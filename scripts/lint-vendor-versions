#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

offline=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --offline)
            offline="--offline"
            ;;
    esac
    shift
done

cargo run \
    --quiet \
    --manifest-path "${REPO_ROOT}/src/build_support/Cargo.toml" \
    --bin lint-vendor-versions \
    -- ${offline} "${REPO_ROOT}"
