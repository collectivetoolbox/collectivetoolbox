set -euo pipefail

cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

# Usage: ./scripts/generate-kaitai-tests [--clean-old] [--force]
# Regenerate Kaitai Struct tests to meet ctoolbox repository standards (.generated.rs, #[crate::ctb_test])

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

cargo run \
    --manifest-path "${REPO_ROOT}/src/formats/kaitai/Cargo.toml" \
    --bin generate-kaitai-tests \
    -- "$@"
