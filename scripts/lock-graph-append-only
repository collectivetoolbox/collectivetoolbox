set -euo pipefail
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1
REPO_ROOT="$(pwd)"
GRAPH_DIR="${REPO_ROOT}/assets/data/graph"
CANARY_FILE="${REPO_ROOT}/src/formats/dcdata/data-src/nodes/ledger.lock"
HELPER_IMAGE="ghcr.io/collectivetoolbox/collectivetoolbox-2026-sept-5-2"
WATCHER_CONTAINER_NAME="ctb-graph-append-only-watcher"

# Self-contained Python script executed inside the helper container (which has CAP_LINUX_IMMUTABLE).
# Uses Linux kernel ioctl FS_IOC_GETFLAGS (0x80086601) and FS_IOC_SETFLAGS (0x40086602) directly
# and verifies every flag readback, failing loudly on any error.
read -r -d '' PYTHON_LOCK_SCRIPT << 'PYEOF' || true
import fcntl
import glob
import os
import struct
import sys
import time

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010
FS_APPEND_FL = 0x00000020

def get_flags(path: str) -> int:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("L", 0))
        return struct.unpack("L", buf)[0]
    finally:
        os.close(fd)

def set_exact_lock_flags(path: str, want_immutable: bool, want_append: bool) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("L", 0))
        cur = struct.unpack("L", buf)[0]
        target = cur & ~(FS_IMMUTABLE_FL | FS_APPEND_FL)
        if want_immutable:
            target |= FS_IMMUTABLE_FL
        if want_append:
            target |= FS_APPEND_FL
        if cur != target:
            # Clear both first if transitioning between +a and +i
            if (cur & (FS_IMMUTABLE_FL | FS_APPEND_FL)) and (target & (FS_IMMUTABLE_FL | FS_APPEND_FL)):
                cleared = cur & ~(FS_IMMUTABLE_FL | FS_APPEND_FL)
                fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("L", cleared))
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("L", target))
        verify_buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("L", 0))
        verified = struct.unpack("L", verify_buf)[0]
        if (verified & (FS_IMMUTABLE_FL | FS_APPEND_FL)) != (target & (FS_IMMUTABLE_FL | FS_APPEND_FL)):
            raise RuntimeError(
                f"Kernel flag verification failed for {path}: expected 0x{target:08x}, got 0x{verified:08x}"
            )
    finally:
        os.close(fd)

def is_journal_pending(journal_dir: str | None) -> bool:
    if not journal_dir:
        return False
    journal_path = os.path.join(journal_dir, "ledger-journal.jsonl")
    if not os.path.isfile(journal_path):
        return False
    try:
        with open(journal_path, "rb") as jf:
            raw = jf.read()
        if not raw:
            return False
        if not raw.endswith(b"\n"):
            return True
        lines = [ln for ln in raw.splitlines() if ln.strip()]
        if not lines:
            return False
        import json
        last_rec = json.loads(lines[-1].decode("utf-8"))
        return (
            last_rec.get("state") == "BATCH_PENDING"
            or last_rec.get("status") == "BATCH_PENDING"
        )
    except Exception:
        return True

def is_complete_100_line_chunk(path: str) -> bool:
    import re
    line_re = re.compile(rb"^l[0-9]+:( .*)?\n$")
    with open(path, "rb") as f:
        raw = f.read()
    if not raw.endswith(b"\n"):
        return False
    lines = raw.splitlines(keepends=True)
    if len(lines) != 100:
        return False
    return all(line_re.match(ln) is not None for ln in lines)

def cleanup_legacy_git_canary(git_dir: str | None) -> None:
    if not git_dir:
        return
    legacy_canary = os.path.join(git_dir, "ctb-append-only-canary")
    if os.path.isfile(legacy_canary):
        set_exact_lock_flags(legacy_canary, want_immutable=False, want_append=False)
        os.unlink(legacy_canary)

def lock_pass(
    graph_dir: str,
    canary_path: str,
    journal_dir: str | None = None,
    git_dir: str | None = None,
) -> tuple[int, int]:
    cleanup_legacy_git_canary(git_dir)
    if not os.path.isfile(canary_path):
        raise RuntimeError(f"Required lock inode does not exist: {canary_path}")
    lock_fd = os.open(canary_path, os.O_RDONLY)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return (0, 0)
        set_exact_lock_flags(canary_path, want_immutable=False, want_append=True)
        journal_pending = is_journal_pending(journal_dir)
        immutable_count = 0
        append_count = 0
        for path in sorted(glob.glob(os.path.join(graph_dir, "*.ctbnodes"))):
            if not journal_pending and is_complete_100_line_chunk(path):
                set_exact_lock_flags(path, want_immutable=True, want_append=False)
                immutable_count += 1
            else:
                set_exact_lock_flags(path, want_immutable=False, want_append=True)
                append_count += 1
        return immutable_count, append_count
    finally:
        os.close(lock_fd)

def unlock_pass(graph_dir: str, canary_path: str, git_dir: str | None = None) -> int:
    cleanup_legacy_git_canary(git_dir)
    unlocked = 0
    if os.path.isfile(canary_path):
        set_exact_lock_flags(canary_path, want_immutable=False, want_append=False)
        unlocked += 1
    for path in sorted(glob.glob(os.path.join(graph_dir, "*.ctbnodes"))):
        set_exact_lock_flags(path, want_immutable=False, want_append=False)
        unlocked += 1
    return unlocked

mode = sys.argv[1]
graph_dir = sys.argv[2]
canary_path = sys.argv[3]
journal_dir = sys.argv[4] if len(sys.argv) > 4 else None
git_dir = sys.argv[5] if len(sys.argv) > 5 else None

if mode == "lock-once":
    imm, app = lock_pass(graph_dir, canary_path, journal_dir, git_dir)
    print(f"Locked graph ledger: {imm} full chunk(s) set FS_IMMUTABLE_FL (+i), {app} active tail chunk(s) + canary set FS_APPEND_FL (+a).")
elif mode == "watch":
    while True:
        lock_pass(graph_dir, canary_path, journal_dir, git_dir)
        time.sleep(2.0)
elif mode == "unlock":
    count = unlock_pass(graph_dir, canary_path, git_dir)
    print(f"Unlocked {count} file(s) (cleared FS_IMMUTABLE_FL and FS_APPEND_FL).")
else:
    raise ValueError(f"Unknown mode: {mode}")
PYEOF

ensure_canary_file() {
    mkdir -p "${REPO_ROOT}/src/formats/dcdata/data-src/nodes/allocated"
    if [ ! -f "${CANARY_FILE}" ]; then
        printf "ctb-append-only-canary initialized\n" > "${CANARY_FILE}"
    fi
}

run_host_init() {
    if [ ! -d "${GRAPH_DIR}" ]; then
        echo "Error: Graph directory not found at ${GRAPH_DIR}" >&2
        exit 1
    fi
    ensure_canary_file

    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: docker CLI is required on the host to apply CAP_LINUX_IMMUTABLE without host root." >&2
        exit 1
    fi

    # 1. Synchronously apply and verify FS_IMMUTABLE_FL (+i) and FS_APPEND_FL (+a) via a one-shot helper container.
    docker run --rm \
        --network=none \
        --security-opt=no-new-privileges \
        --cap-add=LINUX_IMMUTABLE \
        -v "${GRAPH_DIR}:/graph" \
        -v "${CANARY_FILE}:/canary" \
        -v "${REPO_ROOT}/src/formats/dcdata/data-src/nodes/allocated:/journal-dir:ro" \
        -v "${REPO_ROOT}/.git:/git-dir" \
        "${HELPER_IMAGE}" \
        python3 -c "${PYTHON_LOCK_SCRIPT}" lock-once /graph /canary /journal-dir /git-dir

    # 2. Ensure the detached watcher container is running so newly created .ctbnodes chunks are automatically locked.
    if docker ps -a --format '{{.Names}}' | grep -Fxq "${WATCHER_CONTAINER_NAME}"; then
        docker rm -f "${WATCHER_CONTAINER_NAME}" >/dev/null
    fi

    docker run -d \
        --name "${WATCHER_CONTAINER_NAME}" \
        --restart=unless-stopped \
        --network=none \
        --security-opt=no-new-privileges \
        --cap-add=LINUX_IMMUTABLE \
        -v "${GRAPH_DIR}:/graph" \
        -v "${CANARY_FILE}:/canary" \
        -v "${REPO_ROOT}/src/formats/dcdata/data-src/nodes/allocated:/journal-dir:ro" \
        "${HELPER_IMAGE}" \
        python3 -c "${PYTHON_LOCK_SCRIPT}" watch /graph /canary /journal-dir >/dev/null

    echo "Started background Docker watcher '${WATCHER_CONTAINER_NAME}' for ${GRAPH_DIR}."
}

run_unlock() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "Error: docker CLI is required on the host to run --unlock." >&2
        exit 1
    fi
    ensure_canary_file

    if docker ps -a --format '{{.Names}}' | grep -Fxq "${WATCHER_CONTAINER_NAME}"; then
        docker rm -f "${WATCHER_CONTAINER_NAME}" >/dev/null
        echo "Stopped background Docker watcher '${WATCHER_CONTAINER_NAME}'."
    fi

    docker run --rm \
        --network=none \
        --security-opt=no-new-privileges \
        --cap-add=LINUX_IMMUTABLE \
        -v "${GRAPH_DIR}:/graph" \
        -v "${CANARY_FILE}:/canary" \
        -v "${REPO_ROOT}/src/formats/dcdata/data-src/nodes/allocated:/journal-dir:ro" \
        -v "${REPO_ROOT}/.git:/git-dir" \
        "${HELPER_IMAGE}" \
        python3 -c "${PYTHON_LOCK_SCRIPT}" unlock /graph /canary /journal-dir /git-dir
}

seed_highwater_from_head() {
    local target_dir="$1"
    if [ ! -d "${REPO_ROOT}/.git" ]; then
        return 0
    fi
    mkdir -p "${target_dir}"
    local existing_files
    existing_files="$(find "${target_dir}" -maxdepth 1 -name '*.ctbnodes' | wc -l | tr -d '[:space:]')"
    if [ "${existing_files}" -gt 0 ]; then
        return 0
    fi
    while IFS= read -r rel_path; do
        if [ -z "${rel_path}" ]; then
            continue
        fi
        local base_name
        base_name="$(basename "${rel_path}")"
        local dest_file="${target_dir}/${base_name}"
        git -C "${REPO_ROOT}" show "HEAD:${rel_path}" > "${dest_file}"
        chmod 0444 "${dest_file}"
    done < <(git -C "${REPO_ROOT}" ls-tree --name-only HEAD -- assets/data/graph/ | grep '\.ctbnodes$' || true)
}

remove_legacy_wrappers() {
    for cmd in git rm mv truncate; do
        if [ -f "/usr/local/sbin/${cmd}" ] && grep -q "assets/data/graph" "/usr/local/sbin/${cmd}" 2>/dev/null; then
            unlink "/usr/local/sbin/${cmd}"
        fi
    done
}

install_git_pre_commit_hook() {
    if [ ! -d "${REPO_ROOT}/.git" ]; then
        return 0
    fi
    mkdir -p "${REPO_ROOT}/.git/hooks"
    local hook_path="${REPO_ROOT}/.git/hooks/pre-commit"
    cat > "${hook_path}" << 'HOOKEOF'
#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

while IFS= read -r rel_path; do
    if [ -z "${rel_path}" ]; then
        continue
    fi
    work_file="${REPO_ROOT}/${rel_path}"
    if [ ! -f "${work_file}" ]; then
        echo "FATAL [pre-commit]: Append-only graph chunk '${rel_path}' from HEAD is missing in the working tree!" >&2
        exit 1
    fi
    head_tmp="$(mktemp)"
    git show "HEAD:${rel_path}" > "${head_tmp}"
    head_size="$(wc -c < "${head_tmp}" | tr -d '[:space:]')"
    work_size="$(wc -c < "${work_file}" | tr -d '[:space:]')"
    if [ "${work_size}" -lt "${head_size}" ]; then
        rm "${head_tmp}"
        echo "FATAL [pre-commit]: Append-only graph chunk '${rel_path}' shrank (${work_size} < ${head_size} bytes in HEAD)!" >&2
        exit 1
    fi
    if ! cmp -n "${head_size}" -s "${head_tmp}" "${work_file}"; then
        rm "${head_tmp}"
        echo "FATAL [pre-commit]: Existing lines in append-only graph chunk '${rel_path}' were modified relative to HEAD!" >&2
        exit 1
    fi
    rm "${head_tmp}"
done < <(git ls-tree --name-only HEAD -- assets/data/graph/ | grep '\.ctbnodes$' || true)
HOOKEOF
    chmod +x "${hook_path}"
}

run_container_init() {
    remove_legacy_wrappers
    ensure_canary_file
    install_git_pre_commit_hook
    seed_highwater_from_head "${REPO_ROOT}/built/graph-ledger/highwater"
}

run_test_canary() {
    ensure_canary_file
    python3 - "${CANARY_FILE}" "${GRAPH_DIR}" << 'PYTEST'
import errno
import fcntl
import glob
import os
import struct
import sys

FS_IOC_GETFLAGS = 0x80086601
FS_IOC_SETFLAGS = 0x40086602
FS_IMMUTABLE_FL = 0x00000010
FS_APPEND_FL = 0x00000020

canary = sys.argv[1]
graph_dir = sys.argv[2]

def get_flags(path: str) -> int:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        buf = fcntl.ioctl(fd, FS_IOC_GETFLAGS, struct.pack("L", 0))
        return struct.unpack("L", buf)[0]
    finally:
        os.close(fd)

flags = get_flags(canary)
if not (flags & FS_APPEND_FL):
    print(
        f"ERROR: Canary file {canary} does not have FS_APPEND_FL set (flags=0x{flags:08x}).\n"
        "Run `./scripts/lock-graph-append-only --host-init` on the host (or reload the devcontainer) first.",
        file=sys.stderr,
    )
    sys.exit(1)

# 1. Verify clearing FS_APPEND_FL inside container fails with EPERM
fd = os.open(canary, os.O_RDONLY)
try:
    try:
        fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("L", flags & ~FS_APPEND_FL))
        print("ERROR: Container was able to clear FS_APPEND_FL on canary!", file=sys.stderr)
        sys.exit(1)
    except PermissionError:
        pass
finally:
    os.close(fd)

# 2. Verify O_TRUNC fails with EPERM on canary
try:
    fd = os.open(canary, os.O_WRONLY | os.O_TRUNC)
    os.close(fd)
    print("ERROR: O_TRUNC succeeded on append-only canary!", file=sys.stderr)
    sys.exit(1)
except PermissionError:
    pass

# 3. Verify non-append O_WRONLY fails with EPERM on canary
try:
    fd = os.open(canary, os.O_WRONLY)
    os.close(fd)
    print("ERROR: Non-append O_WRONLY succeeded on append-only canary!", file=sys.stderr)
    sys.exit(1)
except PermissionError:
    pass

# 4. Verify unlink and rename fail with EPERM on canary
try:
    os.unlink(canary)
    print("ERROR: unlink succeeded on append-only canary!", file=sys.stderr)
    sys.exit(1)
except PermissionError:
    pass

try:
    os.rename(canary, canary + ".moved")
    print("ERROR: rename succeeded on append-only canary!", file=sys.stderr)
    sys.exit(1)
except PermissionError:
    pass

# 5. Verify O_APPEND open succeeds on canary without dirtying the tracked lock file
fd = os.open(canary, os.O_WRONLY | os.O_APPEND)
try:
    os.write(fd, b"")
finally:
    os.close(fd)

# 6. Read-only verification of FS_IMMUTABLE_FL / FS_APPEND_FL on assets/data/graph/*.ctbnodes
imm_count = 0
app_count = 0
for path in sorted(glob.glob(os.path.join(graph_dir, "*.ctbnodes"))):
    f_flags = get_flags(path)
    with open(path, "rb") as f:
        lines = sum(1 for _ in f)
    if lines >= 100:
        if not (f_flags & FS_IMMUTABLE_FL):
            print(f"ERROR: Full 100-line chunk {path} lacks FS_IMMUTABLE_FL (0x{f_flags:08x})", file=sys.stderr)
            sys.exit(1)
        imm_count += 1
    else:
        if not (f_flags & FS_APPEND_FL):
            print(f"ERROR: Active tail chunk {path} lacks FS_APPEND_FL (0x{f_flags:08x})", file=sys.stderr)
            sys.exit(1)
        app_count += 1

print(
    f"Canary self-test passed on {canary} (O_TRUNC/O_WRONLY/unlink/rename/chattr blocked with EPERM; O_APPEND succeeded).\n"
    f"Read-only flag check verified {imm_count} immutable (+i) and {app_count} append-only (+a) .ctbnodes files."
)
PYTEST
}

MODE="${1:---container-init}"
case "${MODE}" in
    --host-init)
        run_host_init
        ;;
    --unlock)
        run_unlock
        ;;
    --container-init)
        run_container_init
        ;;
    --test-canary)
        run_test_canary
        ;;
    *)
        echo "Usage: $0 [--host-init | --unlock | --container-init | --test-canary]" >&2
        exit 1
        ;;
esac
