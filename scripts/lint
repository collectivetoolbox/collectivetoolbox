#!/usr/bin/env bash
set -euxo pipefail

# Change directory to the repository root
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

# ### 2. Why `LOCKSTEP_XML_PATH` was needed with vendored dependencies

# The need for `LOCKSTEP_XML_PATH` stems from an upstream bug in [`zbus_lockstep::resolve_xml_path`](file:///workspaces/ctoolbox/vendor/ctb-vendored/vendor/zbus-lockstep/src/macros.rs#L35-L122) that only surfaces when using **cargo-vendored** sources:

# 1. `atspi-common` uses `#[validate(...)]` from `zbus-lockstep-macros` to validate D-Bus interfaces against XML definitions.
# 2. During path resolution, `resolve_xml_path` checks candidate locations. However, instead of using `if ... else if ...`, it uses **sequential `if` statements**:
#    ```rust
#    if current_dir_lower_case.exists() {
#        xml = Some(current_dir_lower_case.to_str()...);
#    }
#    ...
#    if parent_dir_lower_case.exists() {
#        xml = Some(parent_dir_lower_case.to_str()...); // <--- overwrites previous matches!
#    }
#    ```
# 3. When using dependencies directly from Crates.io (in `~/.cargo/registry/src/index.crates.io-.../`), directories include version numbers (e.g. `atspi-common-0.3.0` and `xml-0.8.4`). There is no directory named `../xml`.
# 4. In `vendor/ctb-vendored/vendor/`, version numbers are omitted. Sitting alongside `atspi-common` is the `xml` crate (`vendor/ctb-vendored/vendor/xml`).
# 5. Because `../xml` exists, `parent_dir_lower_case.exists()` evaluates to `true` and **overwrites** `atspi-common/xml` with `vendor/ctb-vendored/vendor/xml`!
# 6. `zbus-lockstep-macros` then scans the `xml` crate directory, encounters files like `LICENSE` without an extension, and panics with:
#    ```text
#    entry.path().extension().expect("File has no extension.")
#    ```
# 7. Setting `LOCKSTEP_XML_PATH="$(pwd)/vendor/ctb-vendored/vendor/atspi-common/xml"` overrides the fallback search order and points it directly to `atspi-common`'s actual XML definitions.

export LOCKSTEP_XML_PATH="$(pwd)/vendor/ctb-vendored/vendor/atspi-common/xml"

offline=""
quick=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --offline)
            offline="--offline"
            ;;
        --quick)
            quick="--quick"
            ;;
    esac
    shift
done

echo "=== Checking unwrap_or domain fallbacks ==="
# This lint aims to encourage the following principles:
# - Avoid panics, but do not fail silently - fail early and loudly:
#   - For any fallible operation or suppressed error condition, the function signature will be refactored to return anyhow::Result<T> and propagate errors using ?.
#   - `expect` and `unreachable!` may be used with an explanation, but they are reserved strictly for provably infallible operations (such as bitwise masks `x & 0x3F` or range-checked bounds) or genuinely unrecoverable scenarios (such as during application or installer startup), and never if a function returns a Result. Use of `unwrap_or(0)` or similar for infallible operations is an antipattern, as it obscures the intent.
#   - Use of `unwrap_or` and similar is acceptable when it's used for logic that's clearly documented in the function contract. A comment is required to document why it's an acceptable fallback and will not mask any true error.
# - Comments for lint bypasses (such as on uses of "expect" or "unwrap_or") must answer the *why*, not the *what* - do not restate what the code does, but explain *why* the problem the lint aims to cover is not an issue in the particular case.
./scripts/lint-unwrap-or ${offline} || exit 1

if [[ -n "$quick" ]]; then
    export CTB_SKIP_DOCS=1
fi

if [[ -z "${CTB_SKIP_DOCS:-}" ]]; then
    # Documentation needs to exist to build linter (it's fine if it's not up to date, but does need to be there).
    if [[ ! -f target/x86_64-unknown-linux-musl/doc/index.html && ! -f built/docs/index.html ]]; then
        echo "Docs not found. Building..."
        cargo doc --workspace --no-deps --target=x86_64-unknown-linux-musl || exit 1
        mkdir -p built/docs
        cp -r target/x86_64-unknown-linux-musl/doc/* built/docs/
    fi
fi

pushd assets || exit 1
if grep --exclude-dir=vendor -r '!important'; then
    echo "!important used in CSS"
    exit 1
fi
popd || exit 1

echo "=== Checking that patched crates are actually being used ==="
./scripts/lint-patches || exit 1

if [[ -z "$quick" ]]; then
    echo "=== Checking for newer versions of vendored packages ==="
    ./scripts/lint-vendor-versions ${offline} || exit 1
fi

echo "=== Checking for unsafe file writes in tests ==="
./scripts/lint-helper || exit 1

echo "=== Checking file headers and module docblocks ==="
./scripts/lint-headers || exit 1

echo "=== Validating data tables ==="
./scripts/validate-data-tables ${offline} || exit 1

echo "=== Checking for idiosyncratic styling ==="
./scripts/lint-encrecss || exit 1

echo "=== Checking test macro conventions ==="
if git grep -E '^\s*#\[(tokio::)?test\]\s*$' -- 'src/' ':!src/build_support/' ':!src/formats/ctb_asset_bundle/'; then
    echo "Error: Standard test macros #[test] or #[tokio::test] found."
    echo "Please update tests to use \`#[crate::ctb_test]\` or \`#[crate::ctb_test(\"tokio\")]\`."
    exit 1
fi

echo "=== Checking test module boilerplate ==="
./scripts/lint-test-boilerplate || exit 1

echo "=== Running cargo clippy ==="
if ! RUSTFLAGS="-A warnings" cargo clippy --workspace --all-targets $offline; then
    echo "Clippy reported errors."
    exit 1
fi
if ! RUSTFLAGS="-A warnings" cargo clippy --workspace --all-targets --tests $offline; then
    echo "Clippy reported errors in tests."
    exit 1
fi

echo "=== Running cargo deny ==="
deny_flags=""
if [[ -n "$offline" ]]; then
    deny_flags="--offline"
fi
if ! cargo deny $deny_flags --workspace check; then
    echo "cargo-deny reported errors."
    exit 1
fi

if [[ ! -f "vendor/TypeScript-built.tar" ]]; then
    echo "=== Building TypeScript-built.tar ==="
    cargo run -p ctb-formats-javascript-bootstrap-ts --bin bootstrap_ts --release -- ./vendor/TypeScript
fi

if [[ ! -f "vendor/v86_images/guix/guix-fs.json" ]]; then
    echo "=== Building Guix v86 image ==="
    ./scripts/guix/build-v86-guix-image.sh
fi



echo "=== Running JavaScript linter ==="
cargo run $offline -p ctb-formats-javascript --bin js-lint --release

echo "=== Running JavaScript type checker ==="
if [[ -n "$quick" ]];  then
    if tsc; then
        echo "TypeScript type checking passed using system tsc."
    else
        echo "Quick TypeScript type checking failed. Maybe leave off --quick to use the bundled tsc?"
        exit 1
    fi
else
    cargo run $offline -p ctb-formats-javascript --bin ts-check --release -- --add-types jquery
fi

