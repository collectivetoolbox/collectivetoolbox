set -euo pipefail

# Change directory to the repository root
cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." || exit 1

echo "Cleaning generated files..."
# FIXME Guix
find src docs -type f \( -name '*.generated.*' -o -name '*.dtos.generated.rs' -o -name 'generated.rs' \) \
    ! -path '*/packaging/guix/generated/*' \
    ! -path '*/vendor/*' \
    -print \
    -delete
