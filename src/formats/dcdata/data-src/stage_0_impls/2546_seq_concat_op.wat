;; SPDX-License-Identifier: AGPL-3.0-or-later
;; Stage 0 implementation of Dc 2546 ("Concatenate sequences operation").
;;
;; Allocates a new immutable `l/T` sequence containing all elements of `$a`
;; followed by all elements of `$b`.
(module
  (memory (export "memory") 1)

  (const $MB_IN_PTR 0)
  (const $MB_IN_LEN 4)
  (const $HEAP_MIN  256)
  (const $MAX_ADDR  0x7FFF0000)

  (global $__heap_ptr (mut i32) (i32.const 256))

  (func $_alloc (param $size i32) (result i32)
    (local $floor i32)
    (local $ptr   i32)
    (local $next  i32)
    (local $cap   i32)
    (when (i32.lt_s $size 0) (unreachable))
    (set $floor (i32.add (i32.load $MB_IN_PTR) (i32.load $MB_IN_LEN)))
    (when (i32.lt_u $floor $HEAP_MIN)
      (set $floor $HEAP_MIN))
    (set $ptr $__heap_ptr)
    (when (i32.lt_u $ptr $floor)
      (set $ptr $floor))
    (set $ptr (i32.and (i32.add $ptr 7) -8))
    (when (i32.gt_u $size (i32.sub $MAX_ADDR $ptr)) (unreachable))
    (set $next (i32.and (i32.add (i32.add $ptr $size) 7) -8))
    (set $cap (i32.shl (memory.size) 16))
    (when (i32.gt_u $next $cap)
      (when
        (i32.eq
          (memory.grow (i32.shr_u (i32.add (i32.sub $next $cap) 65535) 16))
          -1)
        (unreachable)))
    (global.set $__heap_ptr $next)
    (get $ptr))

  ;; 1-byte elements: `u8` (`f203`) and `b` (`f1424`).
  ;; @context(2576 f203)
  ;; @context(2576 f1424)
  (func $concat_1b (param $a i32) (param $b i32) (result i32)
    (local $la    i32)
    (local $lb    i32)
    (local $tot64 i64)
    (local $tot   i32)
    (local $hdr   i32)
    (local $data  i32)
    (set $la (i32.load offset=4 $a))
    (set $lb (i32.load offset=4 $b))
    (set $tot64 (i64.add (i64.extend_i32_u $la) (i64.extend_i32_u $lb)))
    (when (i64.gt_u $tot64 0x7FFEFF00) (unreachable))
    (set $tot (i32.wrap_i64 $tot64))
    (set $hdr (call $_alloc (i32.add 16 $tot)))
    (set $data (i32.add $hdr 16))
    (when (i32.gt_u $la 0)
      (memory.copy $data (i32.load $a) $la))
    (when (i32.gt_u $lb 0)
      (memory.copy (i32.add $data $la) (i32.load $b) $lb))
    (i32.store $hdr $data)
    (i32.store offset=4 $hdr $tot)
    (i32.store offset=8 $hdr $tot)
    (i32.store offset=12 $hdr 1)
    (get $hdr))

  ;; 4-byte elements: `i32` (`f208`), `u32` (`f207`), and nested lists `l/*` (`2576 275`).
  ;; @context(2576 f208)
  ;; @context(2576 f207)
  ;; @context(2576 2576 275)
  (func $concat_4b (param $a i32) (param $b i32) (result i32)
    (local $la      i32)
    (local $lb      i32)
    (local $bytes64 i64)
    (local $tot     i32)
    (local $ba      i32)
    (local $bb      i32)
    (local $hdr     i32)
    (local $data    i32)
    (set $la (i32.load offset=4 $a))
    (set $lb (i32.load offset=4 $b))
    (set $bytes64 (i64.shl (i64.add (i64.extend_i32_u $la) (i64.extend_i32_u $lb)) 2))
    (when (i64.gt_u $bytes64 0x7FFEFF00) (unreachable))
    (set $tot (i32.add $la $lb))
    (set $ba (i32.shl $la 2))
    (set $bb (i32.shl $lb 2))
    (set $hdr (call $_alloc (i32.add 16 (i32.wrap_i64 $bytes64))))
    (set $data (i32.add $hdr 16))
    (when (i32.gt_u $ba 0)
      (memory.copy $data (i32.load $a) $ba))
    (when (i32.gt_u $bb 0)
      (memory.copy (i32.add $data $ba) (i32.load $b) $bb))
    (i32.store $hdr $data)
    (i32.store offset=4 $hdr $tot)
    (i32.store offset=8 $hdr $tot)
    (i32.store offset=12 $hdr 1)
    (get $hdr))

  ;; 8-byte elements: `i64` (`f210`) and `u64` (`f209`).
  ;; @context(2576 f210)
  ;; @context(2576 f209)
  (func $concat_8b (param $a i32) (param $b i32) (result i32)
    (local $la      i32)
    (local $lb      i32)
    (local $bytes64 i64)
    (local $tot     i32)
    (local $ba      i32)
    (local $bb      i32)
    (local $hdr     i32)
    (local $data    i32)
    (set $la (i32.load offset=4 $a))
    (set $lb (i32.load offset=4 $b))
    (set $bytes64 (i64.shl (i64.add (i64.extend_i32_u $la) (i64.extend_i32_u $lb)) 3))
    (when (i64.gt_u $bytes64 0x7FFEFF00) (unreachable))
    (set $tot (i32.add $la $lb))
    (set $ba (i32.shl $la 3))
    (set $bb (i32.shl $lb 3))
    (set $hdr (call $_alloc (i32.add 16 (i32.wrap_i64 $bytes64))))
    (set $data (i32.add $hdr 16))
    (when (i32.gt_u $ba 0)
      (memory.copy $data (i32.load $a) $ba))
    (when (i32.gt_u $bb 0)
      (memory.copy (i32.add $data $ba) (i32.load $b) $bb))
    (i32.store $hdr $data)
    (i32.store offset=4 $hdr $tot)
    (i32.store offset=8 $hdr $tot)
    (i32.store offset=12 $hdr 1)
    (get $hdr))
)
