;; SPDX-License-Identifier: AGPL-3.0-or-later
;; Stage 0 implementation of Dc 2582 ("StageL buffer push").
;;
;; Appends `$val` to `$buf` in amortized O(1) time; traps if `$buf` is frozen.
(module
  (memory (export "memory") 1)

  (const $MB_IN_PTR 0)
  (const $MB_IN_LEN 4)
  (const $HEAP_MIN  256)
  (const $MAX_ADDR  0x7FFF0000)

  (global $__heap_ptr (mut i32) (i32.const 256))

  (func $_alloc (param $size i32) (result i32)
    (local $floor i32)
    (local $ptr   i32)
    (local $next  i32)
    (local $cap   i32)
    (when (i32.lt_s $size 0) (unreachable))
    (set $floor (i32.add (i32.load $MB_IN_PTR) (i32.load $MB_IN_LEN)))
    (when (i32.lt_u $floor $HEAP_MIN)
      (set $floor $HEAP_MIN))
    (set $ptr $__heap_ptr)
    (when (i32.lt_u $ptr $floor)
      (set $ptr $floor))
    (set $ptr (i32.and (i32.add $ptr 7) -8))
    (when (i32.gt_u $size (i32.sub $MAX_ADDR $ptr)) (unreachable))
    (set $next (i32.and (i32.add (i32.add $ptr $size) 7) -8))
    (set $cap (i32.shl (memory.size) 16))
    (when (i32.gt_u $next $cap)
      (when
        (i32.eq
          (memory.grow (i32.shr_u (i32.add (i32.sub $next $cap) 65535) 16))
          -1)
        (unreachable)))
    (global.set $__heap_ptr $next)
    (get $ptr))

  ;; 1-byte elements: `u8` (`f203`) and `b` (`f1424`).
  ;; @context(2577 f203)
  ;; @context(2577 f1424)
  (func $buf_push_1b (param $buf i32) (param $val i32)
    (local $len      i32)
    (local $cap      i32)
    (local $data     i32)
    (local $new_cap  i32)
    (local $new_data i32)
    (when (i32.ne (i32.load offset=12 $buf) 0) (unreachable))
    (set $len (i32.load offset=4 $buf))
    (set $cap (i32.load offset=8 $buf))
    (set $data (i32.load $buf))
    (when (i32.eq $len $cap)
      (when (i32.ge_u $len 0x7FFEFF00) (unreachable))
      (if (i32.lt_u $cap 8)
        (then (set $new_cap 8))
        (else
          (if (i32.gt_u $cap 0x3FFF7F80)
            (then (set $new_cap 0x7FFEFF00))
            (else (set $new_cap (i32.shl $cap 1))))))
      (set $new_data (call $_alloc $new_cap))
      (when (i32.gt_u $len 0)
        (memory.copy $new_data $data $len))
      (i32.store $buf $new_data)
      (i32.store offset=8 $buf $new_cap)
      (set $data $new_data))
    (i32.store8 (i32.add $data $len) $val)
    (i32.store offset=4 $buf (i32.add $len 1)))

  ;; 4-byte elements: `i32` (`f208`), `u32` (`f207`), and nested lists `l/*` (`2576 275`).
  ;; @context(2577 f208)
  ;; @context(2577 f207)
  ;; @context(2577 2576 275)
  (func $buf_push_4b (param $buf i32) (param $val i32)
    (local $len      i32)
    (local $cap      i32)
    (local $data     i32)
    (local $new_cap  i32)
    (local $new_data i32)
    (when (i32.ne (i32.load offset=12 $buf) 0) (unreachable))
    (set $len (i32.load offset=4 $buf))
    (set $cap (i32.load offset=8 $buf))
    (set $data (i32.load $buf))
    (when (i32.eq $len $cap)
      (when (i32.ge_u $len 0x1FFFBFC0) (unreachable))
      (if (i32.lt_u $cap 8)
        (then (set $new_cap 8))
        (else
          (if (i32.gt_u $cap 0x0FFFDFE0)
            (then (set $new_cap 0x1FFFBFC0))
            (else (set $new_cap (i32.shl $cap 1))))))
      (set $new_data (call $_alloc (i32.shl $new_cap 2)))
      (when (i32.gt_u $len 0)
        (memory.copy $new_data $data (i32.shl $len 2)))
      (i32.store $buf $new_data)
      (i32.store offset=8 $buf $new_cap)
      (set $data $new_data))
    (i32.store (i32.add $data (i32.shl $len 2)) $val)
    (i32.store offset=4 $buf (i32.add $len 1)))

  ;; 8-byte elements: `i64` (`f210`) and `u64` (`f209`).
  ;; @context(2577 f210)
  ;; @context(2577 f209)
  (func $buf_push_8b (param $buf i32) (param $val i64)
    (local $len      i32)
    (local $cap      i32)
    (local $data     i32)
    (local $new_cap  i32)
    (local $new_data i32)
    (when (i32.ne (i32.load offset=12 $buf) 0) (unreachable))
    (set $len (i32.load offset=4 $buf))
    (set $cap (i32.load offset=8 $buf))
    (set $data (i32.load $buf))
    (when (i32.eq $len $cap)
      (when (i32.ge_u $len 0x0FFFDFE0) (unreachable))
      (if (i32.lt_u $cap 8)
        (then (set $new_cap 8))
        (else
          (if (i32.gt_u $cap 0x07FFEF00)
            (then (set $new_cap 0x0FFFDFE0))
            (else (set $new_cap (i32.shl $cap 1))))))
      (set $new_data (call $_alloc (i32.shl $new_cap 3)))
      (when (i32.gt_u $len 0)
        (memory.copy $new_data $data (i32.shl $len 3)))
      (i32.store $buf $new_data)
      (i32.store offset=8 $buf $new_cap)
      (set $data $new_data))
    (i64.store (i32.add $data (i32.shl $len 3)) $val)
    (i32.store offset=4 $buf (i32.add $len 1)))
)
