        out structNew i128Val: u64:18446744073709551611 u64:18446744073709551615 ::.
        in structNew i128Val: u64:0 u64:9223372036854775808 ::
        out fault.
    be tup: b i128Val u8 ::/r tryNeg /a.
    if not field /r u32:0
        fault
        field /r u32:1.

