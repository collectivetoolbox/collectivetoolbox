: Total StageR 3 `shl` on `i128Val` (`tup: b i128Val u8 ::`, returning `errOverflow` when `cnt >= 128`).
: @dc l8589980731
pub v/tup: b i128Val u8 ::/tryShl i128Val/a u32/cnt
    test
        in structNew i128Val: u64:1 u64:0 :: u32:127
        out tupNew: true structNew i128Val: u64:0 u64:9223372036854775808 :: u8:0 ::.
        in structNew i128Val: u64:1 u64:0 :: u32:128
        out tupNew: false structNew i128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /cnt u32:128
        tupNew: false /i128Zero /errOverflow ::
        tupNew: true fromBits u128ShlRaw toBits /a /cnt u8:0 ::.

: Total StageR 3 arithmetic sign-extending `shr` on `i128Val` (`tup: b i128Val u8 ::`, returning `errOverflow` when `cnt >= 128`).
: @dc l8589980732
pub v/tup: b i128Val u8 ::/tryShr i128Val/a u32/cnt
    test
        in structNew i128Val: u64:0 u64:9223372036854775808 :: u32:127
        out tupNew: true structNew i128Val: u64:18446744073709551615 u64:18446744073709551615 :: u8:0 ::.
        in structNew i128Val: u64:0 u64:9223372036854775808 :: u32:128
        out tupNew: false structNew i128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /cnt u32:128
        return tupNew: false /i128Zero /errOverflow ::
        nop.
    if eq /cnt u32:0
        return tupNew: true /a u8:0 ::
        nop.
    be u64/lo field /a u32:0.
    be u64/hi field /a u32:1.
    be i64/hiSigned bitcast /hi i64.
    if lt /cnt u32:64
        tupNew: true structNew i128Val: bitOr shr /lo /cnt shl /hi diff u32:64 /cnt bitcast shr /hiSigned /cnt u64 :: u8:0 ::
        do
            be u64/signFill bitcast shr /hiSigned u32:63 u64.
            if eq /cnt u32:64
                tupNew: true structNew i128Val: /hi /signFill :: u8:0 ::
                tupNew: true structNew i128Val: bitcast shr /hiSigned diff /cnt u32:64 u64 /signFill :: u8:0 ::.
        ::.

