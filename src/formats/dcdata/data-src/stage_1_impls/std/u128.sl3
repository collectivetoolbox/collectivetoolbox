: Stage 1 128-bit unsigned integer (`u128Val`) arithmetic, bitwise, shift, and conversion primitives
: plus canonical StageR 3 diagnostic `error` tag constants (`u8:0`..`u8:10`).
ns std/u128.

: Two-limb little-endian 128-bit unsigned integer: slot 0 = `lo` (`u64`), slot 1 = `hi` (`u64`).
: @dc l8589980643
pub struct u128Val :: u64 u64.

: StageR 3 `error:overflow` tag (`0`).
: @dc l8589980736
pub u8/errOverflow u8:0.

: StageR 3 `error:divisionByZero` tag (`1`).
: @dc l8589980737
pub u8/errDivisionByZero u8:1.

: StageR 3 `error:outOfBounds` tag (`2`).
: @dc l8589980738
pub u8/errOutOfBounds u8:2.

: StageR 3 `error:frozenBuffer` tag (`3`).
: @dc l8589980739
pub u8/errFrozenBuffer u8:3.

: StageR 3 `error:invalidEncoding` tag (`4`).
: @dc l8589980740
pub u8/errInvalidEncoding u8:4.

: StageR 3 `error:numberOutsideDcRange` tag (`5`).
: @dc l8589987644
pub u8/errNumberOutsideDcRange u8:5.

: StageR 3 `error:parseFailure` tag (`6`).
: @dc l8589980742
pub u8/errParseFailure u8:6.

: StageR 3 `error:unexpectedNone` tag (`7`).
: @dc l8589980743
pub u8/errUnexpectedNone u8:7.

: StageR 3 `error:numberOutsideShortDcRange` tag (`8`).
: @dc l8589987645
pub u8/errNumberOutsideShortDcRange u8:8.

: StageR 3 `error:numberOutsideFormatRange` tag (`9`).
: @dc l8589987646
pub u8/errNumberOutsideFormatRange u8:9.

: StageR 3 `error:numberOutsideUnicodeRange` tag (`10`).
: @dc l8589987647
pub u8/errNumberOutsideUnicodeRange u8:10.

: Constant `0` (`u128:0`).
: @dc l8589980745
pub u128Val/u128Zero structNew u128Val: u64:0 u64:0 ::.

: Constant `1` (`u128:1`).
: @dc l8589980746
pub u128Val/u128One structNew u128Val: u64:1 u64:0 ::.

: Constant `2^128 - 1` (`u128Max`).
: @dc l8589980747
pub u128Val/u128Max structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 ::.

: Constructs `u128Val` from `(lo, hi)` 64-bit limbs.
: @dc l8589980748
pub v/u128Val/u128New u64/lo u64/hi
    test
        in u64:42 u64:7
        out structNew u128Val: u64:42 u64:7 ::.
    structNew u128Val: /lo /hi ::.

: Returns the low 64-bit limb of `x`.
: @dc l8589994027
pub v/u64/u128Lo u128Val/x
    test
        in structNew u128Val: u64:42 u64:9 ::
        out u64:42.
    field /x u32:0.

: Widens `u64` to `u128Val`.
: @dc l8589980749
pub v/u128Val/from u64/x
    test
        in u64:99
        out structNew u128Val: u64:99 u64:0 ::.
    structNew u128Val: /x u64:0 ::.

: Widens `u32` to `u128Val`.
: @dc l8589980750
pub v/u128Val/from u32/x
    test
        in u32:12345
        out structNew u128Val: u64:12345 u64:0 ::.
    structNew u128Val: conv /x u64 u64:0 ::.

: Widens `u8` to `u128Val`.
: @dc l8589980751
pub v/u128Val/from u8/x
    test
        in u8:255
        out structNew u128Val: u64:255 u64:0 ::.
    structNew u128Val: conv /x u64 u64:0 ::.

: Checked narrowing `u128Val -> result/u64` (`tup: b u64 u8 ::`).
: @dc l8589980752
pub v/tup: b u64 u8 ::/tryToU64 u128Val/x
    test
        in structNew u128Val: u64:500 u64:0 ::
        out tupNew: true u64:500 u8:0 ::.
        in structNew u128Val: u64:0 u64:1 ::
        out tupNew: false u64:0 u8:0 ::.
    if eq field /x u32:1 u64:0
        tupNew: true field /x u32:0 u8:0 ::
        tupNew: false u64:0 /errOverflow ::.

: Checked narrowing `u128Val -> result/u32` (`tup: b u32 u8 ::`).
: @dc l8589980753
pub v/tup: b u32 u8 ::/tryToU32 u128Val/x
    test
        in structNew u128Val: u64:4294967295 u64:0 ::
        out tupNew: true u32:4294967295 u8:0 ::.
        in structNew u128Val: u64:4294967296 u64:0 ::
        out tupNew: false u32:0 u8:0 ::.
    if and eq field /x u32:1 u64:0 le field /x u32:0 u64:4294967295
        tupNew: true conv field /x u32:0 u32 u8:0 ::
        tupNew: false u32:0 /errOverflow ::.

: Checked narrowing `u128Val -> result/u8` (`tup: b u8 u8 ::`).
: @dc l8589980754
pub v/tup: b u8 u8 ::/tryToU8 u128Val/x
    test
        in structNew u128Val: u64:255 u64:0 ::
        out tupNew: true u8:255 u8:0 ::.
        in structNew u128Val: u64:256 u64:0 ::
        out tupNew: false u8:0 u8:0 ::.
    if and eq field /x u32:1 u64:0 le field /x u32:0 u64:255
        tupNew: true conv field /x u32:0 u8 u8:0 ::
        tupNew: false u8:0 /errOverflow ::.

: Checked narrowing `u128Val -> result/i64` (`tup: b i64 u8 ::`).
: @dc l8589980755
pub v/tup: b i64 u8 ::/tryToI64 u128Val/x
    test
        in structNew u128Val: u64:9223372036854775807 u64:0 ::
        out tupNew: true i64:9223372036854775807 u8:0 ::.
        in structNew u128Val: u64:9223372036854775808 u64:0 ::
        out tupNew: false i64:0 u8:0 ::.
    if and eq field /x u32:1 u64:0 le field /x u32:0 u64:9223372036854775807
        tupNew: true conv field /x u32:0 i64 u8:0 ::
        tupNew: false i64:0 /errOverflow ::.

: Checked narrowing `u128Val -> result/i32` (`tup: b i32 u8 ::`).
: @dc l8589980756
pub v/tup: b i32 u8 ::/tryToI32 u128Val/x
    test
        in structNew u128Val: u64:2147483647 u64:0 ::
        out tupNew: true i32:2147483647 u8:0 ::.
        in structNew u128Val: u64:2147483648 u64:0 ::
        out tupNew: false i32:0 u8:0 ::.
    if and eq field /x u32:1 u64:0 le field /x u32:0 u64:2147483647
        tupNew: true conv field /x u32:0 i32 u8:0 ::
        tupNew: false i32:0 /errOverflow ::.

: Checked conversion `i64 -> result/u128` (`tup: b u128Val u8 ::`).
: @dc l8589980757
pub v/tup: b u128Val u8 ::/tryFromI64 i64/x
    test
        in i64:42
        out tupNew: true structNew u128Val: u64:42 u64:0 :: u8:0 ::.
        in i64:-1
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /x i64:0
        tupNew: true structNew u128Val: conv /x u64 u64:0 :: u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Checked conversion `i32 -> result/u128` (`tup: b u128Val u8 ::`).
: @dc l8589980758
pub v/tup: b u128Val u8 ::/tryFromI32 i32/x
    test
        in i32:42
        out tupNew: true structNew u128Val: u64:42 u64:0 :: u8:0 ::.
        in i32:-1
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /x i32:0
        tupNew: true structNew u128Val: conv /x u64 u64:0 :: u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Equality `a == b`.
: @dc l8589980759
pub v/b/eq u128Val/a u128Val/b
    test
        in structNew u128Val: u64:1 u64:2 :: structNew u128Val: u64:1 u64:2 ::
        out true.
        in structNew u128Val: u64:1 u64:2 :: structNew u128Val: u64:1 u64:3 ::
        out false.
    eq /a /b.

: Inequality `a != b`.
: @dc l8589980760
pub v/b/ne u128Val/a u128Val/b
    test
        in structNew u128Val: u64:1 u64:2 :: structNew u128Val: u64:1 u64:3 ::
        out true.
    ne /a /b.

: Unsigned `<` on `u128Val`.
: @dc l8589980761
pub v/b/lt u128Val/a u128Val/b
    test
        in structNew u128Val: u64:10 u64:0 :: structNew u128Val: u64:0 u64:1 ::
        out true.
        in structNew u128Val: u64:5 u64:2 :: structNew u128Val: u64:6 u64:2 ::
        out true.
        in structNew u128Val: u64:6 u64:2 :: structNew u128Val: u64:6 u64:2 ::
        out false.
    if ne field /a u32:1 field /b u32:1
        lt field /a u32:1 field /b u32:1
        lt field /a u32:0 field /b u32:0.

: Unsigned `<=` on `u128Val`.
: @dc l8589980762
pub v/b/le u128Val/a u128Val/b
    test
        in structNew u128Val: u64:6 u64:2 :: structNew u128Val: u64:6 u64:2 ::
        out true.
    not lt /b /a.

: Unsigned `>` on `u128Val`.
: @dc l8589980763
pub v/b/gt u128Val/a u128Val/b
    test
        in structNew u128Val: u64:0 u64:1 :: structNew u128Val: u64:99 u64:0 ::
        out true.
    lt /b /a.

: Unsigned `>=` on `u128Val`.
: @dc l8589980764
pub v/b/ge u128Val/a u128Val/b
    test
        in structNew u128Val: u64:5 u64:1 :: structNew u128Val: u64:5 u64:1 ::
        out true.
    not lt /a /b.

: Wrapping `2^128` addition.
: @dc l8589980765
pub v/u128Val/wrapSum u128Val/a u128Val/b
    test
        in structNew u128Val: u64:18446744073709551615 u64:0 :: structNew u128Val: u64:2 u64:0 ::
        out structNew u128Val: u64:1 u64:1 ::.
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 :: structNew u128Val: u64:1 u64:0 ::
        out structNew u128Val: u64:0 u64:0 ::.
    be u64/lo wrapSum field /a u32:0 field /b u32:0.
    be u64/carry if lt /lo field /a u32:0 u64:1 u64:0.
    be u64/hi wrapSum wrapSum field /a u32:1 field /b u32:1 /carry.
    structNew u128Val: /lo /hi ::.

: Wrapping `2^128` subtraction.
: @dc l8589980766
pub v/u128Val/wrapDiff u128Val/a u128Val/b
    test
        in structNew u128Val: u64:1 u64:1 :: structNew u128Val: u64:2 u64:0 ::
        out structNew u128Val: u64:18446744073709551615 u64:0 ::.
        in structNew u128Val: u64:0 u64:0 :: structNew u128Val: u64:1 u64:0 ::
        out structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 ::.
    be u64/lo wrapDiff field /a u32:0 field /b u32:0.
    be u64/borrow if lt field /a u32:0 field /b u32:0 u64:1 u64:0.
    be u64/hi wrapDiff wrapDiff field /a u32:1 field /b u32:1 /borrow.
    structNew u128Val: /lo /hi ::.

: Full widening `u64 * u64 -> u128Val` exact 128-bit product.
: @dc l8589980767
pub v/u128Val/mul64Wide u64/x u64/y
    test
        in u64:18446744073709551615 u64:18446744073709551615
        out structNew u128Val: u64:1 u64:18446744073709551614 ::.
        in u64:4294967296 u64:4294967296
        out structNew u128Val: u64:0 u64:1 ::.
    be u64/mask32 u64:4294967295.
    be u64/x0 bitAnd /x /mask32.
    be u64/x1 shr /x u32:32.
    be u64/y0 bitAnd /y /mask32.
    be u64/y1 shr /y u32:32.
    be u64/p00 prod /x0 /y0.
    be u64/p01 prod /x0 /y1.
    be u64/p10 prod /x1 /y0.
    be u64/p11 prod /x1 /y1.
    be u64/mid sum sum shr /p00 u32:32 bitAnd /p01 /mask32 bitAnd /p10 /mask32.
    be u64/lo bitOr bitAnd /p00 /mask32 shl bitAnd /mid /mask32 u32:32.
    be u64/hi sum /p11 sum shr /p01 u32:32 sum shr /p10 u32:32 shr /mid u32:32.
    structNew u128Val: /lo /hi ::.

: Wrapping `2^128` multiplication.
: @dc l8589980768
pub v/u128Val/wrapProd u128Val/a u128Val/b
    test
        in structNew u128Val: u64:18446744073709551615 u64:0 :: structNew u128Val: u64:2 u64:0 ::
        out structNew u128Val: u64:18446744073709551614 u64:1 ::.
        in structNew u128Val: u64:0 u64:1 :: structNew u128Val: u64:0 u64:1 ::
        out structNew u128Val: u64:0 u64:0 ::.
    be u128Val/lowProd mul64Wide field /a u32:0 field /b u32:0.
    be u64/cross wrapSum wrapProd field /a u32:0 field /b u32:1 wrapProd field /a u32:1 field /b u32:0.
    structNew u128Val: field /lowProd u32:0 wrapSum field /lowProd u32:1 /cross ::.

: Predicate returning true iff `a + b < 2^128`.
: @dc l8589980769
pub v/b/canAdd u128Val/a u128Val/b
    test
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 :: structNew u128Val: u64:0 u64:0 ::
        out true.
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 :: structNew u128Val: u64:1 u64:0 ::
        out false.
    ge wrapSum /a /b /a.

: Predicate returning true iff `a >= b`.
: @dc l8589980770
pub v/b/canSub u128Val/a u128Val/b
    test
        in structNew u128Val: u64:0 u64:0 :: structNew u128Val: u64:1 u64:0 ::
        out false.
    ge /a /b.

: Predicate returning true iff `a * b < 2^128`.
: @dc l8589980771
pub v/b/canMul u128Val/a u128Val/b
    test
        in structNew u128Val: u64:18446744073709551615 u64:0 :: structNew u128Val: u64:18446744073709551615 u64:0 ::
        out true.
        in structNew u128Val: u64:0 u64:1 :: structNew u128Val: u64:0 u64:1 ::
        out false.
        in structNew u128Val: u64:2 u64:0 :: structNew u128Val: u64:0 u64:9223372036854775808 ::
        out false.
    be u64/ahi field /a u32:1.
    be u64/bhi field /b u32:1.
    if and ne /ahi u64:0 ne /bhi u64:0
        return false
        nop.
    be u128Val/lowProd mul64Wide field /a u32:0 field /b u32:0.
    be u128Val/c1 mul64Wide field /a u32:0 /bhi.
    be u128Val/c2 mul64Wide /ahi field /b u32:0.
    be u64/cHi bitOr field /c1 u32:1 field /c2 u32:1.
    if ne /cHi u64:0
        return false
        nop.
    be u64/cLo bitOr field /c1 u32:0 field /c2 u32:0.
    be u64/sumHi wrapSum field /lowProd u32:1 /cLo.
    ge /sumHi field /lowProd u32:1.

: Predicate returning true iff `b != 0`.
: @dc l8589980772
pub v/b/canDiv u128Val/a u128Val/b
    test
        in structNew u128Val: u64:10 u64:0 :: structNew u128Val: u64:0 u64:0 ::
        out false.
    be u128Val/_unused /a.
    ne /b /u128Zero.

: Total StageR 3 `add` for `u128` (`tup: b u128Val u8 ::`).
: @dc l8589980773
pub v/tup: b u128Val u8 ::/tryAdd u128Val/a u128Val/b
    test
        in structNew u128Val: u64:5 u64:0 :: structNew u128Val: u64:7 u64:0 ::
        out tupNew: true structNew u128Val: u64:12 u64:0 :: u8:0 ::.
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 :: structNew u128Val: u64:1 u64:0 ::
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    be u128Val/sumVal wrapSum /a /b.
    if ge /sumVal /a
        tupNew: true /sumVal u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Total StageR 3 `sub` for `u128` (`tup: b u128Val u8 ::`).
: @dc l8589980774
pub v/tup: b u128Val u8 ::/trySub u128Val/a u128Val/b
    test
        in structNew u128Val: u64:10 u64:0 :: structNew u128Val: u64:3 u64:0 ::
        out tupNew: true structNew u128Val: u64:7 u64:0 :: u8:0 ::.
        in structNew u128Val: u64:0 u64:0 :: structNew u128Val: u64:1 u64:0 ::
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /a /b
        tupNew: true wrapDiff /a /b u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Total StageR 3 `mul` for `u128` (`tup: b u128Val u8 ::`).
: @dc l8589980775
pub v/tup: b u128Val u8 ::/tryMul u128Val/a u128Val/b
    test
        in structNew u128Val: u64:6 u64:0 :: structNew u128Val: u64:7 u64:0 ::
        out tupNew: true structNew u128Val: u64:42 u64:0 :: u8:0 ::.
        in structNew u128Val: u64:0 u64:1 :: structNew u128Val: u64:0 u64:1 ::
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if canMul /a /b
        tupNew: true wrapProd /a /b u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Bitwise AND on `u128Val`.
: @dc l8589980776
pub v/u128Val/bitAnd u128Val/a u128Val/b
    test
        in structNew u128Val: u64:15 u64:240 :: structNew u128Val: u64:7 u64:16 ::
        out structNew u128Val: u64:7 u64:16 ::.
    structNew u128Val: bitAnd field /a u32:0 field /b u32:0 bitAnd field /a u32:1 field /b u32:1 ::.

: Bitwise OR on `u128Val`.
: @dc l8589980777
pub v/u128Val/bitOr u128Val/a u128Val/b
    test
        in structNew u128Val: u64:1 u64:2 :: structNew u128Val: u64:4 u64:8 ::
        out structNew u128Val: u64:5 u64:10 ::.
    structNew u128Val: bitOr field /a u32:0 field /b u32:0 bitOr field /a u32:1 field /b u32:1 ::.

: Bitwise XOR on `u128Val`.
: @dc l8589980778
pub v/u128Val/bitXor u128Val/a u128Val/b
    test
        in structNew u128Val: u64:5 u64:10 :: structNew u128Val: u64:3 u64:12 ::
        out structNew u128Val: u64:6 u64:6 ::.
    structNew u128Val: bitXor field /a u32:0 field /b u32:0 bitXor field /a u32:1 field /b u32:1 ::.

: Bitwise NOT on `u128Val`.
: @dc l8589980779
pub v/u128Val/bitNot u128Val/a
    test
        in structNew u128Val: u64:0 u64:18446744073709551615 ::
        out structNew u128Val: u64:18446744073709551615 u64:0 ::.
    structNew u128Val: bitNot field /a u32:0 bitNot field /a u32:1 ::.

: Internal raw left shift for `0 <= cnt < 128`.
: @dc l8589980780
pub v/u128Val/u128ShlRaw u128Val/a u32/cnt
    test
        in structNew u128Val: u64:1 u64:0 :: u32:64
        out structNew u128Val: u64:0 u64:1 ::.
        in structNew u128Val: u64:3 u64:0 :: u32:63
        out structNew u128Val: u64:9223372036854775808 u64:1 ::.
    be u64/lo field /a u32:0.
    be u64/hi field /a u32:1.
    if eq /cnt u32:0
        /a
        if lt /cnt u32:64
            structNew u128Val: shl /lo /cnt bitOr shl /hi /cnt shr /lo diff u32:64 /cnt ::
            if eq /cnt u32:64
                structNew u128Val: u64:0 /lo ::
                structNew u128Val: u64:0 shl /lo diff /cnt u32:64 ::.

: Internal raw logical right shift for `0 <= cnt < 128`.
: @dc l8589980781
pub v/u128Val/u128ShrRaw u128Val/a u32/cnt
    test
        in structNew u128Val: u64:0 u64:1 :: u32:64
        out structNew u128Val: u64:1 u64:0 ::.
        in structNew u128Val: u64:9223372036854775808 u64:1 :: u32:63
        out structNew u128Val: u64:3 u64:0 ::.
    be u64/lo field /a u32:0.
    be u64/hi field /a u32:1.
    if eq /cnt u32:0
        /a
        if lt /cnt u32:64
            structNew u128Val: bitOr shr /lo /cnt shl /hi diff u32:64 /cnt shr /hi /cnt ::
            if eq /cnt u32:64
                structNew u128Val: /hi u64:0 ::
                structNew u128Val: shr /hi diff /cnt u32:64 u64:0 ::.

: Total StageR 3 `shl` for `u128` (`tup: b u128Val u8 ::`, returning `errOverflow` when `cnt >= 128`).
: @dc l8589980782
pub v/tup: b u128Val u8 ::/tryShl u128Val/a u32/cnt
    test
        in structNew u128Val: u64:1 u64:0 :: u32:127
        out tupNew: true structNew u128Val: u64:0 u64:9223372036854775808 :: u8:0 ::.
        in structNew u128Val: u64:1 u64:0 :: u32:128
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /cnt u32:128
        tupNew: false /u128Zero /errOverflow ::
        tupNew: true u128ShlRaw /a /cnt u8:0 ::.

: Total StageR 3 `shr` for `u128` (`tup: b u128Val u8 ::`, returning `errOverflow` when `cnt >= 128`).
: @dc l8589980783
pub v/tup: b u128Val u8 ::/tryShr u128Val/a u32/cnt
    test
        in structNew u128Val: u64:8 u64:0 :: u32:127
        out tupNew: true structNew u128Val: u64:0 u64:0 :: u8:0 ::.
        in structNew u128Val: u64:8 u64:0 :: u32:128
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
    if ge /cnt u32:128
        tupNew: false /u128Zero /errOverflow ::
        tupNew: true u128ShrRaw /a /cnt u8:0 ::.

: Rotate left on `u128Val` (`cnt` masked modulo 128).
: @dc l8589980784
pub v/u128Val/rotl u128Val/a u32/cnt
    test
        in structNew u128Val: u64:0 u64:9223372036854775808 :: u32:1
        out structNew u128Val: u64:1 u64:0 ::.
        in structNew u128Val: u64:5 u64:7 :: u32:128
        out structNew u128Val: u64:5 u64:7 ::.
    be u32/k bitAnd /cnt u32:127.
    if eq /k u32:0
        /a
        bitOr u128ShlRaw /a /k u128ShrRaw /a diff u32:128 /k.

: Rotate right on `u128Val` (`cnt` masked modulo 128).
: @dc l8589980785
pub v/u128Val/rotr u128Val/a u32/cnt
    test
        in structNew u128Val: u64:1 u64:0 :: u32:1
        out structNew u128Val: u64:0 u64:9223372036854775808 ::.
    be u32/k bitAnd /cnt u32:127.
    if eq /k u32:0
        /a
        bitOr u128ShrRaw /a /k u128ShlRaw /a diff u32:128 /k.

: Count leading zeros (`0..=128`).
: @dc l8589980786
pub v/u32/clz u128Val/a
    test
        in structNew u128Val: u64:0 u64:0 ::
        out u32:128.
        in structNew u128Val: u64:1 u64:0 ::
        out u32:127.
        in structNew u128Val: u64:0 u64:9223372036854775808 ::
        out u32:0.
    be u64/hi field /a u32:1.
    if ne /hi u64:0
        clz /hi
        sum u32:64 clz field /a u32:0.

: Count trailing zeros (`0..=128`).
: @dc l8589980787
pub v/u32/ctz u128Val/a
    test
        in structNew u128Val: u64:0 u64:0 ::
        out u32:128.
        in structNew u128Val: u64:0 u64:1 ::
        out u32:64.
    be u64/lo field /a u32:0.
    if ne /lo u64:0
        ctz /lo
        sum u32:64 ctz field /a u32:1.

: Population count (`0..=128`).
: @dc l8589980788
pub v/u32/popcnt u128Val/a
    test
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 ::
        out u32:128.
        in structNew u128Val: u64:3 u64:5 ::
        out u32:4.
    sum popcnt field /a u32:0 popcnt field /a u32:1.

: Extracts bit `idx` (`0..=127`) as `u64:0` or `u64:1`.
: @dc l8589980789
v/u64/u128BitAt u128Val/a u32/idx
    if lt /idx u32:64
        bitAnd shr field /a u32:0 /idx u64:1
        bitAnd shr field /a u32:1 diff /idx u32:64 u64:1.

: Sets bit `idx` (`0..=127`) in `a`.
: @dc l8589980790
v/u128Val/u128SetBit u128Val/a u32/idx
    if lt /idx u32:64
        structNew u128Val: bitOr field /a u32:0 shl u64:1 /idx field /a u32:1 ::
        structNew u128Val: field /a u32:0 bitOr field /a u32:1 shl u64:1 diff /idx u32:64 ::.

: Combined total unsigned division and remainder `(ok, quot, rem, err)`.
: @dc l8589980791
pub v/tup: b u128Val u128Val u8 ::/u128DivMod u128Val/a u128Val/b
    test
        in structNew u128Val: u64:100 u64:0 :: structNew u128Val: u64:0 u64:0 ::
        out tupNew: false structNew u128Val: u64:0 u64:0 :: structNew u128Val: u64:0 u64:0 :: u8:1 ::.
        in structNew u128Val: u64:100 u64:0 :: structNew u128Val: u64:7 u64:0 ::
        out tupNew: true structNew u128Val: u64:14 u64:0 :: structNew u128Val: u64:2 u64:0 :: u8:0 ::.
        in structNew u128Val: u64:5 u64:10 :: structNew u128Val: u64:0 u64:3 ::
        out tupNew: true structNew u128Val: u64:3 u64:0 :: structNew u128Val: u64:5 u64:1 :: u8:0 ::.
        in structNew u128Val: u64:18446744073709551615 u64:18446744073709551615 :: structNew u128Val: u64:1 u64:9223372036854775808 ::
        out tupNew: true structNew u128Val: u64:1 u64:0 :: structNew u128Val: u64:18446744073709551614 u64:9223372036854775807 :: u8:0 ::.
    if eq /b /u128Zero
        return tupNew: false /u128Zero /u128Zero /errDivisionByZero ::
        nop.
    if lt /a /b
        return tupNew: true /u128Zero /a u8:0 ::
        nop.
    if and eq field /a u32:1 u64:0 eq field /b u32:1 u64:0
        do
            be u64/alo field /a u32:0.
            be u64/blo field /b u32:0.
            return tupNew: true structNew u128Val: quot /alo /blo u64:0 :: structNew u128Val: rem /alo /blo u64:0 :: u8:0 ::.
        ::
        nop.
    hold u128Val/quotVal /u128Zero.
    hold u128Val/remVal /u128Zero.
    hold i32/bit i32:127.
    be u64/msbMask u64:9223372036854775808.
    while ge /bit i32:0 do
        be u32/uBit conv /bit u32.
        be b/remMsb ne bitAnd field /remVal u32:1 /msbMask u64:0.
        be u64/inBit u128BitAt /a /uBit.
        become /remVal bitOr u128ShlRaw /remVal u32:1 structNew u128Val: /inBit u64:0 ::.
        if or /remMsb ge /remVal /b
            do
                become /remVal wrapDiff /remVal /b.
                become /quotVal u128SetBit /quotVal /uBit.
            ::
            nop.
        become /bit diff /bit i32:1.
    ::.
    tupNew: true /quotVal /remVal u8:0 ::.

: Total StageR 3 `div` for `u128` (`tup: b u128Val u8 ::`).
