pub v/tup: b u128Val u8 ::/tryDiv u128Val/a u128Val/b
    test
        in structNew u128Val: u64:100 u64:0 :: structNew u128Val: u64:7 u64:0 ::
        out tupNew: true structNew u128Val: u64:14 u64:0 :: u8:0 ::.
    be tup: b u128Val u128Val u8 ::/dm u128DivMod /a /b.
    tupNew: field /dm u32:0 field /dm u32:1 field /dm u32:3 ::.

