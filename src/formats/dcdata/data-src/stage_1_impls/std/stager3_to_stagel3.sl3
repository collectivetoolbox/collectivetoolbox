: Resolves a `symRef` in module `modIdx` to a canonical type `(rTypeKind: 21..24, defIdx)`.
: @dc l8589983070
v/tup: u8 u32 ::/resolveTypeSym compEnv/env modScope/mScope b/isStageR symRef/sym
    be u32/modIdx field /mScope u32:0.
    if field /sym u32:0
        do
            be dcVal/targetDc field /sym u32:1.
            hold u64/i u64:0.
            be l/s1StructDef/s1s field /env u32:3.
            while lt /i len /s1s do
                be s1StructDef/d at /s1s /i.
                be tup: b dcVal ::/od field /d u32:2.
                if and field /od u32:0 eq field /od u32:1 /targetDc
                    return tupNew: u8:21 conv /i u32 ::
                    nop.
                become /i sum /i u64:1.
            ::.
            if not /isStageR fault nop.
            become /i u64:0.
            be l/namedStructDef/nss field /env u32:4.
            while lt /i len /nss do
                be namedStructDef/d at /nss /i.
                be tup: b dcVal ::/od field /d u32:2.
                if and field /od u32:0 eq field /od u32:1 /targetDc
                    return tupNew: u8:22 conv /i u32 ::
                    nop.
                become /i sum /i u64:1.
            ::.
            become /i u64:0.
            be l/brandDef/bs field /env u32:5.
            while lt /i len /bs do
                be brandDef/d at /bs /i.
                be tup: b dcVal ::/od field /d u32:3.
                if and field /od u32:0 eq field /od u32:1 /targetDc
                    return tupNew: u8:23 conv /i u32 ::
                    nop.
                become /i sum /i u64:1.
            ::.
            become /i u64:0.
            be l/enumDef/es field /env u32:6.
            while lt /i len /es do
                be enumDef/d at /es /i.
                be tup: b dcVal ::/od field /d u32:2.
                if and field /od u32:0 eq field /od u32:1 /targetDc
                    return tupNew: u8:24 conv /i u32 ::
                    nop.
                become /i sum /i u64:1.
            ::.
            fault.
        ::
        do
            be l/u8/name field /sym u32:2.
            hold u64/i u64:0.
            be l/s1StructDef/s1s field /env u32:3.
            while lt /i len /s1s do
                be s1StructDef/d at /s1s /i.
                if and eq field /d u32:0 /modIdx eq field /d u32:3 /name
                    return tupNew: u8:21 conv /i u32 ::
                    nop.
                become /i sum /i u64:1.
            ::.
            if /isStageR
                do
                    become /i u64:0.
                    be l/namedStructDef/nss field /env u32:4.
                    while lt /i len /nss do
                        be namedStructDef/d at /nss /i.
                        if and eq field /d u32:0 /modIdx eq field /d u32:3 /name
                            return tupNew: u8:22 conv /i u32 ::
                            nop.
                        become /i sum /i u64:1.
                    ::.
                    become /i u64:0.
                    be l/brandDef/bs field /env u32:5.
                    while lt /i len /bs do
                        be brandDef/d at /bs /i.
                        if and eq field /d u32:0 /modIdx eq field /d u32:4 /name
                            return tupNew: u8:23 conv /i u32 ::
                            nop.
                        become /i sum /i u64:1.
                    ::.
                    become /i u64:0.
                    be l/enumDef/es field /env u32:6.
                    while lt /i len /es do
                        be enumDef/d at /es /i.
                        if and eq field /d u32:0 /modIdx eq field /d u32:3 /name
                            return tupNew: u8:24 conv /i u32 ::
                            nop.
                        become /i sum /i u64:1.
                    ::.
                ::
                nop.
            foreach aliasEntry/ae field /mScope u32:1 do
                if and eq field /ae u32:0 /name le field /ae u32:1 u8:3
                    do
                        if and not /isStageR gt field /ae u32:1 u8:0 fault nop.
                        return tupNew: sum u8:21 field /ae u32:1 field /ae u32:2 ::.
                    ::
                    nop.
            ::.
            fault.
        ::.

: @dc l8589983071
v/rType/canonType compEnv/env modScope/mScope b/isStageR rawType/rt
    be u8/k field /rt u32:0.
    if le /k u8:15
        return primType /k
        nop.
    if and ge /k u8:16 le /k u8:20
        do
            be l/rawType/subs field /rt u32:2.
            be buf/rType/csubs bufNew rType len /subs.
            foreach rawType/sub /subs do
                if and /isStageR eq field /sub u32:0 u8:17 fault nop.
                bufGain /csubs canonType /env /mScope /isStageR /sub.
            ::.
            return structNew rType: /k u32:0 bufFrozen /csubs ::.
        ::
        nop.
    if or eq /k u8:21 eq /k u8:22
        do
            if and not /isStageR eq /k u8:22 fault nop.
            be tup: u8 u32 ::/res resolveTypeSym /env /mScope /isStageR field /rt u32:1.
            return structNew rType: field /res u32:0 field /res u32:1 l/rType: :: ::.
        ::
        nop.
    fault.

: Checks whether two StageR types lower to identical StageL 3 parameter types (for overload disambiguation).
: @dc l8589983072
v/b/sameLoweredShape compEnv/env rType/a rType/b
    be u8/ka field /a u32:0.
    be u8/kb field /b u32:0.
    if and or eq /ka u8:13 eq /ka u8:14 or eq /kb u8:13 eq /kb u8:14
        return true
        nop.
    if and or eq /ka u8:3 eq /ka u8:15 or eq /kb u8:3 eq /kb u8:15
        return true
        nop.
    if and eq /ka u8:19 eq /kb u8:18
        do
            be l/rType/sb field /b u32:2.
            return and eq len /sb u64:2
                and sameLoweredShape /env primType u8:2 at /sb u64:0
                    sameLoweredShape /env at field /a u32:2 u64:0 at /sb u64:1.
        ::
        nop.
    if and eq /ka u8:18 eq /kb u8:19
        return sameLoweredShape /env /b /a
        nop.
    if and eq /ka u8:20 eq /kb u8:18
        do
            be rType/okA at field /a u32:2 u64:0.
            be l/rType/sb field /b u32:2.
            if eq field /okA u32:0 u8:0
                return and eq len /sb u64:2
                    and sameLoweredShape /env primType u8:2 at /sb u64:0
                        sameLoweredShape /env primType u8:3 at /sb u64:1
                return and eq len /sb u64:3
                    and sameLoweredShape /env primType u8:2 at /sb u64:0
                        and sameLoweredShape /env /okA at /sb u64:1
                            sameLoweredShape /env primType u8:3 at /sb u64:2.
        ::
        nop.
    if and eq /ka u8:18 eq /kb u8:20
        return sameLoweredShape /env /b /a
        nop.
    if eq /ka u8:16
        do
            if or eq /kb u8:13 eq /kb u8:14
                return sameLoweredShape /env at field /a u32:2 u64:0 primType u8:12
                nop.
        ::
        nop.
    if eq /kb u8:16
        do
            if or eq /ka u8:13 eq /ka u8:14
                return sameLoweredShape /env primType u8:12 at field /b u32:2 u64:0
                nop.
        ::
        nop.
    if ne /ka /kb
        return false
        nop.
    if ne field /a u32:1 field /b u32:1
        return false
        nop.
    be l/rType/sa field /a u32:2.
    be l/rType/sb field /b u32:2.
    if ne len /sa len /sb
        return false
        nop.
    hold u64/i u64:0.
    while lt /i len /sa do
        if not sameLoweredShape /env at /sa /i at /sb /i
            return false
            nop.
        become /i sum /i u64:1.
    ::.
    true.

: @dc l8589983073
v/b/sameLoweredParams compEnv/env l/rType/pa l/rType/pb
    if ne len /pa len /pb
        return false
        nop.
    hold u64/i u64:0.
    while lt /i len /pa do
        if not sameLoweredShape /env at /pa /i at /pb /i
            return false
            nop.
        become /i sum /i u64:1.
    ::.
    true.

: Checks unguarded value-type recursion across named structs, brands, and enums.
: @dc l8589983074
v/void/collectDirectTypeEdges rType/ty buf/u64/edges
    be u8/k field /ty u32:0.
    if or eq /k u8:18 or eq /k u8:19 eq /k u8:20
        do
            foreach rType/sub field /ty u32:2 do
                collectDirectTypeEdges /sub /edges.
            ::.
            return.
        ::
        nop.
    if and ge /k u8:21 le /k u8:24
        do
            be u64/node bitOr shl conv diff /k u8:21 u64 u32:32 conv field /ty u32:1 u64.
            bufGain /edges /node.
        ::
        nop.

: @dc l8589983075
v/b/u64ListContains l/u64/xs u64/target
    foreach u64/x /xs do
        if eq /x /target return true nop.
    ::.
    false.

: @dc l8589983076
v/void/checkTypeNoCycleFrom compEnv/env u64/node l/u64/stack
    if u64ListContains /stack /node
        fault
        nop.
    be l/u64/nextStack chain /stack l/u64: /node ::.
    be u8/kind conv shr /node u32:32 u8.
    be u64/idx bitAnd /node u64:4294967295.
    be buf/u64/edges bufNew u64 u64:4.
    if eq /kind u8:0
        do
            be s1StructDef/d at field /env u32:3 /idx.
            foreach rType/ft field /d u32:4 do
                collectDirectTypeEdges /ft /edges.
            ::.
        ::
        if eq /kind u8:1
            do
                be namedStructDef/d at field /env u32:4 /idx.
                foreach namedFieldDef/nf field /d u32:4 do
                    collectDirectTypeEdges field /nf u32:1 /edges.
                ::.
            ::
            if eq /kind u8:2
                do
                    be brandDef/d at field /env u32:5 /idx.
                    collectDirectTypeEdges field /d u32:5 /edges.
                ::
                do
                    be enumDef/d at field /env u32:6 /idx.
                    foreach rType/st field /d u32:5 do
                        collectDirectTypeEdges /st /edges.
                    ::.
                ::.
    be l/u64/frozen bufFrozen /edges.
    foreach u64/child /frozen do
        checkTypeNoCycleFrom /env /child /nextStack.
    ::.

: @dc l8589983077
v/void/checkAllTypeCycles compEnv/env
    hold u64/i u64:0.
    while lt /i len field /env u32:4 do
        checkTypeNoCycleFrom /env bitOr shl u64:1 u32:32 /i l/u64: ::.
        become /i sum /i u64:1.
    ::.
    become /i u64:0.
    while lt /i len field /env u32:5 do
        checkTypeNoCycleFrom /env bitOr shl u64:2 u32:32 /i l/u64: ::.
        become /i sum /i u64:1.
    ::.
    become /i u64:0.
    while lt /i len field /env u32:6 do
        checkTypeNoCycleFrom /env bitOr shl u64:3 u32:32 /i l/u64: ::.
        become /i sum /i u64:1.
    ::.

: Builds the complete multi-module `compEnv` and per-module `modScope` list.
: @dc l8589983078
v/tup: compEnv l/modScope ::/buildCompEnv l/parsedMod/mods
    be u64/mCount len /mods.
    be buf/b/isSrBuf bufNew b /mCount.
    be buf/l/l/dcVal/nsSegsBuf bufNew l/l/dcVal /mCount.
    be buf/l/u8/nsKeysBuf bufNew l/u8 /mCount.

    be buf/s1StructDef/s1Stubs bufNew s1StructDef u64:8.
    be buf/namedStructDef/nsStubs bufNew namedStructDef u64:8.
    be buf/brandDef/bStubs bufNew brandDef u64:8.
    be buf/enumDef/eStubs bufNew enumDef u64:8.

    hold u64/mi u64:0.
    while lt /mi /mCount do
        be parsedMod/pm at /mods /mi.
        be u32/mIdx conv /mi u32.
        if field /pm u32:3
            do
                hold u64/prev u64:0.
                while lt /prev /mi do
                    be parsedMod/ppm at /mods /prev.
                    if and field /ppm u32:3 and eq field /ppm u32:5 field /pm u32:5 and field /ppm u32:0 not field /pm u32:0
                        fault
                        nop.
                    become /prev sum /prev u64:1.
                ::.
            ::
            if field /pm u32:0
                do
                    foreach rawStruct/ns field /pm u32:8 do
                        if field /ns u32:0 fault nop.
                    ::.
                    foreach rawBrand/rb field /pm u32:9 do
                        if field /rb u32:0 fault nop.
                    ::.
                    foreach rawEnum/re field /pm u32:10 do
                        if field /re u32:0 fault nop.
                    ::.
                    foreach rawConst/rc field /pm u32:11 do
                        if field /rc u32:0 fault nop.
                    ::.
                    foreach rawRoutine/rr field /pm u32:12 do
                        if field /rr u32:0 fault nop.
                    ::.
                ::
                nop.
        bufGain /isSrBuf field /pm u32:0.
        bufGain /nsSegsBuf field /pm u32:4.
        bufGain /nsKeysBuf field /pm u32:5.

        foreach rawStruct/rs field /pm u32:7 do
            bufGain /s1Stubs structNew s1StructDef: /mIdx field /rs u32:0 field /rs u32:1 field /rs u32:2 l/rType: :: ::.
        ::.
        foreach rawStruct/ns field /pm u32:8 do
            bufGain /nsStubs structNew namedStructDef: /mIdx field /ns u32:0 field /ns u32:1 field /ns u32:2 l/namedFieldDef: :: ::.
        ::.
        foreach rawBrand/rb field /pm u32:9 do
            bufGain /bStubs structNew brandDef: /mIdx field /rb u32:0 field /rb u32:1 field /rb u32:2 field /rb u32:3 primType u8:0 ::.
        ::.
        foreach rawEnum/re field /pm u32:10 do
            bufGain /eStubs structNew enumDef: /mIdx field /re u32:0 field /re u32:1 field /re u32:2 l/enumVarDef: :: l/rType: :: ::.
        ::.
        become /mi sum /mi u64:1.
    ::.

    be l/b/isSrList bufFrozen /isSrBuf.
    be l/l/l/dcVal/nsSegsList bufFrozen /nsSegsBuf.
    be l/l/u8/nsKeysList bufFrozen /nsKeysBuf.
    be l/s1StructDef/s1StubList bufFrozen /s1Stubs.
    be l/namedStructDef/nsStubList bufFrozen /nsStubs.
    be l/brandDef/bStubList bufFrozen /bStubs.
    be l/enumDef/eStubList bufFrozen /eStubs.

    : Resolve type aliases per module first so type canonicalization has all imported types.
    be buf/l/aliasEntry/typeAliasesPerMod bufNew l/aliasEntry /mCount.
    become /mi u64:0.
    while lt /mi /mCount do
        be parsedMod/pm at /mods /mi.
        be buf/aliasEntry/als bufNew aliasEntry u64:8.
        foreach useItem/ui field /pm u32:6 do
            be l/u8/depKey field /ui u32:1.
            hold b/foundDep false.
            be symRef/ts field /ui u32:2.
            be l/u8/alRaw field /ui u32:3.
            hold u64/di u64:0.
            while lt /di /mi do
                be parsedMod/dpm at /mods /di.
                if and field /dpm u32:3 eq field /dpm u32:5 /depKey
                    do
                        become /foundDep true.
                        be u32/depMod conv /di u32.
                        if field /ts u32:0
                            do
                                if gt len /alRaw u64:0
                                    do
                                        be dcVal/tdc field /ts u32:1.
                                        hold u64/k u64:0.
                                        while lt /k len /s1StubList do
                                            be s1StructDef/d at /s1StubList /k.
                                            be tup: b dcVal ::/od field /d u32:2.
                                            if and eq field /d u32:0 /depMod and field /d u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:0 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                        become /k u64:0.
                                        while lt /k len /nsStubList do
                                            be namedStructDef/d at /nsStubList /k.
                                            be tup: b dcVal ::/od field /d u32:2.
                                            if and eq field /d u32:0 /depMod and field /d u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:1 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                        become /k u64:0.
                                        while lt /k len /bStubList do
                                            be brandDef/d at /bStubList /k.
                                            be tup: b dcVal ::/od field /d u32:3.
                                            if and eq field /d u32:0 /depMod and field /d u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:2 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                        become /k u64:0.
                                        while lt /k len /eStubList do
                                            be enumDef/d at /eStubList /k.
                                            be tup: b dcVal ::/od field /d u32:2.
                                            if and eq field /d u32:0 /depMod and field /d u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:3 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                    ::
                                    nop.
                            ::
                            do
                                be l/u8/orig field /ts u32:2.
                                be l/u8/localName if eq len /alRaw u64:0 /orig /alRaw.
                                hold u64/k u64:0.
                                while lt /k len /s1StubList do
                                    be s1StructDef/d at /s1StubList /k.
                                    if and eq field /d u32:0 /depMod and field /d u32:1 eq field /d u32:3 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:0 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                                become /k u64:0.
                                while lt /k len /nsStubList do
                                    be namedStructDef/d at /nsStubList /k.
                                    if and eq field /d u32:0 /depMod and field /d u32:1 eq field /d u32:3 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:1 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                                become /k u64:0.
                                while lt /k len /bStubList do
                                    be brandDef/d at /bStubList /k.
                                    if and eq field /d u32:0 /depMod and field /d u32:1 eq field /d u32:4 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:2 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                                become /k u64:0.
                                while lt /k len /eStubList do
                                    be enumDef/d at /eStubList /k.
                                    if and eq field /d u32:0 /depMod and field /d u32:1 eq field /d u32:3 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:3 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                            ::.
                    ::
                    nop.
                become /di sum /di u64:1.
            ::.
            if and not /foundDep field /pm u32:0
                fault
                nop.
        ::.
        bufGain /typeAliasesPerMod bufFrozen /als.
        become /mi sum /mi u64:1.
    ::.
    be l/l/aliasEntry/typeAliasLists bufFrozen /typeAliasesPerMod.

    be compEnv/stubEnv structNew compEnv:
        /isSrList /nsSegsList /nsKeysList /s1StubList /nsStubList /bStubList /eStubList
        l/valDef: :: l/routDef: ::
    ::.

    : Canonicalize all struct, brand, enum, constant, and routine signatures.
    be buf/s1StructDef/s1Full bufNew s1StructDef len /s1StubList.
    be buf/namedStructDef/nsFull bufNew namedStructDef len /nsStubList.
    be buf/brandDef/bFull bufNew brandDef len /bStubList.
    be buf/enumDef/eFull bufNew enumDef len /eStubList.

    become /mi u64:0.
    while lt /mi /mCount do
        be parsedMod/pm at /mods /mi.
        be b/isSr field /pm u32:0.
        be u32/mIdx conv /mi u32.
        be modScope/tScope structNew modScope: /mIdx at /typeAliasLists /mi l/synthImport: :: ::.

        foreach rawStruct/rs field /pm u32:7 do
            be buf/rType/fts bufNew rType len field /rs u32:3.
            foreach fieldDecl/fd field /rs u32:3 do
                bufGain /fts canonType /stubEnv /tScope /isSr field /fd u32:1.
            ::.
            bufGain /s1Full structNew s1StructDef: /mIdx field /rs u32:0 field /rs u32:1 field /rs u32:2 bufFrozen /fts ::.
        ::.

        foreach rawStruct/ns field /pm u32:8 do
            be buf/namedFieldDef/nfs bufNew namedFieldDef len field /ns u32:3.
            hold u64/fi u64:0.
            while lt /fi len field /ns u32:3 do
                be fieldDecl/fd at field /ns u32:3 /fi.
                hold u64/fj u64:0.
                while lt /fj /fi do
                    if eq field at field /ns u32:3 /fj u32:0 field /fd u32:0 fault nop.
                    become /fj sum /fj u64:1.
                ::.
                be rType/fty canonType /stubEnv /tScope true field /fd u32:1.
                if eq field /fty u32:0 u8:17 fault nop.
                bufGain /nfs structNew namedFieldDef: field /fd u32:0 /fty ::.
                become /fi sum /fi u64:1.
            ::.
            bufGain /nsFull structNew namedStructDef: /mIdx field /ns u32:0 field /ns u32:1 field /ns u32:2 bufFrozen /nfs ::.
        ::.

        foreach rawBrand/rb field /pm u32:9 do
            be rType/bty canonType /stubEnv /tScope true field /rb u32:4.
            if eq field /bty u32:0 u8:17 fault nop.
            bufGain /bFull structNew brandDef:
                /mIdx field /rb u32:0 field /rb u32:1 field /rb u32:2 field /rb u32:3
                /bty
            ::.
        ::.

        foreach rawEnum/re field /pm u32:10 do
            be l/variantDecl/rawVars field /re u32:3.
            be buf/enumVarDef/evs bufNew enumVarDef len /rawVars.
            be buf/rType/slots bufNew rType len /rawVars.
            hold u64/vi u64:0.
            while lt /vi len /rawVars do
                be variantDecl/vd at /rawVars /vi.
                hold u64/vj u64:0.
                while lt /vj /vi do
                    if eq field at /rawVars /vj u32:0 field /vd u32:0 fault nop.
                    become /vj sum /vj u64:1.
                ::.
                if field /vd u32:1
                    do
                        be rType/pty canonType /stubEnv /tScope true field /vd u32:2.
                        if eq field /pty u32:0 u8:17 fault nop.
                        be u32/slotIdx conv len /slots u32.
                        bufGain /slots /pty.
                        bufGain /evs structNew enumVarDef: field /vd u32:0 true /pty /slotIdx ::.
                    ::
                    bufGain /evs structNew enumVarDef: field /vd u32:0 false primType u8:0 u32:0 ::.
                become /vi sum /vi u64:1.
            ::.
            bufGain /eFull structNew enumDef: /mIdx field /re u32:0 field /re u32:1 field /re u32:2 bufFrozen /evs bufFrozen /slots ::.
        ::.
        become /mi sum /mi u64:1.
    ::.

    be l/s1StructDef/s1List bufFrozen /s1Full.
    be l/namedStructDef/nsList bufFrozen /nsFull.
    be l/brandDef/bList bufFrozen /bFull.
    be l/enumDef/eList bufFrozen /eFull.

    be compEnv/typedEnv structNew compEnv:
        /isSrList /nsSegsList /nsKeysList /s1List /nsList /bList /eList
        l/valDef: :: l/routDef: ::
    ::.
    checkAllTypeCycles /typedEnv.

    : Reject duplicate `pub` type names across namespace strata.
    be buf/tup: u32 l/u8 ::/pubTypeBuf bufNew tup: u32 l/u8 :: u64:32.
    foreach s1StructDef/d /s1List do
        if and field /d u32:1 field at /mods conv field /d u32:0 u64 u32:3
            bufGain /pubTypeBuf tupNew: field /d u32:0 field /d u32:3 ::
            nop.
    ::.
    foreach namedStructDef/d /nsList do
        if and field /d u32:1 field at /mods conv field /d u32:0 u64 u32:3
            bufGain /pubTypeBuf tupNew: field /d u32:0 field /d u32:3 ::
            nop.
    ::.
    foreach brandDef/d /bList do
        if and field /d u32:1 field at /mods conv field /d u32:0 u64 u32:3
            bufGain /pubTypeBuf tupNew: field /d u32:0 field /d u32:4 ::
            nop.
    ::.
    foreach enumDef/d /eList do
        if and field /d u32:1 field at /mods conv field /d u32:0 u64 u32:3
            bufGain /pubTypeBuf tupNew: field /d u32:0 field /d u32:3 ::
            nop.
    ::.
    be l/tup: u32 l/u8 ::/pubTypeList bufFrozen /pubTypeBuf.
    hold u64/pti u64:0.
    while lt /pti len /pubTypeList do
        be tup: u32 l/u8 ::/ta at /pubTypeList /pti.
        hold u64/ptj u64:0.
        while lt /ptj /pti do
            be tup: u32 l/u8 ::/tb at /pubTypeList /ptj.
            if and ne field /ta u32:0 field /tb u32:0 and eq at /nsKeysList conv field /ta u32:0 u64 at /nsKeysList conv field /tb u32:0 u64 eq field /ta u32:1 field /tb u32:1
                fault
                nop.
            become /ptj sum /ptj u64:1.
        ::.
        become /pti sum /pti u64:1.
    ::.

    : Register top-level constants and routines (with StageL overload disambiguation).
    be buf/valDef/vFull bufNew valDef u64:16.
    be buf/routDef/rFull bufNew routDef u64:32.
    be buf/b/s1Fault bufNew b u64:32.
    be buf/l/exprNode/s1Calls bufNew l/exprNode u64:32.

    become /mi u64:0.
    while lt /mi /mCount do
        be parsedMod/pm at /mods /mi.
        be b/isSr field /pm u32:0.
        be u32/mIdx conv /mi u32.
        be modScope/tScope structNew modScope: /mIdx at /typeAliasLists /mi l/synthImport: :: ::.

        foreach rawConst/rc field /pm u32:11 do
            if and field /rc u32:0 field /pm u32:3
                do
                    hold u64/vk u64:0.
                    while lt /vk len /vFull do
                        be valDef/pvd at /vFull /vk.
                        if and ne field /pvd u32:0 /mIdx and field /pvd u32:1 and field at /mods conv field /pvd u32:0 u64 u32:3 and eq at /nsKeysList conv field /pvd u32:0 u64 field /pm u32:5 eq field /pvd u32:3 field /rc u32:3
                            fault
                            nop.
                        become /vk sum /vk u64:1.
                    ::.
                ::
                nop.
            be rType/rawCty canonType /typedEnv /tScope /isSr field /rc u32:2.
            if and /isSr eq field /rawCty u32:0 u8:17 fault nop.
            be rType/cty if /isSr /rawCty bridgeS1TypeForSr /nsKeysList /s1List /rawCty.
            bufGain /vFull structNew valDef: /mIdx field /rc u32:0 field /rc u32:1 field /rc u32:3 /cty ::.
        ::.

        hold u64/ri u64:0.
        be l/rawRoutine/rrouts field /pm u32:12.
        while lt /ri len /rrouts do
            be rawRoutine/rr at /rrouts /ri.
            be rType/rawRet canonType /typedEnv /tScope /isSr field /rr u32:2.
            if and /isSr eq field /rawRet u32:0 u8:17 fault nop.
            be rType/retTy if /isSr /rawRet bridgeS1TypeForSr /nsKeysList /s1List /rawRet.
            be buf/rType/ptys bufNew rType len field /rr u32:4.
            foreach paramDecl/pd field /rr u32:4 do
                be rType/rawPty canonType /typedEnv /tScope /isSr field /pd u32:0.
                if and /isSr eq field /rawPty u32:0 u8:17 fault nop.
                be rType/pty if /isSr /rawPty bridgeS1TypeForSr /nsKeysList /s1List /rawPty.
                bufGain /ptys /pty.
            ::.
            be l/rType/pList bufFrozen /ptys.
            be l/u8/origName field /rr u32:3.
            hold l/u8/emitName /origName.
            hold u64/rk u64:0.
            while lt /rk len /rFull do
                be routDef/prev at /rFull /rk.
                if eq field /prev u32:3 /origName
                    do
                        be u32/prevMod field /prev u32:0.
                        be b/sameMod eq /prevMod /mIdx.
                        be b/sameOverlayNs and not /sameMod and field /pm u32:3 and field at /mods conv /prevMod u64 u32:3 and eq at /nsKeysList conv /prevMod u64 field /pm u32:5 and field /rr u32:0 field /prev u32:1.
                        if /sameOverlayNs
                            do
                                if ne len field /prev u32:6 len /pList fault nop.
                                if eq field /prev u32:6 /pList fault nop.
                            ::
                            nop.
                        if and /isSr and or /sameMod /sameOverlayNs sameLoweredParams /typedEnv field /prev u32:6 /pList
                            become /emitName chain b"__sr_ovl_" chain u64ToAsciiDec conv /mIdx u64 chain b"_" chain u64ToAsciiDec /ri chain b"_" /origName
                            nop.
                    ::
                    nop.
                become /rk sum /rk u64:1.
            ::.
            bufGain /rFull structNew routDef:
                /mIdx field /rr u32:0 field /rr u32:1 /origName /emitName /retTy /pList
            ::.
            be exprNode/rBody field /rr u32:6.
            be b/initFault if /isSr false or ne field /rBody u32:1 u32:0 endsWithStageLInternal /origName.
            bufGain /s1Fault /initFault.
            bufGain /s1Calls if /isSr l/exprNode: :: field /rBody u32:7.
            become /ri sum /ri u64:1.
        ::.
        become /mi sum /mi u64:1.
    ::.

    be l/valDef/vList bufFrozen /vFull.
    be l/routDef/rRawList bufFrozen /rFull.
    be u64/rCount len /rRawList.
    hold b/mfChanged true.
    while /mfChanged do
        become /mfChanged false.
        hold u64/rci u64:0.
        while lt /rci /rCount do
            be routDef/caller at /rRawList /rci.
            be u32/cMod field /caller u32:0.
            if and not at /isSrList conv /cMod u64 not at /s1Fault /rci
                do
                    be parsedMod/cpm at /mods conv /cMod u64.
                    be l/exprNode/calls at /s1Calls /rci.
                    hold b/hitsFault false.
                    foreach exprNode/ce /calls do
                        be symRef/csym field /ce u32:5.
                        if field /csym u32:0
                            do
                                be dcVal/tdc field /csym u32:1.
                                hold u64/rk1 u64:0.
                                while lt /rk1 /rCount do
                                    be routDef/cand1 at /rRawList /rk1.
                                    be tup: b dcVal ::/cod1 field /cand1 u32:2.
                                    if and not at /isSrList conv field /cand1 u32:0 u64 and field /cod1 u32:0 eq field /cod1 u32:1 /tdc
                                        if at /s1Fault /rk1 become /hitsFault true nop
                                        nop.
                                    become /rk1 sum /rk1 u64:1.
                                ::.
                            ::
                            do
                                be l/u8/cname field /csym u32:2.
                                hold u64/rk2 u64:0.
                                while lt /rk2 /rCount do
                                    be routDef/cand2 at /rRawList /rk2.
                                    if and eq field /cand2 u32:0 /cMod eq field /cand2 u32:3 /cname
                                        if at /s1Fault /rk2 become /hitsFault true nop
                                        nop.
                                    become /rk2 sum /rk2 u64:1.
                                ::.
                                foreach useItem/ui field /cpm u32:6 do
                                    be l/u8/depKey field /ui u32:1.
                                    be symRef/ts field /ui u32:2.
                                    be l/u8/alRaw field /ui u32:3.
                                    hold u64/di u64:0.
                                    while lt /di conv /cMod u64 do
                                        be parsedMod/dpm at /mods /di.
                                        if and field /dpm u32:3 eq field /dpm u32:5 /depKey
                                            do
                                                be u32/depMod conv /di u32.
                                                if field /ts u32:0
                                                    do
                                                        if and gt len /alRaw u64:0 eq /alRaw /cname
                                                            do
                                                                be dcVal/tdc2 field /ts u32:1.
                                                                hold u64/rk3 u64:0.
                                                                while lt /rk3 /rCount do
                                                                    be routDef/cand3 at /rRawList /rk3.
                                                                    be tup: b dcVal ::/cod3 field /cand3 u32:2.
                                                                    if and eq field /cand3 u32:0 /depMod and field /cand3 u32:1 and field /cod3 u32:0 eq field /cod3 u32:1 /tdc2
                                                                        if at /s1Fault /rk3 become /hitsFault true nop
                                                                        nop.
                                                                    become /rk3 sum /rk3 u64:1.
                                                                ::.
                                                            ::
                                                            nop.
                                                    ::
                                                    do
                                                        be l/u8/orig field /ts u32:2.
                                                        be l/u8/localName if eq len /alRaw u64:0 /orig /alRaw.
                                                        if eq /localName /cname
                                                            do
                                                                hold u64/rk4 u64:0.
                                                                while lt /rk4 /rCount do
                                                                    be routDef/cand4 at /rRawList /rk4.
                                                                    if and eq field /cand4 u32:0 /depMod and field /cand4 u32:1 eq field /cand4 u32:3 /orig
                                                                        if at /s1Fault /rk4 become /hitsFault true nop
                                                                        nop.
                                                                    become /rk4 sum /rk4 u64:1.
                                                                ::.
                                                            ::
                                                            nop.
                                                    ::.
                                            ::
                                            nop.
                                        become /di sum /di u64:1.
                                    ::.
                                ::.
                            ::.
                    ::.
                    if /hitsFault
                        do
                            bufBecomeAt /s1Fault /rci true.
                            become /mfChanged true.
                        ::
                        nop.
                ::
                nop.
            become /rci sum /rci u64:1.
        ::.
    ::.

    be buf/routDef/rFinal bufNew routDef /rCount.
    hold u64/rfi u64:0.
    while lt /rfi /rCount do
        be routDef/curRd at /rRawList /rfi.
        be l/u8/finalEmit if and not at /isSrList conv field /curRd u32:0 u64 at /s1Fault /rfi b"" field /curRd u32:4.
        bufGain /rFinal structNew routDef:
            field /curRd u32:0 field /curRd u32:1 field /curRd u32:2 field /curRd u32:3 /finalEmit field /curRd u32:5 field /curRd u32:6
        ::.
        become /rfi sum /rfi u64:1.
    ::.
    be l/routDef/rList bufFrozen /rFinal.

    : Build complete per-module `modScope` with type + value + routine aliases.
    be buf/modScope/scopesBuf bufNew modScope /mCount.
    become /mi u64:0.
    while lt /mi /mCount do
        be parsedMod/pm at /mods /mi.
        be u32/mIdx conv /mi u32.
        be buf/aliasEntry/als bufNew aliasEntry u64:16.
        bufGainAll /als at /typeAliasLists /mi.

        foreach useItem/ui field /pm u32:6 do
            be l/u8/depKey field /ui u32:1.
            be symRef/ts field /ui u32:2.
            be l/u8/alRaw field /ui u32:3.
            hold u64/di u64:0.
            while lt /di /mi do
                be parsedMod/dpm at /mods /di.
                if and field /dpm u32:3 eq field /dpm u32:5 /depKey
                    do
                        be u32/depMod conv /di u32.
                        if field /ts u32:0
                            do
                                be dcVal/tdc field /ts u32:1.
                                if gt len /alRaw u64:0
                                    do
                                        hold u64/k u64:0.
                                        while lt /k len /vList do
                                            be valDef/vd at /vList /k.
                                            be tup: b dcVal ::/od field /vd u32:2.
                                            if and eq field /vd u32:0 /depMod and field /vd u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:4 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                        become /k u64:0.
                                        while lt /k len /rList do
                                            be routDef/rd at /rList /k.
                                            be tup: b dcVal ::/od field /rd u32:2.
                                            if and eq field /rd u32:0 /depMod and field /rd u32:1 and field /od u32:0 eq field /od u32:1 /tdc
                                                bufGain /als structNew aliasEntry: /alRaw u8:5 conv /k u32 ::
                                                nop.
                                            become /k sum /k u64:1.
                                        ::.
                                    ::
                                    nop.
                            ::
                            do
                                be l/u8/orig field /ts u32:2.
                                be l/u8/localName if eq len /alRaw u64:0 /orig /alRaw.
                                hold u64/k u64:0.
                                while lt /k len /vList do
                                    be valDef/vd at /vList /k.
                                    if and eq field /vd u32:0 /depMod and field /vd u32:1 eq field /vd u32:3 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:4 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                                become /k u64:0.
                                while lt /k len /rList do
                                    be routDef/rd at /rList /k.
                                    if and eq field /rd u32:0 /depMod and field /rd u32:1 eq field /rd u32:3 /orig
                                        bufGain /als structNew aliasEntry: /localName u8:5 conv /k u32 ::
                                        nop.
                                    become /k sum /k u64:1.
                                ::.
                            ::.
                    ::
                    nop.
                become /di sum /di u64:1.
            ::.
        ::.
        bufGain /scopesBuf structNew modScope: /mIdx bufFrozen /als l/synthImport: :: ::.
        become /mi sum /mi u64:1.
    ::.

    tupNew:
        structNew compEnv:
            /isSrList /nsSegsList /nsKeysList /s1List /nsList /bList /eList /vList /rList
        ::
        bufFrozen /scopesBuf
    ::.

: Static StageR 3 type predicates & overload/value resolution helpers.
: @dc l8589983079
v/b/isFixedIntKind u8/k
    and ge /k u8:3 le /k u8:9.

: @dc l8589983080
v/b/isIntegerKind u8/k
    and ge /k u8:3 le /k u8:10.

: @dc l8589983081
v/b/isNumericKind u8/k
    and ge /k u8:3 le /k u8:11.

: @dc l8589983082
v/b/isSignedFixedKind u8/k
    or eq /k u8:4 or eq /k u8:6 eq /k u8:8.

: @dc l8589983083
v/b/isWideningConv rType/src rType/dst
    if eq /src /dst return true nop.
    be u8/sk field /src u32:0.
    be u8/dk field /dst u32:0.
    if and eq /sk u8:13 eq /dk u8:16
        do
            if eq len field /dst u32:2 u64:1
                if eq field at field /dst u32:2 u64:0 u32:0 u8:12
                    return true
                    nop
                nop.
            return false.
        ::
        nop.
    if and eq /sk u8:16 eq /dk u8:13
        do
            if eq len field /src u32:2 u64:1
                if eq field at field /src u32:2 u64:0 u32:0 u8:12
                    return true
                    nop
                nop.
            return false.
        ::
        nop.
    if not and isNumericKind /sk isNumericKind /dk return false nop.
    if eq /sk u8:3  return and ge /dk u8:4 le /dk u8:11 nop.
    if eq /sk u8:4  return or eq /dk u8:6 or eq /dk u8:8 or eq /dk u8:10 eq /dk u8:11 nop.
    if eq /sk u8:5  return and ge /dk u8:6 le /dk u8:11 nop.
    if eq /sk u8:6  return or eq /dk u8:8 or eq /dk u8:10 eq /dk u8:11 nop.
    if eq /sk u8:7  return and ge /dk u8:8 le /dk u8:11 nop.
    if or eq /sk u8:8 eq /sk u8:9 return or eq /dk u8:10 eq /dk u8:11 nop.
    if eq /sk u8:10 return eq /dk u8:11 nop.
    false.

: @dc l8589983084
v/b/rTypeCompat rType/actual rType/expected
    or eq field /actual u32:0 u8:1 eq /actual /expected.

: @dc l8589983085
v/rType/unifyBranchTypes rType/a rType/b
    if eq field /a u32:0 u8:1 return /b nop.
    if eq field /b u32:0 u8:1 return /a nop.
    if ne /a /b fault nop.
    /a.

: @dc l8589983086
v/rType/resolveValueRefType compEnv/env modScope/mScope fnCtx/fctx symRef/sym
    be u32/mIdx field /mScope u32:0.
    if field /sym u32:0
        do
            be dcVal/tdc field /sym u32:1.
            foreach valDef/vd field /env u32:7 do
                be tup: b dcVal ::/od field /vd u32:2.
                if and field /od u32:0 eq field /od u32:1 /tdc
                    return field /vd u32:4
                    nop.
            ::.
            fault.
        ::
        do
            be l/u8/name field /sym u32:2.
            hold u64/li len field /fctx u32:1.
            while gt /li u64:0 do
                become /li diff /li u64:1.
                be localVar/lv at field /fctx u32:1 /li.
                if eq field /lv u32:0 /name
                    return field /lv u32:1
                    nop.
            ::.
            foreach valDef/vd field /env u32:7 do
                if and eq field /vd u32:0 /mIdx eq field /vd u32:3 /name
                    return field /vd u32:4
                    nop.
            ::.
            foreach aliasEntry/ae field /mScope u32:1 do
                if and eq field /ae u32:0 /name eq field /ae u32:1 u8:4
                    return field at field /env u32:7 conv field /ae u32:2 u64 u32:4
                    nop.
            ::.
            fault.
        ::.

: @dc l8589983087
v/b/paramsMatchArgs l/rType/paramTys l/rType/argTys
    if ne len /paramTys len /argTys return false nop.
    hold u64/i u64:0.
    while lt /i len /paramTys do
        if not rTypeCompat at /argTys /i at /paramTys /i
            return false
            nop.
        become /i sum /i u64:1.
    ::.
    true.

: Resolves a call `(sym, argTys)` -> `(isNested, nestedOrDefIdx, retTy)`.
: @dc l8589983088
v/tup: b u32 rType ::/resolveCallTarget compEnv/env modScope/mScope fnCtx/fctx symRef/sym l/rType/argTys
    be u32/mIdx field /mScope u32:0.
    if field /sym u32:0
        do
            be dcVal/tdc field /sym u32:1.
            hold u64/i u64:0.
            be l/routDef/rs field /env u32:8.
            while lt /i len /rs do
                be routDef/rd at /rs /i.
                be tup: b dcVal ::/od field /rd u32:2.
                if and field /od u32:0 eq field /od u32:1 /tdc
                    do
                        if eq len field /rd u32:4 u64:0 fault nop.
                        if not paramsMatchArgs field /rd u32:6 /argTys fault nop.
                        return tupNew: false conv /i u32 field /rd u32:5 ::.
                    ::
                    nop.
                become /i sum /i u64:1.
            ::.
            fault.
        ::
        do
            be l/u8/name field /sym u32:2.
            hold u64/ni len field /fctx u32:2.
            while gt /ni u64:0 do
                become /ni diff /ni u64:1.
                be nestedSig/ns at field /fctx u32:2 /ni.
                if eq field /ns u32:0 /name
                    do
                        if not paramsMatchArgs field /ns u32:2 /argTys fault nop.
                        return tupNew: true conv /ni u32 field /ns u32:1 ::.
                    ::
                    nop.
            ::.
            hold u32/matchCount u32:0.
            hold u32/matchedIdx u32:0.
            hold rType/matchedRet primType u8:0.
            hold u64/i u64:0.
            be l/routDef/rs field /env u32:8.
            while lt /i len /rs do
                be routDef/rd at /rs /i.
                if and eq field /rd u32:0 /mIdx eq field /rd u32:3 /name
                    do
                        if paramsMatchArgs field /rd u32:6 /argTys
                            do
                                become /matchCount sum /matchCount u32:1.
                                become /matchedIdx conv /i u32.
                                become /matchedRet field /rd u32:5.
                            ::
                            nop.
                    ::
                    nop.
                become /i sum /i u64:1.
            ::.
            foreach aliasEntry/ae field /mScope u32:1 do
                if and eq field /ae u32:0 /name eq field /ae u32:1 u8:5
                    do
                        be u32/rIdx field /ae u32:2.
                        be routDef/rd at /rs conv /rIdx u64.
                        if paramsMatchArgs field /rd u32:6 /argTys
                            do
                                become /matchCount sum /matchCount u32:1.
                                become /matchedIdx /rIdx.
                                become /matchedRet field /rd u32:5.
                            ::
                            nop.
                    ::
                    nop.
            ::.
            if ne /matchCount u32:1 fault nop.
            if eq len field at /rs conv /matchedIdx u64 u32:4 u64:0 fault nop.
            tupNew: false /matchedIdx /matchedRet ::.
        ::.

: @dc l8589983089
v/rType/typedIntFormatRType u32/fmtId
    if eq /fmtId u32:203 return primType u8:3 nop.
    if eq /fmtId u32:208 return primType u8:4 nop.
    if eq /fmtId u32:207 return primType u8:5 nop.
    if eq /fmtId u32:210 return primType u8:6 nop.
    if eq /fmtId u32:209 return primType u8:7 nop.
    if eq /fmtId u32:212 return primType u8:8 nop.
    if eq /fmtId u32:211 return primType u8:9 nop.
    if eq /fmtId u32:199 return primType u8:10 nop.
    fault.

: Infers the canonical StageR `rType` of any `exprNode` in `(env, mScope, fctx)`.
: @dc l8589983090
v/rType/inferExprType compEnv/env modScope/mScope fnCtx/fctx exprNode/node
    be u8/k field /node u32:0.
    be u32/aux field /node u32:1.
    be l/rawType/rts field /node u32:6.
    be l/exprNode/args field /node u32:7.

    if eq /k u8:0  return primType u8:2 nop.
    if eq /k u8:1  return typedIntFormatRType bitAnd /aux u32:65535 nop.
    if eq /k u8:2  return unaryRType u8:16 primType u8:3 nop.
    if eq /k u8:3  return primType u8:14 nop.
    if eq /k u8:4  return primType u8:12 nop.
    if eq /k u8:5  return primType u8:15 nop.
    if eq /k u8:6  return unaryRType u8:16 canonType /env /mScope true at /rts u64:0 nop.
    if eq /k u8:7
        do
            be buf/rType/slots bufNew rType len /args.
            hold b/anyNever false.
            foreach exprNode/el /args do
                be rType/et inferExprType /env /mScope /fctx /el.
                if eq field /et u32:0 u8:1 become /anyNever true nop.
                bufGain /slots /et.
            ::.
            if /anyNever
                return primType u8:1
                return structNew rType: u8:18 u32:0 bufFrozen /slots ::.
        ::
        nop.
    if eq /k u8:8
        do
            be rType/bt inferExprType /env /mScope /fctx at /args u64:0.
            if eq field /bt u32:0 u8:1 return primType u8:1 nop.
            if eq field /bt u32:0 u8:18 return at field /bt u32:2 conv /aux u64 nop.
            if eq field /bt u32:0 u8:21
                return at field at field /env u32:3 conv field /bt u32:1 u64 u32:4 conv /aux u64
                nop.
            fault.
        ::
        nop.
    if eq /k u8:9  return inferExprType /env /mScope /fctx at /args u64:0 nop.
    if eq /k u8:10 return unaryRType u8:17 canonType /env /mScope true at /rts u64:0 nop.
    if eq /k u8:11 return resolveValueRefType /env /mScope /fctx field /node u32:5 nop.
    if and ge /k u8:12 le /k u8:15 return primType u8:0 nop.
    if eq /k u8:16
        do
            be buf/rType/atys bufNew rType len /args.
            foreach exprNode/a /args do
                bufGain /atys inferExprType /env /mScope /fctx /a.
            ::.
            be tup: b u32 rType ::/cr resolveCallTarget /env /mScope /fctx field /node u32:5 bufFrozen /atys.
            return field /cr u32:2.
        ::
        nop.
    if eq /k u8:17
        do
            hold l/localVar/vars field /fctx u32:1.
            hold l/nestedSig/nsigs field /fctx u32:2.
            foreach exprNode/st /args do
                if eq field /st u32:0 u8:15
                    do
                        be rawRoutine/nr at field /st u32:10 u64:0.
                        be buf/rType/nps bufNew rType len field /nr u32:4.
                        foreach paramDecl/npd field /nr u32:4 do
                            bufGain /nps canonType /env /mScope true field /npd u32:0.
                        ::.
                        become /nsigs chain /nsigs l/nestedSig:
                            structNew nestedSig: field /nr u32:3 canonType /env /mScope true field /nr u32:2 bufFrozen /nps ::
                        ::.
                    ::
                    nop.
            ::.
            hold rType/lastTy primType u8:0.
            hold b/terminated false.
            foreach exprNode/st /args do
                be u8/sk field /st u32:0.
                if or eq /sk u8:12 eq /sk u8:13
                    do
                        be rType/vty canonType /env /mScope true at field /st u32:6 u64:0.
                        if gt len field /st u32:7 u64:0
                            do
                                be rType/ity inferExprType /env /mScope structNew fnCtx: field /fctx u32:0 /vars /nsigs :: at field /st u32:7 u64:0.
                                if eq field /ity u32:0 u8:1 become /terminated true nop.
                            ::
                            nop.
                        become /vars chain /vars l/localVar: structNew localVar: field /st u32:3 /vty :: ::.
                        become /lastTy primType u8:0.
                    ::
                    do
                        be rType/sty inferExprType /env /mScope structNew fnCtx: field /fctx u32:0 /vars /nsigs :: /st.
                        if eq field /sty u32:0 u8:1 become /terminated true nop.
                        become /lastTy /sty.
                    ::.
            ::.
            if /terminated return primType u8:1 return /lastTy.
        ::
        nop.
    if eq /k u8:18
        do
            be rType/ct inferExprType /env /mScope /fctx at /args u64:0.
            be rType/tt inferExprType /env /mScope /fctx at /args u64:1.
            be rType/et inferExprType /env /mScope /fctx at /args u64:2.
            if eq field /ct u32:0 u8:1 return primType u8:1 nop.
            return unifyBranchTypes /tt /et.
        ::
        nop.
    if or eq /k u8:19 eq /k u8:20 return primType u8:0 nop.
    if and ge /k u8:21 le /k u8:23 return primType u8:1 nop.
    if eq /k u8:24 return primType u8:0 nop.
    if eq /k u8:25
        do
            be rType/xt inferExprType /env /mScope /fctx at /args u64:0.
            if eq field /xt u32:0 u8:1 return primType u8:1 nop.
            if eq /aux u32:2524 return /xt nop.
            if and ge /aux u32:2529 le /aux u32:2531 return primType u8:5 nop.
            if eq /aux u32:2532 return primType u8:2 nop.
            if or eq /aux u32:2543 eq /aux u32:2572 return primType u8:7 nop.
            if eq /aux u32:2559
                return if isSignedFixedKind field /xt u32:0 unaryRType u8:20 /xt /xt
                nop.
            if and ge /aux u32:2566 le /aux u32:2569 return primType u8:2 nop.
            if eq /aux u32:2585 return unaryRType u8:16 at field /xt u32:2 u64:0 nop.
            if eq /aux u32:2610 return primType u8:12 nop.
            if eq /aux u32:2611 return primType u8:9 nop.
            if eq /aux u32:2612 return unaryRType u8:20 primType u8:13 nop.
            if eq /aux u32:2613 return primType u8:14 nop.
            if eq /aux u32:2616 return unaryRType u8:20 /xt nop.
            fault.
        ::
        nop.
    if eq /k u8:26
        do
            be rType/lt inferExprType /env /mScope /fctx at /args u64:0.
            be rType/rt inferExprType /env /mScope /fctx at /args u64:1.
            if and eq field /lt u32:0 u8:1 eq field /rt u32:0 u8:1 return primType u8:1 nop.
            be rType/ut if eq field /lt u32:0 u8:1 /rt /lt.
            if and ge /aux u32:2518 le /aux u32:2523 return /ut nop.
            if and ge /aux u32:2527 le /aux u32:2528 return /lt nop.
            if and ge /aux u32:2533 le /aux u32:2540 return primType u8:2 nop.
            if eq /aux u32:2546 return /ut nop.
            if and ge /aux u32:2553 le /aux u32:2555
                return if isFixedIntKind field /ut u32:0 unaryRType u8:20 /ut /ut
                nop.
            if and ge /aux u32:2556 le /aux u32:2558 return unaryRType u8:20 /ut nop.
            if and ge /aux u32:2560 le /aux u32:2561 return unaryRType u8:20 /lt nop.
            if eq /aux u32:2563
                do
                    if eq field /lt u32:0 u8:1 return primType u8:1 nop.
                    if eq field /lt u32:0 u8:13 return unaryRType u8:19 primType u8:12 nop.
                    return unaryRType u8:19 at field /lt u32:2 u64:0.
                ::
                nop.
            if eq /aux u32:2570
                return if eq field /lt u32:0 u8:1 /rt at field /lt u32:2 u64:0
                nop.
            if eq /aux u32:2571
                return if eq field /lt u32:0 u8:1 primType u8:1 unaryRType u8:20 at field /lt u32:2 u64:0
                nop.
            if eq /aux u32:2581
                return if or eq field /lt u32:0 u8:1 eq field /rt u32:0 u8:1 primType u8:1 unaryRType u8:17 /lt
                nop.
            if or eq /aux u32:2582 eq /aux u32:2583 return primType u8:0 nop.
            if eq /aux u32:2609 return unaryRType u8:20 primType u8:11 nop.
            if eq /aux u32:2614 return unaryRType u8:16 /ut nop.
            if eq /aux u32:2615
                return if eq field /lt u32:0 u8:1 at field /rt u32:2 u64:0 /lt
                nop.
            fault.
        ::
        nop.
    if eq /k u8:27
        do
            be rType/t1 inferExprType /env /mScope /fctx at /args u64:0.
            if eq /aux u32:2564 return unaryRType u8:19 /t1 nop.
            if eq /aux u32:2565 return unaryRType u8:20 primType u8:0 nop.
            fault.
        ::
        nop.
    if eq /k u8:28
        do
            be rType/srcTy inferExprType /env /mScope /fctx at /args u64:0.
            be rType/dstTy canonType /env /mScope true at /rts u64:0.
            if eq field /srcTy u32:0 u8:1 return primType u8:1 nop.
            return if isWideningConv /srcTy /dstTy /dstTy unaryRType u8:20 /dstTy.
        ::
        nop.
    if eq /k u8:29
        do
            be tup: u8 u32 ::/sr resolveTypeSym /env /mScope true field /node u32:5.
            if ne field /sr u32:0 u8:22 fault nop.
            return structNew rType: u8:22 field /sr u32:1 l/rType: :: ::.
        ::
        nop.
    if eq /k u8:30
        do
            be rType/bt inferExprType /env /mScope /fctx at /args u64:0.
            if eq field /bt u32:0 u8:1 return primType u8:1 nop.
            if ne field /bt u32:0 u8:22 fault nop.
            be namedStructDef/nd at field /env u32:4 conv field /bt u32:1 u64.
            foreach namedFieldDef/nf field /nd u32:4 do
                if eq field /nf u32:0 field /node u32:3
                    return field /nf u32:1
                    nop.
            ::.
            fault.
        ::
        nop.
    if eq /k u8:31 return inferExprType /env /mScope /fctx at /args u64:0 nop.
    if eq /k u8:32
        do
            be tup: u8 u32 ::/sr resolveTypeSym /env /mScope true field /node u32:5.
            if ne field /sr u32:0 u8:24 fault nop.
            return structNew rType: u8:24 field /sr u32:1 l/rType: :: ::.
        ::
        nop.
