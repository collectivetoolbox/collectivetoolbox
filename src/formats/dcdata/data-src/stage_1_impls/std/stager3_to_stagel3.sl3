    be symRef/selfSym if field /optDcVal u32:0
        structNew symRef: true field /optDcVal u32:1 b"" ::
        structNew symRef: false dcZero field /nr u32:0 ::.

    be buf/testCase/tests bufNew testCase u64:4.
    hold b/tdone false.
    while not /tdone do
        become /cur skipComments /tokens /cur.
        if and lt /cur len /tokens eq dcShortId at /tokens /cur u32:2206
            do
                become /cur sum /cur u64:1.
                hold b/cdone false.
                while not /cdone do
                    become /cur skipComments /tokens /cur.
                    if ge /cur len /tokens
                        fault
                        nop.
