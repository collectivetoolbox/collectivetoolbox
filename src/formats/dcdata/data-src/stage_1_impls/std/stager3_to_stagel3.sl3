                            if ne /tsid u32:2208
                                fault
                                nop.
                            become /cur sum /cur u64:1.
                            be buf/exprNode/ins bufNew exprNode u64:4.
                            hold b/idone false.
                            while not /idone do
                                become /cur skipComments /tokens /cur.
                                if ge /cur len /tokens
