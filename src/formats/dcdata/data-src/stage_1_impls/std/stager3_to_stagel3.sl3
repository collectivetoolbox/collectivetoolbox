: Self-hosted Stage 1 document transformation (`f1681`, `StageR3ToStageL3`)
: lowering StageR 3 Token Dcs (`Dc 2221`..`Dc 2222`, plus bundled Stage 1
: `Dc 2192`..`Dc 2193` dependency modules) into canonical StageL 3 Token Dcs.
ns std/stager3_to_stagel3.
use std/dctf:
    dcVal dcNew dcShort dcFormat dcIsShort dcShortId dcIsFormat dcFormatId
    decodeDcStream encodeDcStream skipComments
    readAtomDc readIdentBytes readEscapedLiteral readNumberRaw digitsToU128 readBinaryBytes
    tokAtomDc tokOptAtomDc tokIdent tokEscapedLiteral tokDcNumberU64 tokTypedU64 tokTypedNumberU128 tokBinaryBytes
::.
use std/u128: u128Val u128New le as u128Le ::.
use std/bigint: bigInt intFromBase64Digits ::.

: ---------------------------------------------------------------------------
: 0. AST, Canonical Type, and Symbol-Table Struct Definitions
: ---------------------------------------------------------------------------

: Identifier or `@dc` atom reference (`isDc`, `dcAtom`, `identBytes`).
: @dc l8589982979
struct symRef :: b dcVal l/u8.

: Syntactic StageL/StageR type tree:
: `kind`: 0=void, 1=never, 2=b, 3=u8, 4=i32, 5=u32, 6=i64, 7=u64,
:         8=i128, 9=u128, 10=int, 11=rat, 12=dc, 13=dcs, 14=s, 15=error,
:         16=l/T, 17=buf/T, 18=tup, 19=option/T, 20=result/T,
:         21=struct(symRef), 22=nominal(symRef).
: @dc l8589982980
struct rawType :: u8 symRef l/rawType.

: Canonical StageR/StageL type tree:
: `kind`: 0..=20 same as `rawType`;
:         21=stage1Struct(defIdx), 22=namedStruct(defIdx),
:         23=brand(defIdx), 24=enum(defIdx).
: @dc l8589982981
struct rType :: u8 u32 l/rType.

: `use` import item (`nsSegs`, `nsKey`, `target`, `aliasBytes` — empty if unaliased).
: @dc l8589982982
struct useItem :: l/l/dcVal l/u8 symRef l/u8.

: Routine parameter (`ty`, `name`).
: @dc l8589982983
struct paramDecl :: rawType l/u8.

: Named or positional struct field (`name` — empty on Stage 1 positional structs, `ty`).
: @dc l8589982984
struct fieldDecl :: l/u8 rawType.

: Enum variant declaration (`name`, `hasPayload`, `payloadTy`).
: @dc l8589982985
struct variantDecl :: l/u8 b rawType.

: Brand / module-opaque type declaration (`isPub`, `isOpaque`, `optDc`, `name`, `innerTy`).
: @dc l8589982986
struct rawBrand :: b b tup: b dcVal :: l/u8 rawType.

: Named or Stage 1 positional struct declaration (`isPub`, `optDc`, `name`, `fields`).
: @dc l8589982987
struct rawStruct :: b tup: b dcVal :: l/u8 l/fieldDecl.

: Algebraic enum declaration (`isPub`, `optDc`, `name`, `variants`).
: @dc l8589982988
struct rawEnum :: b tup: b dcVal :: l/u8 l/variantDecl.

: Named struct field initializer (`fieldName`, `valExpr`).
: @dc l8589982989
struct fieldInit :: l/u8 exprNode.

: Match case arm (`variantName`, `hasBind`, `bindTy`, `bindName`, `body`).
: @dc l8589982990
struct matchArm :: l/u8 b rawType l/u8 exprNode.

: Inline routine test case (`inputs`, `expectedKind`: 0=void, 1=fault, 2=expr, `expectedExpr`).
: @dc l8589982991
struct testCase :: l/exprNode u8 exprNode.

: Routine declaration (`isPub`, `optDc`, `retTy`, `name`, `params`, `tests`, `body`).
: @dc l8589982992
struct rawRoutine :: b tup: b dcVal :: rawType l/u8 l/paramDecl l/testCase exprNode.

: Top-level constant declaration (`isPub`, `optDc`, `ty`, `name`, `valExpr`).
: @dc l8589982993
struct rawConst :: b tup: b dcVal :: rawType l/u8 exprNode.

: Unified StageR 3 expression AST node:
: `kind`:
:   0=Bool(aux), 1=TypedInt(aux=fmtId|(isNeg<<16), bytes=digits), 2=Bytes(bytes),
:   3=DctsString(dcsVal), 4=DcLit(dcAtom), 5=ErrorTag(aux=0..7),
:   6=List(types=[elem], args), 7=TupleNew(args), 8=Field(aux=idx, args=[base]),
:   9=With(aux=idx, args=[base,val]), 10=BufNew(types=[elem], args=[cap]),
:   11=ValueRef(types=[]|[ty], sym), 12=Let(types=[ty], bytes=name, args=[]|[init]),
:   13=Const(aux=hasDc, dcAtom, types=[ty], bytes=name, args=[val]),
:   14=Set(types=[]|[ty], bytes=name, args=[val]), 15=RoutineDecl(nested=[rout]),
:   16=Call(sym, args), 17=Block(args), 18=If(args=[c,t,e]),
:   19=While(args=[c,b]), 20=ForEach(types=[ty], bytes=name, args=[list,b]),
:   21=Break, 22=Continue, 23=Return(args=[]|[val]), 24=Nop,
:   25=Unary(aux=opSid, args=[x]), 26=Binary(aux=opSid, args=[l,r]),
:   27=Ternary(aux=opSid, args=[a,b,c]), 28=TotalConv(types=[dst], args=[src]),
:   29=NamedStructNew(sym, namedFields), 30=NamedField(bytes=field, args=[base]),
:   31=NamedWith(bytes=field, args=[base,val]),
:   32=EnumVariant(sym, bytes=variant, args=[]|[payload]),
:   33=OptionNone(types=[inner]), 34=OptionSome(types=[inner], args=[val]),
:   35=ResultOk(types=[okTy], args=[val]), 36=ResultErr(types=[okTy], args=[err]),
:   37=WrapNominal(types=[target], args=[inner]), 38=UnwrapNominal(args=[inner]),
:   39=Match(aux=hasFallback, args=[scr]|[scr,fb], arms), 40=Propagate(args=[inner]).
: @dc l8589982994
struct exprNode ::
    u8
    u32
    dcVal
    l/u8
    l/dcVal
    symRef
    l/rawType
    l/exprNode
    l/fieldInit
    l/matchArm
    l/rawRoutine.

: Parsed module record (`isStageR`, `rawStart`, `rawEnd`, `hasNs`, `nsSegs`, `nsKey`,
: `uses`, `s1Structs`, `namedStructs`, `brands`, `enums`, `consts`, `routines`).
: @dc l8589982995
struct parsedMod ::
    b
    u64
    u64
    b
    l/l/dcVal
    l/u8
    l/useItem
    l/rawStruct
    l/rawStruct
    l/rawBrand
    l/rawEnum
    l/rawConst
    l/rawRoutine.

: Canonical definition entries across all modules in the compilation unit.
: @dc l8589982996
struct s1StructDef :: u32 b tup: b dcVal :: l/u8 l/rType.
: @dc l8589982997
struct namedFieldDef :: l/u8 rType.
: @dc l8589982998
struct namedStructDef :: u32 b tup: b dcVal :: l/u8 l/namedFieldDef.
: @dc l8589982999
struct brandDef :: u32 b b tup: b dcVal :: l/u8 rType.
: @dc l8589983000
struct enumVarDef :: l/u8 b rType u32.
: @dc l8589983001
struct enumDef :: u32 b tup: b dcVal :: l/u8 l/enumVarDef l/rType.
: @dc l8589983002
struct valDef :: u32 b tup: b dcVal :: l/u8 rType.
: @dc l8589983003
struct routDef :: u32 b tup: b dcVal :: l/u8 l/u8 rType l/rType.

: Global read-only compilation environment across all modules.
: @dc l8589983004
struct compEnv ::
    l/b
    l/l/l/dcVal
    l/l/u8
    l/s1StructDef
    l/namedStructDef
    l/brandDef
    l/enumDef
    l/valDef
    l/routDef.

: Resolved per-module `use` alias entry (`aliasBytes`, `kind`: 0=s1Struct, 1=namedStruct,
: 2=brand, 3=enum, 4=val, 5=rout, `defIdx`).
: @dc l8589983005
struct aliasEntry :: l/u8 u8 u32.

: Per-module scope (`modIdx`, `aliases`, `synthTypeImports`: `(kind, defIdx, synthAlias)`).
: @dc l8589983006
struct synthImport :: u8 u32 l/u8 l/l/dcVal l/u8.
: @dc l8589983007
struct modScope :: u32 l/aliasEntry l/synthImport.

: Local lexical binding inside a routine (`name`, `ty`) and nested routine (`name`, `retTy`, `paramTys`).
: @dc l8589983008
struct localVar :: l/u8 rType.
: @dc l8589983009
struct nestedSig :: l/u8 rType l/rType.
: @dc l8589983010
struct fnCtx :: rType l/localVar l/nestedSig.

: ---------------------------------------------------------------------------
: 1. Foundational Constructors, @dc Constants, and Token Emission Helpers
: ---------------------------------------------------------------------------

: @dc l8589983013
v/dcVal/dcZero
    dcNew u64:0 u64:0.

: @dc l8589983014
v/dcVal/dcLong u64/id
    dcNew /id u64:0.

: @dc l8589983015
v/symRef/emptySym
    structNew symRef: false dcZero b"" ::.

: @dc l8589983016
v/rawType/rawScalarType u8/kind
    structNew rawType: /kind emptySym l/rawType: :: ::.

: @dc l8589983017
v/rType/primType u8/kind
    structNew rType: /kind u32:0 l/rType: :: ::.

: @dc l8589983018
v/rType/unaryRType u8/kind rType/inner
    structNew rType: /kind u32:0 l/rType: /inner :: ::.

: @dc l8589983019
v/exprNode/makeExpr u8/kind u32/aux dcVal/dcAtom l/u8/bytes l/dcVal/dcsVal symRef/sym l/rawType/types l/exprNode/args l/fieldInit/nfields l/matchArm/arms l/rawRoutine/nested
    structNew exprNode: /kind /aux /dcAtom /bytes /dcsVal /sym /types /args /nfields /arms /nested ::.

: @dc l8589983020
v/exprNode/simpleExpr u8/kind u32/aux l/exprNode/args
    makeExpr /kind /aux dcZero b"" l/dcVal: :: emptySym l/rawType: :: /args l/fieldInit: :: l/matchArm: :: l/rawRoutine: ::.

: @dc l8589983021
v/exprNode/nopExpr
    simpleExpr u8:24 u32:0 l/exprNode: ::.

: @dc l8589983022
v/void/emitDc buf/dcVal/out dcVal/c
    bufGain /out /c.

: @dc l8589983023
v/void/emitShort buf/dcVal/out u32/sid
    bufGain /out dcShort /sid.

: @dc l8589983024
v/void/emitFormat buf/dcVal/out u32/fid
    bufGain /out dcFormat /fid.

: @dc l8589983025
v/void/emitBool buf/dcVal/out b/flag
    emitShort /out if /flag u32:517 u32:518.

: @dc l8589983026
v/void/emitAtom buf/dcVal/out dcVal/c
    bufGainAll /out tokAtomDc /c.

: @dc l8589983027
v/void/emitOptAtom buf/dcVal/out tup: b dcVal ::/optDc
    bufGainAll /out tokOptAtomDc field /optDc u32:0 field /optDc u32:1.

: @dc l8589983028
v/void/emitIdent buf/dcVal/out l/u8/name
    bufGainAll /out tokIdent /name.

: @dc l8589983029
v/void/emitSymTarget buf/dcVal/out symRef/sym
    if field /sym u32:0
        emitAtom /out field /sym u32:1
        emitIdent /out field /sym u32:2.

: @dc l8589983030
v/void/emitDcNumU64 buf/dcVal/out u64/val
    bufGainAll /out tokDcNumberU64 /val.

: @dc l8589983031
v/void/emitTypedU64 buf/dcVal/out u32/fmtId u64/val
    bufGainAll /out tokTypedU64 /fmtId /val.

: @dc l8589983032
v/l/u8/u64ToAsciiDec u64/n
    if eq /n u64:0
        return b"0"
        nop.
    be buf/u8/rev bufNew u8 u64:20.
    hold u64/cur /n.
    while gt /cur u64:0 do
        bufGain /rev sum u8:48 conv rem /cur u64:10 u8.
        become /cur quot /cur u64:10.
    ::.
    be buf/u8/out bufNew u8 len /rev.
    hold u64/i len /rev.
    while gt /i u64:0 do
        become /i diff /i u64:1.
        bufGain /out at /rev /i.
    ::.
    bufFrozen /out.

: @dc l8589983033
v/l/u8/freshTemp buf/u64/gensym
    be u64/id at /gensym u64:0.
    bufBecomeAt /gensym u64:0 sum /id u64:1.
    chain b"__sr_g" u64ToAsciiDec /id.

: Converts a `FilePath` segment list (`l/l/dcVal`) into a canonical `'/'`-joined byte key.
: @dc l8589983034
v/l/u8/joinFilePathKey l/l/dcVal/segs
    be buf/u8/out bufNew u8 u64:32.
    hold u64/si u64:0.
    while lt /si len /segs do
        if gt /si u64:0
            bufGain /out u8:47
            nop.
        be l/dcVal/seg at /segs /si.
        foreach dcVal/ch /seg do
            be u64/lo field /ch u32:0.
            bufGain /out conv bitAnd /lo u64:255 u8.
            if gt /lo u64:255
                do
                    bufGain /out conv bitAnd shr /lo u32:8 u64:255 u8.
                    bufGain /out conv bitAnd shr /lo u32:16 u64:255 u8.
                ::
                nop.
        ::.
        become /si sum /si u64:1.
    ::.
    bufFrozen /out.

: @dc l8589983035
v/void/emitFilePath buf/dcVal/out l/l/dcVal/segs
    emitShort /out u32:511.
    emitFormat /out u32:229.
    emitShort /out u32:310.
    emitShort /out u32:516.
    emitFormat /out u32:228.
    emitShort /out u32:513.
    hold u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            emitShort /out u32:513
            nop.
        emitShort /out u32:511.
        emitFormat /out u32:228.
        bufGainAll /out tokEscapedLiteral dcShort u32:264 at /segs /i.
        emitShort /out u32:512.
        become /i sum /i u64:1.
    ::.
    emitShort /out u32:311.
    emitShort /out u32:512.

: ---------------------------------------------------------------------------
: 2. StageR 3 / StageL 3 Token-Dc Recursive-Descent Parser
: ---------------------------------------------------------------------------

: @dc l8589983036
v/u64/expectShort l/dcVal/tokens u64/pos u32/expectedSid
    be u64/p skipComments /tokens /pos.
    if or ge /p len /tokens ne dcShortId at /tokens /p /expectedSid
        fault
        sum /p u64:1.

: @dc l8589983037
v/tup: b u64 ::/readBoolTok l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        fault
        nop.
    be u32/sid dcShortId at /tokens /p.
    if eq /sid u32:517
        tupNew: true sum /p u64:1 ::
        if eq /sid u32:518
            tupNew: false sum /p u64:1 ::
            fault.

: @dc l8589983038
v/tup: tup: b dcVal :: u64 ::/readOptAtomTok l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        fault
        nop.
    if eq dcShortId at /tokens /p u32:316
        return tupNew: tupNew: false dcZero :: sum /p u64:1 ::
        nop.
    be tup: b dcVal u64 ::/ar readAtomDc /tokens /p.
    if not field /ar u32:0
        fault
        tupNew: tupNew: true field /ar u32:1 :: field /ar u32:2 ::.

: @dc l8589983039
v/tup: l/u8 u64 ::/mustReadIdent l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    be tup: b l/u8 u64 ::/ir readIdentBytes /tokens /p.
    if or not field /ir u32:0 eq len field /ir u32:1 u64:0
        fault
        tupNew: field /ir u32:1 field /ir u32:2 ::.

: @dc l8589983040
v/tup: symRef u64 ::/readSymRef l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        fault
        nop.
    if eq dcShortId at /tokens /p u32:270
        do
            be tup: l/u8 u64 ::/ir mustReadIdent /tokens /p.
            tupNew: structNew symRef: false dcZero field /ir u32:0 :: field /ir u32:1 ::.
        ::
        do
            be tup: b dcVal u64 ::/ar readAtomDc /tokens /p.
            if not field /ar u32:0
                fault
                tupNew: structNew symRef: true field /ar u32:1 b"" :: field /ar u32:2 ::.
        ::.

: @dc l8589983041
v/tup: u64 u64 ::/readUntypedU64 l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    be tup: b u32 b l/u8 u64 ::/nr readNumberRaw /tokens /p.
    if or not field /nr u32:0 or ne field /nr u32:1 u32:199 field /nr u32:2
        fault
        nop.
    be tup: b u128Val ::/dr digitsToU128 field /nr u32:3.
    if or not field /dr u32:0 ne field field /dr u32:1 u32:1 u64:0
        fault
        tupNew: field field /dr u32:1 u32:0 field /nr u32:4 ::.

: @dc l8589983042
v/tup: l/l/dcVal u64 ::/readFilePath l/dcVal/tokens u64/pos
    hold u64/p expectShort /tokens /pos u32:511.
    if or ge /p len /tokens ne dcFormatId at /tokens /p u32:229
        fault
        nop.
    become /p expectShort /tokens sum /p u64:1 u32:310.
    become /p skipComments /tokens /p.
    if and lt sum /p u64:1 len /tokens and eq dcShortId at /tokens /p u32:516 eq dcFormatId at /tokens sum /p u64:1 u32:228
        do
            become /p sum /p u64:2.
            if and lt /p len /tokens eq dcShortId at /tokens /p u32:513
                become /p sum /p u64:1
                nop.
        ::
        nop.
    be buf/l/dcVal/segs bufNew l/dcVal u64:4.
    hold b/done false.
    while not /done do
        become /p skipComments /tokens /p.
        if ge /p len /tokens
            fault
            nop.
        be u32/sid dcShortId at /tokens /p.
        if eq /sid u32:311
            do
                become /p sum /p u64:1.
                become /done true.
            ::
            if eq /sid u32:513
                become /p sum /p u64:1
                do
                    become /p expectShort /tokens /p u32:511.
                    if or ge /p len /tokens ne dcFormatId at /tokens /p u32:228
                        fault
                        nop.
                    be tup: b dcVal l/dcVal u64 ::/lit readEscapedLiteral /tokens sum /p u64:1.
                    if or not field /lit u32:0 or ne dcShortId field /lit u32:1 u32:264 eq len field /lit u32:2 u64:0
                        fault
                        nop.
                    bufGain /segs field /lit u32:2.
                    become /p expectShort /tokens field /lit u32:3 u32:512.
                ::.
    ::.
    become /p expectShort /tokens /p u32:512.
    if eq len /segs u64:0
        fault
        tupNew: bufFrozen /segs /p ::.

: @dc l8589983043
v/b/peekStartsType l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        return false
        nop.
    be dcVal/tok at /tokens /p.
    if dcIsFormat /tok
        return true
        nop.
    be u32/sid dcShortId /tok.
    or eq /sid u32:262
        or eq /sid u32:264
            or eq /sid u32:640
                or eq /sid u32:2576
                    or eq /sid u32:2577
                        and ge /sid u32:2672 le /sid u32:2679.

: @dc l8589983044
v/u64/skipGeneralOrStagelType l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        fault
        nop.
    if eq dcShortId at /tokens /p u32:262
        do
            hold u64/cur sum /p u64:1.
            hold u64/depth u64:1.
            while gt /depth u64:0 do
                if ge /cur len /tokens
                    fault
                    nop.
                be u32/sid dcShortId at /tokens /cur.
                if eq /sid u32:255
                    become /cur sum /cur u64:2
                    do
                        if eq /sid u32:262
                            become /depth sum /depth u64:1
                            if eq /sid u32:263
                                become /depth diff /depth u64:1
                                nop.
                        become /cur sum /cur u64:1.
                    ::.
            ::.
            return /cur.
        ::
        nop.
    be tup: rawType u64 ::/tr readRawType /tokens /p.
    field /tr u32:1.

: @dc l8589983045
v/tup: rawType u64 ::/readRawType l/dcVal/tokens u64/pos
    be u64/p skipComments /tokens /pos.
    if ge /p len /tokens
        fault
        nop.
    be dcVal/tok at /tokens /p.
    be u64/next sum /p u64:1.
    if dcIsFormat /tok
        do
            be u32/fid dcFormatId /tok.
            if eq /fid u32:1425 return tupNew: rawScalarType u8:0 /next :: nop.
            if eq /fid u32:1426 return tupNew: rawScalarType u8:1 /next :: nop.
            if eq /fid u32:1424 return tupNew: rawScalarType u8:2 /next :: nop.
            if eq /fid u32:203  return tupNew: rawScalarType u8:3 /next :: nop.
            if eq /fid u32:208  return tupNew: rawScalarType u8:4 /next :: nop.
            if eq /fid u32:207  return tupNew: rawScalarType u8:5 /next :: nop.
            if eq /fid u32:210  return tupNew: rawScalarType u8:6 /next :: nop.
            if eq /fid u32:209  return tupNew: rawScalarType u8:7 /next :: nop.
            if eq /fid u32:212  return tupNew: rawScalarType u8:8 /next :: nop.
            if eq /fid u32:211  return tupNew: rawScalarType u8:9 /next :: nop.
            if eq /fid u32:199  return tupNew: rawScalarType u8:10 /next :: nop.
            if eq /fid u32:345  return tupNew: rawScalarType u8:11 /next :: nop.
            if eq /fid u32:484  return tupNew: rawScalarType u8:14 /next :: nop.
            fault.
        ::
        nop.
    be u32/sid dcShortId /tok.
    if eq /sid u32:262
        do
            be tup: rawType u64 ::/inner readRawType /tokens /next.
            be u64/after expectShort /tokens field /inner u32:1 u32:263.
            return tupNew: field /inner u32:0 /after ::.
        ::
        nop.
    if eq /sid u32:640  return tupNew: rawScalarType u8:12 /next :: nop.
    if eq /sid u32:264  return tupNew: rawScalarType u8:13 /next :: nop.
    if eq /sid u32:2676 return tupNew: rawScalarType u8:15 /next :: nop.
    if or eq /sid u32:2576 or eq /sid u32:2577 or eq /sid u32:2674 eq /sid u32:2675
        do
            be tup: rawType u64 ::/sub readRawType /tokens /next.
            be u8/k if eq /sid u32:2576 u8:16 if eq /sid u32:2577 u8:17 if eq /sid u32:2674 u8:19 u8:20.
            return tupNew: structNew rawType: /k emptySym l/rawType: field /sub u32:0 :: :: field /sub u32:1 ::.
        ::
        nop.
    if eq /sid u32:2672
        do
            hold u64/cur expectShort /tokens /next u32:310.
            become /cur skipComments /tokens /cur.
            if and lt /cur len /tokens eq dcShortId at /tokens /cur u32:6
                do
                    be tup: u64 u64 ::/lenSkip readUntypedU64 /tokens /cur.
                    become /cur field /lenSkip u32:1.
                ::
                nop.
