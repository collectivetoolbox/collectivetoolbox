: Rewrites outer `Dc 2242` (`EnclosingRoutine`, or legacy `Dc 599`) call targets in `e` to `selfSym` without
: descending into nested `u8:15` (`RoutineDecl`) bodies (which bind their own self-target).
: @dc l8589998200
v/exprNode/rewriteSelfRefInExpr exprNode/e symRef/selfSym
    be u8/k field /e u32:0.
    if eq /k u8:15
        return /e
        nop.
    be l/exprNode/inArgs field /e u32:7.
    hold l/exprNode/outArgs /inArgs.
    if gt len /inArgs u64:0
        do
            be buf/exprNode/ab bufNew exprNode len /inArgs.
            foreach exprNode/sub /inArgs do
                bufGain /ab rewriteSelfRefInExpr /sub /selfSym.
            ::.
            become /outArgs bufFrozen /ab.
        ::
        nop.
    be l/fieldInit/inFields field /e u32:8.
    hold l/fieldInit/outFields /inFields.
    if gt len /inFields u64:0
        do
            be buf/fieldInit/fb bufNew fieldInit len /inFields.
            foreach fieldInit/fi /inFields do
                bufGain /fb structNew fieldInit: field /fi u32:0 rewriteSelfRefInExpr field /fi u32:1 /selfSym ::.
            ::.
            become /outFields bufFrozen /fb.
        ::
        nop.
    be l/matchArm/inArms field /e u32:9.
    hold l/matchArm/outArms /inArms.
    if gt len /inArms u64:0
        do
            be buf/matchArm/mb bufNew matchArm len /inArms.
            foreach matchArm/ma /inArms do
                bufGain /mb structNew matchArm:
                    field /ma u32:0 field /ma u32:1 field /ma u32:2 field /ma u32:3
                    rewriteSelfRefInExpr field /ma u32:4 /selfSym
                ::.
            ::.
            become /outArms bufFrozen /mb.
        ::
        nop.
    hold symRef/outSym field /e u32:5.
    if and eq /k u8:16 and field /outSym u32:0 or eq dcShortId field /outSym u32:1 u32:2242 eq dcShortId field /outSym u32:1 u32:599
        become /outSym /selfSym
        nop.
    makeExpr /k field /e u32:1 field /e u32:2 field /e u32:3 field /e u32:4 /outSym field /e u32:6 /outArgs /outFields /outArms field /e u32:10.

