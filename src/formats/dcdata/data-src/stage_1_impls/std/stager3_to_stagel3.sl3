    be tup: exprNode u64 ::/br readStageRExpr /tokens /cur.
    become /cur expectShort /tokens field /br u32:1 u32:2204.
    tupNew:
        structNew rawRoutine:
            field /pr u32:0 /optDcVal field /rtr u32:0 field /nr u32:0
