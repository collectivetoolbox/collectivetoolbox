                                do
                                    become /testDepth sum /testDepth u64:1.
                                    become /cur sum /cur u64:1.
                                ::
                                if eq /sid u32:2207
                                    do
                                        if eq /testDepth u64:0 fault nop.
                                        become /testDepth diff /testDepth u64:1.
                                        become /cur sum /cur u64:1.
                                    ::
                                    if eq /sid u32:2203
                                        do
                                            become /depth sum /depth u64:1.
                                            become /cur sum /cur u64:1.
                                        ::
                                        if eq /sid u32:2204
                                            do
                                                become /depth diff /depth u64:1.
                                                become /cur sum /cur u64:1.
                                            ::
                                            do
                                                if eq /testDepth u64:0
                                                    do
                                                        if eq /sid u32:2454
                                                            do
                                                                become /hasFault true.
                                                                become /cur sum /cur u64:1.
                                                            ::
                                                            if eq /sid u32:2211
                                                                do
                                                                    be u64/hpos skipComments /tokens sum /cur u64:1.
                                                                    if and lt /hpos len /tokens eq dcShortId at /tokens /hpos u32:2240
                                                                        become /cur sum /hpos u64:1
                                                                        do
                                                                            be tup: symRef u64 ::/sr readSymRef /tokens /hpos.
                                                                            be symRef/rawSym field /sr u32:0.
                                                                            be symRef/callSym if and field /rawSym u32:0 or eq dcShortId field /rawSym u32:1 u32:2242 eq dcShortId field /rawSym u32:1 u32:599
                                                                                /selfSym
                                                                                /rawSym.
                                                                            bufGain /calls makeExpr u8:16 u32:0 dcZero b"" l/dcVal: :: /callSym l/rawType: :: l/exprNode: :: l/fieldInit: :: l/matchArm: :: l/rawRoutine: ::.
                                                                            become /cur field /sr u32:1.
                                                                        ::.
                                                                ::
                                                                become /cur sum /cur u64:1.
                                                    ::
                                                    become /cur sum /cur u64:1.
                                            ::.
    ::.
    be u32/faultAux if /hasFault u32:1 u32:0.
    be exprNode/scanSummary makeExpr u8:0 /faultAux dcZero b"" l/dcVal: :: emptySym l/rawType: :: bufFrozen /calls l/fieldInit: :: l/matchArm: :: l/rawRoutine: ::.
    tupNew: /scanSummary /cur ::.

: Bridges Stage 1 carrier structs (`std/i128:i128Val`, `std/u128:u128Val`, `std/bigint:bigInt`,
: `std/rat:ratVal`, `std/dctf:dcVal`) to StageR 3 scalar primitives, recursing in `l/T` and `tup`.
: @dc l8589984967
v/rType/bridgeS1TypeForSr l/l/u8/nsKeysList l/s1StructDef/s1List rType/ty
    be u8/k field /ty u32:0.
    if eq /k u8:21
        do
            be s1StructDef/sd at /s1List conv field /ty u32:1 u64.
            be l/u8/nsKey at /nsKeysList conv field /sd u32:0 u64.
            be l/u8/sname field /sd u32:3.
            if and eq /nsKey b"std//i128" eq /sname b"i128Val"
                return primType u8:8
                nop.
            if and eq /nsKey b"std//u128" eq /sname b"u128Val"
                return primType u8:9
                nop.
            if and eq /nsKey b"std//bigint" eq /sname b"bigInt"
                return primType u8:10
                nop.
            if and eq /nsKey b"std//rat" eq /sname b"ratVal"
                return primType u8:11
                nop.
            if and eq /nsKey b"std//dctf" eq /sname b"dcVal"
                return primType u8:12
                nop.
            return /ty.
        ::
        nop.
    if eq /k u8:16
        return structNew rType: u8:16 u32:0 l/rType: bridgeS1TypeForSr /nsKeysList /s1List at field /ty u32:2 u64:0 :: ::
        nop.
    if eq /k u8:18
        do
            be l/rType/subs field /ty u32:2.
            be buf/rType/mapped bufNew rType len /subs.
            foreach rType/sub /subs do
                bufGain /mapped bridgeS1TypeForSr /nsKeysList /s1List /sub.
            ::.
            return structNew rType: u8:18 u32:0 bufFrozen /mapped ::.
        ::
        nop.
    /ty.

: Returns true iff `name` ends with ASCII case-insensitive `"StageLInternal"`.
: @dc l8589984968
v/b/endsWithStageLInternal l/u8/name
    be l/u8/suf b"stagelinternal".
    be u64/slen len /suf.
    be u64/nlen len /name.
    if lt /nlen /slen
        return false
        nop.
    be u64/off diff /nlen /slen.
    hold u64/i u64:0.
    while lt /i /slen do
        hold u8/b at /name sum /off /i.
        if and ge /b u8:65 le /b u8:90
            become /b sum /b u8:32
            nop.
        if ne /b at /suf /i
            return false
            nop.
        become /i sum /i u64:1.
    ::.
    true.

: Parses module header (`ns` + `use`s) shared by StageL (`Dc 2192`) and StageR (`Dc 2221`).
: @dc l8589983054
v/tup: b l/l/dcVal l/u8 l/useItem u64 ::/readModHeader l/dcVal/tokens u64/posAfterOpen
    hold u64/cur skipComments /tokens /posAfterOpen.
    if ge /cur len /tokens fault nop.
    hold b/hasNs false.
    hold l/l/dcVal/nsSegs l/l/dcVal: ::.
    hold l/u8/nsKey b"".
    if eq dcShortId at /tokens /cur u32:2194
        do
            be tup: l/l/dcVal u64 ::/fpr readFilePath /tokens sum /cur u64:1.
            become /hasNs true.
            become /nsSegs field /fpr u32:0.
            become /nsKey joinFilePathKey /nsSegs.
            become /cur field /fpr u32:1.
        ::
        become /cur expectShort /tokens /cur u32:316.

    be buf/useItem/uses bufNew useItem u64:4.
    hold b/udone false.
    while not /udone do
        become /cur skipComments /tokens /cur.
        if and lt /cur len /tokens eq dcShortId at /tokens /cur u32:2195
            do
                be tup: l/l/dcVal u64 ::/fpr readFilePath /tokens sum /cur u64:1.
                be l/l/dcVal/uSegs field /fpr u32:0.
                be l/u8/uKey joinFilePathKey /uSegs.
                become /cur field /fpr u32:1.
                hold b/idone false.
                while not /idone do
                    become /cur skipComments /tokens /cur.
                    if ge /cur len /tokens fault nop.
                    if eq dcShortId at /tokens /cur u32:2196
                        do
                            become /cur sum /cur u64:1.
                            become /idone true.
                        ::
                        do
                            become /cur expectShort /tokens /cur u32:2197.
                            be tup: symRef u64 ::/tsr readSymRef /tokens /cur.
                            become /cur skipComments /tokens field /tsr u32:1.
                            hold l/u8/alias b"".
                            if and lt /cur len /tokens eq dcShortId at /tokens /cur u32:316
                                do
                                    if field field /tsr u32:0 u32:0 fault nop.
                                    become /cur sum /cur u64:1.
                                ::
                                do
                                    be tup: l/u8 u64 ::/alr mustReadIdent /tokens /cur.
                                    become /alias field /alr u32:0.
                                    become /cur field /alr u32:1.
                                ::.
                            bufGain /uses structNew useItem: /uSegs /uKey field /tsr u32:0 /alias ::.
                        ::.
                ::.
            ::
            become /udone true.
    ::.
    tupNew: /hasNs /nsSegs /nsKey bufFrozen /uses /cur ::.

: Parses a StageL 3 (`Dc 2192..2193`) dependency module header & top-level signatures.
: @dc l8589983055
v/tup: parsedMod u64 ::/parseStage1Module l/dcVal/tokens u64/startPos
    be u64/afterOpen expectShort /tokens /startPos u32:2192.
    be tup: b l/l/dcVal l/u8 l/useItem u64 ::/hdr readModHeader /tokens /afterOpen.
    hold u64/cur field /hdr u32:4.

    be buf/rawStruct/s1Structs bufNew rawStruct u64:4.
    be buf/rawConst/consts bufNew rawConst u64:4.
    be buf/rawRoutine/routs bufNew rawRoutine u64:8.

    hold b/done false.
    while not /done do
        become /cur skipComments /tokens /cur.
        if ge /cur len /tokens fault nop.
        be u32/sid dcShortId at /tokens /cur.
        if eq /sid u32:2193
            do
                become /cur sum /cur u64:1.
                become /done true.
            ::
            if eq /sid u32:2217
                do
                    be tup: b u64 ::/pr readBoolTok /tokens sum /cur u64:1.
                    be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens field /pr u32:1.
                    be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /odr u32:1.
                    become /cur field /nr u32:1.
                    be buf/fieldDecl/flds bufNew fieldDecl u64:4.
                    hold b/fdone false.
                    while not /fdone do
                        become /cur skipComments /tokens /cur.
                        if ge /cur len /tokens fault nop.
                        if eq dcShortId at /tokens /cur u32:2218
                            do
                                become /cur sum /cur u64:1.
                                become /fdone true.
                            ::
                            do
                                be tup: rawType u64 ::/ftr readRawType /tokens /cur.
                                bufGain /flds structNew fieldDecl: b"" field /ftr u32:0 ::.
                                become /cur field /ftr u32:1.
                            ::.
                    ::.
                    bufGain /s1Structs structNew rawStruct: field /pr u32:0 field /odr u32:0 field /nr u32:0 bufFrozen /flds ::.
                ::
                if or eq /sid u32:2199 eq /sid u32:2200
                    do
                        be b/isPub eq /sid u32:2200.
                        be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens sum /cur u64:1.
                        be tup: rawType u64 ::/tr readRawType /tokens field /odr u32:1.
                        be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /tr u32:1.
                        become /cur skipStageLExpr /tokens field /nr u32:1.
                        bufGain /consts structNew rawConst: /isPub field /odr u32:0 field /tr u32:0 field /nr u32:0 nopExpr ::.
                    ::
                    if eq /sid u32:2203
                        do
                            be tup: b u64 ::/pr readBoolTok /tokens sum /cur u64:1.
                            be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens field /pr u32:1.
                            be tup: rawType u64 ::/rtr readRawType /tokens field /odr u32:1.
                            be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /rtr u32:1.
                            hold u64/pcur field /nr u32:1.
                            be buf/paramDecl/params bufNew paramDecl u64:4.
                            hold b/pdone false.
                            while not /pdone do
                                become /pcur skipComments /tokens /pcur.
                                if and lt /pcur len /tokens eq dcShortId at /tokens /pcur u32:2205
                                    do
                                        be tup: rawType u64 ::/ptr readRawType /tokens sum /pcur u64:1.
                                        be tup: l/u8 u64 ::/pnr mustReadIdent /tokens field /ptr u32:1.
                                        bufGain /params structNew paramDecl: field /ptr u32:0 field /pnr u32:0 ::.
                                        become /pcur field /pnr u32:1.
                                    ::
                                    become /pdone true.
                            ::.
                            be tup: b dcVal ::/s1OptDc field /odr u32:0.
                            be symRef/s1SelfSym if field /s1OptDc u32:0
                                structNew symRef: true field /s1OptDc u32:1 b"" ::
                                structNew symRef: false dcZero field /nr u32:0 ::.
                            be tup: exprNode u64 ::/scanRes scanStageLRoutineTail /tokens /pcur /s1SelfSym.
                            become /cur field /scanRes u32:1.
                            bufGain /routs structNew rawRoutine: field /pr u32:0 /s1OptDc field /rtr u32:0 field /nr u32:0 bufFrozen /params l/testCase: :: field /scanRes u32:0 ::.
                        ::
                        fault.
    ::.
    tupNew:
        structNew parsedMod:
            false /startPos /cur field /hdr u32:0 field /hdr u32:1 field /hdr u32:2 field /hdr u32:3
            bufFrozen /s1Structs l/rawStruct: :: l/rawBrand: :: l/rawEnum: :: bufFrozen /consts bufFrozen /routs
        ::
        /cur
    ::.

: Parses a complete StageR 3 (`Dc 2221..2222`) module into `parsedMod`.
: @dc l8589983056
v/tup: parsedMod u64 ::/parseStageRModule l/dcVal/tokens u64/startPos
    be u64/afterOpen expectShort /tokens /startPos u32:2221.
    be tup: b l/l/dcVal l/u8 l/useItem u64 ::/hdr readModHeader /tokens /afterOpen.
    hold u64/cur field /hdr u32:4.

    be buf/rawStruct/nStructs bufNew rawStruct u64:4.
    be buf/rawBrand/brands bufNew rawBrand u64:4.
    be buf/rawEnum/enums bufNew rawEnum u64:4.
    be buf/rawConst/consts bufNew rawConst u64:4.
    be buf/rawRoutine/routs bufNew rawRoutine u64:8.

    hold b/done false.
    while not /done do
        become /cur skipComments /tokens /cur.
        if ge /cur len /tokens fault nop.
        be u32/sid dcShortId at /tokens /cur.
        if eq /sid u32:2222
            do
                become /cur sum /cur u64:1.
                become /done true.
            ::
            if eq /sid u32:2223
                do
                    be tup: b u64 ::/p1 readBoolTok /tokens sum /cur u64:1.
                    be tup: b u64 ::/p2 readBoolTok /tokens field /p1 u32:1.
                    be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens field /p2 u32:1.
                    be tup: rawType u64 ::/itr readRawType /tokens field /odr u32:1.
                    be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /itr u32:1.
                    bufGain /brands structNew rawBrand: field /p1 u32:0 field /p2 u32:0 field /odr u32:0 field /nr u32:0 field /itr u32:0 ::.
                    become /cur field /nr u32:1.
                ::
                if eq /sid u32:2224
                    do
                        be tup: b u64 ::/pr readBoolTok /tokens sum /cur u64:1.
                        be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens field /pr u32:1.
                        be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /odr u32:1.
                        become /cur field /nr u32:1.
                        be buf/fieldDecl/flds bufNew fieldDecl u64:4.
                        hold b/fdone false.
                        while not /fdone do
                            become /cur skipComments /tokens /cur.
                            if ge /cur len /tokens fault nop.
                            if eq dcShortId at /tokens /cur u32:2225
                                do
                                    become /cur sum /cur u64:1.
                                    become /fdone true.
                                ::
                                do
                                    become /cur expectShort /tokens /cur u32:2226.
                                    be tup: rawType u64 ::/ftr readRawType /tokens /cur.
                                    be tup: l/u8 u64 ::/fnr mustReadIdent /tokens field /ftr u32:1.
                                    bufGain /flds structNew fieldDecl: field /fnr u32:0 field /ftr u32:0 ::.
                                    become /cur field /fnr u32:1.
                                ::.
                        ::.
                        if eq len /flds u64:0 fault nop.
                        bufGain /nStructs structNew rawStruct: field /pr u32:0 field /odr u32:0 field /nr u32:0 bufFrozen /flds ::.
                    ::
                    if eq /sid u32:2230
                        do
                            be tup: b u64 ::/pr readBoolTok /tokens sum /cur u64:1.
                            be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens field /pr u32:1.
                            be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /odr u32:1.
                            become /cur field /nr u32:1.
                            be buf/variantDecl/vars bufNew variantDecl u64:4.
                            hold b/vdone false.
                            while not /vdone do
                                become /cur skipComments /tokens /cur.
                                if ge /cur len /tokens fault nop.
                                if eq dcShortId at /tokens /cur u32:2231
                                    do
                                        become /cur sum /cur u64:1.
                                        become /vdone true.
                                    ::
                                    do
                                        become /cur expectShort /tokens /cur u32:2232.
                                        become /cur skipComments /tokens /cur.
                                        hold b/hasPay false.
                                        hold rawType/payTy rawScalarType u8:0.
                                        if and lt /cur len /tokens eq dcShortId at /tokens /cur u32:316
                                            become /cur sum /cur u64:1
                                            do
                                                be tup: rawType u64 ::/ptr readRawType /tokens /cur.
                                                become /hasPay true.
                                                become /payTy field /ptr u32:0.
                                                become /cur field /ptr u32:1.
                                            ::.
                                        be tup: l/u8 u64 ::/vnr mustReadIdent /tokens /cur.
                                        bufGain /vars structNew variantDecl: field /vnr u32:0 /hasPay /payTy ::.
                                        become /cur field /vnr u32:1.
                                    ::.
                            ::.
                            bufGain /enums structNew rawEnum: field /pr u32:0 field /odr u32:0 field /nr u32:0 bufFrozen /vars ::.
                        ::
                        if or eq /sid u32:2199 eq /sid u32:2200
                            do
                                be b/isPub eq /sid u32:2200.
                                be tup: tup: b dcVal :: u64 ::/odr readOptAtomTok /tokens sum /cur u64:1.
                                be tup: rawType u64 ::/tr readRawType /tokens field /odr u32:1.
                                be tup: l/u8 u64 ::/nr mustReadIdent /tokens field /tr u32:1.
                                be tup: exprNode u64 ::/vr readStageRExpr /tokens field /nr u32:1.
                                bufGain /consts structNew rawConst: /isPub field /odr u32:0 field /tr u32:0 field /nr u32:0 field /vr u32:0 ::.
                                become /cur field /vr u32:1.
                            ::
                            if eq /sid u32:2203
                                do
                                    be tup: rawRoutine u64 ::/rr readStageRRoutine /tokens /cur.
                                    bufGain /routs field /rr u32:0.
                                    become /cur field /rr u32:1.
                                ::
                                fault.
    ::.
    tupNew:
        structNew parsedMod:
            true /startPos /cur field /hdr u32:0 field /hdr u32:1 field /hdr u32:2 field /hdr u32:3
            l/rawStruct: :: bufFrozen /nStructs bufFrozen /brands bufFrozen /enums bufFrozen /consts bufFrozen /routs
        ::
        /cur
    ::.

: ---------------------------------------------------------------------------
: 3. Symbol Registration, Type Canonicalization, & Static Type Inference
: ---------------------------------------------------------------------------

: @dc l8589983057
v/l/dcVal/asciiToDcSeg l/u8/ascii
    be buf/dcVal/out bufNew dcVal len /ascii.
    foreach u8/ch /ascii do
        bufGain /out dcNew conv /ch u64 u64:0.
    ::.
    bufFrozen /out.

: @dc l8589983058
v/l/u8/stdPkgNsKey u8/pkgId
    if eq /pkgId u8:0 return b"std//dctf" nop.
    if eq /pkgId u8:1 return b"std//i128" nop.
    if eq /pkgId u8:2 return b"std//u128" nop.
    if eq /pkgId u8:3 return b"std//bigint" nop.
    if eq /pkgId u8:4 return b"std//rat" nop.
    if eq /pkgId u8:5 return b"std//dcmst" nop.
    if eq /pkgId u8:6 return b"std//dcs" nop.
    fault.

: @dc l8589983059
v/l/l/dcVal/stdPkgNsSegs u8/pkgId
    if eq /pkgId u8:0 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"dctf" :: nop.
    if eq /pkgId u8:1 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"i128" :: nop.
    if eq /pkgId u8:2 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"u128" :: nop.
    if eq /pkgId u8:3 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"bigint" :: nop.
    if eq /pkgId u8:4 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"rat" :: nop.
    if eq /pkgId u8:5 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"dcmst" :: nop.
    if eq /pkgId u8:6 return l/l/dcVal: asciiToDcSeg b"std" asciiToDcSeg b"dcs" :: nop.
    fault.

: @dc l8589983060
v/b/usesHasUnaliasedDc l/useItem/uses dcVal/targetDc
    foreach useItem/u /uses do
        be symRef/ts field /u u32:2.
        if and field /ts u32:0 and eq field /ts u32:1 /targetDc eq len field /u u32:3 u64:0
            return true
            nop.
    ::.
    false.

: @dc l8589983061
v/void/recordStdImport buf/tup: u8 dcVal ::/stdImports l/u8/selfNsKey l/useItem/uses u8/pkgId dcVal/c
    if usesHasUnaliasedDc /uses /c
        return
        nop.
    hold u64/i u64:0.
    while lt /i len /stdImports do
        be tup: u8 dcVal ::/cur at /stdImports /i.
        if eq field /cur u32:1 /c
            return
            nop.
        become /i sum /i u64:1.
    ::.
    bufGain /stdImports tupNew: /pkgId /c ::.

: @dc l8589983062
v/void/emitStdDc buf/dcVal/out buf/tup: u8 dcVal ::/stdImports l/u8/selfNsKey l/useItem/uses u8/pkgId u64/longId
    be dcVal/c dcLong /longId.
    recordStdImport /stdImports /selfNsKey /uses /pkgId /c.
    emitAtom /out /c.

: @dc l8589983063
v/void/recordCrossDcImport buf/tup: l/l/dcVal dcVal ::/crossDcs l/useItem/uses l/l/dcVal/nsSegs dcVal/c
    if usesHasUnaliasedDc /uses /c
        return
        nop.
    hold u64/i u64:0.
    while lt /i len /crossDcs do
        be tup: l/l/dcVal dcVal ::/cur at /crossDcs /i.
        if eq field /cur u32:1 /c
            return
            nop.
        become /i sum /i u64:1.
    ::.
    bufGain /crossDcs tupNew: /nsSegs /c ::.

: @dc l8589983064
v/l/u8/findOrAddSynthImport buf/synthImport/synths u8/kind u32/defIdx l/l/dcVal/nsSegs l/u8/origName
    hold u64/i u64:0.
    while lt /i len /synths do
        be synthImport/cur at /synths /i.
        if and eq field /cur u32:0 /kind eq field /cur u32:1 /defIdx
            return field /cur u32:2
            nop.
        become /i sum /i u64:1.
    ::.
    be l/u8/al chain b"__sr_imp_" u64ToAsciiDec len /synths.
    bufGain /synths structNew synthImport: /kind /defIdx /al /nsSegs /origName ::.
    /al.

: @dc l8589983065
v/tup: b l/u8 ::/findAliasForDef l/aliasEntry/aliases u8/kind u32/defIdx
    foreach aliasEntry/ae /aliases do
        if and eq field /ae u32:1 /kind eq field /ae u32:2 /defIdx
            return tupNew: true field /ae u32:0 ::
            nop.
    ::.
    tupNew: false b"" ::.

: @dc l8589983066
v/tup: u32 b tup: b dcVal :: l/u8 ::/typeDefHeader compEnv/env u8/kind u32/defIdx
    be u64/idx conv /defIdx u64.
    if eq /kind u8:0
        do
            be s1StructDef/d at field /env u32:3 /idx.
            return tupNew: field /d u32:0 field /d u32:1 field /d u32:2 field /d u32:3 ::.
        ::
        nop.
    if eq /kind u8:1
        do
            be namedStructDef/d at field /env u32:4 /idx.
            return tupNew: field /d u32:0 field /d u32:1 field /d u32:2 field /d u32:3 ::.
        ::
        nop.
    if eq /kind u8:2
        do
            be brandDef/d at field /env u32:5 /idx.
            return tupNew: field /d u32:0 field /d u32:1 field /d u32:3 field /d u32:4 ::.
