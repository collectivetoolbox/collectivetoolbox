: Stage 1 mixed-mode string (`s` / `DcMst`, represented as `l/dcVal`) runtime helpers:
: `byteLen`, `dcsFromS`, `sFromDcs`, and atomic-unit-preserving `explode` / `implode`.
ns std/dcmst.
use std/u128: errInvalidEncoding ::.
use std/dctf: dcVal dcShort dcShortId dcIsValid lenDctf ::.
use std/dcs: dcsImplode ::.

: Returns true iff `c` is a Base64 encapsulation digit (`Dc 127..=190`) or padding (`Dc 195`).
: @dc l8589982132
v/b/isB64DigitOrPad dcVal/c
    const u32/sid dcShortId /c.
    or eq /sid u32:195 and ge /sid u32:127 le /sid u32:190.

: Parses a `Dc 203 .. Dc 204` binary encapsulation frame starting at `start` (`get chars start == Dc 203`),
: returning `(nextIdx, frameByteLen)` using `DcMst` binary chunk header + decoded Base64 payload sizes.
: @dc l8589982133
v/tup: u64 u64 ::/measureBinaryFrame l/dcVal/chars u64/start
    const u64/clen len /chars.
    let u64/endIdx add /start u64:1.
    while and lt /endIdx /clen ne dcShortId get /chars /endIdx u32:204 do
        set /endIdx add /endIdx u64:1.
    ::.
    const u64/innerStart add /start u64:1.
    let u64/firstB64 /endIdx.
    let u64/scan /innerStart.
    while and lt /scan /endIdx eq /firstB64 /endIdx do
        if isB64DigitOrPad get /chars /scan
            set /firstB64 /scan
            set /scan add /scan u64:1.
    ::.
    const u64/b64Len sub /endIdx /firstB64.
    let u64/padding u64:0.
    if gt /b64Len u64:0
        do
            if eq dcShortId get /chars sub /endIdx u64:1 u32:195
                set /padding add /padding u64:1
                nop.
            if and gt /b64Len u64:1 eq dcShortId get /chars sub /endIdx u64:2 u32:195
                set /padding add /padding u64:1
                nop.
        ::
        nop.
    const u64/decodedLen sub mul shr /b64Len u32:2 u64:3 /padding.
    let u64/frameBytes.
    if eq /firstB64 /innerStart
        set /frameBytes add u64:21 /decodedLen
        do
            let u64/metaBytes u64:0.
            let u64/mIdx /innerStart.
            while lt /mIdx /firstB64 do
                set /metaBytes add /metaBytes lenDctf get /chars /mIdx.
                set /mIdx add /mIdx u64:1.
            ::.
            set /frameBytes add u64:37 add /metaBytes /decodedLen.
        ::.
    const u64/nextIdx if lt /endIdx /clen add /endIdx u64:1 /clen.
    tupNew: /nextIdx /frameBytes ::.

: Computes `byteLen` of a validated mixed-mode `s` (`DcMst`) `l/dcVal` sequence.
: @dc l8589982134
pub v/u64/dcmstByteLen l/dcVal/chars
    test
        in l/dcVal: ::
        out u64:0.
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out u64:25.
    const u64/clen len /chars.
    let u64/idx u64:0.
    let u64/total u64:0.
    while lt /idx /clen do
        const dcVal/ch get /chars /idx.
        const u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                const u64/nextIdx add /idx u64:1.
                if lt /nextIdx /clen
                    do
                        set /total add /total add lenDctf /ch lenDctf get /chars /nextIdx.
                        set /idx add /idx u64:2.
                    ::
                    do
                        set /total add /total lenDctf /ch.
                        set /idx /clen.
                    ::.
            ::
            if eq /sid u32:203
                do
                    const tup: u64 u64 ::/fb measureBinaryFrame /chars /idx.
                    set /idx field /fb u32:0.
                    set /total add /total field /fb u32:1.
                ::
                do
                    set /total add /total lenDctf /ch.
                    set /idx add /idx u64:1.
                ::.
    ::.
    /total.

: Total `dcsFromS` conversion (`l/dcVal -> tup: b l/dcVal u8 ::`), returning `errInvalidEncoding` (`u8:4`)
: when unescaped binary encapsulation markers (`Dc 203`/`Dc 204`), trailing escapes, or surrogates appear.
: @dc l8589982135
pub v/tup: b l/dcVal u8 ::/dcmstToDcs l/dcVal/chars
    test
        in l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: ::
        out tupNew: true l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: :: u8:0 ::.
        in l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out tupNew: false l/dcVal: :: u8:4 ::.
    const u64/clen len /chars.
    const buf/dcVal/out bufNew dcVal /clen.
    let u64/idx u64:0.
    while lt /idx /clen do
        const dcVal/ch get /chars /idx.
        if not dcIsValid /ch
            return tupNew: false l/dcVal: :: /errInvalidEncoding ::
            nop.
        const u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                const u64/nextIdx add /idx u64:1.
                if ge /nextIdx /clen
                    return tupNew: false l/dcVal: :: /errInvalidEncoding ::
                    nop.
                const dcVal/esc get /chars /nextIdx.
                if not dcIsValid /esc
                    return tupNew: false l/dcVal: :: /errInvalidEncoding ::
                    nop.
                bufPush /out /esc.
                set /idx add /idx u64:2.
            ::
            if or eq /sid u32:203 eq /sid u32:204
                return tupNew: false l/dcVal: :: /errInvalidEncoding ::
                do
                    bufPush /out /ch.
                    set /idx add /idx u64:1.
                ::.
    ::.
    tupNew: true bufFreeze /out u8:0 ::.

: Infallible `sFromDcs` widening (`l/dcVal -> l/dcVal`), escaping `Dc 255`, `Dc 203`, and `Dc 204` with `Dc 255`.
: @dc l8589982136
pub v/l/dcVal/dcmstFromDcs l/dcVal/chars
    test
        in l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: ::
        out l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: ::.
    const buf/dcVal/out bufNew dcVal len /chars.
    foreach dcVal/ch /chars do
        const u32/sid dcShortId /ch.
        if or eq /sid u32:255 or eq /sid u32:203 eq /sid u32:204
            bufPush /out dcShort u32:255
            nop.
        bufPush /out /ch.
    ::.
    bufFreeze /out.

: Segments `chars` into atomic `DcMst` units (single `dcVal`, `Dc 255` escape pair, or `Dc 203..Dc 204` binary frame).
: @dc l8589982137
v/l/l/dcVal/dcmstAtomicUnits l/dcVal/chars
    const u64/clen len /chars.
    const buf/l/dcVal/units bufNew l/dcVal /clen.
    let u64/idx u64:0.
    while lt /idx /clen do
        const dcVal/ch get /chars /idx.
        const u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                const u64/endIdx if lt add /idx u64:2 /clen add /idx u64:2 /clen.
                bufPush /units slice /chars /idx /endIdx.
                set /idx /endIdx.
            ::
            if eq /sid u32:203
                do
                    const tup: u64 u64 ::/fb measureBinaryFrame /chars /idx.
                    const u64/nextIdx field /fb u32:0.
                    bufPush /units slice /chars /idx /nextIdx.
                    set /idx /nextIdx.
                ::
                do
                    bufPush /units l/dcVal: /ch ::.
                    set /idx add /idx u64:1.
                ::.
    ::.
    bufFreeze /units.

: Flattens a slice of atomic `DcMst` units `[start..end)` into a single `l/dcVal`.
: @dc l8589982138
v/l/dcVal/flattenUnits l/l/dcVal/units u64/start u64/end
    let u64/total u64:0.
    let u64/i /start.
    while lt /i /end do
        set /total add /total len get /units /i.
        set /i add /i u64:1.
    ::.
    const buf/dcVal/out bufNew dcVal /total.
    let u64/j /start.
    while lt /j /end do
        bufExtend /out get /units /j.
        set /j add /j u64:1.
    ::.
    bufFreeze /out.

: Splits `input` around non-overlapping occurrences of `sep` (`explode` on `s`), never splitting inside
: a `Dc 255` escape pair or `Dc 203..Dc 204` binary encapsulation frame.
: @dc l8589982139
pub v/l/l/dcVal/dcmstExplode l/dcVal/sep l/dcVal/input
    test
        in l/dcVal: :: l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out l/l/dcVal: l/dcVal: structNew dcVal: u64:97 u64:0 :: :: l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: :: ::.
    const l/l/dcVal/sepUnits dcmstAtomicUnits /sep.
    const l/l/dcVal/inpUnits dcmstAtomicUnits /input.
    const u64/slen len /sepUnits.
    const u64/ilen len /inpUnits.
    if eq /slen u64:0
        return /inpUnits
        nop.
    const buf/l/dcVal/out bufNew l/dcVal u64:4.
    let u64/cursor u64:0.
    while le /cursor /ilen do
        const u64/remLen sub /ilen /cursor.
        if lt /remLen /slen
            do
                bufPush /out flattenUnits /inpUnits /cursor /ilen.
                return bufFreeze /out.
            ::
            nop.
        const u64/maxOff sub /remLen /slen.
        let b/found false.
        let u64/foundOff u64:0.
        let u64/off u64:0.
        while and not /found le /off /maxOff do
            const u64/cand add /cursor /off.
            if eq slice /inpUnits /cand add /cand /slen /sepUnits
                do
                    set /found true.
                    set /foundOff /off.
                ::
                set /off add /off u64:1.
        ::.
        if /found
            do
                bufPush /out flattenUnits /inpUnits /cursor add /cursor /foundOff.
                set /cursor add add /cursor /foundOff /slen.
            ::
            do
                bufPush /out flattenUnits /inpUnits /cursor /ilen.
                return bufFreeze /out.
            ::.
    ::.
    bufPush /out l/dcVal: ::.
    bufFreeze /out.

: Concatenates `parts` interspersed with `sep` (`implode` on `s`).
: @dc l8589982140
pub v/l/dcVal/dcmstImplode l/dcVal/sep l/l/dcVal/parts
    dcsImplode /sep /parts.
