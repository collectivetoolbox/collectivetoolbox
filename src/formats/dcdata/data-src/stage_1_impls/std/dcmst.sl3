: Stage 1 mixed-mode string (`s` / `DcMst`, represented as `l/dcVal`) runtime helpers:
: `byteLen`, `dcsFromS`, `sFromDcs`, and atomic-unit-preserving `explode` / `implode`.
: FIXME: Checksums?
ns std/dcmst.
use std/u128: errInvalidEncoding ::.
use std/dctf: dcVal dcShort dcShortId lenDctf encodeDcStream decodeDcStream ::.
use std/dcs: joined as dcsImplode ::.

: Returns true iff `c` is a Base64 encapsulation digit (`Dc 127..=190`) or padding (`Dc 195`).
: @dc l8589982132
v/b/isB64DigitOrPad dcVal/c
    be u32/sid dcShortId /c.
    or eq /sid u32:195 and ge /sid u32:127 le /sid u32:190.

: Parses a `Dc 203 .. Dc 204` binary encapsulation frame starting at `start` (`get chars start == Dc 203`),
: returning `(nextIdx, frameByteLen)` using `DcMst` binary chunk header + decoded Base64 payload sizes.
: @dc l8589982133
v/tup: u64 u64 ::/measureBinaryFrame l/dcVal/chars u64/start
    be u64/clen len /chars.
    hold u64/endIdx sum /start u64:1.
    while and lt /endIdx /clen ne dcShortId at /chars /endIdx u32:204 do
        become /endIdx sum /endIdx u64:1.
    ::.
    be u64/innerStart sum /start u64:1.
    hold u64/firstB64 /endIdx.
    hold u64/scan /innerStart.
    while and lt /scan /endIdx eq /firstB64 /endIdx do
        if isB64DigitOrPad at /chars /scan
            become /firstB64 /scan
            become /scan sum /scan u64:1.
    ::.
    be u64/b64Len diff /endIdx /firstB64.
    hold u64/padding u64:0.
    if gt /b64Len u64:0
        do
            if eq dcShortId at /chars diff /endIdx u64:1 u32:195
                become /padding sum /padding u64:1
                nop.
            if and gt /b64Len u64:1 eq dcShortId at /chars diff /endIdx u64:2 u32:195
                become /padding sum /padding u64:1
                nop.
        ::
        nop.
    be u64/decodedLen diff prod shr /b64Len u32:2 u64:3 /padding.
    hold u64/frameBytes.
    if eq /firstB64 /innerStart
        become /frameBytes sum u64:21 /decodedLen
        do
            hold u64/metaBytes u64:0.
            hold u64/mIdx /innerStart.
            while lt /mIdx /firstB64 do
                become /metaBytes sum /metaBytes lenDctf at /chars /mIdx.
                become /mIdx sum /mIdx u64:1.
            ::.
            become /frameBytes sum u64:37 sum /metaBytes /decodedLen.
        ::.
    be u64/nextIdx if lt /endIdx /clen sum /endIdx u64:1 /clen.
    tupNew: /nextIdx /frameBytes ::.

: Computes `byteLen` of a validated mixed-mode `s` (`DcMst`) `l/dcVal` sequence.
: @dc l8589982134
pub v/u64/byteLen l/dcVal/chars
    test
        in l/dcVal: ::
        out u64:0.
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out u64:25.
    be u64/clen len /chars.
    hold u64/idx u64:0.
    hold u64/total u64:0.
    while lt /idx /clen do
        be dcVal/ch at /chars /idx.
        be u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                be u64/nextIdx sum /idx u64:1.
                if lt /nextIdx /clen
                    do
                        become /total sum /total sum lenDctf /ch lenDctf at /chars /nextIdx.
                        become /idx sum /idx u64:2.
                    ::
                    do
                        become /total sum /total lenDctf /ch.
                        become /idx /clen.
                    ::.
            ::
            if eq /sid u32:203
                do
                    be tup: u64 u64 ::/fb measureBinaryFrame /chars /idx.
                    become /idx field /fb u32:0.
                    become /total sum /total field /fb u32:1.
                ::
                do
                    become /total sum /total lenDctf /ch.
                    become /idx sum /idx u64:1.
                ::.
    ::.
    /total.

: Total `dcsFromS` conversion (`l/dcVal -> tup: b l/dcVal u8 ::`), returning `errInvalidEncoding` (`u8:4`)
: when unescaped binary encapsulation markers (`Dc 203`/`Dc 204`) or trailing escapes appear.
: @dc l8589982135
pub v/tup: b l/dcVal u8 ::/tryDcsFromS l/dcVal/chars
    test
        in l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: ::
        out tupNew: true l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: :: u8:0 ::.
        in l/dcVal: structNew dcVal: u64:55296 u64:0 :: ::
        out tupNew: true l/dcVal: structNew dcVal: u64:55296 u64:0 :: :: u8:0 ::.
        in l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out tupNew: false l/dcVal: :: u8:4 ::.
    be u64/clen len /chars.
    be buf/dcVal/out bufNew dcVal /clen.
    hold u64/idx u64:0.
    while lt /idx /clen do
        be dcVal/ch at /chars /idx.
        be u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                be u64/nextIdx sum /idx u64:1.
                if ge /nextIdx /clen
                    return tupNew: false l/dcVal: :: /errInvalidEncoding ::
                    nop.
                be dcVal/esc at /chars /nextIdx.
                bufGain /out /esc.
                become /idx sum /idx u64:2.
            ::
            if or eq /sid u32:203 eq /sid u32:204
                return tupNew: false l/dcVal: :: /errInvalidEncoding ::
                do
                    bufGain /out /ch.
                    become /idx sum /idx u64:1.
                ::.
    ::.
    tupNew: true bufFrozen /out u8:0 ::.

: Infallible `sFromDcs` widening (`l/dcVal -> l/dcVal`), escaping `Dc 255`, `Dc 203`, and `Dc 204` with `Dc 255`.
: @dc l8589982136
pub v/l/dcVal/sFromDcs l/dcVal/chars
    test
        in l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: ::
        out l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: ::.
    be buf/dcVal/out bufNew dcVal len /chars.
    foreach dcVal/ch /chars do
        be u32/sid dcShortId /ch.
        if or eq /sid u32:255 or eq /sid u32:203 eq /sid u32:204
            bufGain /out dcShort u32:255
            nop.
        bufGain /out /ch.
    ::.
    bufFrozen /out.

: Segments `chars` into atomic `DcMst` units (single `dcVal`, `Dc 255` escape pair, or `Dc 203..Dc 204` binary frame).
: @dc l8589982137
v/l/l/dcVal/dcmstAtomicUnits l/dcVal/chars
    be u64/clen len /chars.
    be buf/l/dcVal/units bufNew l/dcVal /clen.
    hold u64/idx u64:0.
    while lt /idx /clen do
        be dcVal/ch at /chars /idx.
        be u32/sid dcShortId /ch.
        if eq /sid u32:255
            do
                be u64/endIdx if lt sum /idx u64:2 /clen sum /idx u64:2 /clen.
                bufGain /units slice /chars /idx /endIdx.
                become /idx /endIdx.
            ::
            if eq /sid u32:203
                do
                    be tup: u64 u64 ::/fb measureBinaryFrame /chars /idx.
                    be u64/nextIdx field /fb u32:0.
                    bufGain /units slice /chars /idx /nextIdx.
                    become /idx /nextIdx.
                ::
                do
                    bufGain /units l/dcVal: /ch ::.
                    become /idx sum /idx u64:1.
                ::.
    ::.
    bufFrozen /units.

: Flattens a slice of atomic `DcMst` units `[start..end)` into a single `l/dcVal`.
: @dc l8589982138
v/l/dcVal/flattenUnits l/l/dcVal/units u64/start u64/end
    hold u64/total u64:0.
    hold u64/i /start.
    while lt /i /end do
        become /total sum /total len at /units /i.
        become /i sum /i u64:1.
    ::.
    be buf/dcVal/out bufNew dcVal /total.
    hold u64/j /start.
    while lt /j /end do
        bufGainAll /out at /units /j.
        become /j sum /j u64:1.
    ::.
    bufFrozen /out.

: Splits `input` around non-overlapping occurrences of `sep` (`explode` on `s`), never splitting inside
: a `Dc 255` escape pair or `Dc 203..Dc 204` binary encapsulation frame.
: @dc l8589982139
pub v/l/l/dcVal/pieces l/dcVal/sep l/dcVal/input
    test
        in l/dcVal: :: l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::
        out l/l/dcVal: l/dcVal: structNew dcVal: u64:97 u64:0 :: :: l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: :: ::.
    be l/l/dcVal/sepUnits dcmstAtomicUnits /sep.
    be l/l/dcVal/inpUnits dcmstAtomicUnits /input.
    be u64/slen len /sepUnits.
    be u64/ilen len /inpUnits.
    if eq /slen u64:0
        return /inpUnits
        nop.
    be buf/l/dcVal/out bufNew l/dcVal u64:4.
    hold u64/cursor u64:0.
    while le /cursor /ilen do
        be u64/remLen diff /ilen /cursor.
        if lt /remLen /slen
            do
                bufGain /out flattenUnits /inpUnits /cursor /ilen.
                return bufFrozen /out.
            ::
            nop.
        be u64/maxOff diff /remLen /slen.
        hold b/found false.
        hold u64/foundOff u64:0.
        hold u64/off u64:0.
        while and not /found le /off /maxOff do
            be u64/cand sum /cursor /off.
            if eq slice /inpUnits /cand sum /cand /slen /sepUnits
                do
                    become /found true.
                    become /foundOff /off.
                ::
                become /off sum /off u64:1.
        ::.
        if /found
            do
                bufGain /out flattenUnits /inpUnits /cursor sum /cursor /foundOff.
                become /cursor sum sum /cursor /foundOff /slen.
            ::
            do
                bufGain /out flattenUnits /inpUnits /cursor /ilen.
                return bufFrozen /out.
            ::.
    ::.
    bufGain /out l/dcVal: ::.
    bufFrozen /out.

: Concatenates `parts` interspersed with `sep` (`implode` on `s`).
: @dc l8589982140
pub v/l/dcVal/joined l/dcVal/sep l/l/dcVal/parts
    dcsImplode /sep /parts.

: Host capability RPC for mixed-mode/pure-Dc strings (`l/dcVal -> tup: b l/dcVal u8 ::`),
: encoding the request to DcTF, calling StageL `requestCapability` (`Dc 2616`), and
: decoding the response DcTF bytes (returning `errInvalidEncoding` if malformed).
: @dc l8589992731
pub v/tup: b l/dcVal u8 ::/requestCapabilityS l/dcVal/req
    be l/u8/reqBytes encodeDcStream /req.
    be l/u8/respBytes capability /reqBytes.
    be tup: b l/dcVal ::/dec decodeDcStream /respBytes.
    if field /dec u32:0
        tupNew: true field /dec u32:1 u8:0 ::
        tupNew: false l/dcVal: :: /errInvalidEncoding ::.

: Raw DcTF-byte host capability RPC (`l/u8 -> l/u8`), invoking StageL `Dc 2616`
: directly without decoding or re-encoding the payload token stream.
: @dc l8589993763
pub v/l/u8/requestCapabilityBytes l/u8/req
    capability /req.

: Checked StageL `dcsFromS` conversion (`l/dcVal -> l/dcVal`), faulting when unescaped binary
: encapsulation markers (`Dc 203`/`Dc 204`), trailing escapes, or surrogates appear.
: @dc l8589984707
pub v/l/dcVal/dcsFromS l/dcVal/chars
    test
        in l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: ::
        out l/dcVal: structNew dcVal: u64:104 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: ::.
        in l/dcVal: structNew dcVal: u64:1114315 u64:0 :: ::
        out fault.
    be tup: b l/dcVal u8 ::/r tryDcsFromS /chars.
    if not field /r u32:0
        fault
        field /r u32:1.
