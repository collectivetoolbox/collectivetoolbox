        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    const dcVal/first get /tokens /pos.
    if eq dcShortId /first u32:255
        if ge add /pos u64:1 /tlen
            tupNew: false dcNew u64:0 u64:0 /pos ::
            tupNew: true get /tokens add /pos u64:1 add /pos u64:2 ::
        tupNew: true /first add /pos u64:1 ::.

: Reads a `Dc 270 .. Dc 271` ASCII programmatic identifier at `pos` -> `(ok, asciiBytes, nextPos)`.
: @dc l8589980677
pub v/tup: b l/u8 u64 ::/readIdentBytes l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114382 u64:0 :: structNew dcVal: u64:120 u64:0 :: structNew dcVal: u64:49 u64:0 :: structNew dcVal: u64:1114383 u64:0 :: :: u64:0
        out tupNew: true b"x1" u64:4 ::.
    const u64/tlen len /tokens.
    if or ge /pos /tlen ne dcShortId get /tokens /pos u32:270
        return tupNew: false b"" /pos ::
        nop.
    const buf/u8/chars bufNew u8 u64:16.
    let u64/i add /pos u64:1.
    while lt /i /tlen do
        const dcVal/tok get /tokens /i.
        const u32/sid dcShortId /tok.
        if eq /sid u32:271
            return tupNew: true bufFreeze /chars add /i u64:1 ::
            nop.
        let dcVal/ch /tok.
        if eq /sid u32:255
            do
                if ge add /i u64:1 /tlen
                    return tupNew: false b"" /pos ::
                    nop.
                set /ch get /tokens add /i u64:1.
                set /i add /i u64:2.
            ::
            set /i add /i u64:1.
        if or ne field /ch u32:1 u64:0 gt field /ch u32:0 u64:127
            return tupNew: false b"" /pos ::
            nop.
        bufPush /chars conv field /ch u32:0 u8.
    ::.
    tupNew: false b"" /pos ::.

: Reads `Dc 260 Dc 262 <typeDc> Dc 263 <escaped payload> Dc 261` at `pos` -> `(ok, typeDc, payload, nextPos)`.
: @dc l8589980678
pub v/tup: b dcVal l/dcVal u64 ::/readEscapedLiteral l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114372 u64:0 :: structNew dcVal: u64:1114374 u64:0 :: structNew dcVal: u64:1114752 u64:0 :: structNew dcVal: u64:1114375 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: :: u64:0
        out tupNew: true structNew dcVal: u64:1114752 u64:0 :: l/dcVal: structNew dcVal: u64:1114373 u64:0 :: :: u64:7 ::.
    const u64/tlen len /tokens.
    if gt add /pos u64:5 /tlen
        return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
        nop.
    if or ne dcShortId get /tokens /pos u32:260 or ne dcShortId get /tokens add /pos u64:1 u32:262 ne dcShortId get /tokens add /pos u64:3 u32:263
        return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
        nop.
    const dcVal/typeDc get /tokens add /pos u64:2.
    const buf/dcVal/payload bufNew dcVal u64:16.
    let u64/i add /pos u64:4.
    while lt /i /tlen do
        const dcVal/tok get /tokens /i.
        const u32/sid dcShortId /tok.
        if eq /sid u32:261
            return tupNew: true /typeDc bufFreeze /payload add /i u64:1 ::
            nop.
        if eq /sid u32:255
