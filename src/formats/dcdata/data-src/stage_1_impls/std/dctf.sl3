: Stage 1 canonical `DcTF` (`f641`) wire codec and high-level Token-Dc stream reader/builder helpers.
ns std/dctf.
use std/u128: u128Val u128Zero u128New u128FromU64 u128Lt u128Ge u128BitOr u128ShlRaw u128ShrRaw u128Clz ::.

: 128-bit Document Character scalar: slot 0 = `lo` (`u64`), slot 1 = `hi` (`u64`).
: @dc l8589980641
pub struct dcVal :: u64 u64.

: Sentinel returned by `dcShortId` and `dcFormatId` when a `dcVal` is outside that region.
: @dc l8589980646
pub u32/noRegionId u32:4294967295.

: Constructs `dcVal` from raw `(lo, hi)` 64-bit limbs.
: @dc l8589980647
pub v/dcVal/dcNew u64/lo u64/hi
    test
        in u64:65 u64:0
        out structNew dcVal: u64:65 u64:0 ::.
    structNew dcVal: /lo /hi ::.

: Converts `u128Val` to `dcVal` without checking surrogate range.
: @dc l8589980648
pub v/dcVal/dcFromU128Raw u128Val/v
    test
        in structNew u128Val: u64:97 u64:0 ::
        out structNew dcVal: u64:97 u64:0 ::.
    structNew dcVal: field /v u32:0 field /v u32:1 ::.

: Converts `dcVal` to `u128Val`.
: @dc l8589980649
pub v/u128Val/dcToU128Raw dcVal/c
    test
        in structNew dcVal: u64:97 u64:0 ::
        out structNew u128Val: u64:97 u64:0 ::.
    u128New field /c u32:0 field /c u32:1.

: Returns true iff `c` is outside the UTF-16 surrogate range `0xD800..=0xDFFF`.
: @dc l8589980650
pub v/b/dcIsValid dcVal/c
    test
        in structNew dcVal: u64:55295 u64:0 ::
        out true.
        in structNew dcVal: u64:55296 u64:0 ::
        out false.
        in structNew dcVal: u64:57343 u64:0 ::
        out false.
        in structNew dcVal: u64:57344 u64:0 ::
        out true.
    not and eq field /c u32:1 u64:0 and ge field /c u32:0 u64:55296 le field /c u32:0 u64:57343.

: Constructs a Short Document Character (`1_114_112 + id`).
: @dc l8589980651
pub v/dcVal/dcShort u32/id
    test
        in u32:256
        out structNew dcVal: u64:1114368 u64:0 ::.
    structNew dcVal: add u64:1114112 conv /id u64 u64:0 ::.

: Constructs a Format Document Character (`2_228_224 + id`).
: @dc l8589980652
pub v/dcVal/dcFormat u32/id
    test
        in u32:199
        out structNew dcVal: u64:2228423 u64:0 ::.
    structNew dcVal: add u64:2228224 conv /id u64 u64:0 ::.

: Constructs a Unicode codepoint `dcVal` (`0..=0x10FFFF`).
: @dc l8589980653
pub v/dcVal/dcUnicode u32/cp
    test
        in u32:65
        out structNew dcVal: u64:65 u64:0 ::.
    structNew dcVal: conv /cp u64 u64:0 ::.

: Returns `Dc 517 "Boolean true"` or `Dc 518 "Boolean false"`.
: @dc l8589980654
pub v/dcVal/dcBool b/val
    test
        in true
        out structNew dcVal: u64:1114629 u64:0 ::.
        in false
        out structNew dcVal: u64:1114630 u64:0 ::.
    dcShort if /val u32:517 u32:518.

: Returns true iff `c` is in the Short Dc region (`1_114_112..=2_228_223`).
: @dc l8589980655
pub v/b/dcIsShort dcVal/c
    test
        in structNew dcVal: u64:1114368 u64:0 ::
        out true.
        in structNew dcVal: u64:2228224 u64:0 ::
        out false.
    and eq field /c u32:1 u64:0 and ge field /c u32:0 u64:1114112 le field /c u32:0 u64:2228223.

: Returns the Short Dc ID (`0..=1_114_111`), or `noRegionId` (`u32:4294967295`) if not a Short Dc.
: @dc l8589980656
pub v/u32/dcShortId dcVal/c
    test
        in structNew dcVal: u64:1114368 u64:0 ::
        out u32:256.
        in structNew dcVal: u64:65 u64:0 ::
        out u32:4294967295.
    if dcIsShort /c
        conv sub field /c u32:0 u64:1114112 u32
        /noRegionId.

: Returns true iff `c` is in the Format Dc region (`2_228_224..=3_342_335`).
: @dc l8589980657
pub v/b/dcIsFormat dcVal/c
    test
        in structNew dcVal: u64:2228423 u64:0 ::
        out true.
        in structNew dcVal: u64:1114368 u64:0 ::
        out false.
    and eq field /c u32:1 u64:0 and ge field /c u32:0 u64:2228224 le field /c u32:0 u64:3342335.

: Returns the Format ID (`0..=1_114_111`), or `noRegionId` (`u32:4294967295`) if not a Format Dc.
: @dc l8589980658
pub v/u32/dcFormatId dcVal/c
    test
        in structNew dcVal: u64:2228423 u64:0 ::
        out u32:199.
        in structNew dcVal: u64:1114368 u64:0 ::
        out u32:4294967295.
    if dcIsFormat /c
        conv sub field /c u32:0 u64:2228224 u32
        /noRegionId.

: Exact `DcTF` (`f641`) encoded byte length (`1..=23`) for any 128-bit `dcVal`.
: @dc l8589980659
pub v/u64/lenDctf dcVal/c
    test
        in structNew dcVal: u64:0 u64:0 ::
        out u64:1.
        in structNew dcVal: u64:127 u64:0 ::
        out u64:1.
        in structNew dcVal: u64:128 u64:0 ::
        out u64:2.
        in structNew dcVal: u64:2047 u64:0 ::
        out u64:2.
        in structNew dcVal: u64:2048 u64:0 ::
        out u64:3.
        in structNew dcVal: u64:65535 u64:0 ::
        out u64:3.
        in structNew dcVal: u64:65536 u64:0 ::
        out u64:4.
        in structNew dcVal: u64:2097151 u64:0 ::
        out u64:4.
        in structNew dcVal: u64:2097152 u64:0 ::
        out u64:5.
        in structNew dcVal: u64:68719476735 u64:0 ::
        out u64:7.
        in structNew dcVal: u64:68719476736 u64:0 ::
        out u64:8.
        in structNew dcVal: u64:18446744073709551615 u64:18446744073709551615 ::
        out u64:23.
    const u64/lo field /c u32:0.
    const u64/hi field /c u32:1.
    if eq /hi u64:0
        if le /lo u64:127
            u64:1
            if le /lo u64:2047
                u64:2
                if le /lo u64:65535
                    u64:3
                    if le /lo u64:2097151
                        u64:4
                        if le /lo u64:67108863
                            u64:5
                            if le /lo u64:2147483647
                                u64:6
                                if le /lo u64:68719476735
                                    u64:7
                                    do
                                        const u32/lz u128Clz dcToU128Raw /c.
                                        const u32/bits sub u32:128 /lz.
                                        const u32/k if le /bits u32:38 u32:0 div add sub /bits u32:38 u32:5 u32:6.
                                        add u64:8 conv /k u64.
                                    ::
        do
            const u32/lz u128Clz dcToU128Raw /c.
            const u32/bits sub u32:128 /lz.
            const u32/k if le /bits u32:38 u32:0 div add sub /bits u32:38 u32:5 u32:6.
            add u64:8 conv /k u64.
        ::.

: Module-private helper appending the canonical `DcTF` byte encoding of `c` into `out`.
: @dc l8589980660
v/void/encodeDctfPush buf/u8/out dcVal/c
    const u64/lo field /c u32:0.
    const u64/hi field /c u32:1.
    if and eq /hi u64:0 le /lo u64:127
        do
            bufPush /out conv /lo u8.
            return.
        ::
        nop.
    if and eq /hi u64:0 le /lo u64:68719476735
        do
            let u32/contCount u32:1.
            let u8/leadPrefix u8:192.
            if le /lo u64:2047
                nop
                if le /lo u64:65535
                    do
                        set /contCount u32:2.
                        set /leadPrefix u8:224.
                    ::
                    if le /lo u64:2097151
                        do
                            set /contCount u32:3.
                            set /leadPrefix u8:240.
                        ::
                        if le /lo u64:67108863
                            do
                                set /contCount u32:4.
                                set /leadPrefix u8:248.
                            ::
                            if le /lo u64:2147483647
                                do
                                    set /contCount u32:5.
                                    set /leadPrefix u8:252.
                                ::
                                do
                                    set /contCount u32:6.
                                    set /leadPrefix u8:254.
                                ::.
            const u32/topShift mul /contCount u32:6.
            bufPush /out bitOr /leadPrefix conv shr /lo /topShift u8.
            let u32/idx u32:0.
            while lt /idx /contCount do
                const u32/sh mul sub sub /contCount u32:1 /idx u32:6.
                bufPush /out bitOr u8:128 conv bitAnd shr /lo /sh u64:63 u8.
                set /idx add /idx u32:1.
            ::.
            return.
        ::
        nop.
    const u128Val/u dcToU128Raw /c.
    const u32/lz u128Clz /u.
    const u32/bits sub u32:128 /lz.
    const u32/k if le /bits u32:38 u32:0 div add sub /bits u32:38 u32:5 u32:6.
    const u32/contCount add /k u32:6.
    const u32/topShift mul /contCount u32:6.
    const u8/top2 if lt /topShift u32:128
        conv bitAnd field u128ShrRaw /u /topShift u32:0 u64:3 u8
        u8:0.
    bufPush /out u8:255.
    bufPush /out bitOr u8:128 bitOr shl conv /k u8 u32:2 /top2.
    let u32/idx u32:0.
    while lt /idx /contCount do
        const u32/sh mul sub sub /contCount u32:1 /idx u32:6.
        const u128Val/shifted u128ShrRaw /u /sh.
        bufPush /out bitOr u8:128 conv bitAnd field /shifted u32:0 u64:63 u8.
        set /idx add /idx u32:1.
    ::.

: Encodes a single `dcVal` into its canonical `1..=23`-byte `DcTF` slice (`l/u8`).
: @dc l8589980661
pub v/l/u8/encodeDctfOne dcVal/c
    test
        in structNew dcVal: u64:65 u64:0 ::
        out b"A".
        in structNew dcVal: u64:128 u64:0 ::
        out b"/xc2/x80".
    const buf/u8/out bufNew u8 lenDctf /c.
    encodeDctfPush /out /c.
    bufFreeze /out.

: Encodes a `l/dcVal` sequence into a canonical `DcTF` byte slice (`l/u8`).
: @dc l8589980662
pub v/l/u8/encodeDcStream l/dcVal/tokens
    test
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:128 u64:0 :: ::
        out b"A/xc2/x80".
    let u64/total u64:0.
    foreach dcVal/tok /tokens do
        set /total add /total lenDctf /tok.
    ::.
    const buf/u8/out bufNew u8 /total.
    foreach dcVal/tok /tokens do
        encodeDctfPush /out /tok.
    ::.
    bufFreeze /out.

: Decodes one canonical `DcTF` character starting at `pos` in `bytes` -> `(ok, dc, nextPos)`.
: @dc l8589980663
pub v/tup: b dcVal u64 ::/decodeDctfOne l/u8/bytes u64/pos
    test
        in b"A" u64:0
        out tupNew: true structNew dcVal: u64:65 u64:0 :: u64:1 ::.
        in b"/xc2/x80" u64:0
        out tupNew: true structNew dcVal: u64:128 u64:0 :: u64:2 ::.
        in b"/xc0/x80" u64:0
        out tupNew: false structNew dcVal: u64:0 u64:0 :: u64:0 ::.
    const u64/blen len /bytes.
    if ge /pos /blen
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    const u8/first get /bytes /pos.
    if lt /first u8:128
        return tupNew: true dcNew conv /first u64 u64:0 add /pos u64:1 ::
        nop.
    if lt /first u8:194
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    if eq /first u8:255
        do
            if ge add /pos u64:1 /blen
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            const u8/b1 get /bytes add /pos u64:1.
            if ne bitAnd /b1 u8:192 u8:128
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            const u32/k conv bitAnd shr /b1 u32:2 u8:15 u32.
            const u64/totalLen add u64:8 conv /k u64.
            if gt add /pos /totalLen /blen
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            let u128Val/val u128FromU64 conv bitAnd /b1 u8:3 u64.
            let u64/idx u64:2.
            while lt /idx /totalLen do
                const u8/cont get /bytes add /pos /idx.
                if ne bitAnd /cont u8:192 u8:128
                    return tupNew: false dcNew u64:0 u64:0 /pos ::
                    nop.
                set /val u128BitOr u128ShlRaw /val u32:6 u128FromU64 conv bitAnd /cont u8:63 u64.
                set /idx add /idx u64:1.
            ::.
            const u32/minShift if eq /k u32:0 u32:36 add u32:32 mul u32:6 /k.
            const u128Val/minVal u128ShlRaw u128FromU64 u64:1 /minShift.
            if u128Lt /val /minVal
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            return tupNew: true dcFromU128Raw /val add /pos /totalLen ::.
        ::
        nop.
    let u64/seqLen u64:7.
    let u64/minLo u64:2147483648.
    let u8/leadMask u8:0.
    if eq bitAnd /first u8:224 u8:192
        do
            set /seqLen u64:2.
            set /minLo u64:128.
            set /leadMask u8:31.
        ::
        if eq bitAnd /first u8:240 u8:224
            do
                set /seqLen u64:3.
                set /minLo u64:2048.
                set /leadMask u8:15.
            ::
            if eq bitAnd /first u8:248 u8:240
                do
                    set /seqLen u64:4.
                    set /minLo u64:65536.
                    set /leadMask u8:7.
                ::
                if eq bitAnd /first u8:252 u8:248
                    do
                        set /seqLen u64:5.
                        set /minLo u64:2097152.
                        set /leadMask u8:3.
                    ::
                    if eq bitAnd /first u8:254 u8:252
                        do
                            set /seqLen u64:6.
                            set /minLo u64:67108864.
                            set /leadMask u8:1.
                        ::
                        nop.
    if gt add /pos /seqLen /blen
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    let u64/acc conv bitAnd /first /leadMask u64.
    let u64/j u64:1.
    while lt /j /seqLen do
        const u8/cb get /bytes add /pos /j.
        if ne bitAnd /cb u8:192 u8:128
            return tupNew: false dcNew u64:0 u64:0 /pos ::
            nop.
        set /acc bitOr shl /acc u32:6 conv bitAnd /cb u8:63 u64.
        set /j add /j u64:1.
    ::.
    if lt /acc /minLo
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    tupNew: true dcNew /acc u64:0 add /pos /seqLen ::.

: Decodes an entire canonical `DcTF` byte slice into `l/dcVal` (`(ok, tokens)`).
: @dc l8589980664
pub v/tup: b l/dcVal ::/decodeDcStream l/u8/bytes
    test
        in b"A/xc2/x80"
        out tupNew: true l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:128 u64:0 :: :: ::.
        in b"/xff/x80"
        out tupNew: false l/dcVal: :: ::.
    const u64/blen len /bytes.
    const buf/dcVal/out bufNew dcVal shr /blen u32:2.
    let u64/pos u64:0.
    while lt /pos /blen do
        const tup: b dcVal u64 ::/one decodeDctfOne /bytes /pos.
        if not field /one u32:0
            return tupNew: false l/dcVal: :: ::
            nop.
        bufPush /out field /one u32:1.
        set /pos field /one u32:2.
    ::.
    tupNew: true bufFreeze /out ::.

: Builds an atom `dcVal` token sequence (`[Dc 255, c]` when `c` is `Dc 203`/`255`/`616`, else `[c]`).
: @dc l8589980665
pub v/l/dcVal/tokAtomDc dcVal/c
    test
        in structNew dcVal: u64:1114315 u64:0 ::
        out l/dcVal: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: ::.
        in structNew dcVal: u64:1114368 u64:0 ::
        out l/dcVal: structNew dcVal: u64:1114368 u64:0 :: ::.
    const u32/sid dcShortId /c.
    if or eq /sid u32:203 or eq /sid u32:255 eq /sid u32:616
        l/dcVal: dcShort u32:255 /c ::
        l/dcVal: /c ::.

: Builds `tokAtomDc /c` when `present` is true, or `[Dc 316]` when false.
: @dc l8589980666
pub v/l/dcVal/tokOptAtomDc b/present dcVal/c
    test
        in false structNew dcVal: u64:1114368 u64:0 ::
        out l/dcVal: structNew dcVal: u64:1114428 u64:0 :: ::.
    if /present
        tokAtomDc /c
        l/dcVal: dcShort u32:316 ::.

: Builds a `Dc 270 .. Dc 271` programmatic identifier token sequence from ASCII bytes `name`.
: @dc l8589980667
pub v/l/dcVal/tokIdent l/u8/name
    test
        in b"x1"
        out l/dcVal: structNew dcVal: u64:1114382 u64:0 :: structNew dcVal: u64:120 u64:0 :: structNew dcVal: u64:49 u64:0 :: structNew dcVal: u64:1114383 u64:0 :: ::.
    const u64/nlen len /name.
    const buf/dcVal/out bufNew dcVal add /nlen u64:2.
    bufPush /out dcShort u32:270.
    let u64/i u64:0.
    while lt /i /nlen do
        const dcVal/ch dcUnicode conv get /name /i u32.
        const u32/sid dcShortId /ch.
        if or eq /sid u32:255 or eq /sid u32:271 and eq /i u64:0 or dcIsFormat /ch eq /sid u32:262
            bufPush /out dcShort u32:255
            nop.
        bufPush /out /ch.
        set /i add /i u64:1.
    ::.
    bufPush /out dcShort u32:271.
    bufFreeze /out.

: Builds `Dc 260 Dc 262 <typeDc> Dc 263 <escaped payload> Dc 261`.
: @dc l8589980668
pub v/l/dcVal/tokEscapedLiteral dcVal/typeDc l/dcVal/payload
    test
        in structNew dcVal: u64:1114752 u64:0 :: l/dcVal: structNew dcVal: u64:1114373 u64:0 :: ::
        out l/dcVal: structNew dcVal: u64:1114372 u64:0 :: structNew dcVal: u64:1114374 u64:0 :: structNew dcVal: u64:1114752 u64:0 :: structNew dcVal: u64:1114375 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: ::.
    const buf/dcVal/out bufNew dcVal add len /payload u64:5.
    bufPush /out dcShort u32:260.
    bufPush /out dcShort u32:262.
    bufPush /out /typeDc.
    bufPush /out dcShort u32:263.
    foreach dcVal/ch /payload do
        const u32/sid dcShortId /ch.
        if or eq /sid u32:261 eq /sid u32:255
            bufPush /out dcShort u32:255
            nop.
        bufPush /out /ch.
    ::.
    bufPush /out dcShort u32:261.
    bufFreeze /out.

: Builds `Dc 6 <dcFormat fmtId> [Dc 11] <MSB-first Base64 digits> Dc 7`.
: @dc l8589980669
pub v/l/dcVal/tokTypedNumberU128 u32/fmtId b/isNeg u128Val/mag
    test
        in u32:208 true structNew u128Val: u64:5 u64:0 ::
        out l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228432 u64:0 :: structNew dcVal: u64:1114123 u64:0 :: structNew dcVal: u64:1114244 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: ::.
        in u32:199 false structNew u128Val: u64:0 u64:0 ::
        out l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228423 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: ::.
    if eq /mag /u128Zero
        return l/dcVal: dcShort u32:6 dcFormat /fmtId dcShort u32:127 dcShort u32:7 ::
        nop.
    const buf/dcVal/out bufNew dcVal u64:26.
    bufPush /out dcShort u32:6.
    bufPush /out dcFormat /fmtId.
    if /isNeg
        bufPush /out dcShort u32:11
        nop.
    const buf/u32/revDigits bufNew u32 u64:22.
    let u128Val/cur /mag.
    while ne /cur /u128Zero do
        const u32/dig conv bitAnd field /cur u32:0 u64:63 u32.
        bufPush /revDigits add u32:127 /dig.
        set /cur u128ShrRaw /cur u32:6.
    ::.
    let u64/idx len /revDigits.
    while gt /idx u64:0 do
        set /idx sub /idx u64:1.
        bufPush /out dcShort get /revDigits /idx.
    ::.
    bufPush /out dcShort u32:7.
    bufFreeze /out.

: Builds an untyped `Dc 6 f199 <digits> Dc 7` numeral for `val`.
: @dc l8589980670
pub v/l/dcVal/tokDcNumberU64 u64/val
    test
        in u64:0
        out l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228423 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: ::.
    tokTypedNumberU128 u32:199 false u128FromU64 /val.

: Builds a typed non-negative `Dc 6 <dcFormat fmtId> <digits> Dc 7` numeral for `val`.
: @dc l8589980671
pub v/l/dcVal/tokTypedU64 u32/fmtId u64/val
    test
        in u32:207 u64:3
        out l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228431 u64:0 :: structNew dcVal: u64:1114242 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: ::.
    tokTypedNumberU128 /fmtId false u128FromU64 /val.

: Builds a `Dc 203 <len> <Base64 digits/padding> Dc 204` raw binary byte literal token sequence.
: @dc l8589980672
pub v/l/dcVal/tokBinaryBytes l/u8/bytes
    test
        in b""
