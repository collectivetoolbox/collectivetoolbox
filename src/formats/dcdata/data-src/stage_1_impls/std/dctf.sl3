: Builds a `Dc 203 <len> <Base64 digits/padding> Dc 204` raw binary byte literal token sequence.
: @dc l8589980672
pub v/l/dcVal/tokBinaryBytes l/u8/bytes
    test
        in b""
        out l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228423 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: ::.
    be u64/blen len /bytes.
    be buf/dcVal/out bufNew dcVal sum u64:10 prod quot sum /blen u64:2 u64:3 u64:4.
    bufGain /out dcShort u32:203.
    bufGainAll /out tokDcNumberU64 /blen.
    hold u64/i u64:0.
    while le sum /i u64:3 /blen do
        be u8/b0 at /bytes /i.
        be u8/b1 at /bytes sum /i u64:1.
        be u8/b2 at /bytes sum /i u64:2.
        bufGain /out dcShort sum u32:127 conv shr /b0 u32:2 u32.
        bufGain /out dcShort sum u32:127 conv bitOr shl bitAnd /b0 u8:3 u32:4 shr /b1 u32:4 u32.
        bufGain /out dcShort sum u32:127 conv bitOr shl bitAnd /b1 u8:15 u32:2 shr /b2 u32:6 u32.
        bufGain /out dcShort sum u32:127 conv bitAnd /b2 u8:63 u32.
        become /i sum /i u64:3.
    ::.
    be u64/rem diff /blen /i.
    if eq /rem u64:1
        do
            be u8/b0 at /bytes /i.
            bufGain /out dcShort sum u32:127 conv shr /b0 u32:2 u32.
            bufGain /out dcShort sum u32:127 conv shl bitAnd /b0 u8:3 u32:4 u32.
            bufGain /out dcShort u32:195.
            bufGain /out dcShort u32:195.
        ::
        if eq /rem u64:2
            do
                be u8/b0 at /bytes /i.
                be u8/b1 at /bytes sum /i u64:1.
                bufGain /out dcShort sum u32:127 conv shr /b0 u32:2 u32.
                bufGain /out dcShort sum u32:127 conv bitOr shl bitAnd /b0 u8:3 u32:4 shr /b1 u32:4 u32.
                bufGain /out dcShort sum u32:127 conv shl bitAnd /b1 u8:15 u32:2 u32.
                bufGain /out dcShort u32:195.
            ::
            nop.
    bufGain /out dcShort u32:204.
    bufFrozen /out.

: Returns true iff `c` opens a single-line or block comment (`Dc 246`, `247`, `249`, `250`).
: @dc l8589980673
pub v/b/isCommentOpen dcVal/c
    test
        in structNew dcVal: u64:1114359 u64:0 ::
        out true.
        in structNew dcVal: u64:1116304 u64:0 ::
        out false.
    be u32/sid dcShortId /c.
    or eq /sid u32:246 or eq /sid u32:247 or eq /sid u32:249 eq /sid u32:250.

: Advances past one comment frame starting at `pos` (honoring `Dc 255` escapes).
: @dc l8589980674
pub v/u64/skipOneComment l/dcVal/tokens u64/pos
    be u64/tlen len /tokens.
    if ge /pos /tlen
        return /pos
        nop.
    be u32/openSid dcShortId at /tokens /pos.
    be u32/closeSid if or eq /openSid u32:246 eq /openSid u32:247 u32:248 u32:251.
    hold u64/i sum /pos u64:1.
    while lt /i /tlen do
        be u32/sid dcShortId at /tokens /i.
        if eq /sid u32:255
            become /i sum /i u64:2
            if eq /sid /closeSid
                return sum /i u64:1
                become /i sum /i u64:1.
    ::.
    /tlen.

: Advances `pos` past all consecutive comment frames.
: @dc l8589980675
pub v/u64/skipComments l/dcVal/tokens u64/pos
    be u64/tlen len /tokens.
    hold u64/cur /pos.
    while and lt /cur /tlen isCommentOpen at /tokens /cur do
        become /cur skipOneComment /tokens /cur.
    ::.
    /cur.

: Reads one atom `dcVal` (with optional `Dc 255` escape or `Dc 2239` atom quote) at `pos` -> `(ok, atom, nextPos)`.
: @dc l8589980676
pub v/tup: b dcVal u64 ::/readAtomDc l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: :: u64:0
        out tupNew: true structNew dcVal: u64:1114315 u64:0 :: u64:2 ::.
    test
        in l/dcVal: structNew dcVal: u64:1116351 u64:0 :: structNew dcVal: u64:0 u64:2 :: :: u64:0
        out tupNew: true structNew dcVal: u64:0 u64:2 :: u64:2 ::.
    be u64/tlen len /tokens.
    if ge /pos /tlen
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    be dcVal/first at /tokens /pos.
    be u32/fsid dcShortId /first.
    if eq /fsid u32:2239
        do
            be u64/p1 sum /pos u64:1.
            if ge /p1 /tlen
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            be dcVal/nx at /tokens /p1.
            if eq dcShortId /nx u32:255
                if ge sum /pos u64:2 /tlen
                    return tupNew: false dcNew u64:0 u64:0 /pos ::
                    return tupNew: true at /tokens sum /pos u64:2 sum /pos u64:3 ::
                return tupNew: true /nx sum /pos u64:2 ::.
        ::
        nop.
    if eq /fsid u32:255
        if ge sum /pos u64:1 /tlen
            tupNew: false dcNew u64:0 u64:0 /pos ::
            tupNew: true at /tokens sum /pos u64:1 sum /pos u64:2 ::
        tupNew: true /first sum /pos u64:1 ::.

: Reads a `Dc 270 .. Dc 271` ASCII programmatic identifier at `pos` -> `(ok, asciiBytes, nextPos)`.
: @dc l8589980677
pub v/tup: b l/u8 u64 ::/readIdentBytes l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114382 u64:0 :: structNew dcVal: u64:120 u64:0 :: structNew dcVal: u64:49 u64:0 :: structNew dcVal: u64:1114383 u64:0 :: :: u64:0
        out tupNew: true b"x1" u64:4 ::.
    test
        in l/dcVal: structNew dcVal: u64:1114382 u64:0 :: structNew dcVal: u64:1116351 u64:0 :: structNew dcVal: u64:120 u64:0 :: structNew dcVal: u64:1114383 u64:0 :: :: u64:0
        out tupNew: true b"x" u64:4 ::.
    be u64/tlen len /tokens.
    if or ge /pos /tlen ne dcShortId at /tokens /pos u32:270
        return tupNew: false b"" /pos ::
        nop.
    be buf/u8/chars bufNew u8 u64:16.
    hold u64/i sum /pos u64:1.
    while lt /i /tlen do
        be dcVal/tok at /tokens /i.
        be u32/sid dcShortId /tok.
        if eq /sid u32:271
            return tupNew: true bufFrozen /chars sum /i u64:1 ::
            nop.
        hold dcVal/ch /tok.
        if eq /sid u32:2239
            do
                if ge sum /i u64:1 /tlen
                    return tupNew: false b"" /pos ::
                    nop.
                become /ch at /tokens sum /i u64:1.
                if eq dcShortId /ch u32:255
                    do
                        if ge sum /i u64:2 /tlen
                            return tupNew: false b"" /pos ::
                            nop.
                        become /ch at /tokens sum /i u64:2.
                        become /i sum /i u64:3.
                    ::
                    become /i sum /i u64:2.
            ::
            if eq /sid u32:255
                do
                    if ge sum /i u64:1 /tlen
                        return tupNew: false b"" /pos ::
                        nop.
                    become /ch at /tokens sum /i u64:1.
                    become /i sum /i u64:2.
                ::
                become /i sum /i u64:1.
        if or ne field /ch u32:1 u64:0 gt field /ch u32:0 u64:127
            return tupNew: false b"" /pos ::
            nop.
        bufGain /chars conv field /ch u32:0 u8.
    ::.
    tupNew: false b"" /pos ::.

: Reads `Dc 260 Dc 262 <typeDc> Dc 263 <escaped payload> Dc 261` at `pos` -> `(ok, typeDc, payload, nextPos)`.
: @dc l8589980678
pub v/tup: b dcVal l/dcVal u64 ::/readEscapedLiteral l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114372 u64:0 :: structNew dcVal: u64:1114374 u64:0 :: structNew dcVal: u64:1114752 u64:0 :: structNew dcVal: u64:1114375 u64:0 :: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: structNew dcVal: u64:1114373 u64:0 :: :: u64:0
        out tupNew: true structNew dcVal: u64:1114752 u64:0 :: l/dcVal: structNew dcVal: u64:1114373 u64:0 :: :: u64:7 ::.
    test
        in l/dcVal: structNew dcVal: u64:1114372 u64:0 :: structNew dcVal: u64:1114374 u64:0 :: structNew dcVal: u64:1114376 u64:0 :: structNew dcVal: u64:1114375 u64:0 :: structNew dcVal: u64:1116351 u64:0 :: structNew dcVal: u64:0 u64:2 :: structNew dcVal: u64:1114373 u64:0 :: :: u64:0
        out tupNew: true structNew dcVal: u64:1114376 u64:0 :: l/dcVal: structNew dcVal: u64:0 u64:2 :: :: u64:7 ::.
    be u64/tlen len /tokens.
    if gt sum /pos u64:5 /tlen
        return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
        nop.
    if or ne dcShortId at /tokens /pos u32:260 or ne dcShortId at /tokens sum /pos u64:1 u32:262 ne dcShortId at /tokens sum /pos u64:3 u32:263
        return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
        nop.
    be dcVal/typeDc at /tokens wrapSum /pos u64:2.
    be buf/dcVal/payload bufNew dcVal wrapDiff /tlen /pos.
    hold u64/i wrapSum /pos u64:4.
    while lt /i /tlen do
        be dcVal/tok at /tokens /i.
        be u32/sid dcShortId /tok.
        if eq /sid u32:261
            return tupNew: true /typeDc bufFrozen /payload wrapSum /i u64:1 ::
            nop.
        if eq /sid u32:2239
            do
                be u64/i1 wrapSum /i u64:1.
                if ge /i1 /tlen
                    return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
                    nop.
                be dcVal/nx at /tokens /i1.
                if eq dcShortId /nx u32:255
                    do
                        be u64/i2 wrapSum /i u64:2.
                        if ge /i2 /tlen
                            return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
                            nop.
                        bufGain /payload at /tokens /i2.
                        become /i wrapSum /i u64:3.
                    ::
                    do
                        bufGain /payload /nx.
                        become /i wrapSum /i u64:2.
                    ::.
            ::
            if eq /sid u32:255
                do
                    be u64/i1 wrapSum /i u64:1.
                    if ge /i1 /tlen
                        return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
                        nop.
                    bufGain /payload at /tokens /i1.
                    become /i wrapSum /i u64:2.
                ::
                do
                    bufGain /payload /tok.
                    become /i wrapSum /i u64:1.
                ::.
    ::.
    tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::.

: Reads `Dc 6 <fmtDc> [Dc 11] <Base64 digits 0..=63> Dc 7` -> `(ok, fmtId, isNeg, digits0to63, nextPos)`.
: @dc l8589980679
pub v/tup: b u32 b l/u8 u64 ::/readNumberRaw l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228432 u64:0 :: structNew dcVal: u64:1114123 u64:0 :: structNew dcVal: u64:1114244 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: :: u64:0
        out tupNew: true u32:208 true b"/x05" u64:5 ::.
    be u64/tlen len /tokens.
    if gt sum /pos u64:4 /tlen
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    if ne dcShortId at /tokens /pos u32:6
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    be dcVal/fmtTok at /tokens sum /pos u64:1.
    if not dcIsFormat /fmtTok
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    be u32/fmtId dcFormatId /fmtTok.
    hold u64/i sum /pos u64:2.
    hold b/isNeg false.
    if eq dcShortId at /tokens /i u32:11
        do
            become /isNeg true.
            become /i sum /i u64:1.
        ::
        nop.
    be buf/u8/digits bufNew u8 u64:22.
    while lt /i /tlen do
        be u32/sid dcShortId at /tokens /i.
        if eq /sid u32:7
            if eq len /digits u64:0
                return tupNew: false u32:0 false b"" /pos ::
                return tupNew: true /fmtId /isNeg bufFrozen /digits sum /i u64:1 ::
            nop.
        if or lt /sid u32:127 gt /sid u32:190
            return tupNew: false u32:0 false b"" /pos ::
            nop.
        bufGain /digits conv diff /sid u32:127 u8.
        become /i sum /i u64:1.
    ::.
    tupNew: false u32:0 false b"" /pos ::.

: Converts MSB-first 6-bit Base64 digits (`0..=63`) to `u128Val` (`(ok, val)`), rejecting `>= 2^128`.
: @dc l8589980680
pub v/tup: b u128Val ::/digitsToU128 l/u8/digits
    test
        in b"/x01/x00"
        out tupNew: true structNew u128Val: u64:64 u64:0 :: ::.
    be u128Val/maxBeforeShift u128New u64:18446744073709551615 u64:288230376151711743.
    hold u128Val/acc /u128Zero.
    foreach u8/dig /digits do
        if not u128Ge /maxBeforeShift /acc
            return tupNew: false /u128Zero ::
            nop.
        become /acc u128BitOr u128ShlRaw /acc u32:6 u128FromU64 conv /dig u64.
    ::.
    tupNew: true /acc ::.

: Reads a `Dc 203 <len> <Base64 digits/padding> Dc 204` raw binary literal at `pos` -> `(ok, bytes, nextPos)`.
: @dc l8589980681
pub v/tup: b l/u8 u64 ::/readBinaryBytes l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228423 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: :: u64:0
        out tupNew: true b"" u64:6 ::.
    be u64/tlen len /tokens.
    if or ge /pos /tlen ne dcShortId at /tokens /pos u32:203
        return tupNew: false b"" /pos ::
        nop.
    be tup: b u32 b l/u8 u64 ::/numRes readNumberRaw /tokens sum /pos u64:1.
    if or not field /numRes u32:0 or ne field /numRes u32:1 u32:199 field /numRes u32:2
        return tupNew: false b"" /pos ::
        nop.
    be tup: b u128Val ::/lenRes digitsToU128 field /numRes u32:3.
    if or not field /lenRes u32:0 ne field field /lenRes u32:1 u32:1 u64:0
        return tupNew: false b"" /pos ::
        nop.
    be u64/expectedLen field field /lenRes u32:1 u32:0.
    be buf/u8/out bufNew u8 /expectedLen.
    hold u64/i field /numRes u32:4.
    while lt /i /tlen do
        if eq dcShortId at /tokens /i u32:204
            if eq len /out /expectedLen
                return tupNew: true bufFrozen /out sum /i u64:1 ::
                return tupNew: false b"" /pos ::
            nop.
        if gt sum /i u64:4 /tlen
            return tupNew: false b"" /pos ::
            nop.
        be u32/s0 dcShortId at /tokens /i.
        be u32/s1 dcShortId at /tokens sum /i u64:1.
        be u32/s2 dcShortId at /tokens sum /i u64:2.
        be u32/s3 dcShortId at /tokens sum /i u64:3.
        if or lt /s0 u32:127 or gt /s0 u32:190 or lt /s1 u32:127 gt /s1 u32:190
            return tupNew: false b"" /pos ::
            nop.
        be u8/d0 conv diff /s0 u32:127 u8.
        be u8/d1 conv diff /s1 u32:127 u8.
        bufGain /out bitOr shl /d0 u32:2 shr /d1 u32:4.
        if eq /s2 u32:195
            if ne /s3 u32:195
                return tupNew: false b"" /pos ::
                nop
            do
                if or lt /s2 u32:127 gt /s2 u32:190
                    return tupNew: false b"" /pos ::
                    nop.
                be u8/d2 conv diff /s2 u32:127 u8.
                bufGain /out bitOr shl bitAnd /d1 u8:15 u32:4 shr /d2 u32:2.
                if ne /s3 u32:195
                    do
                        if or lt /s3 u32:127 gt /s3 u32:190
                            return tupNew: false b"" /pos ::
                            nop.
                        be u8/d3 conv diff /s3 u32:127 u8.
                        bufGain /out bitOr shl bitAnd /d2 u8:3 u32:6 /d3.
                    ::
                    nop.
            ::.
        become /i sum /i u64:4.
    ::.
    tupNew: false b"" /pos ::.

: Verifies multi-tier `DcTF` (`1..=23` bytes) and Token-Dc builder/reader roundtrips.
: @dc l8589980682
v/b/checkDctfRoundtrips
    test
        in.
        out true.
    be l/dcVal/sample l/dcVal:
        dcNew u64:0 u64:0
        dcNew u64:127 u64:0
        dcNew u64:128 u64:0
        dcNew u64:2048 u64:0
        dcNew u64:65536 u64:0
        dcNew u64:2097152 u64:0
        dcNew u64:67108864 u64:0
        dcNew u64:2147483648 u64:0
        dcNew u64:68719476736 u64:0
        dcNew u64:8589978237 u64:0
        dcNew u64:18446744073709551615 u64:18446744073709551615
    ::.
    be tup: b l/dcVal ::/dec decodeDcStream encodeDcStream /sample.
    be tup: b l/u8 u64 ::/b1 readBinaryBytes tokBinaryBytes b"Hello!" u64:0.
    be tup: b l/u8 u64 ::/b2 readBinaryBytes tokBinaryBytes b"ab" u64:0.
    be tup: b l/u8 u64 ::/b3 readBinaryBytes tokBinaryBytes b"a" u64:0.
    and field /dec u32:0
        and eq field /dec u32:1 /sample
            and eq field /b1 u32:1 b"Hello!"
                and eq field /b2 u32:1 b"ab"
                    eq field /b3 u32:1 b"a".
