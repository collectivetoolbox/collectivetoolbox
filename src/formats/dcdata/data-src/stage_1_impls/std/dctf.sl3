: Returns true iff `c` opens a single-line or block comment (`Dc 246`, `247`, `249`, `250`).
: @dc l8589980673
pub v/b/isCommentOpen dcVal/c
    test
        in structNew dcVal: u64:1114359 u64:0 ::
        out true.
        in structNew dcVal: u64:1116304 u64:0 ::
        out false.
    const u32/sid dcShortId /c.
    or eq /sid u32:246 or eq /sid u32:247 or eq /sid u32:249 eq /sid u32:250.

: Advances past one comment frame starting at `pos` (honoring `Dc 255` escapes).
: @dc l8589980674
pub v/u64/skipOneComment l/dcVal/tokens u64/pos
    const u64/tlen len /tokens.
    if ge /pos /tlen
        return /pos
        nop.
    const u32/openSid dcShortId get /tokens /pos.
    const u32/closeSid if or eq /openSid u32:246 eq /openSid u32:247 u32:248 u32:251.
    let u64/i add /pos u64:1.
    while lt /i /tlen do
        const u32/sid dcShortId get /tokens /i.
        if eq /sid u32:255
            set /i add /i u64:2
            if eq /sid /closeSid
                return add /i u64:1
                set /i add /i u64:1.
    ::.
    /tlen.

: Advances `pos` past all consecutive comment frames.
: @dc l8589980675
pub v/u64/skipComments l/dcVal/tokens u64/pos
    const u64/tlen len /tokens.
    let u64/cur /pos.
    while and lt /cur /tlen isCommentOpen get /tokens /cur do
        set /cur skipOneComment /tokens /cur.
    ::.
    /cur.

: Reads one atom `dcVal` (with optional `Dc 255` escape) at `pos` -> `(ok, atom, nextPos)`.
: @dc l8589980676
pub v/tup: b dcVal u64 ::/readAtomDc l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114367 u64:0 :: structNew dcVal: u64:1114315 u64:0 :: :: u64:0
        out tupNew: true structNew dcVal: u64:1114315 u64:0 :: u64:2 ::.
