                if ge add /i u64:1 /tlen
                    return tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::
                    nop.
                bufPush /payload get /tokens add /i u64:1.
                set /i add /i u64:2.
            ::
            do
                bufPush /payload /tok.
                set /i add /i u64:1.
            ::.
    ::.
    tupNew: false dcNew u64:0 u64:0 l/dcVal: :: /pos ::.

: Reads `Dc 6 <fmtDc> [Dc 11] <Base64 digits 0..=63> Dc 7` -> `(ok, fmtId, isNeg, digits0to63, nextPos)`.
: @dc l8589980679
pub v/tup: b u32 b l/u8 u64 ::/readNumberRaw l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228432 u64:0 :: structNew dcVal: u64:1114123 u64:0 :: structNew dcVal: u64:1114244 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: :: u64:0
        out tupNew: true u32:208 true b"/x05" u64:5 ::.
    const u64/tlen len /tokens.
    if gt add /pos u64:4 /tlen
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    if ne dcShortId get /tokens /pos u32:6
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    const dcVal/fmtTok get /tokens add /pos u64:1.
    if not dcIsFormat /fmtTok
        return tupNew: false u32:0 false b"" /pos ::
        nop.
    const u32/fmtId dcFormatId /fmtTok.
    let u64/i add /pos u64:2.
    let b/isNeg false.
    if eq dcShortId get /tokens /i u32:11
        do
            set /isNeg true.
            set /i add /i u64:1.
        ::
        nop.
    const buf/u8/digits bufNew u8 u64:22.
    while lt /i /tlen do
        const u32/sid dcShortId get /tokens /i.
        if eq /sid u32:7
            if eq len /digits u64:0
                return tupNew: false u32:0 false b"" /pos ::
                return tupNew: true /fmtId /isNeg bufFreeze /digits add /i u64:1 ::
            nop.
        if or lt /sid u32:127 gt /sid u32:190
            return tupNew: false u32:0 false b"" /pos ::
            nop.
        bufPush /digits conv sub /sid u32:127 u8.
        set /i add /i u64:1.
    ::.
    tupNew: false u32:0 false b"" /pos ::.

: Converts MSB-first 6-bit Base64 digits (`0..=63`) to `u128Val` (`(ok, val)`), rejecting `>= 2^128`.
: @dc l8589980680
pub v/tup: b u128Val ::/digitsToU128 l/u8/digits
    test
        in b"/x01/x00"
        out tupNew: true structNew u128Val: u64:64 u64:0 :: ::.
    const u128Val/maxBeforeShift u128New u64:18446744073709551615 u64:288230376151711743.
    let u128Val/acc /u128Zero.
    foreach u8/dig /digits do
        if not u128Ge /maxBeforeShift /acc
            return tupNew: false /u128Zero ::
            nop.
        set /acc u128BitOr u128ShlRaw /acc u32:6 u128FromU64 conv /dig u64.
    ::.
    tupNew: true /acc ::.

: Reads a `Dc 203 <len> <Base64 digits/padding> Dc 204` raw binary literal at `pos` -> `(ok, bytes, nextPos)`.
: @dc l8589980681
pub v/tup: b l/u8 u64 ::/readBinaryBytes l/dcVal/tokens u64/pos
    test
        in l/dcVal: structNew dcVal: u64:1114315 u64:0 :: structNew dcVal: u64:1114118 u64:0 :: structNew dcVal: u64:2228423 u64:0 :: structNew dcVal: u64:1114239 u64:0 :: structNew dcVal: u64:1114119 u64:0 :: structNew dcVal: u64:1114316 u64:0 :: :: u64:0
        out tupNew: true b"" u64:6 ::.
    const u64/tlen len /tokens.
    if or ge /pos /tlen ne dcShortId get /tokens /pos u32:203
        return tupNew: false b"" /pos ::
        nop.
    const tup: b u32 b l/u8 u64 ::/numRes readNumberRaw /tokens add /pos u64:1.
    if or not field /numRes u32:0 or ne field /numRes u32:1 u32:199 field /numRes u32:2
        return tupNew: false b"" /pos ::
        nop.
    const tup: b u128Val ::/lenRes digitsToU128 field /numRes u32:3.
    if or not field /lenRes u32:0 ne field field /lenRes u32:1 u32:1 u64:0
        return tupNew: false b"" /pos ::
        nop.
    const u64/expectedLen field field /lenRes u32:1 u32:0.
    const buf/u8/out bufNew u8 /expectedLen.
    let u64/i field /numRes u32:4.
    while lt /i /tlen do
        if eq dcShortId get /tokens /i u32:204
            if eq len /out /expectedLen
                return tupNew: true bufFreeze /out add /i u64:1 ::
                return tupNew: false b"" /pos ::
            nop.
        if gt add /i u64:4 /tlen
            return tupNew: false b"" /pos ::
            nop.
        const u32/s0 dcShortId get /tokens /i.
        const u32/s1 dcShortId get /tokens add /i u64:1.
        const u32/s2 dcShortId get /tokens add /i u64:2.
        const u32/s3 dcShortId get /tokens add /i u64:3.
        if or lt /s0 u32:127 or gt /s0 u32:190 or lt /s1 u32:127 gt /s1 u32:190
            return tupNew: false b"" /pos ::
            nop.
        const u8/d0 conv sub /s0 u32:127 u8.
        const u8/d1 conv sub /s1 u32:127 u8.
        bufPush /out bitOr shl /d0 u32:2 shr /d1 u32:4.
        if eq /s2 u32:195
            if ne /s3 u32:195
                return tupNew: false b"" /pos ::
                nop
            do
                if or lt /s2 u32:127 gt /s2 u32:190
                    return tupNew: false b"" /pos ::
                    nop.
                const u8/d2 conv sub /s2 u32:127 u8.
                bufPush /out bitOr shl bitAnd /d1 u8:15 u32:4 shr /d2 u32:2.
                if ne /s3 u32:195
                    do
                        if or lt /s3 u32:127 gt /s3 u32:190
                            return tupNew: false b"" /pos ::
                            nop.
                        const u8/d3 conv sub /s3 u32:127 u8.
                        bufPush /out bitOr shl bitAnd /d2 u8:3 u32:6 /d3.
                    ::
                    nop.
            ::.
        set /i add /i u64:4.
    ::.
    tupNew: false b"" /pos ::.

: Verifies multi-tier `DcTF` (`1..=23` bytes) and Token-Dc builder/reader roundtrips.
: @dc l8589980682
v/b/checkDctfRoundtrips
    test
        in.
        out true.
    const l/dcVal/sample l/dcVal:
        dcNew u64:0 u64:0
        dcNew u64:127 u64:0
        dcNew u64:128 u64:0
        dcNew u64:2048 u64:0
        dcNew u64:65536 u64:0
        dcNew u64:2097152 u64:0
        dcNew u64:67108864 u64:0
        dcNew u64:2147483648 u64:0
        dcNew u64:68719476736 u64:0
        dcNew u64:8589978237 u64:0
        dcNew u64:18446744073709551615 u64:18446744073709551615
    ::.
    const tup: b l/dcVal ::/dec decodeDcStream encodeDcStream /sample.
    const tup: b l/u8 u64 ::/b1 readBinaryBytes tokBinaryBytes b"Hello!" u64:0.
    const tup: b l/u8 u64 ::/b2 readBinaryBytes tokBinaryBytes b"ab" u64:0.
    const tup: b l/u8 u64 ::/b3 readBinaryBytes tokBinaryBytes b"a" u64:0.
    and field /dec u32:0
        and eq field /dec u32:1 /sample
            and eq field /b1 u32:1 b"Hello!"
                and eq field /b2 u32:1 b"ab"
                    eq field /b3 u32:1 b"a".
