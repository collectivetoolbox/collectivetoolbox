: Stage 1 canonical `DcTF` (`f641`) wire codec and high-level Token-Dc stream reader/builder helpers.
ns std/dctf.
use std/u128: u128Val u128Zero u128New from as u128FromU64 lt as u128Lt ge as u128Ge bitOr as u128BitOr u128ShlRaw u128ShrRaw clz as u128Clz ::.

: 128-bit Document Character scalar: slot 0 = `lo` (`u64`), slot 1 = `hi` (`u64`).
: @dc l8589980641
pub struct dcVal :: u64 u64.

: Sentinel returned by `dcShortId` and `dcFormatId` when a `dcVal` is outside that region.
: @dc l8589980646
pub u32/noRegionId u32:4294967295.

: Constructs `dcVal` from raw `(lo, hi)` 64-bit limbs.
: @dc l8589980647
pub v/dcVal/dcNew u64/lo u64/hi
    test
        in u64:65 u64:0
        out structNew dcVal: u64:65 u64:0 ::.
    structNew dcVal: /lo /hi ::.

: Converts `u128Val` to `dcVal` without checking surrogate range.
: @dc l8589980648
pub v/dcVal/dcFromU128Raw u128Val/v
    test
        in structNew u128Val: u64:97 u64:0 ::
        out structNew dcVal: u64:97 u64:0 ::.
    structNew dcVal: field /v u32:0 field /v u32:1 ::.

: Converts `dcVal` to `u128Val`.
: @dc l8589980649
pub v/u128Val/dcToU128Raw dcVal/c
    test
        in structNew dcVal: u64:97 u64:0 ::
        out structNew u128Val: u64:97 u64:0 ::.
    u128New field /c u32:0 field /c u32:1.

: Constructs a Short Document Character (`1_114_112 + id`).
: @dc l8589980651
pub v/dcVal/dcShort u32/id
    test
        in u32:256
        out structNew dcVal: u64:1114368 u64:0 ::.
    structNew dcVal: sum u64:1114112 conv /id u64 u64:0 ::.

: Constructs a Format Document Character (`2_228_224 + id`).
: @dc l8589980652
pub v/dcVal/dcFormat u32/id
    test
        in u32:199
        out structNew dcVal: u64:2228423 u64:0 ::.
    structNew dcVal: sum u64:2228224 conv /id u64 u64:0 ::.

: Constructs a Unicode codepoint `dcVal` (`0..=0x10FFFF`).
: @dc l8589980653
pub v/dcVal/dcUnicode u32/cp
    test
        in u32:65
        out structNew dcVal: u64:65 u64:0 ::.
    structNew dcVal: conv /cp u64 u64:0 ::.

: Returns `Dc 517 "Boolean true"` or `Dc 518 "Boolean false"`.
: @dc l8589980654
pub v/dcVal/dcBool b/val
    test
        in true
        out structNew dcVal: u64:1114629 u64:0 ::.
        in false
        out structNew dcVal: u64:1114630 u64:0 ::.
    dcShort if /val u32:517 u32:518.

: Returns true iff `c` is in the Short Dc region (`1_114_112..=2_228_223`).
: @dc l8589980655
pub v/b/dcIsShort dcVal/c
    test
        in structNew dcVal: u64:1114368 u64:0 ::
        out true.
        in structNew dcVal: u64:2228224 u64:0 ::
        out false.
    and eq field /c u32:1 u64:0 and ge field /c u32:0 u64:1114112 le field /c u32:0 u64:2228223.

: Returns the Short Dc ID (`0..=1_114_111`), or `noRegionId` (`u32:4294967295`) if not a Short Dc.
: @dc l8589980656
pub v/u32/dcShortId dcVal/c
    test
        in structNew dcVal: u64:1114368 u64:0 ::
        out u32:256.
        in structNew dcVal: u64:65 u64:0 ::
        out u32:4294967295.
    if dcIsShort /c
        conv diff field /c u32:0 u64:1114112 u32
        /noRegionId.

: Returns true iff `c` is in the Format Dc region (`2_228_224..=3_342_335`).
: @dc l8589980657
pub v/b/dcIsFormat dcVal/c
    test
        in structNew dcVal: u64:2228423 u64:0 ::
        out true.
        in structNew dcVal: u64:1114368 u64:0 ::
        out false.
    and eq field /c u32:1 u64:0 and ge field /c u32:0 u64:2228224 le field /c u32:0 u64:3342335.

: Returns the Format ID (`0..=1_114_111`), or `noRegionId` (`u32:4294967295`) if not a Format Dc.
: @dc l8589980658
pub v/u32/dcFormatId dcVal/c
    test
        in structNew dcVal: u64:2228423 u64:0 ::
        out u32:199.
        in structNew dcVal: u64:1114368 u64:0 ::
        out u32:4294967295.
    if dcIsFormat /c
        conv diff field /c u32:0 u64:2228224 u32
        /noRegionId.

: Exact `DcTF` (`f641`) encoded byte length (`1..=23`) for any 128-bit `dcVal`.
: @dc l8589980659
pub v/u64/lenDctf dcVal/c
    test
        in structNew dcVal: u64:0 u64:0 ::
        out u64:1.
        in structNew dcVal: u64:127 u64:0 ::
        out u64:1.
        in structNew dcVal: u64:128 u64:0 ::
        out u64:2.
        in structNew dcVal: u64:2047 u64:0 ::
        out u64:2.
        in structNew dcVal: u64:2048 u64:0 ::
        out u64:3.
        in structNew dcVal: u64:65535 u64:0 ::
        out u64:3.
        in structNew dcVal: u64:65536 u64:0 ::
        out u64:4.
        in structNew dcVal: u64:2097151 u64:0 ::
        out u64:4.
        in structNew dcVal: u64:2097152 u64:0 ::
        out u64:5.
        in structNew dcVal: u64:68719476735 u64:0 ::
        out u64:7.
        in structNew dcVal: u64:68719476736 u64:0 ::
        out u64:8.
        in structNew dcVal: u64:18446744073709551615 u64:18446744073709551615 ::
        out u64:23.
    be u64/lo field /c u32:0.
    be u64/hi field /c u32:1.
    if eq /hi u64:0
        if le /lo u64:127
            u64:1
            if le /lo u64:2047
                u64:2
                if le /lo u64:65535
                    u64:3
                    if le /lo u64:2097151
                        u64:4
                        if le /lo u64:67108863
                            u64:5
                            if le /lo u64:2147483647
                                u64:6
                                if le /lo u64:68719476735
                                    u64:7
                                    do
                                        be u32/lz u128Clz dcToU128Raw /c.
                                        be u32/bits diff u32:128 /lz.
                                        be u32/k if le /bits u32:38 u32:0 quot sum diff /bits u32:38 u32:5 u32:6.
                                        sum u64:8 conv /k u64.
                                    ::
        do
            be u32/lz u128Clz dcToU128Raw /c.
            be u32/bits diff u32:128 /lz.
            be u32/k if le /bits u32:38 u32:0 quot sum diff /bits u32:38 u32:5 u32:6.
            sum u64:8 conv /k u64.
        ::.

: Module-private helper appending the canonical `DcTF` byte encoding of `c` into `out`.
: @dc l8589980660
v/void/encodeDctfPush buf/u8/out dcVal/c
    be u64/lo field /c u32:0.
    be u64/hi field /c u32:1.
    if and eq /hi u64:0 le /lo u64:127
        do
            bufGain /out conv /lo u8.
            return.
        ::
        nop.
    if and eq /hi u64:0 le /lo u64:68719476735
        do
            hold u32/contCount u32:1.
            hold u8/leadPrefix u8:192.
            if le /lo u64:2047
                nop
                if le /lo u64:65535
                    do
                        become /contCount u32:2.
                        become /leadPrefix u8:224.
                    ::
                    if le /lo u64:2097151
                        do
                            become /contCount u32:3.
                            become /leadPrefix u8:240.
                        ::
                        if le /lo u64:67108863
                            do
                                become /contCount u32:4.
                                become /leadPrefix u8:248.
                            ::
                            if le /lo u64:2147483647
                                do
                                    become /contCount u32:5.
                                    become /leadPrefix u8:252.
                                ::
                                do
                                    become /contCount u32:6.
                                    become /leadPrefix u8:254.
                                ::.
            be u32/topShift prod /contCount u32:6.
            bufGain /out bitOr /leadPrefix conv shr /lo /topShift u8.
            hold u32/idx u32:0.
            while lt /idx /contCount do
                be u32/sh prod diff diff /contCount u32:1 /idx u32:6.
                bufGain /out bitOr u8:128 conv bitAnd shr /lo /sh u64:63 u8.
                become /idx sum /idx u32:1.
            ::.
            return.
        ::
        nop.
    be u128Val/u dcToU128Raw /c.
    be u32/lz u128Clz /u.
    be u32/bits diff u32:128 /lz.
    be u32/k if le /bits u32:38 u32:0 quot sum diff /bits u32:38 u32:5 u32:6.
    be u32/contCount sum /k u32:6.
    be u32/topShift prod /contCount u32:6.
    be u8/top2 if lt /topShift u32:128
        conv bitAnd field u128ShrRaw /u /topShift u32:0 u64:3 u8
        u8:0.
    bufGain /out u8:255.
    bufGain /out bitOr u8:128 bitOr shl conv /k u8 u32:2 /top2.
    hold u32/idx u32:0.
    while lt /idx /contCount do
        be u32/sh prod diff diff /contCount u32:1 /idx u32:6.
        be u128Val/shifted u128ShrRaw /u /sh.
        bufGain /out bitOr u8:128 conv bitAnd field /shifted u32:0 u64:63 u8.
        become /idx sum /idx u32:1.
    ::.

: Encodes a single `dcVal` into its canonical `1..=23`-byte `DcTF` slice (`l/u8`).
: @dc l8589980661
pub v/l/u8/encodeDctfOne dcVal/c
    test
        in structNew dcVal: u64:65 u64:0 ::
        out b"A".
        in structNew dcVal: u64:128 u64:0 ::
        out b"/xc2/x80".
    be buf/u8/out bufNew u8 lenDctf /c.
    encodeDctfPush /out /c.
    bufFrozen /out.

: Encodes a `l/dcVal` sequence into a canonical `DcTF` byte slice (`l/u8`).
: @dc l8589980662
pub v/l/u8/encodeDcStream l/dcVal/tokens
    test
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:128 u64:0 :: ::
        out b"A/xc2/x80".
    be buf/u8/out bufNew u8 wrapSum wrapProd len /tokens u64:4 u64:64.
    foreach dcVal/tok /tokens do
        be u64/lo field /tok u32:0.
        be u64/hi field /tok u32:1.
        if eq /hi u64:0
            if le /lo u64:127
                bufGain /out conv /lo u8
                if and ge /lo u64:65536 le /lo u64:2097151
                    do
                        bufGain /out bitOr u8:240 conv shr /lo u32:18 u8.
                        bufGain /out bitOr u8:128 conv bitAnd shr /lo u32:12 u64:63 u8.
                        bufGain /out bitOr u8:128 conv bitAnd shr /lo u32:6 u64:63 u8.
                        bufGain /out bitOr u8:128 conv bitAnd /lo u64:63 u8.
                    ::
                    if and ge /lo u64:2097152 le /lo u64:67108863
                        do
                            bufGain /out bitOr u8:248 conv shr /lo u32:24 u8.
                            bufGain /out bitOr u8:128 conv bitAnd shr /lo u32:18 u64:63 u8.
                            bufGain /out bitOr u8:128 conv bitAnd shr /lo u32:12 u64:63 u8.
                            bufGain /out bitOr u8:128 conv bitAnd shr /lo u32:6 u64:63 u8.
                            bufGain /out bitOr u8:128 conv bitAnd /lo u64:63 u8.
                        ::
                        encodeDctfPush /out /tok
            encodeDctfPush /out /tok.
    ::.
    bufFrozen /out.

: Decodes one canonical `DcTF` character starting at `pos` in `bytes` -> `(ok, dc, nextPos)`.
: @dc l8589980663
pub v/tup: b dcVal u64 ::/decodeDctfOne l/u8/bytes u64/pos
    test
        in b"A" u64:0
        out tupNew: true structNew dcVal: u64:65 u64:0 :: u64:1 ::.
        in b"/xc2/x80" u64:0
        out tupNew: true structNew dcVal: u64:128 u64:0 :: u64:2 ::.
        in b"/xc0/x80" u64:0
        out tupNew: false structNew dcVal: u64:0 u64:0 :: u64:0 ::.
    be u64/blen len /bytes.
    if ge /pos /blen
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    be u8/first at /bytes /pos.
    if lt /first u8:128
        return tupNew: true dcNew conv /first u64 u64:0 sum /pos u64:1 ::
        nop.
    if lt /first u8:194
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    if eq /first u8:255
        do
            if ge sum /pos u64:1 /blen
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            be u8/b1 at /bytes sum /pos u64:1.
            if ne bitAnd /b1 u8:192 u8:128
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            be u32/k conv bitAnd shr /b1 u32:2 u8:15 u32.
            be u64/totalLen sum u64:8 conv /k u64.
            if gt sum /pos /totalLen /blen
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            hold u128Val/val u128FromU64 conv bitAnd /b1 u8:3 u64.
            hold u64/idx u64:2.
            while lt /idx /totalLen do
                be u8/cont at /bytes sum /pos /idx.
                if ne bitAnd /cont u8:192 u8:128
                    return tupNew: false dcNew u64:0 u64:0 /pos ::
                    nop.
                become /val u128BitOr u128ShlRaw /val u32:6 u128FromU64 conv bitAnd /cont u8:63 u64.
                become /idx sum /idx u64:1.
            ::.
            be u32/minShift if eq /k u32:0 u32:36 sum u32:32 prod u32:6 /k.
            be u128Val/minVal u128ShlRaw u128FromU64 u64:1 /minShift.
            if u128Lt /val /minVal
                return tupNew: false dcNew u64:0 u64:0 /pos ::
                nop.
            return tupNew: true dcFromU128Raw /val sum /pos /totalLen ::.
        ::
        nop.
    hold u64/seqLen u64:7.
    hold u64/minLo u64:2147483648.
    hold u8/leadMask u8:0.
    if eq bitAnd /first u8:224 u8:192
        do
            become /seqLen u64:2.
            become /minLo u64:128.
            become /leadMask u8:31.
        ::
        if eq bitAnd /first u8:240 u8:224
            do
                become /seqLen u64:3.
                become /minLo u64:2048.
                become /leadMask u8:15.
            ::
            if eq bitAnd /first u8:248 u8:240
                do
                    become /seqLen u64:4.
                    become /minLo u64:65536.
                    become /leadMask u8:7.
                ::
                if eq bitAnd /first u8:252 u8:248
                    do
                        become /seqLen u64:5.
                        become /minLo u64:2097152.
                        become /leadMask u8:3.
                    ::
                    if eq bitAnd /first u8:254 u8:252
                        do
                            become /seqLen u64:6.
                            become /minLo u64:67108864.
                            become /leadMask u8:1.
                        ::
                        nop.
    if gt sum /pos /seqLen /blen
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    hold u64/acc conv bitAnd /first /leadMask u64.
    hold u64/j u64:1.
    while lt /j /seqLen do
        be u8/cb at /bytes sum /pos /j.
        if ne bitAnd /cb u8:192 u8:128
            return tupNew: false dcNew u64:0 u64:0 /pos ::
            nop.
        become /acc bitOr shl /acc u32:6 conv bitAnd /cb u8:63 u64.
        become /j sum /j u64:1.
    ::.
    if lt /acc /minLo
        return tupNew: false dcNew u64:0 u64:0 /pos ::
        nop.
    tupNew: true dcNew /acc u64:0 sum /pos /seqLen ::.

: Decodes an entire canonical `DcTF` byte slice into `l/dcVal` (`(ok, tokens)`).
: @dc l8589980664
pub v/tup: b l/dcVal ::/decodeDcStream l/u8/bytes
    test
        in b"A/xc2/x80"
        out tupNew: true l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:128 u64:0 :: :: ::.
        in b"/xff/x80"
        out tupNew: false l/dcVal: :: ::.
    be u64/blen len /bytes.
    be buf/dcVal/out bufNew dcVal shr /blen u32:2.
    hold u64/pos u64:0.
    while lt /pos /blen do
        be u8/b0 at /bytes /pos.
        if lt /b0 u8:128
            do
                bufGain /out structNew dcVal: conv /b0 u64 u64:0 ::.
                become /pos wrapSum /pos u64:1.
                continue.
            ::
            nop.
        if and ge /b0 u8:240 le /b0 u8:247
            do
                be u64/pos4 wrapSum /pos u64:4.
                if gt /pos4 /blen
                    return tupNew: false l/dcVal: :: ::
                    nop.
                be u8/b1 at /bytes wrapSum /pos u64:1.
                be u8/b2 at /bytes wrapSum /pos u64:2.
                be u8/b3 at /bytes wrapSum /pos u64:3.
                if or ne bitAnd /b1 u8:192 u8:128 or ne bitAnd /b2 u8:192 u8:128 ne bitAnd /b3 u8:192 u8:128
                    return tupNew: false l/dcVal: :: ::
                    nop.
                be u64/lo bitOr shl conv bitAnd /b0 u8:7 u64 u32:18
                    bitOr shl conv bitAnd /b1 u8:63 u64 u32:12
                        bitOr shl conv bitAnd /b2 u8:63 u64 u32:6
                            conv bitAnd /b3 u8:63 u64.
                if lt /lo u64:65536
                    return tupNew: false l/dcVal: :: ::
                    nop.
                bufGain /out structNew dcVal: /lo u64:0 ::.
                become /pos /pos4.
                continue.
            ::
            nop.
        if and ge /b0 u8:248 le /b0 u8:251
            do
                be u64/pos5 wrapSum /pos u64:5.
                if gt /pos5 /blen
                    return tupNew: false l/dcVal: :: ::
                    nop.
                be u8/b1 at /bytes wrapSum /pos u64:1.
                be u8/b2 at /bytes wrapSum /pos u64:2.
                be u8/b3 at /bytes wrapSum /pos u64:3.
                be u8/b4 at /bytes wrapSum /pos u64:4.
                if or ne bitAnd /b1 u8:192 u8:128 or ne bitAnd /b2 u8:192 u8:128 or ne bitAnd /b3 u8:192 u8:128 ne bitAnd /b4 u8:192 u8:128
                    return tupNew: false l/dcVal: :: ::
                    nop.
                be u64/lo bitOr shl conv bitAnd /b0 u8:3 u64 u32:24
                    bitOr shl conv bitAnd /b1 u8:63 u64 u32:18
                        bitOr shl conv bitAnd /b2 u8:63 u64 u32:12
                            bitOr shl conv bitAnd /b3 u8:63 u64 u32:6
                                conv bitAnd /b4 u8:63 u64.
                if lt /lo u64:2097152
                    return tupNew: false l/dcVal: :: ::
                    nop.
                bufGain /out structNew dcVal: /lo u64:0 ::.
                become /pos /pos5.
                continue.
            ::
            nop.
        be tup: b dcVal u64 ::/one decodeDctfOne /bytes /pos.
        if not field /one u32:0
            return tupNew: false l/dcVal: :: ::
            nop.
        bufGain /out field /one u32:1.
        become /pos field /one u32:2.
    ::.
    tupNew: true bufFrozen /out ::.

: Returns exact canonical `DcTF` byte length (`1..=23`) at `pos < end`, or `0` if invalid/truncated.
: @dc l8589993764
v/u64/dctfTokenByteLen l/u8/rawBytes u64/pos u64/end
    be u8/b0 at /rawBytes /pos.
    if lt /b0 u8:128
        return u64:1
        nop.
    if lt /b0 u8:194
        return u64:0
        nop.
    if lt /b0 u8:224
        return u64:2
        nop.
    if lt /b0 u8:240
        return u64:3
        nop.
    if lt /b0 u8:248
        return u64:4
        nop.
    if lt /b0 u8:252
        return u64:5
        nop.
    if lt /b0 u8:254
        return u64:6
        nop.
    if eq /b0 u8:254
        return u64:7
        nop.
    be u64/p1 wrapSum /pos u64:1.
    if ge /p1 /end
        return u64:0
        nop.
    be u8/b1 at /rawBytes /p1.
    if ne bitAnd /b1 u8:192 u8:128
        return u64:0
        nop.
    wrapSum u64:8 conv bitAnd shr /b1 u32:2 u8:15 u64.

: Validates a `DcTF`-encoded `[string]` literal (`Dc 260 262 264 263 <payload> Dc 261`)
: and strips literal `Dc 255` escapes via bulk `slice`/`bufExtend`,
: returning `(ok, unescapedBytes)`.
: @dc l8589993765
pub v/tup: b l/u8 ::/unescapeDctfStringLitBytes l/u8/rawBytes
    test
        in b"/xf4/x90/x84/x84/xf4/x90/x84/x86/xf4/x90/x84/x88/xf4/x90/x84/x87A/xf4/x90/x9e/x87/xf4/x90/x84/x85"
        out tupNew: true b"A/xf4/x90/x9e/x87" ::.
        in b"/xf4/x90/x84/x84/xf4/x90/x84/x86/xf4/x90/x84/x88/xf4/x90/x84/x87A/xf4/x90/x83/xbf/xf4/x90/x84/x85/xf4/x90/x83/xbf/xf4/x90/x83/xbf/xf4/x90/x84/x85"
        out tupNew: true b"A/xf4/x90/x84/x85/xf4/x90/x83/xbf" ::.
        in b"/xf4/x90/x84/x84/xf4/x90/x84/x86/xf4/x90/x84/x88/xf4/x90/x84/x87/xf4/x90/x84/x85/xf4/x90/x84/x85"
        out tupNew: false b"" ::.
        in b"/xf4/x90/x84/x84/xf4/x90/x84/x86/xf4/x90/x84/x88/xf4/x90/x84/x87/xf4/x90/x83/xbf/xf4/x90/x84/x85"
        out tupNew: false b"" ::.
        in b"/xf4/x90/x84/x84/xf4/x90/x84/x86/xf4/x90/x84/x88/xf4/x90/x84/x87/xff/x80/x88/x80/x80/x80/x80/x80/xf4/x90/x84/x85"
        out tupNew: true b"/xff/x80/x88/x80/x80/x80/x80/x80" ::.
    be u64/blen len /rawBytes.
