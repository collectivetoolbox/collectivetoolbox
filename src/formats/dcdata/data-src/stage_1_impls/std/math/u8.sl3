: SPDX-License-Identifier: AGPL-3.0-or-later
: Stage 1 unsigned 8-bit non-trapping overflow and division predicates.
ns std/math/u8.

: Maximum unsigned 8-bit integer (255).
: @dc l8589978265
pub u8/MAX u8:255.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978266
pub v/b/canAdd u8/lhs u8/rhs
    test
        in u8:200 u8:55
        out true.
        in u8:200 u8:56
        out false.
        in u8:255 u8:0
        out true.
        in u8:255 u8:1
        out false.
    ge wrapAdd u8/lhs u8/rhs u8/lhs.

: Returns true iff checked `sub lhs rhs` will not underflow unsigned 8-bit bounds.
: @dc l8589978267
pub v/b/canSub u8/lhs u8/rhs
    test
        in u8:10 u8:10
        out true.
        in u8:10 u8:11
        out false.
        in u8:0 u8:1
        out false.
    ge u8/lhs u8/rhs.

: Returns true iff checked `mul lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978268
pub v/b/canMul u8/lhs u8/rhs
    test
        in u8:15 u8:17
        out true.
        in u8:16 u8:16
        out false.
        in u8:255 u8:0
        out true.
        in u8:0 u8:255
        out true.
        in u8:255 u8:1
        out true.
    if eq u8/rhs u8:0
        true
        eq div wrapMul u8/lhs u8/rhs u8/rhs u8/lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0`).
: @dc l8589978269
pub v/b/canDiv u8/lhs u8/rhs
    test
        in u8:10 u8:2
        out true.
        in u8:10 u8:0
        out false.
        in u8:0 u8:0
        out false.
    ne u8/rhs u8:0.
