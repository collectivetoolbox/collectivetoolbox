: Stage 1 pure Document Character (`dc` / `dcVal`) and sequence (`dcs` / `l/dcVal`) runtime helpers.
ns std/dcs.
use std/u128: u128Val ::.
use std/dctf: dcVal dcNew dcFromU128Raw dcToU128Raw ::.

: Infallible `u128FromDc` projection (`dcVal -> u128Val`).
: @dc l8589982142
pub v/u128Val/u128FromDc dcVal/c
    test
        in structNew dcVal: u64:1114368 u64:0 ::
        out structNew u128Val: u64:1114368 u64:0 ::.
    dcToU128Raw /c.

: Total `get` on `dcs` (`(l/dcVal, u64) -> tup: b dcVal ::`).
: @dc l8589982143
pub v/tup: b dcVal ::/tryGet l/dcVal/seq u64/idx
    test
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:66 u64:0 :: :: u64:1
        out tupNew: true structNew dcVal: u64:66 u64:0 :: ::.
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: :: u64:3
        out tupNew: false structNew dcVal: u64:0 u64:0 :: ::.
    if lt /idx len /seq
        tupNew: true at /seq /idx ::
        tupNew: false dcNew u64:0 u64:0 ::.

: Total `slice` on `dcs` (`(l/dcVal, u64, u64) -> tup: b l/dcVal ::`).
: @dc l8589982144
pub v/tup: b l/dcVal ::/trySlice l/dcVal/seq u64/start u64/end
    test
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: structNew dcVal: u64:66 u64:0 :: structNew dcVal: u64:67 u64:0 :: :: u64:1 u64:3
        out tupNew: true l/dcVal: structNew dcVal: u64:66 u64:0 :: structNew dcVal: u64:67 u64:0 :: :: ::.
        in l/dcVal: structNew dcVal: u64:65 u64:0 :: :: u64:2 u64:1
        out tupNew: false l/dcVal: :: ::.
    if and le /start /end le /end len /seq
        tupNew: true slice /seq /start /end ::
        tupNew: false l/dcVal: :: ::.

: Splits `input` around non-overlapping occurrences of `sep` (`explode` on `dcs`).
: @dc l8589982145
pub v/l/l/dcVal/pieces l/dcVal/sep l/dcVal/input
    test
        in l/dcVal: structNew dcVal: u64:58 u64:0 :: :: l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:58 u64:0 :: structNew dcVal: u64:98 u64:0 :: structNew dcVal: u64:58 u64:0 :: ::
        out l/l/dcVal: l/dcVal: structNew dcVal: u64:97 u64:0 :: :: l/dcVal: structNew dcVal: u64:98 u64:0 :: :: l/dcVal: :: ::.
        in l/dcVal: :: l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:98 u64:0 :: ::
        out l/l/dcVal: l/dcVal: structNew dcVal: u64:97 u64:0 :: :: l/dcVal: structNew dcVal: u64:98 u64:0 :: :: ::.
        in l/dcVal: :: l/dcVal: ::
        out l/l/dcVal: ::.
    be u64/slen len /sep.
    be u64/ilen len /input.
    if eq /slen u64:0
        do
            if eq /ilen u64:0
                return l/l/dcVal: ::
                nop.
            be buf/l/dcVal/out bufNew l/dcVal /ilen.
            hold u64/i u64:0.
            while lt /i /ilen do
                bufGain /out l/dcVal: at /input /i ::.
                become /i sum /i u64:1.
            ::.
            return bufFrozen /out.
        ::
        nop.
    be buf/l/dcVal/out bufNew l/dcVal u64:4.
    hold u64/cursor u64:0.
    while le /cursor /ilen do
        be u64/remLen diff /ilen /cursor.
        if lt /remLen /slen
            do
                bufGain /out slice /input /cursor /ilen.
                return bufFrozen /out.
            ::
            nop.
        be u64/maxOff diff /remLen /slen.
        hold b/found false.
        hold u64/foundOff u64:0.
        hold u64/off u64:0.
        while and not /found le /off /maxOff do
            be u64/cand sum /cursor /off.
            if eq slice /input /cand sum /cand /slen /sep
                do
                    become /found true.
                    become /foundOff /off.
                ::
                become /off sum /off u64:1.
        ::.
        if /found
            do
                bufGain /out slice /input /cursor sum /cursor /foundOff.
                become /cursor sum sum /cursor /foundOff /slen.
            ::
            do
                bufGain /out slice /input /cursor /ilen.
                return bufFrozen /out.
            ::.
    ::.
    bufGain /out l/dcVal: ::.
    bufFrozen /out.

: Concatenates `parts` interspersed with `sep` (`implode` on `dcs`).
: @dc l8589982146
pub v/l/dcVal/joined l/dcVal/sep l/l/dcVal/parts
    test
        in l/dcVal: structNew dcVal: u64:58 u64:0 :: :: l/l/dcVal: l/dcVal: structNew dcVal: u64:97 u64:0 :: :: l/dcVal: structNew dcVal: u64:98 u64:0 :: :: l/dcVal: :: ::
        out l/dcVal: structNew dcVal: u64:97 u64:0 :: structNew dcVal: u64:58 u64:0 :: structNew dcVal: u64:98 u64:0 :: structNew dcVal: u64:58 u64:0 :: ::.
    be u64/plen len /parts.
    if eq /plen u64:0
        return l/dcVal: ::
        nop.
    be u64/slen len /sep.
    hold u64/total prod diff /plen u64:1 /slen.
    foreach l/dcVal/p /parts do
        become /total sum /total len /p.
    ::.
    be buf/dcVal/out bufNew dcVal /total.
    hold u64/idx u64:0.
    while lt /idx /plen do
        if gt /idx u64:0
            bufGainAll /out /sep
            nop.
        bufGainAll /out at /parts /idx.
        become /idx sum /idx u64:1.
    ::.
    bufFrozen /out.

: Infallible `dcFromU128` conversion (`u128Val -> dcVal`, `Dc 2610`; all `0..=2^128-1` scalars including surrogates are valid).
: @dc l8589984708
pub v/dcVal/dcFromU128 u128Val/raw
    test
        in structNew u128Val: u64:256 u64:0 ::
        out structNew dcVal: u64:256 u64:0 ::.
        in structNew u128Val: u64:55296 u64:0 ::
        out structNew dcVal: u64:55296 u64:0 ::.
    dcFromU128Raw /raw.
