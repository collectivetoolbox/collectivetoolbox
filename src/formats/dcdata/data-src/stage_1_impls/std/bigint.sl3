: Stage 1 arbitrary-precision signed integer (`bigInt`) arithmetic, GCD, and conversion primitives.
ns std/bigint.
use std/u128: u128Val errOverflow errDivisionByZero u128Zero u128New tryToU64 as u128ToU64 tryToU32 as u128ToU32 tryToU8 as u128ToU8 ::.
use std/i128: i128Val i128Zero i128Min isNeg as i128IsNeg absU128 as i128AbsU128 tryFromU128 as i128FromU128 tryNeg as i128Neg tryToI64 as i128ToI64 tryToI32 as i128ToI32 ::.

: Canonical arbitrary-precision signed integer:
: slot 0 = `isNeg` (`false` when `>= 0`, `true` when `< 0`),
: slot 1 = little-endian base-`2^32` limbs with no trailing `u32:0` (`0` is `false` + `[]`).
: @dc l8589982082
pub struct bigInt :: b l/u32.

: Canonical `int:0`.
: @dc l8589982087
pub bigInt/intZero structNew bigInt: false l/u32: :: ::.

: Canonical `int:1`.
: @dc l8589982088
pub bigInt/intOne structNew bigInt: false l/u32: u32:1 :: ::.

: Canonical `int:-1`.
: @dc l8589982089
pub bigInt/intNegOne structNew bigInt: true l/u32: u32:1 :: ::.

: Strips trailing zero limbs from `raw`.
: @dc l8589982090
v/l/u32/normLimbs l/u32/raw
    hold u64/n len /raw.
    while and gt /n u64:0 eq at /raw diff /n u64:1 u32:0 do
        become /n diff /n u64:1.
    ::.
    if eq /n len /raw
        /raw
        slice /raw u64:0 /n.

: Builds a canonical `bigInt` from `isNeg` and `raw` little-endian `u32` limbs.
: @dc l8589982091
pub v/bigInt/makeBigInt b/isNeg l/u32/raw
    test
        in true l/u32: u32:0 u32:0 ::
        out structNew bigInt: false l/u32: :: ::.
        in true l/u32: u32:7 u32:0 ::
        out structNew bigInt: true l/u32: u32:7 :: ::.
    be l/u32/limbs normLimbs /raw.
    if eq len /limbs u64:0
        /intZero
        structNew bigInt: /isNeg /limbs ::.

: Returns true iff `x == 0`.
: @dc l8589982092
pub v/b/isZero bigInt/x
    test
        in structNew bigInt: false l/u32: :: ::
        out true.
        in structNew bigInt: false l/u32: u32:1 :: ::
        out false.
    eq len field /x u32:1 u64:0.

: Infallible widening `u64 -> bigInt`.
: @dc l8589982093
pub v/bigInt/from u64/x
    test
        in u64:0
        out structNew bigInt: false l/u32: :: ::.
        in u64:4294967297
        out structNew bigInt: false l/u32: u32:1 u32:1 :: ::.
    if eq /x u64:0
        /intZero
        do
            be u32/lo conv bitAnd /x u64:4294967295 u32.
            be u32/hi conv shr /x u32:32 u32.
            if eq /hi u32:0
                structNew bigInt: false l/u32: /lo :: ::
                structNew bigInt: false l/u32: /lo /hi :: ::.
        ::.

: Infallible widening `u32 -> bigInt`.
: @dc l8589982094
pub v/bigInt/from u32/x
    test
        in u32:42
        out structNew bigInt: false l/u32: u32:42 :: ::.
    if eq /x u32:0
        /intZero
        structNew bigInt: false l/u32: /x :: ::.

: Infallible widening `u8 -> bigInt`.
: @dc l8589982095
pub v/bigInt/from u8/x
    test
        in u8:255
        out structNew bigInt: false l/u32: u32:255 :: ::.
    from conv /x u32.

: Infallible widening `u128Val -> bigInt`.
: @dc l8589982096
pub v/bigInt/from u128Val/x
    test
        in structNew u128Val: u64:0 u64:1 ::
        out structNew bigInt: false l/u32: u32:0 u32:0 u32:1 :: ::.
    be u64/lo field /x u32:0.
    be u64/hi field /x u32:1.
    makeBigInt false l/u32:
        conv bitAnd /lo u64:4294967295 u32
        conv shr /lo u32:32 u32
        conv bitAnd /hi u64:4294967295 u32
        conv shr /hi u32:32 u32
    ::.

: Infallible widening `i128Val -> bigInt`.
: @dc l8589982097
pub v/bigInt/from i128Val/x
    test
        in structNew i128Val: u64:18446744073709551615 u64:18446744073709551615 ::
        out structNew bigInt: true l/u32: u32:1 :: ::.
    be u128Val/mag i128AbsU128 /x.
    be bigInt/pos from /mag.
    makeBigInt i128IsNeg /x field /pos u32:1.

: Infallible widening `i64 -> bigInt`.
: @dc l8589982098
pub v/bigInt/from i64/x
    test
        in i64:-9223372036854775808
        out structNew bigInt: true l/u32: u32:0 u32:2147483648 :: ::.
    if lt /x i64:0
        do
            be u64/mag wrapDiff u64:0 bitcast /x u64.
            be bigInt/pos from /mag.
            makeBigInt true field /pos u32:1.
        ::
        from conv /x u64.

: Infallible widening `i32 -> bigInt`.
: @dc l8589982099
pub v/bigInt/from i32/x
    test
        in i32:-42
        out structNew bigInt: true l/u32: u32:42 :: ::.
    from conv /x i64.

: Extracts unsigned `u128Val` magnitude if `len limbs <= 4` (`(ok, u128Val)`).
: @dc l8589982100
v/tup: b u128Val ::/limbsToU128 l/u32/limbs
    be u64/n len /limbs.
    if gt /n u64:4
        return tupNew: false /u128Zero ::
        nop.
    be u64/w0 if gt /n u64:0 conv at /limbs u64:0 u64 u64:0.
    be u64/w1 if gt /n u64:1 conv at /limbs u64:1 u64 u64:0.
    be u64/w2 if gt /n u64:2 conv at /limbs u64:2 u64 u64:0.
    be u64/w3 if gt /n u64:3 conv at /limbs u64:3 u64 u64:0.
    tupNew: true u128New bitOr /w0 shl /w1 u32:32 bitOr /w2 shl /w3 u32:32 ::.

: Checked narrowing `bigInt -> result/u128` (`tup: b u128Val u8 ::`).
: @dc l8589982101
pub v/tup: b u128Val u8 ::/tryToU128 bigInt/x
    test
        in structNew bigInt: true l/u32: u32:1 :: ::
        out tupNew: false structNew u128Val: u64:0 u64:0 :: u8:0 ::.
        in structNew bigInt: false l/u32: u32:5 :: ::
        out tupNew: true structNew u128Val: u64:5 u64:0 :: u8:0 ::.
    if field /x u32:0
        return tupNew: false /u128Zero /errOverflow ::
        nop.
    be tup: b u128Val ::/m limbsToU128 field /x u32:1.
    if field /m u32:0
        tupNew: true field /m u32:1 u8:0 ::
        tupNew: false /u128Zero /errOverflow ::.

: Checked narrowing `bigInt -> result/i128` (`tup: b i128Val u8 ::`).
: @dc l8589982102
pub v/tup: b i128Val u8 ::/tryToI128 bigInt/x
    test
        in structNew bigInt: true l/u32: u32:0 u32:0 u32:0 u32:2147483648 :: ::
        out tupNew: true structNew i128Val: u64:0 u64:9223372036854775808 :: u8:0 ::.
        in structNew bigInt: false l/u32: u32:0 u32:0 u32:0 u32:2147483648 :: ::
        out tupNew: false structNew i128Val: u64:0 u64:0 :: u8:0 ::.
    be tup: b u128Val ::/m limbsToU128 field /x u32:1.
    if not field /m u32:0
        return tupNew: false /i128Zero /errOverflow ::
        nop.
    be u128Val/mag field /m u32:1.
    if field /x u32:0
        if eq /mag u128New u64:0 u64:9223372036854775808
            tupNew: true /i128Min u8:0 ::
            do
                be tup: b i128Val u8 ::/pos i128FromU128 /mag.
                if not field /pos u32:0
                    tupNew: false /i128Zero /errOverflow ::
                    i128Neg field /pos u32:1.
            ::
        i128FromU128 /mag.

: Checked narrowing `bigInt -> result/u64`.
: @dc l8589982103
pub v/tup: b u64 u8 ::/tryToU64 bigInt/x
    be tup: b u128Val u8 ::/u tryToU128 /x.
    if not field /u u32:0
        tupNew: false u64:0 /errOverflow ::
        u128ToU64 field /u u32:1.

: Checked narrowing `bigInt -> result/u32`.
: @dc l8589982104
pub v/tup: b u32 u8 ::/tryToU32 bigInt/x
    be tup: b u128Val u8 ::/u tryToU128 /x.
    if not field /u u32:0
        tupNew: false u32:0 /errOverflow ::
        u128ToU32 field /u u32:1.

: Checked narrowing `bigInt -> result/u8`.
: @dc l8589982105
pub v/tup: b u8 u8 ::/tryToU8 bigInt/x
    test
        in structNew bigInt: false l/u32: u32:255 :: ::
        out tupNew: true u8:255 u8:0 ::.
        in structNew bigInt: false l/u32: u32:256 :: ::
        out tupNew: false u8:0 u8:0 ::.
    be tup: b u128Val u8 ::/u tryToU128 /x.
    if not field /u u32:0
        tupNew: false u8:0 /errOverflow ::
        u128ToU8 field /u u32:1.

: Checked narrowing `bigInt -> result/i64`.
: @dc l8589982106
pub v/tup: b i64 u8 ::/tryToI64 bigInt/x
    be tup: b i128Val u8 ::/s tryToI128 /x.
    if not field /s u32:0
        tupNew: false i64:0 /errOverflow ::
        i128ToI64 field /s u32:1.

: Checked narrowing `bigInt -> result/i32`.
: @dc l8589982107
pub v/tup: b i32 u8 ::/tryToI32 bigInt/x
    be tup: b i128Val u8 ::/s tryToI128 /x.
    if not field /s u32:0
        tupNew: false i32:0 /errOverflow ::
        i128ToI32 field /s u32:1.

: Decodes MSB-first 6-bit Base64 digits (`0..=63`, from `Dc 6 f199 ... Dc 7`) into a canonical `bigInt`.
: @dc l8589982108
pub v/bigInt/intFromBase64Digits b/isNeg l/u8/digits
    test
        in false b"/x00"
        out structNew bigInt: false l/u32: :: ::.
        in true b"/x01/x00"
        out structNew bigInt: true l/u32: u32:64 :: ::.
    be buf/u32/limbs bufNew u32 sum quot len /digits u64:5 u64:2.
    foreach u8/dig /digits do
        hold u64/carry conv /dig u64.
        hold u64/i u64:0.
        be u64/curLen len /limbs.
        while lt /i /curLen do
            be u64/prodVal sum shl conv at /limbs /i u64 u32:6 /carry.
            bufBecomeAt /limbs /i conv bitAnd /prodVal u64:4294967295 u32.
            become /carry shr /prodVal u32:32.
            become /i sum /i u64:1.
        ::.
        if ne /carry u64:0
            bufGain /limbs conv /carry u32
            nop.
    ::.
    makeBigInt /isNeg bufFrozen /limbs.

: Unsigned limb magnitude comparison (`-1`, `0`, `1`).
: @dc l8589982109
v/i32/cmpMag l/u32/a l/u32/b
    be u64/la len /a.
    be u64/lb len /b.
    if lt /la /lb
        return i32:-1
        nop.
    if gt /la /lb
        return i32:1
        nop.
    hold u64/i /la.
    while gt /i u64:0 do
        become /i diff /i u64:1.
        be u32/wa at /a /i.
        be u32/wb at /b /i.
        if lt /wa /wb
            return i32:-1
            nop.
        if gt /wa /wb
            return i32:1
            nop.
    ::.
    i32:0.

: Signed comparison (`-1`, `0`, `1`) on canonical `bigInt`.
: @dc l8589982110
pub v/i32/cmp bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:2 :: :: structNew bigInt: false l/u32: u32:1 :: ::
        out i32:-1.
        in structNew bigInt: true l/u32: u32:2 :: :: structNew bigInt: true l/u32: u32:5 :: ::
        out i32:1.
    be b/na field /a u32:0.
    be b/nb field /b u32:0.
    if ne /na /nb
        if /na i32:-1 i32:1
        do
            be i32/mc cmpMag field /a u32:1 field /b u32:1.
            if /na neg /mc /mc.
        ::.

: Equality `a == b`.
: @dc l8589982111
pub v/b/eq bigInt/a bigInt/b
    eq /a /b.

: Inequality `a != b`.
: @dc l8589982112
pub v/b/ne bigInt/a bigInt/b
    ne /a /b.

: Signed `<` on `bigInt`.
: @dc l8589982113
pub v/b/lt bigInt/a bigInt/b
    lt cmp /a /b i32:0.

: Signed `<=` on `bigInt`.
: @dc l8589982114
pub v/b/le bigInt/a bigInt/b
    le cmp /a /b i32:0.

: Signed `>` on `bigInt`.
: @dc l8589982115
pub v/b/gt bigInt/a bigInt/b
    gt cmp /a /b i32:0.

: Signed `>=` on `bigInt`.
: @dc l8589982116
pub v/b/ge bigInt/a bigInt/b
    ge cmp /a /b i32:0.

: Infallible negation on `bigInt`.
: @dc l8589982117
pub v/bigInt/neg bigInt/a
    test
        in structNew bigInt: false l/u32: :: ::
        out structNew bigInt: false l/u32: :: ::.
        in structNew bigInt: false l/u32: u32:9 :: ::
        out structNew bigInt: true l/u32: u32:9 :: ::.
    if isZero /a
        /intZero
        structNew bigInt: not field /a u32:0 field /a u32:1 ::.

: Infallible absolute value `|a|` on `bigInt`.
: @dc l8589982118
pub v/bigInt/abs bigInt/a
    structNew bigInt: false field /a u32:1 ::.

: Unsigned magnitude addition.
: @dc l8589982119
v/l/u32/addMag l/u32/a l/u32/b
    be u64/la len /a.
    be u64/lb len /b.
    be u64/maxLen if gt /la /lb /la /lb.
    be buf/u32/out bufNew u32 sum /maxLen u64:1.
    hold u64/carry u64:0.
    hold u64/i u64:0.
    while lt /i /maxLen do
        be u64/wa if lt /i /la conv at /a /i u64 u64:0.
        be u64/wb if lt /i /lb conv at /b /i u64 u64:0.
        be u64/sumVal sum sum /wa /wb /carry.
        bufGain /out conv bitAnd /sumVal u64:4294967295 u32.
        become /carry shr /sumVal u32:32.
        become /i sum /i u64:1.
    ::.
    if ne /carry u64:0
        bufGain /out conv /carry u32
        nop.
    bufFrozen /out.

: Unsigned magnitude subtraction (`a >= b`).
: @dc l8589982120
v/l/u32/subMag l/u32/a l/u32/b
    be u64/la len /a.
    be u64/lb len /b.
    be buf/u32/out bufNew u32 /la.
    hold u64/borrow u64:0.
    hold u64/i u64:0.
    while lt /i /la do
        be u64/wa conv at /a /i u64.
        be u64/wb sum if lt /i /lb conv at /b /i u64 u64:0 /borrow.
        if ge /wa /wb
            do
                bufGain /out conv diff /wa /wb u32.
                become /borrow u64:0.
            ::
            do
                bufGain /out conv diff sum /wa u64:4294967296 /wb u32.
                become /borrow u64:1.
            ::.
        become /i sum /i u64:1.
    ::.
    normLimbs bufFrozen /out.

: Unsigned magnitude multiplication.
: @dc l8589982121
v/l/u32/mulMag l/u32/a l/u32/b
    be u64/la len /a.
    be u64/lb len /b.
    if or eq /la u64:0 eq /lb u64:0
        return l/u32: ::
        nop.
    be buf/u32/out bufFilled u32:0 sum /la /lb.
    hold u64/i u64:0.
    while lt /i /la do
        be u64/ai conv at /a /i u64.
        hold u64/carry u64:0.
        hold u64/j u64:0.
        while lt /j /lb do
            be u64/idx sum /i /j.
            be u64/cur conv at /out /idx u64.
            be u64/prodVal sum /cur sum prod /ai conv at /b /j u64 /carry.
            bufBecomeAt /out /idx conv bitAnd /prodVal u64:4294967295 u32.
            become /carry shr /prodVal u32:32.
            become /j sum /j u64:1.
        ::.
        be u64/topIdx sum /i /lb.
        bufBecomeAt /out /topIdx conv sum conv at /out /topIdx u64 /carry u32.
        become /i sum /i u64:1.
    ::.
    normLimbs bufFrozen /out.

: Infallible addition `a + b` on `bigInt`.
: @dc l8589982122
pub v/bigInt/sum bigInt/a bigInt/b
    test
        in structNew bigInt: false l/u32: u32:4294967295 :: :: structNew bigInt: false l/u32: u32:2 :: ::
        out structNew bigInt: false l/u32: u32:1 u32:1 :: ::.
        in structNew bigInt: true l/u32: u32:10 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out structNew bigInt: true l/u32: u32:7 :: ::.
    be b/na field /a u32:0.
    be b/nb field /b u32:0.
    be l/u32/la field /a u32:1.
    be l/u32/lb field /b u32:1.
    if eq /na /nb
        makeBigInt /na addMag /la /lb
        do
            be i32/mc cmpMag /la /lb.
            if eq /mc i32:0
                /intZero
                if gt /mc i32:0
                    makeBigInt /na subMag /la /lb
                    makeBigInt /nb subMag /lb /la.
        ::.

: Infallible subtraction `a - b` on `bigInt`.
: @dc l8589982123
pub v/bigInt/diff bigInt/a bigInt/b
    sum /a neg /b.

: Infallible multiplication `a * b` on `bigInt`.
: @dc l8589982124
pub v/bigInt/prod bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:6 :: :: structNew bigInt: false l/u32: u32:7 :: ::
        out structNew bigInt: true l/u32: u32:42 :: ::.
    makeBigInt ne field /a u32:0 field /b u32:0 mulMag field /a u32:1 field /b u32:1.

: In-place comparison of `remBuf` (`len == len b + 1`) against `b`.
: @dc l8589982125
v/b/remGeDivisor buf/u32/remBuf l/u32/b
    be u64/lb len /b.
    if ne at /remBuf /lb u32:0
        return true
        nop.
    hold u64/i /lb.
    while gt /i u64:0 do
        become /i diff /i u64:1.
        be u32/rw at /remBuf /i.
        be u32/bw at /b /i.
        if gt /rw /bw
            return true
            nop.
        if lt /rw /bw
            return false
            nop.
    ::.
    true.

: Unsigned magnitude division and remainder `(quotLimbs, remLimbs)` for `len b > 0`.
: @dc l8589982126
v/tup: l/u32 l/u32 ::/divModMag l/u32/a l/u32/b
    be i32/mc cmpMag /a /b.
    if lt /mc i32:0
        return tupNew: l/u32: :: /a ::
        nop.
    if eq /mc i32:0
        return tupNew: l/u32: u32:1 :: l/u32: :: ::
        nop.
    be u64/la len /a.
    be u64/lb len /b.
    if eq /lb u64:1
        do
            be u64/divWord conv at /b u64:0 u64.
            be buf/u32/qBuf bufFilled u32:0 /la.
            hold u64/remWord u64:0.
            hold u64/idx /la.
            while gt /idx u64:0 do
                become /idx diff /idx u64:1.
                be u64/cur bitOr shl /remWord u32:32 conv at /a /idx u64.
                bufBecomeAt /qBuf /idx conv quot /cur /divWord u32.
                become /remWord rem /cur /divWord.
            ::.
            be l/u32/rOut if eq /remWord u64:0 l/u32: :: l/u32: conv /remWord u32 ::.
            return tupNew: normLimbs bufFrozen /qBuf /rOut ::.
        ::
        nop.
    be buf/u32/qBuf bufFilled u32:0 /la.
    be buf/u32/remBuf bufFilled u32:0 sum /lb u64:1.
    be u32/topLimb at /a diff /la u64:1.
    be u64/topBits conv diff u32:32 clz /topLimb u64.
    hold u64/bitPos sum prod diff /la u64:1 u64:32 /topBits.
    while gt /bitPos u64:0 do
        become /bitPos diff /bitPos u64:1.
        be u64/wordIdx shr /bitPos u32:5.
        be u32/bitOff conv bitAnd /bitPos u64:31 u32.
        be u32/inBit bitAnd shr at /a /wordIdx /bitOff u32:1.
        hold u32/carry /inBit.
        hold u64/k u64:0.
        while le /k /lb do
            be u32/cur at /remBuf /k.
            be u32/nextCarry shr /cur u32:31.
            bufBecomeAt /remBuf /k bitOr shl bitAnd /cur u32:2147483647 u32:1 /carry.
            become /carry /nextCarry.
            become /k sum /k u64:1.
        ::.
        if remGeDivisor /remBuf /b
            do
                hold u64/borrow u64:0.
                hold u64/m u64:0.
                while lt /m /lb do
                    be u64/rw conv at /remBuf /m u64.
                    be u64/bw sum conv at /b /m u64 /borrow.
                    if ge /rw /bw
                        do
                            bufBecomeAt /remBuf /m conv diff /rw /bw u32.
                            become /borrow u64:0.
                        ::
                        do
                            bufBecomeAt /remBuf /m conv diff sum /rw u64:4294967296 /bw u32.
                            become /borrow u64:1.
                        ::.
                    become /m sum /m u64:1.
                ::.
                bufBecomeAt /remBuf /lb conv diff conv at /remBuf /lb u64 /borrow u32.
                bufBecomeAt /qBuf /wordIdx bitOr at /qBuf /wordIdx shl u32:1 /bitOff.
            ::
            nop.
    ::.
    tupNew: normLimbs bufFrozen /qBuf normLimbs bufFrozen /remBuf ::.

: Total truncating `div` on `bigInt` (`tup: b bigInt u8 ::`).
: @dc l8589982127
pub v/tup: b bigInt u8 ::/tryDiv bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:7 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out tupNew: true structNew bigInt: true l/u32: u32:2 :: :: u8:0 ::.
        in structNew bigInt: false l/u32: u32:5 :: :: structNew bigInt: false l/u32: :: ::
        out tupNew: false structNew bigInt: false l/u32: :: :: u8:1 ::.
    if isZero /b
        return tupNew: false /intZero /errDivisionByZero ::
        nop.
    be tup: l/u32 l/u32 ::/dm divModMag field /a u32:1 field /b u32:1.
    tupNew: true makeBigInt ne field /a u32:0 field /b u32:0 field /dm u32:0 u8:0 ::.

: Total `truncRem` on `bigInt` (`tup: b bigInt u8 ::`).
: @dc l8589982128
pub v/tup: b bigInt u8 ::/tryTruncRem bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:7 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out tupNew: true structNew bigInt: true l/u32: u32:1 :: :: u8:0 ::.
    if isZero /b
        return tupNew: false /intZero /errDivisionByZero ::
        nop.
    be tup: l/u32 l/u32 ::/dm divModMag field /a u32:1 field /b u32:1.
    tupNew: true makeBigInt field /a u32:0 field /dm u32:1 u8:0 ::.

: Total Euclidean `mod` (`0 <= r < |b|`) on `bigInt` (`tup: b bigInt u8 ::`).
: @dc l8589982129
pub v/tup: b bigInt u8 ::/tryMod bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:7 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out tupNew: true structNew bigInt: false l/u32: u32:2 :: :: u8:0 ::.
        in structNew bigInt: true l/u32: u32:7 :: :: structNew bigInt: true l/u32: u32:3 :: ::
        out tupNew: true structNew bigInt: false l/u32: u32:2 :: :: u8:0 ::.
    be tup: b bigInt u8 ::/trRes tryTruncRem /a /b.
    if not field /trRes u32:0
        return /trRes
        nop.
    be bigInt/tr field /trRes u32:1.
    if field /tr u32:0
        tupNew: true sum /tr abs /b u8:0 ::
        tupNew: true /tr u8:0 ::.

: Unsigned Euclidean greatest common divisor `gcd(|a|, |b|) >= 0` (`gcd(0, 0) == 0`).
: @dc l8589982130
pub v/bigInt/gcd bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:6 :: :: structNew bigInt: true l/u32: u32:4 :: ::
        out structNew bigInt: false l/u32: u32:2 :: ::.
        in structNew bigInt: false l/u32: :: :: structNew bigInt: true l/u32: u32:9 :: ::
        out structNew bigInt: false l/u32: u32:9 :: ::.
    hold l/u32/x field /a u32:1.
    hold l/u32/y field /b u32:1.
    while gt len /y u64:0 do
        be tup: l/u32 l/u32 ::/dm divModMag /x /y.
        become /x /y.
        become /y field /dm u32:1.
    ::.
    makeBigInt false /x.

: Multi-limb bigInt multiplication, division, and Base64 decoding self-test.
: @dc l8589982131
v/b/checkMultiLimbBigInt
    test
        in.
        out true.
    be bigInt/p1 prod from u64:18446744073709551615 from u64:18446744073709551615.
    be bigInt/p2 prod /p1 from i64:-1000000007.
    be tup: b bigInt u8 ::/q tryDiv /p2 /p1.
    be tup: b bigInt u8 ::/r tryMod /p2 from u64:97.
    and field /q u32:0
        and eq field /q u32:1 from i64:-1000000007
            and field /r u32:0
                ge cmp field /r u32:1 /intZero i32:0.

