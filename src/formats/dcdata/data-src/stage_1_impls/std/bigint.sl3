pub v/b/canDiv bigInt/a bigInt/b
    test
        in structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: :: ::
        out false.
        in structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:2 :: ::
        out true.
    not isZero /b.

: Checked StageL `div` on `bigInt`, faulting on division by zero.
: @dc l8589984703
pub v/bigInt/quot bigInt/a bigInt/b
    test
        in structNew bigInt: true l/u32: u32:7 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out structNew bigInt: true l/u32: u32:2 :: ::.
        in structNew bigInt: false l/u32: u32:5 :: :: structNew bigInt: false l/u32: :: ::
