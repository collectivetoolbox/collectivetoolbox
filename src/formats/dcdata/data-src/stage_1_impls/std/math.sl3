: SPDX-License-Identifier: AGPL-3.0-or-later
: Stage 1 integer bounds, Euclidean modulus, and non-trapping overflow/division predicates.
ns std/math.

: Minimum unsigned 8-bit integer (0).
: @dc l8589978541
pub u8/MIN u8:0.

: Maximum unsigned 8-bit integer (255).
: @dc l8589978265
pub u8/MAX u8:255.

: Unsigned 8-bit Euclidean modulus (`0 <= (mod lhs rhs) < rhs`); faults when `rhs == 0`.
: @dc l8589978542
pub v/u8/mod u8/lhs u8/rhs
    test
        in u8:7 u8:3
        out u8:1.
        in u8:255 u8:10
        out u8:5.
        in u8:0 u8:5
        out u8:0.
        in u8:1 u8:0
        out fault.
    rem u8/lhs u8/rhs.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978266
pub v/b/canAdd u8/lhs u8/rhs
    test
        in u8:200 u8:55
        out true.
        in u8:200 u8:56
        out false.
        in u8:255 u8:0
        out true.
        in u8:255 u8:1
        out false.
    ge wrapAdd u8/lhs u8/rhs u8/lhs.

: Returns true iff checked `sub lhs rhs` will not underflow unsigned 8-bit bounds.
: @dc l8589978267
pub v/b/canSub u8/lhs u8/rhs
    test
        in u8:10 u8:10
        out true.
        in u8:10 u8:11
        out false.
        in u8:0 u8:1
        out false.
    ge u8/lhs u8/rhs.

: Returns true iff checked `mul lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978268
pub v/b/canMul u8/lhs u8/rhs
    test
        in u8:15 u8:17
        out true.
        in u8:16 u8:16
        out false.
        in u8:255 u8:0
        out true.
        in u8:0 u8:255
        out true.
        in u8:255 u8:1
        out true.
    if eq u8/rhs u8:0
        true
        eq div wrapMul u8/lhs u8/rhs u8/rhs u8/lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0`).
: @dc l8589978269
pub v/b/canDiv u8/lhs u8/rhs
    test
        in u8:10 u8:2
        out true.
        in u8:10 u8:0
        out false.
        in u8:0 u8:0
        out false.
    ne u8/rhs u8:0.

: Minimum signed 32-bit integer (-2^31).
: @dc l8589978241
pub i32/MIN i32:-2147483648.

: Maximum signed 32-bit integer (2^31 - 1).
: @dc l8589978242
pub i32/MAX i32:2147483647.

: Euclidean modulus satisfying `0 <= (mod lhs rhs) < |rhs|` for all `rhs != 0`
: (including `mod MIN -1 == 0` and `mod -1 MIN == MAX`); faults when `rhs == 0`.
: @dc l8589978243
pub v/i32/mod i32/lhs i32/rhs
    test
        in i32:7 i32:3
        out i32:1.
        in i32:-7 i32:3
        out i32:2.
        in i32:7 i32:-3
        out i32:1.
        in i32:-7 i32:-3
        out i32:2.
        in i32:0 i32:5
        out i32:0.
        in i32:-2147483648 i32:-1
        out i32:0.
        in i32:-2147483648 i32:1
        out i32:0.
        in i32:-2147483648 i32:-2147483648
        out i32:0.
        in i32:5 i32:-2147483648
        out i32:5.
        in i32:-1 i32:-2147483648
        out i32:2147483647.
        in i32:1 i32:0
        out fault.
        in i32:-2147483648 i32:0
        out fault.
    if eq i32/rhs i32:0
        fault
        if and eq i32/lhs i32/MIN eq i32/rhs i32:-1
            i32:0
            do
                const i32/remVal rem i32/lhs i32/rhs.
                if ge i32/remVal i32:0
                    i32/remVal
                    if gt i32/rhs i32:0
                        add i32/remVal i32/rhs
                        sub i32/remVal i32/rhs.
            ::.

: Returns true iff checked `add lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978244
pub v/b/canAdd i32/lhs i32/rhs
    test
        in i32:10 i32:20
        out true.
        in i32:2147483647 i32:0
        out true.
        in i32:2147483647 i32:1
        out false.
        in i32:-2147483648 i32:0
        out true.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-2147483648 i32:2147483647
        out true.
    const i32/sumVal wrapAdd i32/lhs i32/rhs.
    ge bitAnd bitXor i32/sumVal i32/lhs bitXor i32/sumVal i32/rhs i32:0.

: Returns true iff checked `sub lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978245
pub v/b/canSub i32/lhs i32/rhs
    test
        in i32:10 i32:20
        out true.
        in i32:-2147483648 i32:1
        out false.
        in i32:0 i32:-2147483648
        out false.
        in i32:-1 i32:-2147483648
        out true.
        in i32:2147483647 i32:-1
        out false.
        in i32:2147483647 i32:2147483647
        out true.
    const i32/diffVal wrapSub i32/lhs i32/rhs.
    ge bitAnd bitXor i32/lhs i32/rhs bitXor i32/diffVal i32/lhs i32:0.

: Returns true iff checked `mul lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978246
pub v/b/canMul i32/lhs i32/rhs
    test
        in i32:46340 i32:46340
        out true.
        in i32:46341 i32:46341
        out false.
        in i32:-2147483648 i32:0
        out true.
        in i32:-2147483648 i32:1
        out true.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-1 i32:-2147483648
        out false.
        in i32:1073741824 i32:-2
        out true.
        in i32:1073741824 i32:2
        out false.
    const i64/prod mul conv i32/lhs i64 conv i32/rhs i64.
    and ge i64/prod conv i32/MIN i64 le i64/prod conv i32/MAX i64.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0` and `!(lhs == MIN && rhs == -1)`).
: @dc l8589978247
pub v/b/canDiv i32/lhs i32/rhs
    test
        in i32:10 i32:2
        out true.
        in i32:10 i32:0
        out false.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-2147483648 i32:1
        out true.
        in i32:-2147483647 i32:-1
        out true.
    and ne i32/rhs i32:0 not and eq i32/lhs i32/MIN eq i32/rhs i32:-1.

: Minimum unsigned 32-bit integer (0).
: @dc l8589978543
pub u32/MIN u32:0.

: Maximum unsigned 32-bit integer (2^32 - 1).
: @dc l8589978255
pub u32/MAX u32:4294967295.

: Unsigned 32-bit Euclidean modulus (`0 <= (mod lhs rhs) < rhs`); faults when `rhs == 0`.
: @dc l8589978544
pub v/u32/mod u32/lhs u32/rhs
    test
        in u32:7 u32:3
        out u32:1.
        in u32:4294967295 u32:10
        out u32:5.
        in u32:0 u32:5
        out u32:0.
        in u32:1 u32:0
        out fault.
    rem u32/lhs u32/rhs.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 32-bit bounds.
: @dc l8589978256
pub v/b/canAdd u32/lhs u32/rhs
    test
        in u32:4294967295 u32:0
        out true.
        in u32:4294967295 u32:1
        out false.
        in u32:2147483648 u32:2147483647
        out true.
        in u32:2147483648 u32:2147483648
        out false.
    ge wrapAdd u32/lhs u32/rhs u32/lhs.

: Returns true iff checked `sub lhs rhs` will not underflow unsigned 32-bit bounds.
: @dc l8589978257
pub v/b/canSub u32/lhs u32/rhs
    test
        in u32:5 u32:5
        out true.
        in u32:5 u32:6
        out false.
        in u32:0 u32:1
        out false.
    ge u32/lhs u32/rhs.

: Returns true iff checked `mul lhs rhs` will not overflow unsigned 32-bit bounds.
: @dc l8589978258
pub v/b/canMul u32/lhs u32/rhs
    test
        in u32:65535 u32:65537
        out true.
        in u32:65536 u32:65536
        out false.
        in u32:4294967295 u32:0
        out true.
        in u32:4294967295 u32:1
        out true.
    if eq u32/rhs u32:0
        true
        eq div wrapMul u32/lhs u32/rhs u32/rhs u32/lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0`).
: @dc l8589978259
pub v/b/canDiv u32/lhs u32/rhs
    test
        in u32:10 u32:2
        out true.
        in u32:10 u32:0
        out false.
        in u32:0 u32:0
        out false.
    ne u32/rhs u32:0.

: Minimum signed 64-bit integer (-2^63).
: @dc l8589978248
pub i64/MIN i64:-9223372036854775808.

: Maximum signed 64-bit integer (2^63 - 1).
: @dc l8589978249
pub i64/MAX i64:9223372036854775807.

: Euclidean modulus satisfying `0 <= (mod lhs rhs) < |rhs|` for all `rhs != 0`
: (including `mod MIN -1 == 0` and `mod -1 MIN == MAX`); faults when `rhs == 0`.
: @dc l8589978250
pub v/i64/mod i64/lhs i64/rhs
    test
        in i64:7 i64:3
        out i64:1.
        in i64:-7 i64:3
        out i64:2.
        in i64:7 i64:-3
        out i64:1.
        in i64:-7 i64:-3
        out i64:2.
        in i64:0 i64:5
        out i64:0.
        in i64:-9223372036854775808 i64:-1
        out i64:0.
        in i64:-9223372036854775808 i64:1
        out i64:0.
        in i64:-9223372036854775808 i64:-9223372036854775808
        out i64:0.
        in i64:5 i64:-9223372036854775808
        out i64:5.
        in i64:-1 i64:-9223372036854775808
        out i64:9223372036854775807.
        in i64:1 i64:0
        out fault.
        in i64:-9223372036854775808 i64:0
        out fault.
    if eq i64/rhs i64:0
        fault
        if and eq i64/lhs i64/MIN eq i64/rhs i64:-1
            i64:0
            do
                const i64/remVal rem i64/lhs i64/rhs.
                if ge i64/remVal i64:0
                    i64/remVal
                    if gt i64/rhs i64:0
                        add i64/remVal i64/rhs
                        sub i64/remVal i64/rhs.
            ::.

: Returns true iff checked `add lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978251
pub v/b/canAdd i64/lhs i64/rhs
    test
        in i64:10 i64:20
        out true.
        in i64:9223372036854775807 i64:0
        out true.
        in i64:9223372036854775807 i64:1
        out false.
        in i64:-9223372036854775808 i64:0
        out true.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-9223372036854775808 i64:9223372036854775807
        out true.
    const i64/sumVal wrapAdd i64/lhs i64/rhs.
    ge bitAnd bitXor i64/sumVal i64/lhs bitXor i64/sumVal i64/rhs i64:0.

: Returns true iff checked `sub lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978252
pub v/b/canSub i64/lhs i64/rhs
    test
        in i64:10 i64:20
        out true.
        in i64:-9223372036854775808 i64:1
        out false.
        in i64:0 i64:-9223372036854775808
        out false.
        in i64:-1 i64:-9223372036854775808
        out true.
        in i64:9223372036854775807 i64:-1
        out false.
        in i64:9223372036854775807 i64:9223372036854775807
        out true.
    const i64/diffVal wrapSub i64/lhs i64/rhs.
    ge bitAnd bitXor i64/lhs i64/rhs bitXor i64/diffVal i64/lhs i64:0.

: Returns true iff checked `mul lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978253
pub v/b/canMul i64/lhs i64/rhs
    test
        in i64:3037000499 i64:3037000499
        out true.
        in i64:3037000500 i64:3037000500
        out false.
        in i64:-9223372036854775808 i64:0
        out true.
        in i64:0 i64:-9223372036854775808
        out true.
        in i64:-9223372036854775808 i64:1
        out true.
        in i64:1 i64:-9223372036854775808
        out true.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-1 i64:-9223372036854775808
        out false.
        in i64:4611686018427387904 i64:-2
        out true.
        in i64:4611686018427387904 i64:2
        out false.
    if eq i64/rhs i64:0
        true
        if eq i64/rhs i64:-1
            ne i64/lhs i64/MIN
            eq div wrapMul i64/lhs i64/rhs i64/rhs i64/lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0` and `!(lhs == MIN && rhs == -1)`).
: @dc l8589978254
pub v/b/canDiv i64/lhs i64/rhs
    test
        in i64:10 i64:2
        out true.
        in i64:10 i64:0
        out false.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-9223372036854775808 i64:1
        out true.
        in i64:-9223372036854775807 i64:-1
        out true.
    and ne i64/rhs i64:0 not and eq i64/lhs i64/MIN eq i64/rhs i64:-1.

: Minimum unsigned 64-bit integer (0).
: @dc l8589978545
pub u64/MIN u64:0.

