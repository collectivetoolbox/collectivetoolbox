: SPDX-License-Identifier: AGPL-3.0-or-later
: Stage 1 integer bounds, StageL-internal Euclidean modulus, and non-trapping overflow/division predicates.
ns std/math.

: Minimum unsigned 8-bit integer (0).
: @dc l8589978541
pub u8/u8Min u8:0.

: Maximum unsigned 8-bit integer (255).
: @dc l8589978265
pub u8/u8Max u8:255.

: Unsigned 8-bit StageL-internal Euclidean modulus (`0 <= (modStageLInternal lhs rhs) < rhs`); faults when `rhs == 0`.
: @dc l8589978542
pub v/u8/modStageLInternal u8/lhs u8/rhs
    test
        in u8:7 u8:3
        out u8:1.
        in u8:255 u8:10
        out u8:5.
        in u8:0 u8:5
        out u8:0.
        in u8:1 u8:0
        out fault.
    rem /lhs /rhs.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978266
pub v/b/canAdd u8/lhs u8/rhs
    test
        in u8:200 u8:55
        out true.
        in u8:200 u8:56
        out false.
        in u8:255 u8:0
        out true.
        in u8:255 u8:1
        out false.
    ge wrapAdd /lhs /rhs /lhs.

: Returns true iff checked `sub lhs rhs` will not underflow unsigned 8-bit bounds.
: @dc l8589978267
pub v/b/canSub u8/lhs u8/rhs
    test
        in u8:10 u8:10
        out true.
        in u8:10 u8:11
        out false.
        in u8:0 u8:1
        out false.
    ge /lhs /rhs.

: Returns true iff checked `mul lhs rhs` will not overflow unsigned 8-bit bounds.
: @dc l8589978268
pub v/b/canMul u8/lhs u8/rhs
    test
        in u8:15 u8:17
        out true.
        in u8:16 u8:16
        out false.
        in u8:255 u8:0
        out true.
        in u8:0 u8:255
        out true.
        in u8:255 u8:1
        out true.
    if eq /rhs u8:0
        true
        eq div wrapMul /lhs /rhs /rhs /lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0`).
: @dc l8589978269
pub v/b/canDiv u8/lhs u8/rhs
    test
        in u8:10 u8:2
        out true.
        in u8:10 u8:0
        out false.
        in u8:0 u8:0
        out false.
    ne /rhs u8:0.

: Minimum signed 32-bit integer (-2^31).
: @dc l8589978241
pub i32/i32Min i32:-2147483648.

: Maximum signed 32-bit integer (2^31 - 1).
: @dc l8589978242
pub i32/i32Max i32:2147483647.

: StageL-internal Euclidean modulus satisfying `0 <= (modStageLInternal lhs rhs) < |rhs|` for all `rhs != 0`
: (including `modStageLInternal i32Min -1 == 0` and `modStageLInternal -1 i32Min == i32Max`); faults when `rhs == 0`.
: @dc l8589978243
pub v/i32/modStageLInternal i32/lhs i32/rhs
    test
        in i32:7 i32:3
        out i32:1.
        in i32:-7 i32:3
        out i32:2.
        in i32:7 i32:-3
        out i32:1.
        in i32:-7 i32:-3
        out i32:2.
        in i32:0 i32:5
        out i32:0.
        in i32:-2147483648 i32:-1
        out i32:0.
        in i32:-2147483648 i32:1
        out i32:0.
        in i32:-2147483648 i32:-2147483648
        out i32:0.
        in i32:5 i32:-2147483648
        out i32:5.
        in i32:-1 i32:-2147483648
        out i32:2147483647.
        in i32:1 i32:0
        out fault.
        in i32:-2147483648 i32:0
        out fault.
    if eq /rhs i32:0
        fault
        if and eq /lhs /i32Min eq /rhs i32:-1
            i32:0
            do
                const i32/remVal rem /lhs /rhs.
                if ge /remVal i32:0
                    /remVal
                    if gt /rhs i32:0
                        add /remVal /rhs
                        sub /remVal /rhs.
            ::.

: Returns true iff checked `add lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978244
pub v/b/canAdd i32/lhs i32/rhs
    test
        in i32:10 i32:20
        out true.
        in i32:2147483647 i32:0
        out true.
        in i32:2147483647 i32:1
        out false.
        in i32:-2147483648 i32:0
        out true.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-2147483648 i32:2147483647
        out true.
    const i32/sumVal wrapAdd /lhs /rhs.
    ge bitAnd bitXor /sumVal /lhs bitXor /sumVal /rhs i32:0.

: Returns true iff checked `sub lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978245
pub v/b/canSub i32/lhs i32/rhs
    test
        in i32:10 i32:20
        out true.
        in i32:-2147483648 i32:1
        out false.
        in i32:0 i32:-2147483648
        out false.
        in i32:-1 i32:-2147483648
        out true.
        in i32:2147483647 i32:-1
        out false.
        in i32:2147483647 i32:2147483647
        out true.
    const i32/diffVal wrapSub /lhs /rhs.
    ge bitAnd bitXor /lhs /rhs bitXor /diffVal /lhs i32:0.

: Returns true iff checked `mul lhs rhs` will not overflow signed 32-bit bounds.
: @dc l8589978246
pub v/b/canMul i32/lhs i32/rhs
    test
        in i32:46340 i32:46340
        out true.
        in i32:46341 i32:46341
        out false.
        in i32:-2147483648 i32:0
        out true.
        in i32:-2147483648 i32:1
        out true.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-1 i32:-2147483648
        out false.
        in i32:1073741824 i32:-2
        out true.
        in i32:1073741824 i32:2
        out false.
    const i64/prod mul conv /lhs i64 conv /rhs i64.
    and ge /prod conv /i32Min i64 le /prod conv /i32Max i64.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0` and `!(lhs == i32Min && rhs == -1)`).
: @dc l8589978247
pub v/b/canDiv i32/lhs i32/rhs
    test
        in i32:10 i32:2
        out true.
        in i32:10 i32:0
        out false.
        in i32:-2147483648 i32:-1
        out false.
        in i32:-2147483648 i32:1
        out true.
        in i32:-2147483647 i32:-1
        out true.
    and ne /rhs i32:0 not and eq /lhs /i32Min eq /rhs i32:-1.

: Minimum unsigned 32-bit integer (0).
: @dc l8589978543
pub u32/u32Min u32:0.

: Maximum unsigned 32-bit integer (2^32 - 1).
: @dc l8589978255
pub u32/u32Max u32:4294967295.

: Unsigned 32-bit StageL-internal Euclidean modulus (`0 <= (modStageLInternal lhs rhs) < rhs`); faults when `rhs == 0`.
: @dc l8589978544
pub v/u32/modStageLInternal u32/lhs u32/rhs
    test
        in u32:7 u32:3
        out u32:1.
        in u32:4294967295 u32:10
        out u32:5.
        in u32:0 u32:5
        out u32:0.
        in u32:1 u32:0
        out fault.
    rem /lhs /rhs.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 32-bit bounds.
: @dc l8589978256
pub v/b/canAdd u32/lhs u32/rhs
    test
        in u32:4294967295 u32:0
        out true.
        in u32:4294967295 u32:1
        out false.
        in u32:2147483648 u32:2147483647
        out true.
        in u32:2147483648 u32:2147483648
        out false.
    ge wrapAdd /lhs /rhs /lhs.

: Returns true iff checked `sub lhs rhs` will not underflow unsigned 32-bit bounds.
: @dc l8589978257
pub v/b/canSub u32/lhs u32/rhs
    test
        in u32:5 u32:5
        out true.
        in u32:5 u32:6
        out false.
        in u32:0 u32:1
        out false.
    ge /lhs /rhs.

: Returns true iff checked `mul lhs rhs` will not overflow unsigned 32-bit bounds.
: @dc l8589978258
pub v/b/canMul u32/lhs u32/rhs
    test
        in u32:65535 u32:65537
        out true.
        in u32:65536 u32:65536
        out false.
        in u32:4294967295 u32:0
        out true.
        in u32:4294967295 u32:1
        out true.
    if eq /rhs u32:0
        true
        eq div wrapMul /lhs /rhs /rhs /lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0`).
: @dc l8589978259
pub v/b/canDiv u32/lhs u32/rhs
    test
        in u32:10 u32:2
        out true.
        in u32:10 u32:0
        out false.
        in u32:0 u32:0
        out false.
    ne /rhs u32:0.

: Minimum signed 64-bit integer (-2^63).
: @dc l8589978248
pub i64/i64Min i64:-9223372036854775808.

: Maximum signed 64-bit integer (2^63 - 1).
: @dc l8589978249
pub i64/i64Max i64:9223372036854775807.

: StageL-internal Euclidean modulus satisfying `0 <= (modStageLInternal lhs rhs) < |rhs|` for all `rhs != 0`
: (including `modStageLInternal i64Min -1 == 0` and `modStageLInternal -1 i64Min == i64Max`); faults when `rhs == 0`.
: @dc l8589978250
pub v/i64/modStageLInternal i64/lhs i64/rhs
    test
        in i64:7 i64:3
        out i64:1.
        in i64:-7 i64:3
        out i64:2.
        in i64:7 i64:-3
        out i64:1.
        in i64:-7 i64:-3
        out i64:2.
        in i64:0 i64:5
        out i64:0.
        in i64:-9223372036854775808 i64:-1
        out i64:0.
        in i64:-9223372036854775808 i64:1
        out i64:0.
        in i64:-9223372036854775808 i64:-9223372036854775808
        out i64:0.
        in i64:5 i64:-9223372036854775808
        out i64:5.
        in i64:-1 i64:-9223372036854775808
        out i64:9223372036854775807.
        in i64:1 i64:0
        out fault.
        in i64:-9223372036854775808 i64:0
        out fault.
    if eq /rhs i64:0
        fault
        if and eq /lhs /i64Min eq /rhs i64:-1
            i64:0
            do
                const i64/remVal rem /lhs /rhs.
                if ge /remVal i64:0
                    /remVal
                    if gt /rhs i64:0
                        add /remVal /rhs
                        sub /remVal /rhs.
            ::.

: Returns true iff checked `add lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978251
pub v/b/canAdd i64/lhs i64/rhs
    test
        in i64:10 i64:20
        out true.
        in i64:9223372036854775807 i64:0
        out true.
        in i64:9223372036854775807 i64:1
        out false.
        in i64:-9223372036854775808 i64:0
        out true.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-9223372036854775808 i64:9223372036854775807
        out true.
    const i64/sumVal wrapAdd /lhs /rhs.
    ge bitAnd bitXor /sumVal /lhs bitXor /sumVal /rhs i64:0.

: Returns true iff checked `sub lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978252
pub v/b/canSub i64/lhs i64/rhs
    test
        in i64:10 i64:20
        out true.
        in i64:-9223372036854775808 i64:1
        out false.
        in i64:0 i64:-9223372036854775808
        out false.
        in i64:-1 i64:-9223372036854775808
        out true.
        in i64:9223372036854775807 i64:-1
        out false.
        in i64:9223372036854775807 i64:9223372036854775807
        out true.
    const i64/diffVal wrapSub /lhs /rhs.
    ge bitAnd bitXor /lhs /rhs bitXor /diffVal /lhs i64:0.

: Returns true iff checked `mul lhs rhs` will not overflow signed 64-bit bounds.
: @dc l8589978253
pub v/b/canMul i64/lhs i64/rhs
    test
        in i64:3037000499 i64:3037000499
        out true.
        in i64:3037000500 i64:3037000500
        out false.
        in i64:-9223372036854775808 i64:0
        out true.
        in i64:0 i64:-9223372036854775808
        out true.
        in i64:-9223372036854775808 i64:1
        out true.
        in i64:1 i64:-9223372036854775808
        out true.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-1 i64:-9223372036854775808
        out false.
        in i64:4611686018427387904 i64:-2
        out true.
        in i64:4611686018427387904 i64:2
        out false.
    if eq /rhs i64:0
        true
        if eq /rhs i64:-1
            ne /lhs /i64Min
            eq div wrapMul /lhs /rhs /rhs /lhs.

: Returns true iff checked `div lhs rhs` and `rem lhs rhs` will not fault (`rhs != 0` and `!(lhs == i64Min && rhs == -1)`).
: @dc l8589978254
pub v/b/canDiv i64/lhs i64/rhs
    test
        in i64:10 i64:2
        out true.
        in i64:10 i64:0
        out false.
        in i64:-9223372036854775808 i64:-1
        out false.
        in i64:-9223372036854775808 i64:1
        out true.
        in i64:-9223372036854775807 i64:-1
        out true.
    and ne /rhs i64:0 not and eq /lhs /i64Min eq /rhs i64:-1.

: Minimum unsigned 64-bit integer (0).
: @dc l8589978545
pub u64/u64Min u64:0.

: Maximum unsigned 64-bit integer (2^64 - 1).
: @dc l8589978260
pub u64/u64Max u64:18446744073709551615.

: Unsigned 64-bit StageL-internal Euclidean modulus (`0 <= (modStageLInternal lhs rhs) < rhs`); faults when `rhs == 0`.
: @dc l8589978546
pub v/u64/modStageLInternal u64/lhs u64/rhs
    test
        in u64:7 u64:3
        out u64:1.
        in u64:18446744073709551615 u64:10
        out u64:5.
        in u64:0 u64:5
        out u64:0.
        in u64:1 u64:0
        out fault.
    rem /lhs /rhs.

: Returns true iff checked `add lhs rhs` will not overflow unsigned 64-bit bounds.
: @dc l8589978261
