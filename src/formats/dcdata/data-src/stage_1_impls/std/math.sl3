: ---------------------------------------------------------------------------
: Total `bigInt` & `ratVal` arithmetic (`add`, `sub`, `mul`, `neg`)
: ---------------------------------------------------------------------------

: @dc l8589984880
pub v/bigInt/sum bigInt/a bigInt/b
    test
        in structNew bigInt: false l/u32: u32:3 :: :: structNew bigInt: false l/u32: u32:4 :: ::
        out structNew bigInt: false l/u32: u32:7 :: ::.
    bigIntAdd /a /b.

: @dc l8589984881
pub v/bigInt/diff bigInt/a bigInt/b
    test
        in structNew bigInt: false l/u32: u32:10 :: :: structNew bigInt: false l/u32: u32:3 :: ::
        out structNew bigInt: false l/u32: u32:7 :: ::.
    bigIntSub /a /b.

: @dc l8589984882
pub v/bigInt/prod bigInt/a bigInt/b
    test
        in structNew bigInt: false l/u32: u32:6 :: :: structNew bigInt: true l/u32: u32:7 :: ::
        out structNew bigInt: true l/u32: u32:42 :: ::.
    bigIntMul /a /b.

: @dc l8589984883
pub v/bigInt/neg bigInt/a
    test
        in structNew bigInt: false l/u32: u32:5 :: ::
        out structNew bigInt: true l/u32: u32:5 :: ::.
    bigIntNeg /a.

: @dc l8589984884
pub v/ratVal/sum ratVal/a ratVal/b
    test
        in structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:6 :: :: :: structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:3 :: :: ::
        out structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:2 :: :: ::.
    ratAdd /a /b.

: @dc l8589984885
pub v/ratVal/diff ratVal/a ratVal/b
    test
        in structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:2 :: :: :: structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:3 :: :: ::
        out structNew ratVal: structNew bigInt: false l/u32: u32:1 :: :: structNew bigInt: false l/u32: u32:6 :: :: ::.
    ratSub /a /b.

: @dc l8589984886
pub v/ratVal/prod ratVal/a ratVal/b
    test
        in structNew ratVal: structNew bigInt: true l/u32: u32:2 :: :: structNew bigInt: false l/u32: u32:3 :: :: :: structNew ratVal: structNew bigInt: false l/u32: u32:9 :: :: structNew bigInt: false l/u32: u32:4 :: :: ::
        out structNew ratVal: structNew bigInt: true l/u32: u32:3 :: :: structNew bigInt: false l/u32: u32:2 :: :: ::.
    ratMul /a /b.

: @dc l8589984887
pub v/ratVal/neg ratVal/a
    test
        in structNew ratVal: structNew bigInt: false l/u32: u32:3 :: :: structNew bigInt: false l/u32: u32:4 :: :: ::
        out structNew ratVal: structNew bigInt: true l/u32: u32:3 :: :: structNew bigInt: false l/u32: u32:4 :: :: ::.
    ratNeg /a.

: ---------------------------------------------------------------------------
: Checked StageL arithmetic & shift overloads (explicit `fault`, StageL-only)
: ---------------------------------------------------------------------------

: @dc l8589984888
pub v/u8/sum u8/lhs u8/rhs
    test
        in u8:10 u8:32
        out u8:42.
        in u8:255 u8:1
        out fault.
    if not canAdd /lhs /rhs fault sum /lhs /rhs.

: @dc l8589984889
pub v/u8/diff u8/lhs u8/rhs
    test
        in u8:42 u8:10
        out u8:32.
        in u8:0 u8:1
        out fault.
    if not canSub /lhs /rhs fault diff /lhs /rhs.

: @dc l8589984890
pub v/u8/prod u8/lhs u8/rhs
    test
        in u8:6 u8:7
        out u8:42.
        in u8:16 u8:16
        out fault.
    if not canMul /lhs /rhs fault prod /lhs /rhs.

: @dc l8589984891
pub v/u8/quot u8/lhs u8/rhs
    test
        in u8:43 u8:5
        out u8:8.
        in u8:1 u8:0
        out fault.
    if not canDiv /lhs /rhs fault quot /lhs /rhs.

: @dc l8589984892
pub v/u8/rem u8/lhs u8/rhs
    test
        in u8:43 u8:5
        out u8:3.
        in u8:1 u8:0
        out fault.
    if not canDiv /lhs /rhs fault rem /lhs /rhs.

: @dc l8589984893
pub v/u8/truncRem u8/lhs u8/rhs
    test
        in u8:43 u8:5
        out u8:3.
        in u8:1 u8:0
        out fault.
    if eq /rhs u8:0 fault rem /lhs /rhs.

: @dc l8589984894
pub v/u8/mod u8/lhs u8/rhs
    test
        in u8:43 u8:5
        out u8:3.
        in u8:1 u8:0
        out fault.
    if eq /rhs u8:0 fault modStageLInternal /lhs /rhs.

: @dc l8589984895
pub v/u8/shl u8/lhs u32/cnt
    test
        in u8:1 u32:7
        out u8:128.
        in u8:1 u32:8
        out fault.
    if ge /cnt u32:8 fault shl /lhs /cnt.

: @dc l8589984896
pub v/u8/shr u8/lhs u32/cnt
    test
        in u8:128 u32:7
        out u8:1.
        in u8:1 u32:8
        out fault.
    if ge /cnt u32:8 fault shr /lhs /cnt.

: @dc l8589984897
pub v/i32/neg i32/a
    test
        in i32:5
        out i32:-5.
        in i32:-2147483648
        out fault.
    if not canNeg /a fault neg /a.

: @dc l8589984898
pub v/i32/sum i32/lhs i32/rhs
    test
        in i32:10 i32:-3
        out i32:7.
        in i32:2147483647 i32:1
        out fault.
    if not canAdd /lhs /rhs fault sum /lhs /rhs.

: @dc l8589984899
pub v/i32/diff i32/lhs i32/rhs
    test
        in i32:10 i32:3
        out i32:7.
        in i32:-2147483648 i32:1
        out fault.
    if not canSub /lhs /rhs fault diff /lhs /rhs.

: @dc l8589984900
pub v/i32/prod i32/lhs i32/rhs
    test
        in i32:-6 i32:-7
        out i32:42.
        in i32:-2147483648 i32:-1
        out fault.
    if not canMul /lhs /rhs fault prod /lhs /rhs.

: @dc l8589984901
pub v/i32/quot i32/lhs i32/rhs
    test
        in i32:-7 i32:3
        out i32:-2.
        in i32:-2147483648 i32:-1
        out fault.
        in i32:1 i32:0
        out fault.
    if not canDiv /lhs /rhs fault quot /lhs /rhs.

: @dc l8589984902
pub v/i32/rem i32/lhs i32/rhs
    test
        in i32:-7 i32:3
        out i32:-1.
        in i32:-2147483648 i32:-1
        out fault.
        in i32:1 i32:0
        out fault.
    if not canDiv /lhs /rhs fault rem /lhs /rhs.

: @dc l8589984903
pub v/i32/truncRem i32/lhs i32/rhs
    test
        in i32:-7 i32:3
        out i32:-1.
        in i32:-2147483648 i32:-1
        out i32:0.
        in i32:1 i32:0
        out fault.
