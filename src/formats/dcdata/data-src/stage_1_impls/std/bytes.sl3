: Stage 1 byte-sequence splitting (`explode`) and joining (`implode`) primitives.
ns std/bytes.

: Private helper checking whether `sep` matches `input` starting at `pos`.
: @dc l8589978238
v/b/matchesAt l/u8/input u64/pos l/u8/sep
    const u64/sepLen len /sep.
    let u64/k u64:0.
    while lt /k /sepLen do
        if ne get /input add /pos /k get /sep /k
            return false
            nop.
        set /k add /k u64:1.
    ::.
    true.

: Splits `input` at each non-overlapping left-to-right occurrence of `sep`.
: When `sep` is non-empty, preserves leading, trailing, and adjacent empty slices so
: `implode sep (explode sep x) == x`. When `sep` is empty (`b""`), splits `input` into
: individual 1-byte slices (`explode b"" b"" == []` and `explode b"" b"abc" == [b"a", b"b", b"c"]`).
: @dc l8589978239
pub v/l/l/u8/explode l/u8/sep l/u8/input
    test
        in b"," b"a,b,c"
        out l/l/u8: b"a" b"b" b"c" ::.
        in b"," b",a,,b,"
        out l/l/u8: b"" b"a" b"" b"b" b"" ::.
        in b"," b""
        out l/l/u8: b"" ::.
        in b"--" b"a---b"
        out l/l/u8: b"a" b"-b" ::.
        in b"xyz" b"ab"
        out l/l/u8: b"ab" ::.
        in b"" b""
        out l/l/u8: ::.
        in b"" b"abc"
        out l/l/u8: b"a" b"b" b"c" ::.
    const u64/sepLen len /sep.
    const u64/inLen len /input.
    if eq /sepLen u64:0
        do
            const buf/l/u8/elems bufNew l/u8 /inLen.
            let u64/idx u64:0.
            while lt /idx /inLen do
                bufPush /elems slice /input /idx add /idx u64:1.
                set /idx add /idx u64:1.
            ::.
            return bufFreeze /elems.
        ::
        nop.
    const buf/l/u8/outBuf bufNew l/u8 u64:4.
    let u64/segStart u64:0.
    let u64/pos u64:0.
    if le /sepLen /inLen
        do
            const u64/limit sub /inLen /sepLen.
            while le /pos /limit do
                if matchesAt /input /pos /sep
                    do
                        bufPush /outBuf slice /input /segStart /pos.
                        set /pos add /pos /sepLen.
                        set /segStart /pos.
                    ::
                    set /pos add /pos u64:1.
            ::.
        ::
        nop.
    bufPush /outBuf slice /input /segStart /inLen.
    bufFreeze /outBuf.

: Concatenates `parts` in linear `O(N)` time inserting `sep` between adjacent slices.
: @dc l8589978240
pub v/l/u8/implode l/u8/sep l/l/u8/parts
    test
        in b"," l/l/u8: b"a" b"b" b"c" ::
        out b"a,b,c".
        in b"," l/l/u8: b"" b"a" b"" b"b" b"" ::
        out b",a,,b,".
        in b"," l/l/u8: b"" ::
        out b"".
        in b"," l/l/u8: ::
        out b"".
        in b"" l/l/u8: b"ab" b"cd" ::
        out b"abcd".
        in b"--" l/l/u8: b"a" b"-b" ::
        out b"a---b".
    const u64/count len /parts.
    if eq /count u64:0
        return b""
        nop.
    let u64/total mul sub /count u64:1 len /sep.
    let u64/i u64:0.
    while lt /i /count do
        set /total add /total len get /parts /i.
        set /i add /i u64:1.
    ::.
    const buf/u8/outBuf bufNew u8 /total.
    set /i u64:0.
    while lt /i /count do
        if gt /i u64:0
            bufExtend /outBuf /sep
            nop.
        bufExtend /outBuf get /parts /i.
        set /i add /i u64:1.
    ::.
    bufFreeze /outBuf.
