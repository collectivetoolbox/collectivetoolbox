: Returns the smaller of two arbitrary-precision `int` values.
: @dc l8589987681
pub v/int/min int/a int/b
    test
        in int:-999999999999999999999 int:0
        out int:-999999999999999999999.
    if le /a /b /a /b.

: Returns the smaller of two `rat` values.
: @dc l8589987682
pub v/rat/min rat/a rat/b
    test
        in conv int:1 rat conv int:2 rat
        out conv int:1 rat.
    if le /a /b /a /b.

