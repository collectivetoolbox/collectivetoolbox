    foreach convStep/step /chain do
        const l/dc/stripped stripLeadingComments /curTokens.
        const dc/curHead dcAtOr /stripped u64:0 dc:0.
        const b/isWasmDst eq field /step dst dc:1927.
        const b/isStagelInput eq /curHead dc:2192.
        const b/isStagerSrc eq field /step src dc:2221.
        const b/isStagerInput or eq /curHead dc:2221 eq /curHead dc:2192.
        let l/dc/hopInput /curTokens.
        if and /isWasmDst /isStagelInput
            do
                const capCallRes/bun bundleDcModuleDeps /cli /curTokens false.
                set /cli field /bun cli.
                if not field /bun ok
                    return dcRes:err field /bun payload
                    nop.
                const capCallRes/kv prependStage0KvMap /cli field /bun payload.
                set /cli field /kv cli.
                if not field /kv ok
                    return dcRes:err field /kv payload
                    nop.
                set /hopInput field /kv payload.
            ::
            if and /isStagerSrc /isStagerInput
                do
                    const capCallRes/bun bundleDcModuleDeps /cli /curTokens true.
                    set /cli field /bun cli.
                    if not field /bun ok
                        return dcRes:err field /bun payload
                        nop.
                    set /hopInput field /bun payload.
                ::
                nop.

        if eq field /step kind u8:0
            do
                const capCallRes/execRes execPureWasmStep /cli field /step bodyTokens /hopInput.
                set /cli field /execRes cli.
                if not field /execRes ok
                    return dcRes:err field /execRes payload
                    nop.
                set /curTokens field /execRes payload.
            ::
            do
                : StageL converter step: locate active `2192 -> 1927` WASM converter (`f1680`),
                : compile the `step` adapter module to `.WASM`, and execute on `/hopInput`.
                let b/hasS2W false.
                let l/dc/s2wProg l/dc: ::.
                foreach convStep/cs /chain do
                    if and eq field /cs kind u8:0 and field /cs bodyLoaded and eq field /cs src dc:2192 eq field /cs dst dc:1927
                        do
                            set /hasS2W true.
                            set /s2wProg field /cs bodyTokens.
                            break.
                        ::
                        nop.
                ::.
                if not /hasS2W
                    do
                        foreach convStep/cs field /stepsRes steps do
                            if and eq field /cs src dc:2192 eq field /cs dst dc:1927
                                do
                                    const capOptNodeRes/wb resolveWasmDecomp /cli field /cs subj.
                                    set /cli field /wb cli.
                                    if eq field /wb tag u8:2
                                        return dcRes:err field /wb payload
                                        nop.
                                    if eq field /wb tag u8:1
                                        do
                                            set /hasS2W true.
                                            set /s2wProg field /wb payload.
                                            break.
                                        ::
                                        nop.
                                ::
                                nop.
                        ::.
                    ::
                    nop.
                if not /hasS2W
                    return failMsg b"No active StageL-to-WASM converter found in System graph snapshot"
                    nop.
                const l/dc/entryMod buildStageLConverterEntryModule field /step subj.
                const capCallRes/eBun bundleDcModuleDeps /cli /entryMod false.
                set /cli field /eBun cli.
                if not field /eBun ok
                    return dcRes:err field /eBun payload
                    nop.
                const capCallRes/eKv prependStage0KvMap /cli field /eBun payload.
                set /cli field /eKv cli.
                if not field /eKv ok
                    return dcRes:err field /eKv payload
                    nop.
                const capCallRes/compRes execPureWasmStep /cli /s2wProg field /eKv payload.
                set /cli field /compRes cli.
                if not field /compRes ok
                    return dcRes:err field /compRes payload
                    nop.
                const capCallRes/runRes execPureWasmStep /cli field /compRes payload /hopInput.
                set /cli field /runRes cli.
                if not field /runRes ok
                    return dcRes:err field /runRes payload
                    nop.
                set /curTokens field /runRes payload.
            ::.
    ::.

    : 7. Validate final converter output (`Dc 1927..Dc 1928` or `[Routine]`) and expand helpers.
    const u64/cn len /curTokens.
    const b/validFinalWasm or and ge /cn u64:2 and eq dcAtOr /curTokens u64:0 dc:0 dc:1927 eq dcAtOr /curTokens wrapSub /cn u64:1 dc:0 dc:1928 isRoutineNamedConstruct /curTokens.
    if not /validFinalWasm
        return failMsg b"Converter chain did not emit a valid Dc-WASM program (Dc 1927..Dc 1928)"
        nop.
    const capCallRes/finalExp expandWasmTokens /cli /curTokens.
    if not field /finalExp ok
        return dcRes:err field /finalExp payload
        nop.
    dcRes:ok field /finalExp payload.

pub dc/2608 v/dcs/convertDcStringToWasm dcs/input
    match runConvertDcStringToWasm dcsToList /input
        case ok l/dc/toks dcsFromList /toks.
        case err l/dc/e dcsFromList /e.
    ::.
