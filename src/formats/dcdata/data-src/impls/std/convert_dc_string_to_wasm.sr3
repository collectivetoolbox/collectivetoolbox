: Computes declaration end and metadata for a single top-level declaration starting at `pos`.
: @dc l8589992861
v/tup: b b u8 u128 l/u8 l/dc u64 ::/inspectTopDeclMeta l/dc/tokens u64/pos
    : Returns `(isValid, wasPub, hasBuf, catRank, ownDcId, localDcs, cleanedDeclTokens, nextPos)`.
    : Actually packed cleanly into helpers below; this extracts header + end position.
    let u64/i skipAllComments /tokens /pos.
    const u64/n len /tokens.
    if ge /i /n
        return tupNew: false false u8:2 u128:0 l/u8: :: l/dc: :: /pos ::
        nop.
    const dc/head dcAtOr /tokens /i dc:0.
    let b/wasPub false.
    let b/hasBuf false.
    let u8/catRank u8:2.
    let u128/ownDc u128:0.
    let b/hasOwnDc false.
    let u64/declEnd /i.
    if or eq /head dc:2199 eq /head dc:2200
        do
            set /wasPub eq /head dc:2200.
