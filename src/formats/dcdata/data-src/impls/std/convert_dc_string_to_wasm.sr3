                                                case ok nop.
                                                case err error/_e nop.
                                            ::.
                                            bufGain /edges /j.
                                        ::
                                        nop.
                                ::
                                nop.
                        ::
                        nop.
                    become /j wrapSum /j u64:1.
                ::.
            ::
            nop.
        foreach u128/rd field /modI refDcs do
