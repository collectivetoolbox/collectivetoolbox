                                match get /revList /ri
                                    case some convStep/cs bufPush /fwd /cs.
                                    case none nop.
                                ::.
                            ::.
                            return structNew convListRes: cli /curCli ok true steps bufFreeze /fwd errTokens l/dc: :: ::
                        ::
                        nop.
                    const capU128ListRes/nextEq collectEquivClass /curCli field /st dst.
                    set /curCli field /nextEq cli.
                    if not field /nextEq ok
                        return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /nextEq errTokens ::
                        nop.
                    foreach u128/cand field /nextEq ids do
                        let b/seenV false.
                        let u64/vi u64:0.
                        while lt /vi len /visited do
                            const u128/vx match get /visited /vi
                                case some u128/v /v.
                                case none break.
                            ::.
                            if eq /vx /cand
                                do
                                    set /seenV true.
                                    break.
                                ::
                                nop.
                            set /vi wrapAdd /vi u64:1.
                        ::.
                        if not /seenV
                            do
                                bufPush /visited /cand.
                                bufPush /qNodes /cand.
                                bufPush /qParentIdx /qi.
                                bufPush /qStepIdx /loadedIdx.
                            ::
                            nop.
                    ::.
                ::.
            ::
            nop.
        set /qi wrapAdd /qi u64:1.
    ::.
    structNew convListRes: cli /curCli ok true steps l/convStep: :: errTokens l/dc: :: ::.

