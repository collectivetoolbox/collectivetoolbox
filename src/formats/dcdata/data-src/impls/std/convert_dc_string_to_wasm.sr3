        do
            hold buf/dc/out bufNew dc len /tokens.
            bufGain /out /h.
            bufGain /out dc:517.
            match slice /tokens u64:2 len /tokens
                case some l/dc/rest bufGainAll /out /rest.
                case none nop.
            ::.
            return bufFrozen /out
        ::
        nop.
    /tokens.

: @dc l8589992869
v/l/dc/buildSyntheticModuleTokens b/isStager b/hasNs l/l/u8/nsSegs l/dc/useToks l/dc/bodyToks
