: 6. Token-Dc StageL / StageR Dependency Scanner, Bundler & Stage 0 KV Map
: ---------------------------------------------------------------------------

: @dc l8589992851
v/l/u8/joinNsSegs l/l/u8/segs
    test
        in l/l/u8: b"std" b"dctf" ::
        out b"std//dctf".
    let buf/u8/out bufNew u8 u64:16.
    let u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            bufPush /out u8:47
            nop.
        match get /segs /i
            case some l/u8/seg bufExtend /out /seg.
            case none nop.
        ::.
        set /i wrapAdd /i u64:1.
    ::.
    bufFreeze /out.

: @dc l8589992852
v/l/l/u8/splitNsKey l/u8/nsKey
    test
        in b"std//dctf"
        out l/l/u8: b"std" b"dctf" ::.
    const u64/n len /nsKey.
    let buf/l/u8/out bufNew l/u8 u64:4.
    let u64/start u64:0.
    while lt /start /n do
        let u64/end /start.
        while lt /end /n do
            if eq u8AtOr /nsKey /end u8:0 u8:47
                break
                nop.
            set /end wrapAdd /end u64:1.
        ::.
        if gt /end /start
            match slice /nsKey /start /end
                case some l/u8/seg bufPush /out /seg.
                case none nop.
            ::
            nop.
        set /start wrapAdd /end u64:1.
    ::.
    bufFreeze /out.

: @dc l8589992853
v/tup: b l/l/u8 u64 ::/readFilePathSegs l/dc/tokens u64/pos
    const u64/n len /tokens.
    let u64/p skipAllComments /tokens /pos.
    if or ge wrapAdd /p u64:1 /n or ne dcAtOr /tokens /p dc:0 dc:511 ne dcAtOr /tokens wrapAdd /p u64:1 dc:0 dc:f229
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    set /p skipAllComments /tokens wrapAdd /p u64:2.
    if or ge /p /n ne dcAtOr /tokens /p dc:0 dc:310
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    set /p skipAllComments /tokens wrapAdd /p u64:1.
    if and lt wrapAdd /p u64:1 /n and eq dcAtOr /tokens /p dc:0 dc:516 eq dcAtOr /tokens wrapAdd /p u64:1 dc:0 dc:f228
        do
            set /p wrapAdd /p u64:2.
            if and lt /p /n eq dcAtOr /tokens /p dc:0 dc:513
                set /p wrapAdd /p u64:1
                nop.
        ::
        nop.
    let buf/l/u8/segs bufNew l/u8 u64:4.
    let b/done false.
    let b/failed false.
    while not /done do
        set /p skipAllComments /tokens /p.
        if ge /p /n
            do
                set /failed true.
                break.
            ::
            nop.
        const dc/tok dcAtOr /tokens /p dc:0.
        if eq /tok dc:311
            do
                set /p wrapAdd /p u64:1.
                set /done true.
                break.
            ::
            nop.
        if eq /tok dc:513
            do
                set /p skipAllComments /tokens wrapAdd /p u64:1.
            ::
            nop.
        if or ge wrapAdd /p u64:1 /n or ne dcAtOr /tokens /p dc:0 dc:511 ne dcAtOr /tokens wrapAdd /p u64:1 dc:0 dc:f228
            do
                set /failed true.
                break.
            ::
            nop.
        const tup: b dc l/dc u64 ::/lit readEscapedLiteral /tokens wrapAdd /p u64:2.
        if or not field /lit u32:0 ne field /lit u32:1 dc:264
            do
                set /failed true.
                break.
            ::
            nop.
        const u64/endFname skipAllComments /tokens field /lit u32:3.
        if or ge /endFname /n ne dcAtOr /tokens /endFname dc:0 dc:512
            do
                set /failed true.
                break.
            ::
            nop.
        let buf/u8/seg bufNew u8 len field /lit u32:2.
        foreach dc/ch field /lit u32:2 do
            match conv u128FromDc /ch u8
                case ok u8/b bufPush /seg /b.
                case err error/_e nop.
            ::.
        ::.
        bufPush /segs bufFreeze /seg.
        set /p wrapAdd /endFname u64:1.
    ::.
    const l/l/u8/frozenSegs bufFreeze /segs.
    if or /failed eq len /frozenSegs u64:0
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    set /p skipAllComments /tokens /p.
    if or ge /p /n ne dcAtOr /tokens /p dc:0 dc:512
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    tupNew: true /frozenSegs wrapAdd /p u64:1 ::.

: Encodes a segment list into canonical `Dc 511 f229` FilePath tokens
: (`segMode`: `0` = raw inline segments, `1` = `[string]`-interned IDs,
: `2` = legacy Unicode-interned IDs; `hdrMode`: `0` = `516 f228 513`, `1` = `516 f228`,
: `2` = omit `516 f228`).
: @dc l8589992854
v/l/dc/encodeFilePathVariant l/l/u8/segs l/u128/internedSegIds u8/segMode u8/hdrMode
    let buf/dc/out bufNew dc u64:32.
    bufPush /out dc:511.
    bufPush /out dc:f229.
    bufPush /out dc:310.
    if lt /hdrMode u8:2
        do
            bufPush /out dc:516.
            bufPush /out dc:f228.
        ::
        nop.
    if eq /hdrMode u8:0
        bufPush /out dc:513
        nop.
    let u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            bufPush /out dc:513
            nop.
        bufPush /out dc:511.
        bufPush /out dc:f228.
        const l/u8/seg match get /segs /i
            case some l/u8/s /s.
            case none b"".
        ::.
        const u128/sid match get /internedSegIds /i
            case some u128/v /v.
            case none u128:0.
        ::.
        if and eq /segMode u8:1 gt /sid u128:0
            bufPush /out dcFromU128 /sid
            if and eq /segMode u8:2 gt /sid u128:0
                do
                    bufPush /out dc:260.
                    bufPush /out dc:262.
                    bufPush /out dc:264.
                    bufPush /out dc:263.
                    bufPush /out dcFromU128 /sid.
                    bufPush /out dc:261.
                ::
                bufExtend /out tokEscapedLiteral dc:264 u8sToUnicodeDcs /seg.
        bufPush /out dc:512.
        set /i wrapAdd /i u64:1.
    ::.
    bufPush /out dc:311.
    bufPush /out dc:512.
    bufFreeze /out.

: Queries the UNION of active FilePath context node IDs matching `segs`, covering
: `[string]`-interned, legacy Unicode-interned, and raw inline FilePath encodings.
: @dc l8589992855
v/capU128ListRes/findFilePathContextNodes capClient/cli l/l/u8/segs
    let capClient/curCli /cli.
    let buf/u128/strIds bufNew u128 len /segs.
    let buf/u128/uniIds bufNew u128 len /segs.
    let b/allStrHit true.
    let b/allUniHit true.
    foreach l/u8/seg /segs do
        const l/dc/uChars u8sToUnicodeDcs /seg.
        const l/dc/strLit tokEscapedLiteral dc:264 /uChars.
        const capU128ListRes/sr queryNodesByExactTokens /curCli /strLit.
        set /curCli field /sr cli.
        if not field /sr ok
            return /sr
            nop.
        if gt len field /sr ids u64:0
            bufPush /strIds match get field /sr ids u64:0
                case some u128/v /v.
                case none u128:0.
            ::
            do
                set /allStrHit false.
                bufPush /strIds u128:0.
            ::.
        const capU128ListRes/ur queryNodesByExactTokens /curCli /uChars.
        set /curCli field /ur cli.
        if not field /ur ok
            return /ur
            nop.
        if gt len field /ur ids u64:0
            bufPush /uniIds match get field /ur ids u64:0
                case some u128/v /v.
                case none u128:0.
            ::
            do
                set /allUniHit false.
                bufPush /uniIds u128:0.
            ::.
    ::.
    const l/u128/strIdList bufFreeze /strIds.
    const l/u128/uniIdList bufFreeze /uniIds.
    let buf/u128/found bufNew u128 u64:4.
    const l/u8/hdrModes l/u8: u8:0 u8:1 u8:2 ::.
    foreach u8/hm /hdrModes do
        if /allStrHit
            do
                const l/dc/q1 encodeFilePathVariant /segs /strIdList u8:1 /hm.
                const capU128ListRes/r1 queryNodesByExactTokens /curCli /q1.
                set /curCli field /r1 cli.
                if not field /r1 ok
                    return /r1
                    nop.
                foreach u128/id field /r1 ids do
                    let b/seenF false.
                    let u64/fi u64:0.
                    while lt /fi len /found do
                        const u128/fx match get /found /fi
                            case some u128/v /v.
                            case none break.
                        ::.
                        if eq /fx /id
                            do
                                set /seenF true.
                                break.
                            ::
                            nop.
                        set /fi wrapAdd /fi u64:1.
                    ::.
                    if not /seenF
                        bufPush /found /id
                        nop.
                ::.
            ::
            nop.
        if /allUniHit
            do
                const l/dc/q2 encodeFilePathVariant /segs /uniIdList u8:2 /hm.
                const capU128ListRes/r2 queryNodesByExactTokens /curCli /q2.
                set /curCli field /r2 cli.
                if not field /r2 ok
                    return /r2
                    nop.
                foreach u128/id field /r2 ids do
                    let b/seenF false.
                    let u64/fi u64:0.
                    while lt /fi len /found do
                        const u128/fx match get /found /fi
                            case some u128/v /v.
                            case none break.
                        ::.
                        if eq /fx /id
                            do
                                set /seenF true.
                                break.
                            ::
                            nop.
                        set /fi wrapAdd /fi u64:1.
                    ::.
                    if not /seenF
                        bufPush /found /id
                        nop.
                ::.
            ::
            nop.
        const l/dc/q0 encodeFilePathVariant /segs l/u128: :: u8:0 /hm.
        const capU128ListRes/r0 queryNodesByExactTokens /curCli /q0.
        set /curCli field /r0 cli.
        if not field /r0 ok
            return /r0
            nop.
        foreach u128/id field /r0 ids do
            let b/seenF false.
            let u64/fi u64:0.
            while lt /fi len /found do
                const u128/fx match get /found /fi
                    case some u128/v /v.
                    case none break.
                ::.
                if eq /fx /id
                    do
                        set /seenF true.
                        break.
                    ::
                    nop.
                set /fi wrapAdd /fi u64:1.
            ::.
            if not /seenF
                bufPush /found /id
                nop.
        ::.
    ::.
    structNew capU128ListRes: cli /curCli ok true ids bufFreeze /found errTokens l/dc: :: ::.

: Reads `[255]? <atom>` in Token-Dc encoding (`decode.rs:658`).
: @dc l8589992856
v/option/u128Step/readTokAtom l/dc/tokens u64/pos
    const u64/n len /tokens.
    if ge /pos /n
        return option/u128Step:none
        nop.
    const dc/tok dcAtOr /tokens /pos dc:0.
    if eq /tok dc:255
        do
            const u64/p1 wrapAdd /pos u64:1.
            if ge /p1 /n
                return option/u128Step:none
                nop.
            return option/u128Step:some structNew u128Step: val u128FromDc dcAtOr /tokens /p1 dc:0 nextPos wrapAdd /p1 u64:1 ::
        ::
        nop.
    option/u128Step:some structNew u128Step: val u128FromDc /tok nextPos wrapAdd /pos u64:1 ::.

: @dc l8589992857
v/option/u128Step/readTokOptAtom l/dc/tokens u64/pos
    if and lt /pos len /tokens eq dcAtOr /tokens /pos dc:0 dc:316
        return option/u128Step:some structNew u128Step: val u128:0 nextPos wrapAdd /pos u64:1 ::
        nop.
    readTokAtom /tokens /pos.

: @dc l8589992858
v/u64/skipBalancedFrame l/dc/tokens u64/pos dc/openTok dc/closeTok
    const u64/n len /tokens.
    let u64/i wrapAdd /pos u64:1.
    let u64/depth u64:1.
    const u32/openSid dcShortId /openTok.
    const u32/closeSid dcShortId /closeTok.
    if and ne /openSid /noRegionId ne /closeSid /noRegionId
        do
            while and lt /i /n gt /depth u64:0 do
                const u32/tsid dcShortId dcAtOr /tokens /i /dcZero.
                if eq /tsid u32:255
                    do
                        set /i wrapAdd /i u64:2.
                        if gt /i /n
                            set /i /n
                            nop.
                        continue.
                    ::
                    nop.
                if eq /tsid /openSid
                    set /depth wrapAdd /depth u64:1
                    if eq /tsid /closeSid
                        set /depth wrapSub /depth u64:1
                        nop.
                set /i wrapAdd /i u64:1.
            ::.
            return /i.
        ::
        nop.
    while and lt /i /n gt /depth u64:0 do
        const dc/t dcAtOr /tokens /i /dcZero.
        if eq dcShortId /t u32:255
            do
                set /i wrapAdd /i u64:2.
                if gt /i /n
                    set /i /n
                    nop.
                continue.
            ::
            nop.
        if eq /t /openTok
            set /depth wrapAdd /depth u64:1
            if eq /t /closeTok
                set /depth wrapSub /depth u64:1
                nop.
        set /i wrapAdd /i u64:1.
    ::.
    /i.

: @dc l8589992859
v/u64/skipTokenDcType l/dc/tokens u64/pos
    const u64/n len /tokens.
    let u64/i /pos.
    let u64/need u64:1.
    while and lt /i /n gt /need u64:0 do
        set /i skipAllComments /tokens /i.
        if ge /i /n
            break
            nop.
        const dc/t dcAtOr /tokens /i /dcZero.
        const u32/sid dcShortId /t.
        if or eq /sid u32:2576 or eq /sid u32:2577 or eq /sid u32:2674 eq /sid u32:2675
            do
                set /i wrapAdd /i u64:1.
                continue.
            ::
            nop.
        if eq /sid u32:262
            do
                set /i skipBalancedFrame /tokens /i dc:262 dc:263.
                set /need wrapSub /need u64:1.
                continue.
