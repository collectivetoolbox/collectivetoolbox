: @dc l8589992791
pub v/capClient/emptyClient
    be l/capEntry/emptyB l/capEntry: ::.
    hold buf/l/capEntry/bs bufNew l/capEntry u64:64.
    hold u64/i u64:0.
    while lt /i u64:64 do
        bufGain /bs /emptyB.
        become /i wrapSum /i u64:1.
    ::.
    structNew capClient: buckets bufFrozen /bs hasWatermark false watermark /u128Zero ::.

: @dc l8589993410
v/u64/hashDcList l/dc/xs
    hold u64/h u64:14695981039346656037.
    become /h wrapProd bitXor /h len /xs u64:1099511628211.
    foreach dc/c /xs do
        become /h wrapProd bitXor /h u128Lo u128FromDc /c u64:1099511628211.
    ::.
    /h.

: @dc l8589992792
pub v/dc/dcAtOr l/dc/xs u64/idx dc/fallback
    match at /xs /idx
        case some dc/c /c.
        case none /fallback.
    ::.

: @dc l8589992793
pub v/u8/u8AtOr l/u8/xs u64/idx u8/fallback
    match at /xs /idx
        case some u8/b /b.
        case none /fallback.
    ::.

: @dc l8589992794
pub v/l/dc/u8sToUnicodeDcs l/u8/bytes
    test
        in b"AB"
        out l/dc: dcFromU128 u128:65 dcFromU128 u128:66 ::.
    hold buf/dc/out bufNew dc len /bytes.
    foreach u8/b /bytes do
        match dcFromUnicode conv /b u32
            case ok dc/c bufGain /out /c.
            case err error/_e nop.
        ::.
    ::.
    bufFrozen /out.

: @dc l8589992795
pub v/l/dc/errRecord l/u8/msg
    test
        in b"bad"
        out l/dc: dc:552 dc:u62 dc:u61 dc:u64 dc:553 ::.
    be l/dc/chars u8sToUnicodeDcs /msg.
    hold buf/dc/out bufNew dc wrapSum len /chars u64:4.
    bufGain /out dc:552.
    foreach dc/c /chars do
        if or eq /c dc:255 eq /c dc:553
            bufGain /out dc:255
            nop.
        bufGain /out /c.
    ::.
    bufGain /out dc:553.
    bufFrozen /out.

: @dc l8589992796
v/dcRes/failMsg l/u8/msg
    dcRes:err errRecord /msg.

: @dc l8589992797
pub v/b/isErrorRecord l/dc/tokens
    test
        in l/dc: dc:552 dc:u65 dc:553 ::
        out true.
    test
        in l/dc: dc:260 dc:261 ::
        out false.
    if lt len /tokens u64:2
        return false
        nop.
    eq dcAtOr /tokens u64:0 dc:0 dc:552.

: @dc l8589992798
pub v/b/dcListEq l/dc/a l/dc/b
    be u64/n len /a.
    if ne /n len /b
        return false
        nop.
    hold u64/i u64:0.
    while lt /i /n do
        if ne dcAtOr /a /i dc:0 dcAtOr /b /i dc:0
            return false
            nop.
        become /i wrapSum /i u64:1.
    ::.
    true.

: @dc l8589992799
pub v/b/u8ListEq l/u8/a l/u8/b
    be u64/n len /a.
    if ne /n len /b
        return false
        nop.
    hold u64/i u64:0.
    while lt /i /n do
        if ne u8AtOr /a /i u8:0 u8AtOr /b /i u8:0
            return false
            nop.
        become /i wrapSum /i u64:1.
    ::.
    true.

: @dc l8589992800
pub v/b/listContainsU128 l/u128/xs u128/target
    foreach u128/x /xs do
        if eq /x /target
            return true
            nop.
    ::.
    false.

: @dc l8589992801
v/l/u128/appendUniqueU128 l/u128/xs u128/x
    if listContainsU128 /xs /x
        return /xs
        nop.
    hold buf/u128/out bufNew u128 wrapSum len /xs u64:1.
    bufGainAll /out /xs.
    bufGain /out /x.
    bufFrozen /out.

: @dc l8589992802
v/b/listContainsDc l/dc/xs dc/target
    foreach dc/c /xs do
        if eq /c /target
            return true
            nop.
    ::.
    false.

: @dc l8589992803
v/b/listContainsU8Seq l/l/u8/xs l/u8/target
    foreach l/u8/item /xs do
        if u8ListEq /item /target
            return true
            nop.
    ::.
    false.

: @dc l8589993411
v/u64/u128Bucket64 u128/x
    bitAnd u128Lo /x u64:63.

: @dc l8589993412
v/l/l/u128/emptyU128Set
    be l/u128/empty l/u128: ::.
    hold buf/l/u128/bs bufNew l/u128 u64:64.
    hold u64/i u64:0.
    while lt /i u64:64 do
        bufGain /bs /empty.
        become /i wrapSum /i u64:1.
    ::.
    bufFrozen /bs.

: @dc l8589993413
v/b/u128SetContains l/l/u128/bs u128/x
    be l/u128/b match at /bs u128Bucket64 /x
        case some l/u128/xs /xs.
        case none l/u128: ::.
    ::.
    listContainsU128 /b /x.

: @dc l8589993414
v/l/l/u128/u128SetInsert l/l/u128/bs u128/x
    be u64/bIdx u128Bucket64 /x.
    be l/u128/oldB match at /bs /bIdx
        case some l/u128/xs /xs.
        case none l/u128: ::.
    ::.
    if listContainsU128 /oldB /x
        return /bs
        nop.
    hold buf/u128/nb bufNew u128 wrapSum len /oldB u64:1.
    bufGainAll /nb /oldB.
    bufGain /nb /x.
    hold buf/l/u128/out bufNew l/u128 u64:64.
    bufGainAll /out /bs.
    match bufBecomeAt /out /bIdx bufFrozen /nb
        case ok nop.
        case err error/_e nop.
    ::.
    bufFrozen /out.

: @dc l8589993415
v/l/l/u8/appendUniqueU8Seq l/l/u8/xs l/u8/x
    if listContainsU8Seq /xs /x
        return /xs
        nop.
    hold buf/l/u8/out bufNew l/u8 wrapSum len /xs u64:1.
    bufGainAll /out /xs.
    bufGain /out /x.
    bufFrozen /out.

: @dc l8589993416
v/b/isKvMapWasmProgram l/dc/tokens
    be u64/n len /tokens.
    if lt /n u64:4
        return false
        nop.
    and eq dcShortId dcAtOr /tokens u64:0 /dcZero u32:1927
        and eq dcShortId dcAtOr /tokens u64:1 /dcZero u32:559
            and eq dcShortId dcAtOr /tokens wrapDiff /n u64:2 /dcZero u32:560
                eq dcShortId dcAtOr /tokens wrapDiff /n u64:1 /dcZero u32:1928.

: @dc l8589993766
v/b/isKvMapWasmBytes l/u8/bs
    be u64/n len /bs.
    if lt /n u64:16
        return false
        nop.
    be b/pre match slice /bs u64:0 u64:8
        case some l/u8/s eq /s b"/xf4/x90/x9e/x87/xf4/x90/x88/xaf".
        case none false.
    ::.
    if not /pre
        return false
        nop.
    match slice /bs wrapDiff /n u64:8 /n
        case some l/u8/s eq /s b"/xf4/x90/x88/xb0/xf4/x90/x9e/x88".
        case none false.
    ::.

: @dc l8589992804
pub v/b/isSysRegionId u128/id
    and ge /id /u128SysStart le /id /u128SysEnd.

: @dc l8589993556
pub v/b/isSysRegionDc dc/c
    if ne dcShortId /c /noRegionId
        return false
        nop.
    if ne dcFormatId /c /noRegionId
        return false
        nop.
    isSysRegionId u128FromDc /c.

: @dc l8589993557
v/b/hasAnySysRegionToken l/dc/tokens
    foreach dc/tok /tokens do
        be u128/u u128FromDc /tok.
        if and ge /u /u128SysStart le /u /u128SysEnd
            return true
            nop.
    ::.
    false.

: @dc l8589992805
v/b/isSingleLineCommentOpener dc/c
    be u32/sid dcShortId /c.
    or eq /sid u32:246 eq /sid u32:247.

: @dc l8589992806
v/b/isBlockCommentOpener dc/c
    be u32/sid dcShortId /c.
    or eq /sid u32:249 eq /sid u32:250.

: Skips leading single-line (`Dc 246`/`247`..`Dc 248`) and block
: (`Dc 249`/`250`..`Dc 251`) comment frames from `pos`.
: @dc l8589992807
pub v/u64/skipAllComments l/dc/tokens u64/pos
    test
        in l/dc: dc:247 dc:u65 dc:248 dc:249 dc:u66 dc:251 dc:1927 :: u64:0
        out u64:6.
    be u64/n len /tokens.
    hold u64/i /pos.
    while lt /i /n do
        be u32/sid dcShortId dcAtOr /tokens /i /dcZero.
        hold u32/closeSid u32:0.
        if or eq /sid u32:246 eq /sid u32:247
            become /closeSid u32:248
            if or eq /sid u32:249 eq /sid u32:250
                become /closeSid u32:251
                return /i.
        become /i wrapSum /i u64:1.
        hold b/closed false.
        while lt /i /n do
            be u32/inSid dcShortId dcAtOr /tokens /i /dcZero.
            if or eq /inSid u32:255 eq /inSid u32:2239
                do
                    be u64/i1 wrapSum /i u64:1.
                    if and eq /inSid u32:2239 and lt /i1 /n eq dcShortId dcAtOr /tokens /i1 /dcZero u32:255
                        become /i wrapSum /i u64:3
                        become /i wrapSum /i u64:2.
                    if gt /i /n
                        become /i /n
                        nop.
                ::
                do
                    become /i wrapSum /i u64:1.
                    if eq /inSid /closeSid
                        do
                            become /closed true.
                            break.
                        ::
                        nop.
                ::.
        ::.
        if not /closed
            return /i
            nop.
    ::.
    /i.

: Skips leading comments in `tokens` and returns the remaining slice.
: @dc l8589992808
pub v/l/dc/stripLeadingComments l/dc/tokens
    be u64/p skipAllComments /tokens u64:0.
    match slice /tokens /p len /tokens
        case some l/dc/rest /rest.
        case none l/dc: ::.
    ::.

: @dc l8589992809
pub v/b/isAsciiLowerEq u8/a u8/b
    hold u8/la /a.
    if and ge /la u8:65 le /la u8:90
        become /la wrapSum /la u8:32
        nop.
    hold u8/lb /b.
    if and ge /lb u8:65 le /lb u8:90
        become /lb wrapSum /lb u8:32
        nop.
    eq /la /lb.

: Checks whether Unicode Dcs encode `.Formats:transformation` (after trimming
: optional ASCII whitespace and `.Formats:`/`Formats:`/`format_` prefix).
: @dc l8589992810
v/b/isTransformationCategoryDcs l/dc/chars
    test
        in l/dc: dc:u2e dc:u46 dc:u6f dc:u72 dc:u6d dc:u61 dc:u74 dc:u73 dc:u3a dc:u74 dc:u72 dc:u61 dc:u6e dc:u73 dc:u66 dc:u6f dc:u72 dc:u6d dc:u61 dc:u74 dc:u69 dc:u6f dc:u6e ::
        out true.
    test
        in l/dc: dc:u6f dc:u74 dc:u68 dc:u65 dc:u72 ::
        out false.
    hold buf/u8/raw bufNew u8 len /chars.
    foreach dc/c /chars do
        be u128/u u128FromDc /c.
        if gt /u u128:127
            return false
            nop.
        match conv /u u8
            case ok u8/b bufGain /raw /b.
            case err error/_e return false.
        ::.
    ::.
    be l/u8/bytes bufFrozen /raw.
    hold u64/s u64:0.
    hold u64/e len /bytes.
    while lt /s /e do
        be u8/b u8AtOr /bytes /s u8:0.
        if or eq /b u8:32 or eq /b u8:9 or eq /b u8:10 eq /b u8:13
            become /s wrapSum /s u64:1
            break.
    ::.
    while gt /e /s do
        be u64/prev wrapDiff /e u64:1.
        be u8/b u8AtOr /bytes /prev u8:0.
        if or eq /b u8:32 or eq /b u8:9 or eq /b u8:10 eq /b u8:13
            become /e /prev
            break.
    ::.
    be l/u8/trimmed match slice /bytes /s /e
        case some l/u8/sl /sl.
        case none return false.
    ::.
    be u64/tlen len /trimmed.
    be l/u8/p1 b".Formats:".
    be l/u8/p2 b"Formats:".
    be l/u8/p3 b"format_".
    hold u64/off u64:0.
    if ge /tlen len /p1
        do
            be b/m match slice /trimmed u64:0 len /p1
                case some l/u8/hd u8ListEq /hd /p1.
                case none false.
            ::.
            if /m
                become /off len /p1
                nop.
        ::
        nop.
    if and eq /off u64:0 ge /tlen len /p2
        do
            be b/m match slice /trimmed u64:0 len /p2
                case some l/u8/hd u8ListEq /hd /p2.
                case none false.
            ::.
            if /m
                become /off len /p2
                nop.
        ::
        nop.
    if and eq /off u64:0 ge /tlen len /p3
        do
            be b/m match slice /trimmed u64:0 len /p3
                case some l/u8/hd u8ListEq /hd /p3.
                case none false.
            ::.
            if /m
                become /off len /p3
                nop.
        ::
        nop.
    be l/u8/want b"transformation".
    if ne wrapDiff /tlen /off len /want
        return false
        nop.
    hold u64/i u64:0.
    while lt /i len /want do
        if not isAsciiLowerEq u8AtOr /trimmed wrapSum /off /i u8:0 u8AtOr /want /i u8:0
            return false
            nop.
        become /i wrapSum /i u64:1.
    ::.
    true.

: @dc l8589992811
v/strStepRes/readStringLiteralAt l/dc/tokens u64/pos
    test
        in l/dc: dc:260 dc:262 dc:264 dc:263 dc:u65 dc:255 dc:261 dc:261 :: u64:0
        out strStepRes:ok structNew strStep: payload l/dc: dc:u65 dc:261 :: nextPos u64:8 ::.
    test
        in l/dc: dc:260 dc:u66 dc:261 :: u64:0
        out strStepRes:ok structNew strStep: payload l/dc: dc:u66 :: nextPos u64:3 ::.
    test
        in l/dc: dc:260 dc:2239 dc:255 dc:261 dc:261 :: u64:0
        out strStepRes:ok structNew strStep: payload l/dc: dc:261 :: nextPos u64:5 ::.
    be u64/n len /tokens.
    if ge /pos /n
        return strStepRes:err errRecord b"ConvertDcStringToWasm requires a [string] literal argument"
        nop.
    if ne dcAtOr /tokens /pos dc:0 dc:260
        return strStepRes:err errRecord b"Expected Dc 260 opening [string] literal"
        nop.
    be u64/p1 wrapSum /pos u64:1.
    if and lt wrapSum /pos u64:4 /n eq dcAtOr /tokens /p1 dc:0 dc:262
        do
            be tup: b dc l/dc u64 ::/lit readEscapedLiteral /tokens /pos.
            if or not field /lit u32:0 ne field /lit u32:1 dc:264
                return strStepRes:err errRecord b"Malformed typed [string] literal argument"
                nop.
            return strStepRes:ok structNew strStep: payload field /lit u32:2 nextPos field /lit u32:3 ::
        ::
        nop.
    hold buf/dc/out bufNew dc u64:32.
    hold u64/i /p1.
    hold b/closed false.
    while lt /i /n do
        be dc/ch dcAtOr /tokens /i dc:0.
        if eq /ch dc:261
            do
                become /i wrapSum /i u64:1.
                become /closed true.
                break.
            ::
            nop.
        if eq /ch dc:2239
            do
                be u64/ni wrapSum /i u64:1.
                if ge /ni /n
                    return strStepRes:err errRecord b"Dangling Dc 2239 atom quote in [string] literal"
                    nop.
