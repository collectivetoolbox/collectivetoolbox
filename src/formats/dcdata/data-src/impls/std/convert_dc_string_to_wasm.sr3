    bufGain /out dc:2203.
    bufGain /out if /isPub dc:517 dc:518.
    bufGainAll /out tokAtomDc /subj.
    match slice /tokens /retStart /retEnd
        case some l/dc/rt bufGainAll /out /rt.
        case none nop.
    ::.
    bufGainAll /out tokIdent /finalIdent.
    match slice /tokens /retEnd /bodyEnd
        case some l/dc/rest bufGainAll /out /rest.
        case none nop.
    ::.
    bufGain /out dc:2204.
    bufFrozen /out.

: Loads active declarations for a namespace (`segs`) into `(sl3Mod, sr3Mod)`.
: @dc l8589992787
struct loadNsRes
    capClient/cli.
    b/ok.
    l/bundledMod/mods.
    l/dc/errTokens.

: @dc l8589992873
v/loadNsRes/loadNamespaceModules capClient/cli l/l/u8/segs b/allowStager
    hold capClient/curCli /cli.
    be l/u8/nsKey joinNsSegs /segs.
    be capU128ListRes/fpRes findFilePathContextNodes /curCli /segs.
    become /curCli field /fpRes cli.
    if not field /fpRes ok
        return structNew loadNsRes: cli /curCli ok false mods l/bundledMod: :: errTokens field /fpRes errTokens ::
        nop.
    if eq len field /fpRes ids u64:0
        return structNew loadNsRes: cli /curCli ok true mods l/bundledMod: :: errTokens l/dc: :: ::
        nop.
    hold buf/graphDeclItem/slItems bufNew graphDeclItem u64:8.
    hold buf/graphDeclItem/srItems bufNew graphDeclItem u64:8.
    hold buf/l/u128/seenSlBuckets bufFilled l/u128: :: u64:64.
    hold buf/l/u128/seenSrBuckets bufFilled l/u128: :: u64:64.
    foreach u128/ctxId field /fpRes ids do
        be capTripleListRes/inCtx queryTriples /curCli true dc:646 false dc:0 true dcFromU128 /ctxId.
        become /curCli field /inCtx cli.
        if not field /inCtx ok
            return structNew loadNsRes: cli /curCli ok false mods l/bundledMod: :: errTokens field /inCtx errTokens ::
            nop.
        foreach tripleRec/ct field /inCtx triples do
            be u128/hasAId u128FromDc field /ct subj.
            if not isSysRegionId /hasAId
                continue
                nop.
            be capOptNodeRes/stmtNode queryNodeRaw /curCli /hasAId.
            become /curCli field /stmtNode cli.
            if eq field /stmtNode tag u8:2
                return structNew loadNsRes: cli /curCli ok false mods l/bundledMod: :: errTokens field /stmtNode payload ::
                nop.
            if ne field /stmtNode tag u8:1
                continue
                nop.
            be l/dc/stToks field /stmtNode payload.
            if or ne len /stToks u64:3 or ne dcAtOr /stToks u64:0 dc:0 dc:584 ne dcAtOr /stToks u64:2 dc:0 dc:574
                continue
                nop.
            be dc/subj dcAtOr /stToks u64:1 dc:0.
            be u128/sid u128FromDc /subj.
            be capOptNodeRes/declNr resolveStageLOrRDecomp /curCli /subj /allowStager.
            become /curCli field /declNr cli.
            if eq field /declNr tag u8:2
                return structNew loadNsRes: cli /curCli ok false mods l/bundledMod: :: errTokens field /declNr payload ::
                nop.
            if ne field /declNr tag u8:1
                continue
                nop.
            hold l/dc/nsEntryToks field /declNr payload.
            be l/dc/nsStripped stripLeadingComments /nsEntryToks.
            if and gt len /nsStripped u64:0 eq dcShortId dcAtOr /nsStripped u64:0 /dcZero u32:2240
                do
                    be capRawBytesRes/idr resolveHasAValueAscii /curCli /hasAId.
                    become /curCli field /idr cli.
                    if not field /idr ok
                        return structNew loadNsRes: cli /curCli ok false mods l/bundledMod: :: errTokens field /idr errTokens ::
                        nop.
                    become /nsEntryToks wrapRoutineValueNodeIf2240 /subj true field /idr rawBytes /nsEntryToks.
                ::
                nop.
            be tup: b l/graphDeclItem ::/slUnp unpackGraphEntryTokens /subj /sid /nsEntryToks false true.
            if field /slUnp u32:0
                foreach graphDeclItem/it field /slUnp u32:1 do
                    be u128/slSid field /it subjId.
                    be u64/slBi u128Bucket64 /slSid.
                    be l/u128/slB match at /seenSlBuckets /slBi
                        case some l/u128/xs /xs.
                        case none l/u128: ::.
                    ::.
                    if not listContainsU128 /slB /slSid
                        do
                            hold buf/u128/slNb bufNew u128 wrapSum len /slB u64:1.
                            bufGainAll /slNb /slB.
                            bufGain /slNb /slSid.
                            match bufBecomeAt /seenSlBuckets /slBi bufFrozen /slNb
                                case ok nop.
                                case err error/_e nop.
                            ::.
                            bufGain /slItems /it.
                        ::
                        nop.
                ::
                nop.
            if /allowStager
                do
                    be tup: b l/graphDeclItem ::/srUnp unpackGraphEntryTokens /subj /sid /nsEntryToks true true.
                    if field /srUnp u32:0
                        foreach graphDeclItem/it field /srUnp u32:1 do
                            be u128/srSid field /it subjId.
                            be u64/srBi u128Bucket64 /srSid.
                            be l/u128/srB match at /seenSrBuckets /srBi
                                case some l/u128/xs /xs.
                                case none l/u128: ::.
                            ::.
                            if not listContainsU128 /srB /srSid
                                do
                                    hold buf/u128/srNb bufNew u128 wrapSum len /srB u64:1.
                                    bufGainAll /srNb /srB.
                                    bufGain /srNb /srSid.
                                    match bufBecomeAt /seenSrBuckets /srBi bufFrozen /srNb
                                        case ok nop.
                                        case err error/_e nop.
                                    ::.
                                    bufGain /srItems /it.
                                ::
                                nop.
                        ::
                        nop.
                ::
                nop.
        ::.
    ::.
    hold buf/bundledMod/modsOut bufNew bundledMod u64:2.
    be l/graphDeclItem/sortedSl sortGraphDeclItems bufFrozen /slItems.
    if gt len /sortedSl u64:0
        do
            hold buf/dc/uToks bufNew dc u64:16.
            hold buf/u128/locs bufNew u128 u64:16.
            hold buf/u128/refs bufNew u128 u64:32.
            hold l/l/u8/uKeys l/l/u8: ::.
            hold b/anyBuf false.
            foreach graphDeclItem/it /sortedSl do
                foreach l/u8/uk field /it useKeys do
                    become /uKeys appendUniqueU8Seq /uKeys /uk.
                ::.
                bufGainAll /uToks field /it useTokens.
                bufGainAll /locs field /it localDcs.
                bufGainAll /refs field /it refDcs.
                if field /it hasBuf
                    become /anyBuf true
                    nop.
            ::.
            be l/dc/dedupUses extractTopUseItems bufFrozen /uToks /nsKey.
            bufGain /modsOut structNew bundledMod: isStager false isCaller false wasPub true hasBuf /anyBuf isRealNs true isAnchor true synthDc u128:0 nsKey /nsKey nsSegs /segs useKeys /uKeys useTokens /dedupUses localDcs bufFrozen /locs refDcs bufFrozen /refs items /sortedSl tokens l/dc: :: ::.
        ::
        nop.
    be l/graphDeclItem/sortedSr sortGraphDeclItems bufFrozen /srItems.
    if gt len /sortedSr u64:0
        do
            hold buf/dc/uToks bufNew dc u64:16.
            hold buf/u128/locs bufNew u128 u64:16.
            hold buf/u128/refs bufNew u128 u64:32.
            hold l/l/u8/uKeys l/l/u8: ::.
            hold b/anyBuf false.
            foreach graphDeclItem/it /sortedSr do
                foreach l/u8/uk field /it useKeys do
                    become /uKeys appendUniqueU8Seq /uKeys /uk.
                ::.
                bufGainAll /uToks field /it useTokens.
                bufGainAll /locs field /it localDcs.
                bufGainAll /refs field /it refDcs.
                if field /it hasBuf
                    become /anyBuf true
                    nop.
            ::.
            be l/dc/dedupUses extractTopUseItems bufFrozen /uToks /nsKey.
            bufGain /modsOut structNew bundledMod: isStager true isCaller false wasPub true hasBuf /anyBuf isRealNs true isAnchor true synthDc u128:0 nsKey /nsKey nsSegs /segs useKeys /uKeys useTokens /dedupUses localDcs bufFrozen /locs refDcs bufFrozen /refs items /sortedSr tokens l/dc: :: ::.
        ::
        nop.
    structNew loadNsRes: cli /curCli ok true mods bufFrozen /modsOut errTokens l/dc: :: ::.

: @dc l8589992788
struct resolveNsSegsRes
    capClient/cli.
    b/ok.
    b/found.
    l/l/u8/segs.
    l/dc/errTokens.

: @dc l8589992874
v/resolveNsSegsRes/resolveEntityNamespace capClient/cli dc/subj
    hold capClient/curCli /cli.
    be capPropListRes/identQ queryMultiProperty /curCli /subj dc:574.
    become /curCli field /identQ cli.
    if not field /identQ ok
        return structNew resolveNsSegsRes: cli /curCli ok false found false segs l/l/u8: :: errTokens field /identQ errTokens ::
        nop.
    foreach propEntry/it field /identQ props do
        be capTripleListRes/ctxQ queryTriples /curCli true dc:646 true dcFromU128 field /it hasAId false dc:0.
        become /curCli field /ctxQ cli.
        if not field /ctxQ ok
            return structNew resolveNsSegsRes: cli /curCli ok false found false segs l/l/u8: :: errTokens field /ctxQ errTokens ::
            nop.
        foreach tripleRec/ct field /ctxQ triples do
