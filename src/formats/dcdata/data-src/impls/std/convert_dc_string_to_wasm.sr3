: ---------------------------------------------------------------------------
: 1. Pure Sequence, Framing & Error Helpers
: ---------------------------------------------------------------------------

: @dc l8589992791
v/capClient/emptyClient
    structNew capClient: cache l/capEntry: :: hasWatermark false watermark u128:0 ::.

: @dc l8589992792
v/dc/dcAtOr l/dc/xs u64/idx dc/fallback
    match get /xs /idx
        case some dc/c /c.
        case none /fallback.
    ::.

: @dc l8589992793
v/u8/u8AtOr l/u8/xs u64/idx u8/fallback
    match get /xs /idx
        case some u8/b /b.
        case none /fallback.
    ::.

: @dc l8589992794
v/l/dc/u8sToUnicodeDcs l/u8/bytes
    test
        in b"AB"
        out l/dc: dcFromU128 u128:65 dcFromU128 u128:66 ::.
    let buf/dc/out bufNew dc len /bytes.
    foreach u8/b /bytes do
        match dcFromUnicode conv /b u32
            case ok dc/c bufPush /out /c.
            case err error/_e nop.
        ::.
    ::.
    bufFreeze /out.

: @dc l8589992795
v/l/dc/errRecord l/u8/msg
    test
        in b"bad"
        out l/dc: dc:552 dc:u62 dc:u61 dc:u64 dc:553 ::.
    const l/dc/chars u8sToUnicodeDcs /msg.
    let buf/dc/out bufNew dc wrapAdd len /chars u64:4.
    bufPush /out dc:552.
    foreach dc/c /chars do
        if or eq /c dc:255 eq /c dc:553
            bufPush /out dc:255
            nop.
        bufPush /out /c.
    ::.
    bufPush /out dc:553.
    bufFreeze /out.

: @dc l8589992796
v/dcRes/failMsg l/u8/msg
    dcRes:err errRecord /msg.

: @dc l8589992797
v/b/isErrorRecord l/dc/tokens
    test
        in l/dc: dc:552 dc:u65 dc:553 ::
        out true.
    test
        in l/dc: dc:260 dc:261 ::
        out false.
    if lt len /tokens u64:2
        return false
        nop.
    eq dcAtOr /tokens u64:0 dc:0 dc:552.

: @dc l8589992798
v/b/dcListEq l/dc/a l/dc/b
    const u64/n len /a.
    if ne /n len /b
        return false
        nop.
    let u64/i u64:0.
    while lt /i /n do
        if ne dcAtOr /a /i dc:0 dcAtOr /b /i dc:0
            return false
            nop.
        set /i wrapAdd /i u64:1.
    ::.
    true.

: @dc l8589992799
v/b/u8ListEq l/u8/a l/u8/b
    const u64/n len /a.
    if ne /n len /b
        return false
        nop.
    let u64/i u64:0.
    while lt /i /n do
        if ne u8AtOr /a /i u8:0 u8AtOr /b /i u8:0
            return false
            nop.
        set /i wrapAdd /i u64:1.
    ::.
    true.

: @dc l8589992800
v/b/listContainsU128 l/u128/xs u128/target
    foreach u128/x /xs do
        if eq /x /target
            return true
            nop.
    ::.
    false.

: @dc l8589992801
v/l/u128/appendUniqueU128 l/u128/xs u128/x
    if listContainsU128 /xs /x
        return /xs
        nop.
    let buf/u128/out bufNew u128 wrapAdd len /xs u64:1.
    bufExtend /out /xs.
    bufPush /out /x.
    bufFreeze /out.

: @dc l8589992802
v/b/listContainsDc l/dc/xs dc/target
    foreach dc/c /xs do
        if eq /c /target
            return true
            nop.
    ::.
    false.

: @dc l8589992803
v/b/listContainsU8Seq l/l/u8/xs l/u8/target
    foreach l/u8/item /xs do
        if u8ListEq /item /target
            return true
            nop.
    ::.
    false.

: @dc l8589992804
v/b/isSysRegionId u128/id
    and ge /id u128:8589934592 le /id u128:12884901887.

: @dc l8589992805
v/b/isSingleLineCommentOpener dc/c
    or eq /c dc:246 eq /c dc:247.

: @dc l8589992806
v/b/isBlockCommentOpener dc/c
    or eq /c dc:249 eq /c dc:250.

: Skips leading single-line (`Dc 246`/`247`..`Dc 248`) and block
: (`Dc 249`/`250`..`Dc 251`) comment frames from `pos`.
: @dc l8589992807
v/u64/skipAllComments l/dc/tokens u64/pos
    test
        in l/dc: dc:247 dc:u65 dc:248 dc:249 dc:u66 dc:251 dc:1927 :: u64:0
        out u64:6.
    const u64/n len /tokens.
    let u64/i /pos.
    while lt /i /n do
        const dc/tok dcAtOr /tokens /i dc:0.
        let dc/closer dc:0.
        if isSingleLineCommentOpener /tok
            set /closer dc:248
            if isBlockCommentOpener /tok
                set /closer dc:251
                return /i.
        set /i wrapAdd /i u64:1.
        let b/closed false.
        while lt /i /n do
            const dc/inner dcAtOr /tokens /i dc:0.
            if eq /inner dc:255
                do
                    set /i wrapAdd /i u64:2.
                    if gt /i /n
                        set /i /n
                        nop.
                ::
                do
                    set /i wrapAdd /i u64:1.
                    if eq /inner /closer
                        do
                            set /closed true.
                            break.
                        ::
                        nop.
                ::.
        ::.
        if not /closed
            return /i
            nop.
    ::.
    /i.

: Skips leading comments in `tokens` and returns the remaining slice.
: @dc l8589992808
v/l/dc/stripLeadingComments l/dc/tokens
    const u64/p skipAllComments /tokens u64:0.
    match slice /tokens /p len /tokens
        case some l/dc/rest /rest.
        case none l/dc: ::.
    ::.

: @dc l8589992809
v/b/isAsciiLowerEq u8/a u8/b
    let u8/la /a.
    if and ge /la u8:65 le /la u8:90
        set /la wrapAdd /la u8:32
        nop.
    let u8/lb /b.
    if and ge /lb u8:65 le /lb u8:90
        set /lb wrapAdd /lb u8:32
        nop.
    eq /la /lb.

: Checks whether Unicode Dcs encode `.Formats:transformation` (after trimming
: optional ASCII whitespace and `.Formats:`/`Formats:`/`format_` prefix).
: @dc l8589992810
v/b/isTransformationCategoryDcs l/dc/chars
    test
        in l/dc: dc:u2e dc:u46 dc:u6f dc:u72 dc:u6d dc:u61 dc:u74 dc:u73 dc:u3a dc:u74 dc:u72 dc:u61 dc:u6e dc:u73 dc:u66 dc:u6f dc:u72 dc:u6d dc:u61 dc:u74 dc:u69 dc:u6f dc:u6e ::
        out true.
    test
        in l/dc: dc:u6f dc:u74 dc:u68 dc:u65 dc:u72 ::
        out false.
    let buf/u8/raw bufNew u8 len /chars.
    foreach dc/c /chars do
        const u128/u u128FromDc /c.
        if gt /u u128:127
            return false
            nop.
        match conv /u u8
            case ok u8/b bufPush /raw /b.
            case err error/_e return false.
        ::.
    ::.
    const l/u8/bytes bufFreeze /raw.
    let u64/s u64:0.
    let u64/e len /bytes.
    while lt /s /e do
        const u8/b u8AtOr /bytes /s u8:0.
        if or eq /b u8:32 or eq /b u8:9 or eq /b u8:10 eq /b u8:13
            set /s wrapAdd /s u64:1
            break.
    ::.
    while gt /e /s do
        const u64/prev wrapSub /e u64:1.
        const u8/b u8AtOr /bytes /prev u8:0.
        if or eq /b u8:32 or eq /b u8:9 or eq /b u8:10 eq /b u8:13
            set /e /prev
            break.
    ::.
    const l/u8/trimmed match slice /bytes /s /e
        case some l/u8/sl /sl.
        case none return false.
    ::.
    const u64/tlen len /trimmed.
    const l/u8/p1 b".Formats:".
    const l/u8/p2 b"Formats:".
    const l/u8/p3 b"format_".
    let u64/off u64:0.
    if ge /tlen len /p1
        do
            const b/m match slice /trimmed u64:0 len /p1
                case some l/u8/hd u8ListEq /hd /p1.
                case none false.
            ::.
            if /m
                set /off len /p1
                nop.
        ::
        nop.
    if and eq /off u64:0 ge /tlen len /p2
        do
            const b/m match slice /trimmed u64:0 len /p2
                case some l/u8/hd u8ListEq /hd /p2.
                case none false.
            ::.
            if /m
                set /off len /p2
                nop.
        ::
        nop.
    if and eq /off u64:0 ge /tlen len /p3
        do
            const b/m match slice /trimmed u64:0 len /p3
                case some l/u8/hd u8ListEq /hd /p3.
                case none false.
            ::.
            if /m
                set /off len /p3
                nop.
        ::
        nop.
    const l/u8/want b"transformation".
    if ne wrapSub /tlen /off len /want
        return false
        nop.
    let u64/i u64:0.
    while lt /i len /want do
        if not isAsciiLowerEq u8AtOr /trimmed wrapAdd /off /i u8:0 u8AtOr /want /i u8:0
            return false
            nop.
        set /i wrapAdd /i u64:1.
    ::.
    true.

: @dc l8589992811
v/strStepRes/readStringLiteralAt l/dc/tokens u64/pos
    test
        in l/dc: dc:260 dc:262 dc:264 dc:263 dc:u65 dc:255 dc:261 dc:261 :: u64:0
        out strStepRes:ok structNew strStep: payload l/dc: dc:u65 dc:261 :: nextPos u64:8 ::.
    test
        in l/dc: dc:260 dc:u66 dc:261 :: u64:0
        out strStepRes:ok structNew strStep: payload l/dc: dc:u66 :: nextPos u64:3 ::.
    const u64/n len /tokens.
    if ge /pos /n
        return strStepRes:err errRecord b"ConvertDcStringToWasm requires a [string] literal argument"
        nop.
    if ne dcAtOr /tokens /pos dc:0 dc:260
        return strStepRes:err errRecord b"Expected Dc 260 opening [string] literal"
        nop.
    const u64/p1 wrapAdd /pos u64:1.
    if and lt wrapAdd /pos u64:4 /n eq dcAtOr /tokens /p1 dc:0 dc:262
        do
            const tup: b dc l/dc u64 ::/lit readEscapedLiteral /tokens /pos.
            if or not field /lit u32:0 ne field /lit u32:1 dc:264
                return strStepRes:err errRecord b"Malformed typed [string] literal argument"
                nop.
            return strStepRes:ok structNew strStep: payload field /lit u32:2 nextPos field /lit u32:3 ::
        ::
        nop.
    let buf/dc/out bufNew dc u64:32.
    let u64/i /p1.
    let b/closed false.
    while lt /i /n do
        const dc/ch dcAtOr /tokens /i dc:0.
        if eq /ch dc:261
            do
                set /i wrapAdd /i u64:1.
                set /closed true.
                break.
            ::
            nop.
        if eq /ch dc:255
            do
                const u64/ni wrapAdd /i u64:1.
                if ge /ni /n
                    return strStepRes:err errRecord b"Dangling Dc 255 escape in [string] literal"
                    nop.
                bufPush /out dcAtOr /tokens /ni dc:0.
                set /i wrapAdd /ni u64:1.
            ::
            do
                bufPush /out /ch.
                set /i wrapAdd /i u64:1.
            ::.
    ::.
    if not /closed
        return strStepRes:err errRecord b"Unclosed [string] literal argument"
        nop.
    strStepRes:ok structNew strStep: payload bufFreeze /out nextPos /i ::.

: @dc l8589992812
v/b/isClosedStringLiteralNode l/dc/tokens
    test
        in l/dc: dc:260 dc:262 dc:264 dc:263 dc:u65 dc:261 ::
        out true.
    test
        in l/dc: dc:260 dc:261 dc:260 ::
        out false.
    const u64/n len /tokens.
    if lt /n u64:2
        return false
        nop.
    if ne dcAtOr /tokens u64:0 dc:0 dc:260
        return false
        nop.
    let u64/i u64:1.
    while lt /i /n do
        const dc/c dcAtOr /tokens /i dc:0.
        if eq /c dc:255
            do
                set /i wrapAdd /i u64:2.
                if gt /i /n
                    return false
                    nop.
            ::
            if eq /c dc:261
                return eq wrapAdd /i u64:1 /n
                set /i wrapAdd /i u64:1.
    ::.
    false.

: @dc l8589992813
v/b/isLegacyUnicodeRunNode l/dc/tokens
    if eq len /tokens u64:0
        return false
        nop.
    foreach dc/c /tokens do
        if gt u128FromDc /c u128:1114111
            return false
            nop.
    ::.
    true.

: @dc l8589992814
v/b/isRoutineNamedConstruct l/dc/tokens
    const u64/n len /tokens.
    if lt /n u64:6
        return false
        nop.
    if or ne dcAtOr /tokens u64:0 dc:0 dc:260 or ne dcAtOr /tokens u64:1 dc:0 dc:262 or ne dcAtOr /tokens u64:2 dc:0 dc:280 ne dcAtOr /tokens u64:3 dc:0 dc:263
        return false
        nop.
    let u64/i u64:4.
    while lt /i /n do
        const dc/c dcAtOr /tokens /i dc:0.
        if eq /c dc:261
            return eq wrapAdd /i u64:1 /n
            nop.
        set /i wrapAdd /i u64:1.
    ::.
    false.

: @dc l8589992815
v/b/isBuiltInWasmOrSyntaxShortId u128/sid
    if and ge /sid u128:647 le /sid u128:1937
        return true
        nop.
    or eq /sid u128:256 or eq /sid u128:260 or eq /sid u128:268 or eq /sid u128:276 or eq /sid u128:279 or eq /sid u128:307 or eq /sid u128:540 or eq /sid u128:541 or eq /sid u128:584 or eq /sid u128:585 or eq /sid u128:610 or eq /sid u128:616 eq /sid u128:638.

: @dc l8589993365
v/b/isBuiltInWasmOrSyntaxFormatId u128/fid
    or eq /fid u128:199
        or eq /fid u128:203
            or and ge /fid u128:207 le /fid u128:212
                or eq /fid u128:214
                    or eq /fid u128:215
                        or eq /fid u128:1424
                            or eq /fid u128:1425
                                eq /fid u128:1426.

: @dc l8589992816
v/b/isStageLBuiltinOpDc dc/c
    const u128/u u128FromDc /c.
    if lt /u u128:1114112
        return false
        nop.
    const u128/sid wrapSub /u u128:1114112.
    or and ge /sid u128:2512 le /sid u128:2546 or and ge /sid u128:2580 le /sid u128:2585 eq /sid u128:2616.

: @dc l8589992817
v/optU128Step/parsePinDescriptionAt l/dc/tokens u64/pos
    test
        in l/dc: dc:641 dcFromU128 u128:8589934592 :: u64:0
        out optU128Step:some structNew u128Step: val u128:8589934592 nextPos u64:2 ::.
    test
        in l/dc: dc:641 dc:255 dcFromU128 u128:8589934592 :: u64:0
        out optU128Step:some structNew u128Step: val u128:8589934592 nextPos u64:3 ::.
    const u64/n len /tokens.
    if ge /pos /n
        return optU128Step:none
        nop.
    if ne dcAtOr /tokens /pos dc:0 dc:641
        return optU128Step:none
        nop.
    const u64/p1 wrapAdd /pos u64:1.
    if ge /p1 /n
        return optU128Step:err errRecord b"Missing System-block node ID operand after Dc 641"
        nop.
    const dc/tok1 dcAtOr /tokens /p1 dc:0.
    let u128/pinId u128:0.
    let u64/nextP wrapAdd /p1 u64:1.
    if eq /tok1 dc:255
        do
            const u64/p2 wrapAdd /p1 u64:1.
            if ge /p2 /n
                return optU128Step:err errRecord b"Dangling escape in Dc 641 pin_description"
                nop.
            set /pinId u128FromDc dcAtOr /tokens /p2 dc:0.
            set /nextP wrapAdd /p2 u64:1.
        ::
        do
            if or eq /tok1 dc:203 eq /tok1 dc:616
                return optU128Step:err errRecord b"Invalid unescaped non-atomic token in Dc 641 pin_description"
                nop.
            set /pinId u128FromDc /tok1.
        ::.
    if not isSysRegionId /pinId
        return optU128Step:err errRecord b"Invalid System-block most recent node ID in Dc 641 pin_description"
        nop.
    optU128Step:some structNew u128Step: val /pinId nextPos /nextP ::.

: ---------------------------------------------------------------------------
: 2. Memoized Dc 1939 & Dc 1940 Capability Client
: ---------------------------------------------------------------------------

: @dc l8589992818
v/l/dc/encodeCapAtom l/dc/outPrefix dc/c b/escapeWildcard
    let buf/dc/out bufNew dc wrapAdd len /outPrefix u64:2.
    bufExtend /out /outPrefix.
    if or eq /c dc:203 or eq /c dc:255 or eq /c dc:616 and /escapeWildcard eq /c dc:600
        bufPush /out dc:255
        nop.
    bufPush /out /c.
    bufFreeze /out.

: @dc l8589992819
v/capAtomStep/consumeCapAtom l/dc/tokens u64/pos
    const dc/first dcAtOr /tokens /pos dc:0.
    if eq /first dc:255
        do
            const u64/p1 wrapAdd /pos u64:1.
            if ge /p1 len /tokens
                return structNew capAtomStep: ch dc:0 escaped true nextPos len /tokens ::
                nop.
            return structNew capAtomStep: ch dcAtOr /tokens /p1 dc:0 escaped true nextPos wrapAdd /p1 u64:1 ::
        ::
        nop.
    structNew capAtomStep: ch /first escaped false nextPos wrapAdd /pos u64:1 ::.

: @dc l8589992820
v/option/l/dc/lookupCapCache l/capEntry/cache l/dc/req
    foreach capEntry/entry /cache do
        if dcListEq field /entry req /req
            return option/l/dc:some field /entry resp
            nop.
    ::.
    option/l/dc:none.

: @dc l8589992821
v/l/capEntry/insertCapCache l/capEntry/cache l/dc/req l/dc/resp
    let buf/capEntry/out bufNew capEntry wrapAdd len /cache u64:1.
    bufExtend /out /cache.
    bufPush /out structNew capEntry: req /req resp /resp ::.
    bufFreeze /out.

: @dc l8589992822
v/capCallRes/capCallCached capClient/cli l/dc/req
    match lookupCapCache field /cli cache /req
        case some l/dc/resp
            return structNew capCallRes: cli /cli ok true payload /resp ::
        case none
            match requestCapability dcsFromList /req
                case err error/_e
                    return structNew capCallRes: cli /cli ok false payload errRecord b"Host capability invocation failed" ::
                case ok dcs/rawResp
                    do
                        const l/dc/resp dcsToList /rawResp.
                        if isErrorRecord /resp
                            return structNew capCallRes: cli /cli ok false payload /resp ::
                            nop.
                        const capClient/nextCli with /cli cache insertCapCache field /cli cache /req /resp.
                        return structNew capCallRes: cli /nextCli ok true payload /resp ::
                    ::
            ::
    ::.

: @dc l8589992823
v/capCallRes/capCallUncached capClient/cli l/dc/req
    match requestCapability dcsFromList /req
        case err error/_e
