        nop.
    set /pos skipAllComments /inputTokens wrapAdd /pos u64:1.
    if ge /pos len /inputTokens
        return failMsg b"ConvertDcStringToWasm requires a [string] argument"
        nop.
    let b/hasParamWrap false.
    if eq dcAtOr /inputTokens /pos dc:0 dc:258
        do
            set /hasParamWrap true.
            set /pos skipAllComments /inputTokens wrapAdd /pos u64:1.
        ::
        nop.
    let l/dc/argTokens /inputTokens.
    let u64/argPos /pos.
    const dc/argHead dcAtOr /inputTokens /pos dc:0.
