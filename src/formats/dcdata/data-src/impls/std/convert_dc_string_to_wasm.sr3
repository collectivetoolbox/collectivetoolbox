    if not isValidRoutineIdentAscii /finalIdent
        do
            hold buf/u8/fb bufNew u8 u64:24.
            bufGainAll /fb b"__dc_".
            bufGainAll /fb formatDcShorthandAscii /subj.
            become /finalIdent bufFrozen /fb.
