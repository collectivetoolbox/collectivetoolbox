            bufGain /out u8:102.
            bufGainAll /out formatDecimalU128 wrapDiff /u u128:2228224.
            return bufFrozen /out
        ::
        nop.
    if ge /u u128:1114112
        return formatDecimalU128 wrapDiff /u u128:1114112
        nop.
    hold buf/u8/out bufNew u8 u64:12.
    bufGain /out u8:117.
    bufGainAll /out formatDecimalU128 /u.
    bufFrozen /out.

