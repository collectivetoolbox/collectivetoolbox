            ::
            nop.
        : `Dc 256` (`void lang.say([string] text)`): graph WASM definition takes precedence if present in snapshot.
        be capBoolRes/isSay docTokMatchesRole /curCli /tok dc:256.
        become /curCli field /isSay cli.
        if not field /isSay ok
            return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /isSay errTokens ::
            nop.
        if field /isSay val
            do
                be wasmDecompRes/sayWasm resolveWasmDecomp /curCli /tok.
                become /curCli field /sayWasm cli.
                if eq field /sayWasm tag u8:2
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /sayWasm payload ::
                    nop.
                be docValStepRes/sayRes evalLangSayCallAt /curCli /tokens /pos /env.
                become /curCli field /sayRes cli.
                if not field /sayRes ok
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /sayRes errTokens ::
                    nop.
                if eq field /sayWasm tag u8:1
                    match slice /tokens /pos field /sayRes nextPos
                        case some l/dc/callSlice
                            do
                                be capCallRes/wRes if field /sayWasm hasRawWasm
                                    execPureWasmBytesStep /curCli field /sayWasm rawWasmBytes /callSlice
                                    execPureWasmStep /curCli field /sayWasm payload /callSlice.
                                become /curCli field /wRes cli.
                                if not field /wRes ok
                                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /wRes payload ::
                                    nop.
                                bufGainAll /out field /wRes payload.
                                become /pos field /sayRes nextPos.
                                continue.
                            ::.
                        case none nop.
                    ::
                    nop.
                bufGainAll /out field /sayRes valTokens.
                become /pos field /sayRes nextPos.
                continue.
            ::
            nop.
        : `Dc 540` / `Dc 276` / `Dc 397` / `Dc 561` in stream position.
        be capBoolRes/isRef540 docTokMatchesRole /curCli /tok dc:540.
        become /curCli field /isRef540 cli.
        if not field /isRef540 ok
            return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /isRef540 errTokens ::
            nop.
        hold b/isStreamExpr field /isRef540 val.
        if not /isStreamExpr
            do
                be capBoolRes/isRef276 docTokMatchesRole /curCli /tok dc:276.
                become /curCli field /isRef276 cli.
                if not field /isRef276 ok
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /isRef276 errTokens ::
                    nop.
                become /isStreamExpr field /isRef276 val.
            ::
            nop.
        if not /isStreamExpr
            do
                be capBoolRes/isRep397 docTokMatchesRole /curCli /tok dc:397.
                become /curCli field /isRep397 cli.
                if not field /isRep397 ok
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /isRep397 errTokens ::
                    nop.
                become /isStreamExpr field /isRep397 val.
            ::
            nop.
        if not /isStreamExpr
            do
                be capBoolRes/isRep561 docTokMatchesRole /curCli /tok dc:561.
                become /curCli field /isRep561 cli.
                if not field /isRep561 ok
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /isRep561 errTokens ::
                    nop.
                become /isStreamExpr field /isRep561 val.
            ::
            nop.
        if /isStreamExpr
            do
                be docValStepRes/ev evalDocValueExprAt /curCli /tokens /pos /env false.
                become /curCli field /ev cli.
                if not field /ev ok
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens field /ev errTokens ::
                    nop.
                match readStringLiteralAt field /ev valTokens u64:0
                    case ok strStep/st
                        if eq field /st nextPos len field /ev valTokens
                            bufGainAll /out field /st payload
                            bufGainAll /out field /ev valTokens.
                    case err l/dc/_e
                        bufGainAll /out field /ev valTokens.
                ::.
                become /pos field /ev nextPos.
                continue.
            ::
            nop.
        : Quoted framed literal (`Dc 260..Dc 261`, `Dc 6..Dc 7`, `Dc 203..Dc 204`) copied verbatim without executing interior tokens.
        if or eq /sid u32:260 or eq /sid u32:6 eq /sid u32:203
            match scanFramedValueEnd /tokens /pos
                case some u128Step/fs
                    do
                        match slice /tokens /pos field /fs nextPos
                            case some l/dc/litSlice bufGainAll /out /litSlice.
                            case none nop.
                        ::.
                        become /pos field /fs nextPos.
                        continue.
                    ::.
                case err l/dc/e
                    return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens /e ::.
                case none nop.
            ::
            nop.
        : Ordinary semantic/character Dc emitted directly into evaluated document stream.
        bufGain /out /tok.
        become /pos wrapSum /pos u64:1.
    ::.
    if and /expectCloser not /foundCloser
        return structNew docStreamRes: cli /curCli ok false outTokens l/dc: :: env /env nextPos /pos errTokens errRecord b"Unclosed Dc 235 or Dc 541 scope container in Dc document" ::
        nop.
    structNew docStreamRes: cli /curCli ok true outTokens bufFrozen /out env /env nextPos /pos errTokens l/dc: :: ::.

: @dc l8589992882
v/dcRes/runConvertDcStringToWasm l/dc/inputTokens
    hold capClient/cli emptyClient.

    : 1. Parse call prefix `[Dc 2608, <parameter?> [string]]`.
    hold u64/pos skipAllComments /inputTokens u64:0.
    if ge /pos len /inputTokens
        return failMsg b"Empty ConvertDcStringToWasm invocation"
        nop.
    be dc/headDc dcAtOr /inputTokens /pos dc:0.
    be capBoolRes/headOk dcIsEquiv /cli /headDc dc:2608.
    become /cli field /headOk cli.
    if not field /headOk ok
        return dcRes:err field /headOk errTokens
        nop.
    if not field /headOk val
        return failMsg b"ConvertDcStringToWasm call must begin with Dc 2608"
        nop.
    become /pos skipAllComments /inputTokens wrapSum /pos u64:1.
    if ge /pos len /inputTokens
        return failMsg b"ConvertDcStringToWasm requires a [string] argument"
        nop.
    hold b/hasParamWrap false.
    if eq dcAtOr /inputTokens /pos dc:0 dc:258
        do
            become /hasParamWrap true.
            become /pos skipAllComments /inputTokens wrapSum /pos u64:1.
        ::
        nop.
    hold l/dc/argTokens /inputTokens.
    hold u64/argPos /pos.
    be dc/argHead dcAtOr /inputTokens /pos dc:0.
    if isSysRegionDc /argHead
        do
            be capOptNodeRes/argNr queryNodeExpanded /cli u128FromDc /argHead.
            become /cli field /argNr cli.
            if eq field /argNr tag u8:2
                return dcRes:err field /argNr payload
                nop.
            if and eq field /argNr tag u8:1 isClosedStringLiteralNode field /argNr payload
                do
                    become /argTokens field /argNr payload.
                    become /argPos u64:0.
                    become /pos skipAllComments /inputTokens wrapSum /pos u64:1.
                ::
                nop.
        ::
        nop.
    be strStepRes/litRes readStringLiteralAt /argTokens /argPos.
    hold l/dc/rawTarget match /litRes
        case ok strStep/st
            do
                if eq /argPos u64:0
                    nop
                    become /pos skipAllComments /inputTokens field /st nextPos.
                field /st payload.
            ::
        case err l/dc/e return dcRes:err /e.
    ::.
    if /hasParamWrap
        do
            if or ge /pos len /inputTokens ne dcAtOr /inputTokens /pos dc:0 dc:259
                return failMsg b"Unclosed Dc 258..Dc 259 parameter container in ConvertDcStringToWasm"
                nop.
            become /pos skipAllComments /inputTokens wrapSum /pos u64:1.
        ::
        nop.
    if ne /pos len /inputTokens
        return failMsg b"Unexpected trailing tokens after ConvertDcStringToWasm [string] argument"
        nop.
    if and eq len /rawTarget u64:1 isSysRegionDc dcAtOr /rawTarget u64:0 dc:0
        do
            be u128/soleU u128FromDc dcAtOr /rawTarget u64:0 dc:0.
            be capOptNodeRes/soleNr queryNodeRaw /cli /soleU.
            become /cli field /soleNr cli.
            if eq field /soleNr tag u8:2
                return dcRes:err field /soleNr payload
                nop.
            if eq field /soleNr tag u8:1
                do
                    be l/dc/soleToks field /soleNr payload.
                    be u32/ss0 dcShortId dcAtOr /soleToks u64:0 /dcZero.
                    be b/soleIsStmt or and ge /ss0 u32:584 le /ss0 u32:593 or eq /ss0 u32:610 or eq /ss0 u32:627 or eq /ss0 u32:638 or eq /ss0 u32:645 eq /ss0 u32:646.
                    if and gt len /soleToks u64:0 and not /soleIsStmt not tokensStartWasmDefinition /soleToks
                        become /rawTarget /soleToks
                        nop.
                ::
                nop.
        ::
        nop.
    if hasAnySysRegionToken /rawTarget
        do
            be capOptNodeRes/expTgt expandInternedNodesInner /cli /rawTarget l/u128: ::.
            become /cli field /expTgt cli.
            if eq field /expTgt tag u8:2
                return dcRes:err field /expTgt payload
                nop.
            become /rawTarget field /expTgt payload.
        ::
        nop.

    : 2. Strip leading comments in unescaped target document & handle inner `Dc 641` pin.
    hold l/dc/body stripLeadingComments /rawTarget.
    if eq len /body u64:0
        return failMsg b"ConvertDcStringToWasm target document contains no executable tokens"
        nop.
    be dc/bodyFirst dcAtOr /body u64:0 dc:0.
    hold b/startsWithPin eq /bodyFirst dc:641.
    if and not /startsWithPin lt u128FromDc /bodyFirst u128:8589934592
        do
            be capBoolRes/pe dcIsEquiv /cli /bodyFirst dc:641.
            become /cli field /pe cli.
            if not field /pe ok
                return dcRes:err field /pe errTokens
                nop.
            become /startsWithPin field /pe val.
        ::
        nop.
    if /startsWithPin
        do
            : Normalize head Dc 641 if an equivalent alias was used before `parsePinDescriptionAt`.
            hold buf/dc/pinCheck bufNew dc len /body.
            bufGain /pinCheck dc:641.
            match slice /body u64:1 len /body
                case some l/dc/rest bufGainAll /pinCheck /rest.
                case none nop.
            ::.
            be l/dc/normPinBody bufFrozen /pinCheck.
            match parsePinDescriptionAt /normPinBody u64:0
                case some u128Step/ps
                    do
                        be capU128ListRes/wmRes queryWatermark /cli.
                        become /cli field /wmRes cli.
                        if not field /wmRes ok
                            return dcRes:err field /wmRes errTokens
                            nop.
                        match at field /wmRes ids u64:0
                            case some u128/wm
                                if gt field /ps val /wm
                                    return failMsg b"Inner document Dc 641 pin exceeds active pinned System graph snapshot"
                                    nop
                            case none nop.
                        ::.
                        become /body match slice /body field /ps nextPos len /body
                            case some l/dc/after stripLeadingComments /after.
                            case none l/dc: ::.
                        ::.
                    ::
                case none return failMsg b"Invalid leading [pin_description] inside target Dc document".
                case err l/dc/e return dcRes:err /e.
            ::.
            if eq len /body u64:0
                return failMsg b"Target Dc document contains only a pin_description and no body"
                nop.
        ::
        nop.

    be dc/firstBody dcAtOr /body u64:0 dc:0.

    : 3. Fast Path 1: already Dc-WASM program (`1927..1928`) or `[Routine]`.
    if or eq /firstBody dc:1927 isRoutineNamedConstruct /body
        do
            be capCallRes/exp expandWasmTokens /cli /body.
            if not field /exp ok
                return dcRes:err field /exp payload
                nop.
            return dcRes:ok field /exp payload
        ::
        nop.

    : 4. Fast Path 2: single-token WASM helper shorthand (e.g. `Dc 1936`).
    if eq len /body u64:1
        do
            be capOptNodeRes/hd decodeWasmDecompTokens resolveWasmDecomp /cli /firstBody.
            become /cli field /hd cli.
            if eq field /hd tag u8:2
                return dcRes:err field /hd payload
                nop.
            if eq field /hd tag u8:1
                do
                    be capCallRes/exp expandWasmTokens /cli field /hd payload.
                    if not field /exp ok
                        return dcRes:err field /exp payload
                        nop.
                    return dcRes:ok field /exp payload
                ::
                nop.
        ::
        nop.

    : Compute equivalence class of `firstBody` once for both `Dc 1927` alias check and BFS.
    be capU128ListRes/srcEqRes collectEquivClass /cli /firstBody.
    become /cli field /srcEqRes cli.
    if not field /srcEqRes ok
        return dcRes:err field /srcEqRes errTokens
        nop.
    be l/u128/srcEqIds field /srcEqRes ids.
    if listContainsU128 /srcEqIds /u128Dc1927
        do
            be capCallRes/exp expandWasmTokens /cli /body.
            if not field /exp ok
                return dcRes:err field /exp payload
                nop.
            return dcRes:ok field /exp payload
        ::
        nop.

    : 5. Fast direct 1-hop converter lookup before full-graph BFS (`listAllActiveConverterSteps`).
    be capU128ListRes/wmChk queryWatermark /cli.
    become /cli field /wmChk cli.
    if not field /wmChk ok
        return dcRes:err field /wmChk errTokens
        nop.
    if eq len field /wmChk ids u64:0
        return failMsg b"ConvertDcStringToWasm requires a non-empty System graph snapshot"
        nop.
    hold b/canHaveConverter false.
    foreach u128/eqId /srcEqIds do
        if ge /eqId /u128ShortBase
            become /canHaveConverter true
            nop.
    ::.
    hold l/convStep/chain l/convStep: ::.
    hold l/convStep/allStepsPool l/convStep: ::.
    if /canHaveConverter
        do
            be convListRes/directRes findDirectOneHopConverter /cli /srcEqIds dc:1927.
            become /cli field /directRes cli.
            if not field /directRes ok
                return dcRes:err field /directRes errTokens
                nop.
            become /chain field /directRes steps.
            if eq len /chain u64:0
                do
                    be convListRes/stepsRes listAllActiveConverterSteps /cli.
                    become /cli field /stepsRes cli.
                    if not field /stepsRes ok
                        return dcRes:err field /stepsRes errTokens
                        nop.
                    become /allStepsPool field /stepsRes steps.
                    be convListRes/chainRes findShortestConverterChain /cli /allStepsPool /srcEqIds dc:1927.
                    become /cli field /chainRes cli.
                    if not field /chainRes ok
                        return dcRes:err field /chainRes errTokens
                        nop.
                    become /chain field /chainRes steps.
                ::
                nop.
        ::
        nop.
    if eq len /chain u64:0
        do
            be docStreamRes/docEval evalDeclarativeDocRange /cli /body u64:0 false /dcZero u64:0 l/docBinding: ::.
            become /cli field /docEval cli.
            if not field /docEval ok
                return dcRes:err field /docEval errTokens
                nop.
            return dcRes:ok buildStaticOutputWasmProgram field /docEval outTokens
        ::
        nop.

    : 6. Execute each converter step in the resolved chain via `Dc 1940`.
    hold l/dc/curTokens /body.
    foreach convStep/step /chain do
        be l/dc/stripped stripLeadingComments /curTokens.
        be u32/curHeadSid dcShortId dcAtOr /stripped u64:0 /dcZero.
        be b/isWasmDst eq dcShortId field /step dst u32:1927.
        be b/isStagelInput eq /curHeadSid u32:2192.
        be b/isStagerSrc eq dcShortId field /step src u32:2221.
        be b/isStagerInput or eq /curHeadSid u32:2221 eq /curHeadSid u32:2192.
        hold l/dc/hopInput /curTokens.
        if and /isWasmDst /isStagelInput
            do
                be capCallRes/bun bundleDcModuleDeps /cli /curTokens false.
                become /cli field /bun cli.
                if not field /bun ok
                    return dcRes:err field /bun payload
                    nop.
                be capCallRes/kv prependStage0KvMap /cli field /bun payload.
                become /cli field /kv cli.
                if not field /kv ok
                    return dcRes:err field /kv payload
                    nop.
                become /hopInput field /kv payload.
            ::
            if and /isStagerSrc /isStagerInput
                do
                    be capCallRes/bun bundleDcModuleDeps /cli /curTokens true.
                    become /cli field /bun cli.
                    if not field /bun ok
                        return dcRes:err field /bun payload
                        nop.
                    become /hopInput field /bun payload.
                ::
                nop.

        if eq field /step kind u8:0
            do
                be capCallRes/execRes if field /step hasRawWasm
                    execPureWasmBytesStep /cli field /step rawWasmBytes /hopInput
                    execPureWasmStep /cli field /step bodyTokens /hopInput.
                become /cli field /execRes cli.
                if not field /execRes ok
                    return dcRes:err field /execRes payload
                    nop.
                become /curTokens field /execRes payload.
            ::
            do
                : StageL converter step: locate active `2192 -> 1927` WASM converter (`f1680`),
                : compile the `step` adapter module to `.WASM`, and execute on `/hopInput`.
                hold b/hasS2W false.
                hold b/hasS2wRaw false.
                hold l/dc/s2wProg l/dc: ::.
                hold l/u8/s2wRawBytes b"".
                foreach convStep/cs /chain do
                    if and eq field /cs kind u8:0 and field /cs bodyLoaded and eq dcShortId field /cs src u32:2192 eq dcShortId field /cs dst u32:1927
                        do
                            become /hasS2W true.
                            become /hasS2wRaw field /cs hasRawWasm.
                            become /s2wProg field /cs bodyTokens.
                            become /s2wRawBytes field /cs rawWasmBytes.
                            break.
                        ::
                        nop.
                ::.
                if not /hasS2W
                    do
                        if eq len /allStepsPool u64:0
                            do
                                be convListRes/s2wSteps listAllActiveConverterSteps /cli.
                                become /cli field /s2wSteps cli.
                                if not field /s2wSteps ok
                                    return dcRes:err field /s2wSteps errTokens
                                    nop.
                                become /allStepsPool field /s2wSteps steps.
                            ::
                            nop.
                        foreach convStep/cs /allStepsPool do
                            if and eq dcShortId field /cs src u32:2192 eq dcShortId field /cs dst u32:1927
                                do
                                    be wasmDecompRes/wb resolveWasmDecomp /cli field /cs subj.
                                    become /cli field /wb cli.
                                    if eq field /wb tag u8:2
                                        return dcRes:err field /wb payload
                                        nop.
                                    if eq field /wb tag u8:1
                                        do
                                            become /hasS2W true.
                                            become /hasS2wRaw field /wb hasRawWasm.
                                            become /s2wProg field /wb payload.
                                            become /s2wRawBytes field /wb rawWasmBytes.
                                            break.
                                        ::
                                        nop.
                                ::
                                nop.
                        ::.
                    ::
                    nop.
                if not /hasS2W
                    return failMsg b"No active StageL-to-WASM converter found in System graph snapshot"
                    nop.
                be l/dc/entryMod buildStageLConverterEntryModule field /step subj.
                be capCallRes/eBun bundleDcModuleDeps /cli /entryMod false.
                become /cli field /eBun cli.
                if not field /eBun ok
                    return dcRes:err field /eBun payload
                    nop.
                be capCallRes/eKv prependStage0KvMap /cli field /eBun payload.
                become /cli field /eKv cli.
                if not field /eKv ok
                    return dcRes:err field /eKv payload
                    nop.
                be capRawBytesRes/compRaw if /hasS2wRaw
                    execPureWasmBytesToRawBytes /cli /s2wRawBytes field /eKv payload
                    execPureWasmToRawBytes /cli /s2wProg field /eKv payload.
                become /cli field /compRaw cli.
                if not field /compRaw ok
                    return dcRes:err field /compRaw errTokens
                    nop.
                be capCallRes/runRes execPureWasmBytesStep /cli field /compRaw rawBytes /hopInput.
                become /cli field /runRes cli.
                if not field /runRes ok
                    return dcRes:err field /runRes payload
                    nop.
                become /curTokens field /runRes payload.
            ::.
    ::.

    : 7. Validate final converter output (`Dc 1927..Dc 1928` or `[Routine]`) and expand helpers.
    be u64/cn len /curTokens.
    be b/validFinalWasm or and ge /cn u64:2 and eq dcAtOr /curTokens u64:0 dc:0 dc:1927 eq dcAtOr /curTokens wrapDiff /cn u64:1 dc:0 dc:1928 isRoutineNamedConstruct /curTokens.
    if not /validFinalWasm
        return failMsg b"Converter chain did not emit a valid Dc-WASM program (Dc 1927..Dc 1928)"
        nop.
    be capCallRes/finalExp expandWasmTokens /cli /curTokens.
    if not field /finalExp ok
        return dcRes:err field /finalExp payload
        nop.
    dcRes:ok field /finalExp payload.

pub dc/2608 v/dcs/convertDcStringToWasm dcs/input
    match runConvertDcStringToWasm dcsToList /input
        case ok l/dc/toks dcsFromList /toks.
        case err l/dc/e dcsFromList /e.
    ::.
