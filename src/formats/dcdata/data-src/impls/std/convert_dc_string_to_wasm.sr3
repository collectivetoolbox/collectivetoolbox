            set /cli field /argNr cli.
            if eq field /argNr tag u8:2
                return dcRes:err field /argNr payload
                nop.
            if and eq field /argNr tag u8:1 isClosedStringLiteralNode field /argNr payload
                do
                    set /argTokens field /argNr payload.
                    set /argPos u64:0.
                    set /pos skipAllComments /inputTokens wrapAdd /pos u64:1.
                ::
                nop.
        ::
        nop.
    const strStepRes/litRes readStringLiteralAt /argTokens /argPos.
    let l/dc/rawTarget match /litRes
        case ok strStep/st
            do
                if eq /argPos u64:0
                    nop
                    set /pos skipAllComments /inputTokens field /st nextPos.
                field /st payload.
            ::
        case err l/dc/e return dcRes:err /e.
    ::.
    if /hasParamWrap
        do
            if or ge /pos len /inputTokens ne dcAtOr /inputTokens /pos dc:0 dc:259
                return failMsg b"Unclosed Dc 258..Dc 259 parameter container in ConvertDcStringToWasm"
                nop.
            set /pos skipAllComments /inputTokens wrapAdd /pos u64:1.
        ::
        nop.
    if ne /pos len /inputTokens
        return failMsg b"Unexpected trailing tokens after ConvertDcStringToWasm [string] argument"
        nop.
    if and eq len /rawTarget u64:1 isSysRegionDc dcAtOr /rawTarget u64:0 dc:0
        do
            const u128/soleU u128FromDc dcAtOr /rawTarget u64:0 dc:0.
            const capOptNodeRes/soleNr queryNodeRaw /cli /soleU.
