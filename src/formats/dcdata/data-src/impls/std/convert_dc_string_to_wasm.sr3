        bufGain /qStepIdx u64:18446744073709551615.
        hold b/seenV false.
        hold u64/vi u64:0.
        while lt /vi len /visited do
            be u128/vx match at /visited /vi
                case some u128/v /v.
                case none break.
            ::.
            if eq /vx /su
                do
                    become /seenV true.
                    break.
                ::
                nop.
            become /vi wrapSum /vi u64:1.
        ::.
        if not /seenV
            bufGain /visited /su
            nop.
    ::.
    hold u64/qi u64:0.
    while lt /qi len /qNodes do
        be u128/curNode match at /qNodes /qi
            case some u128/v /v.
            case none break.
        ::.
        hold buf/convStep/cands bufNew convStep u64:4.
        foreach convStep/rawSt /allSteps do
            if eq u128FromDc field /rawSt src /curNode
                bufGain /cands /rawSt
                nop.
        ::.
        if gt len /cands u64:0
            do
                be l/convStep/candList bufFrozen /cands.
                hold buf/convStep/elig bufNew convStep len /candList.
                foreach convStep/cst /candList do
                    be capBoolRes/isRout hasEntityClassDef /curCli field /cst subjId dc:280 true.
                    become /curCli field /isRout cli.
                    if not field /isRout ok
                        return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /isRout errTokens ::
                        nop.
                    hold b/eligible field /isRout val.
                    if not /eligible
                        do
                            be capBoolRes/isFmt isTransformationFormatSubj /curCli field /cst subj.
                            become /curCli field /isFmt cli.
                            if not field /isFmt ok
                                return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /isFmt errTokens ::
                                nop.
                            become /eligible field /isFmt val.
                        ::
                        nop.
                    if /eligible
                        bufGain /elig /cst
                        nop.
                ::.
                hold l/convStep/orderedElig bufFrozen /elig.
                if gt len /orderedElig u64:1
                    do
                        hold buf/convStep/withPref bufNew convStep len /orderedElig.
                        foreach convStep/est /orderedElig do
                            be capBoolRes/prefQ isConverterPreferred /curCli field /est subj.
                            become /curCli field /prefQ cli.
                            if not field /prefQ ok
                                return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /prefQ errTokens ::
                                nop.
                            bufGain /withPref with /est preferred field /prefQ val.
                        ::.
                        become /orderedElig sortConverterSteps bufFrozen /withPref.
                    ::
                    nop.
                foreach convStep/candSt /orderedElig do
                    be convStepOptRes/lr resolveConverterStepBody /curCli /candSt.
                    become /curCli field /lr cli.
                    if eq field /lr tag u8:2
                        return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /lr errTokens ::
                        nop.
                    if eq field /lr tag u8:0
                        continue
                        nop.
                    be convStep/st field /lr step.
                    be u64/loadedIdx len /loadedSteps.
                    bufGain /loadedSteps /st.
                    be u128/nextDst u128FromDc field /st dst.
                    if listContainsU128 /dstIds /nextDst
                        do
                            hold buf/convStep/rev bufNew convStep u64:4.
                            bufGain /rev /st.
                            hold u64/back /qi.
                            while true do
                                be u64/psi match at /qStepIdx /back
                                    case some u64/v /v.
                                    case none break.
                                ::.
                                if eq /psi u64:18446744073709551615
                                    break
                                    nop.
                                match at /loadedSteps /psi
                                    case some convStep/ps bufGain /rev /ps.
                                    case none break.
                                ::.
                                become /back match at /qParentIdx /back
                                    case some u64/p /p.
                                    case none break.
                                ::.
                            ::.
                            be l/convStep/revList bufFrozen /rev.
                            hold buf/convStep/fwd bufNew convStep len /revList.
                            hold u64/ri len /revList.
                            while gt /ri u64:0 do
                                become /ri wrapDiff /ri u64:1.
                                match at /revList /ri
                                    case some convStep/cs bufGain /fwd /cs.
                                    case none nop.
                                ::.
                            ::.
                            return structNew convListRes: cli /curCli ok true steps bufFrozen /fwd errTokens l/dc: :: ::
                        ::
                        nop.
                    be capU128ListRes/nextEq collectEquivClass /curCli field /st dst.
                    become /curCli field /nextEq cli.
                    if not field /nextEq ok
                        return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /nextEq errTokens ::
                        nop.
                    foreach u128/cand field /nextEq ids do
                        hold b/seenV false.
                        hold u64/vi u64:0.
                        while lt /vi len /visited do
                            be u128/vx match at /visited /vi
                                case some u128/v /v.
                                case none break.
                            ::.
                            if eq /vx /cand
                                do
                                    become /seenV true.
                                    break.
                                ::
                                nop.
                            become /vi wrapSum /vi u64:1.
                        ::.
                        if not /seenV
                            do
                                bufGain /visited /cand.
                                bufGain /qNodes /cand.
                                bufGain /qParentIdx /qi.
                                bufGain /qStepIdx /loadedIdx.
                            ::
                            nop.
                    ::.
                ::.
            ::
            nop.
        become /qi wrapSum /qi u64:1.
    ::.
    structNew convListRes: cli /curCli ok true steps l/convStep: :: errTokens l/dc: :: ::.

: ---------------------------------------------------------------------------
: 6. Token-Dc StageL / StageR Dependency Scanner, Bundler & Stage 0 KV Map
: ---------------------------------------------------------------------------

: @dc l8589992851
v/l/u8/joinNsSegs l/l/u8/segs
    test
        in l/l/u8: b"std" b"dctf" ::
        out b"std//dctf".
    hold buf/u8/out bufNew u8 u64:16.
    hold u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            bufGain /out u8:47
            nop.
        match at /segs /i
            case some l/u8/seg bufGainAll /out /seg.
            case none nop.
        ::.
        become /i wrapSum /i u64:1.
    ::.
    bufFrozen /out.

: @dc l8589992852
v/l/l/u8/splitNsKey l/u8/nsKey
    test
        in b"std//dctf"
        out l/l/u8: b"std" b"dctf" ::.
    be u64/n len /nsKey.
    hold buf/l/u8/out bufNew l/u8 u64:4.
    hold u64/start u64:0.
    while lt /start /n do
        hold u64/end /start.
        while lt /end /n do
            if eq u8AtOr /nsKey /end u8:0 u8:47
                break
                nop.
            become /end wrapSum /end u64:1.
        ::.
        if gt /end /start
            match slice /nsKey /start /end
                case some l/u8/seg bufGain /out /seg.
                case none nop.
            ::
            nop.
        become /start wrapSum /end u64:1.
    ::.
    bufFrozen /out.

: @dc l8589992853
v/tup: b l/l/u8 u64 ::/readFilePathSegs l/dc/tokens u64/pos
    be u64/n len /tokens.
    hold u64/p skipAllComments /tokens /pos.
    if or ge wrapSum /p u64:1 /n or ne dcAtOr /tokens /p dc:0 dc:511 ne dcAtOr /tokens wrapSum /p u64:1 dc:0 dc:f229
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    become /p skipAllComments /tokens wrapSum /p u64:2.
    if or ge /p /n ne dcAtOr /tokens /p dc:0 dc:310
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    become /p skipAllComments /tokens wrapSum /p u64:1.
    if and lt wrapSum /p u64:1 /n and eq dcAtOr /tokens /p dc:0 dc:516 eq dcAtOr /tokens wrapSum /p u64:1 dc:0 dc:f228
        do
            become /p wrapSum /p u64:2.
            if and lt /p /n eq dcAtOr /tokens /p dc:0 dc:513
                become /p wrapSum /p u64:1
                nop.
        ::
        nop.
    hold buf/l/u8/segs bufNew l/u8 u64:4.
    hold b/done false.
    hold b/failed false.
    while not /done do
        become /p skipAllComments /tokens /p.
        if ge /p /n
            do
                become /failed true.
                break.
            ::
            nop.
        be dc/tok dcAtOr /tokens /p dc:0.
        if eq /tok dc:311
            do
                become /p wrapSum /p u64:1.
                become /done true.
                break.
            ::
            nop.
        if eq /tok dc:513
            do
                become /p skipAllComments /tokens wrapSum /p u64:1.
            ::
            nop.
        if or ge wrapSum /p u64:1 /n or ne dcAtOr /tokens /p dc:0 dc:511 ne dcAtOr /tokens wrapSum /p u64:1 dc:0 dc:f228
            do
                become /failed true.
                break.
            ::
            nop.
        be tup: b dc l/dc u64 ::/lit readEscapedLiteral /tokens wrapSum /p u64:2.
        if or not field /lit u32:0 ne field /lit u32:1 dc:264
            do
                become /failed true.
                break.
            ::
            nop.
        be u64/endFname skipAllComments /tokens field /lit u32:3.
        if or ge /endFname /n ne dcAtOr /tokens /endFname dc:0 dc:512
            do
                become /failed true.
                break.
            ::
            nop.
        hold buf/u8/seg bufNew u8 len field /lit u32:2.
        foreach dc/ch field /lit u32:2 do
            match conv u128FromDc /ch u8
                case ok u8/b bufGain /seg /b.
                case err error/_e nop.
            ::.
        ::.
        bufGain /segs bufFrozen /seg.
        become /p wrapSum /endFname u64:1.
    ::.
    be l/l/u8/frozenSegs bufFrozen /segs.
    if or /failed eq len /frozenSegs u64:0
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    become /p skipAllComments /tokens /p.
    if or ge /p /n ne dcAtOr /tokens /p dc:0 dc:512
        return tupNew: false l/l/u8: :: /pos ::
        nop.
    tupNew: true /frozenSegs wrapSum /p u64:1 ::.

: Encodes a segment list into canonical `Dc 511 f229` FilePath tokens
: (`segMode`: `0` = raw inline segments, `1` = `[string]`-interned IDs,
: `2` = legacy Unicode-interned IDs; `hdrMode`: `0` = `516 f228 513`, `1` = `516 f228`,
: `2` = omit `516 f228`).
: @dc l8589992854
v/l/dc/encodeFilePathVariant l/l/u8/segs l/u128/internedSegIds u8/segMode u8/hdrMode
    hold buf/dc/out bufNew dc u64:32.
    bufGain /out dc:511.
    bufGain /out dc:f229.
    bufGain /out dc:310.
    if lt /hdrMode u8:2
        do
            bufGain /out dc:516.
            bufGain /out dc:f228.
        ::
        nop.
    if eq /hdrMode u8:0
        bufGain /out dc:513
        nop.
    hold u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            bufGain /out dc:513
            nop.
        bufGain /out dc:511.
        bufGain /out dc:f228.
        be l/u8/seg match at /segs /i
            case some l/u8/s /s.
            case none b"".
        ::.
        be u128/sid match at /internedSegIds /i
            case some u128/v /v.
            case none u128:0.
        ::.
        if and eq /segMode u8:1 gt /sid u128:0
            bufGain /out dcFromU128 /sid
            if and eq /segMode u8:2 gt /sid u128:0
                do
                    bufGain /out dc:260.
                    bufGain /out dc:262.
                    bufGain /out dc:264.
                    bufGain /out dc:263.
                    bufGain /out dcFromU128 /sid.
                    bufGain /out dc:261.
                ::
                bufGainAll /out tokEscapedLiteral dc:264 u8sToUnicodeDcs /seg.
        bufGain /out dc:512.
        become /i wrapSum /i u64:1.
    ::.
    bufGain /out dc:311.
    bufGain /out dc:512.
    bufFrozen /out.

: Queries the UNION of active FilePath context node IDs matching `segs`, covering
: `[string]`-interned, legacy Unicode-interned, and raw inline FilePath encodings.
: @dc l8589992855
v/capU128ListRes/findFilePathContextNodes capClient/cli l/l/u8/segs
    hold capClient/curCli /cli.
    hold buf/u128/strIds bufNew u128 len /segs.
    hold buf/u128/uniIds bufNew u128 len /segs.
    hold b/allStrHit true.
    hold b/allUniHit true.
    foreach l/u8/seg /segs do
        be l/dc/uChars u8sToUnicodeDcs /seg.
        be l/dc/strLit tokEscapedLiteral dc:264 /uChars.
        be capU128ListRes/sr queryNodesByExactTokens /curCli /strLit.
        become /curCli field /sr cli.
        if not field /sr ok
            return /sr
            nop.
        if gt len field /sr ids u64:0
            bufGain /strIds match at field /sr ids u64:0
                case some u128/v /v.
                case none u128:0.
            ::
            do
                become /allStrHit false.
                bufGain /strIds u128:0.
            ::.
        be capU128ListRes/ur queryNodesByExactTokens /curCli /uChars.
        become /curCli field /ur cli.
        if not field /ur ok
            return /ur
            nop.
        if gt len field /ur ids u64:0
            bufGain /uniIds match at field /ur ids u64:0
                case some u128/v /v.
                case none u128:0.
            ::
            do
                become /allUniHit false.
                bufGain /uniIds u128:0.
            ::.
    ::.
    be l/u128/strIdList bufFrozen /strIds.
    be l/u128/uniIdList bufFrozen /uniIds.
    hold buf/u128/found bufNew u128 u64:4.
    be l/u8/hdrModes l/u8: u8:0 u8:1 u8:2 ::.
    foreach u8/hm /hdrModes do
        if /allStrHit
            do
                be l/dc/q1 encodeFilePathVariant /segs /strIdList u8:1 /hm.
                be capU128ListRes/r1 queryNodesByExactTokens /curCli /q1.
                become /curCli field /r1 cli.
                if not field /r1 ok
                    return /r1
                    nop.
                foreach u128/id field /r1 ids do
                    hold b/seenF false.
                    hold u64/fi u64:0.
                    while lt /fi len /found do
                        be u128/fx match at /found /fi
                            case some u128/v /v.
                            case none break.
                        ::.
                        if eq /fx /id
                            do
                                become /seenF true.
                                break.
                            ::
                            nop.
                        become /fi wrapSum /fi u64:1.
                    ::.
                    if not /seenF
                        bufGain /found /id
                        nop.
                ::.
            ::
            nop.
        if /allUniHit
            do
                be l/dc/q2 encodeFilePathVariant /segs /uniIdList u8:2 /hm.
                be capU128ListRes/r2 queryNodesByExactTokens /curCli /q2.
                become /curCli field /r2 cli.
                if not field /r2 ok
                    return /r2
                    nop.
                foreach u128/id field /r2 ids do
                    hold b/seenF false.
                    hold u64/fi u64:0.
                    while lt /fi len /found do
                        be u128/fx match at /found /fi
                            case some u128/v /v.
                            case none break.
                        ::.
                        if eq /fx /id
                            do
                                become /seenF true.
                                break.
                            ::
                            nop.
                        become /fi wrapSum /fi u64:1.
                    ::.
                    if not /seenF
                        bufGain /found /id
                        nop.
                ::.
            ::
            nop.
        be l/dc/q0 encodeFilePathVariant /segs l/u128: :: u8:0 /hm.
        be capU128ListRes/r0 queryNodesByExactTokens /curCli /q0.
        become /curCli field /r0 cli.
        if not field /r0 ok
            return /r0
            nop.
        foreach u128/id field /r0 ids do
            hold b/seenF false.
            hold u64/fi u64:0.
            while lt /fi len /found do
                be u128/fx match at /found /fi
                    case some u128/v /v.
                    case none break.
                ::.
                if eq /fx /id
                    do
                        become /seenF true.
                        break.
                    ::
                    nop.
                become /fi wrapSum /fi u64:1.
            ::.
            if not /seenF
                bufGain /found /id
                nop.
        ::.
    ::.
    structNew capU128ListRes: cli /curCli ok true ids bufFrozen /found errTokens l/dc: :: ::.

: Reads `[255]? <atom>` in Token-Dc encoding (`decode.rs:658`).
: @dc l8589992856
v/option/u128Step/readTokAtom l/dc/tokens u64/pos
    be u64/n len /tokens.
    if ge /pos /n
        return option/u128Step:none
        nop.
    be dc/tok dcAtOr /tokens /pos dc:0.
    if eq /tok dc:255
        do
            be u64/p1 wrapSum /pos u64:1.
            if ge /p1 /n
                return option/u128Step:none
                nop.
            return option/u128Step:some structNew u128Step: val u128FromDc dcAtOr /tokens /p1 dc:0 nextPos wrapSum /p1 u64:1 ::
        ::
        nop.
    option/u128Step:some structNew u128Step: val u128FromDc /tok nextPos wrapSum /pos u64:1 ::.

: @dc l8589992857
v/option/u128Step/readTokOptAtom l/dc/tokens u64/pos
    if and lt /pos len /tokens eq dcAtOr /tokens /pos dc:0 dc:316
        return option/u128Step:some structNew u128Step: val u128:0 nextPos wrapSum /pos u64:1 ::
        nop.
    readTokAtom /tokens /pos.

: @dc l8589992858
v/u64/skipBalancedFrame l/dc/tokens u64/pos dc/openTok dc/closeTok
    be u64/n len /tokens.
    hold u64/i wrapSum /pos u64:1.
    hold u64/depth u64:1.
    be u32/openSid dcShortId /openTok.
    be u32/closeSid dcShortId /closeTok.
    if and ne /openSid /noRegionId ne /closeSid /noRegionId
        do
            while and lt /i /n gt /depth u64:0 do
                be u32/tsid dcShortId dcAtOr /tokens /i /dcZero.
                if eq /tsid u32:255
                    do
                        become /i wrapSum /i u64:2.
                        if gt /i /n
                            become /i /n
                            nop.
                        continue.
                    ::
                    nop.
                if eq /tsid /openSid
                    become /depth wrapSum /depth u64:1
                    if eq /tsid /closeSid
                        become /depth wrapDiff /depth u64:1
                        nop.
                become /i wrapSum /i u64:1.
            ::.
            return /i.
        ::
        nop.
    while and lt /i /n gt /depth u64:0 do
        be dc/t dcAtOr /tokens /i /dcZero.
        if eq dcShortId /t u32:255
            do
                become /i wrapSum /i u64:2.
                if gt /i /n
                    become /i /n
                    nop.
                continue.
            ::
            nop.
        if eq /t /openTok
            become /depth wrapSum /depth u64:1
            if eq /t /closeTok
                become /depth wrapDiff /depth u64:1
                nop.
        become /i wrapSum /i u64:1.
    ::.
    /i.

: @dc l8589992859
v/u64/skipTokenDcType l/dc/tokens u64/pos
    be u64/n len /tokens.
    hold u64/i /pos.
    hold u64/need u64:1.
    while and lt /i /n gt /need u64:0 do
        become /i skipAllComments /tokens /i.
        if ge /i /n
            break
            nop.
        be dc/t dcAtOr /tokens /i /dcZero.
        be u32/sid dcShortId /t.
        if or eq /sid u32:2576 or eq /sid u32:2577 or eq /sid u32:2674 eq /sid u32:2675
            do
                become /i wrapSum /i u64:1.
                continue.
            ::
            nop.
        if eq /sid u32:262
            do
                become /i skipBalancedFrame /tokens /i dc:262 dc:263.
                become /need wrapDiff /need u64:1.
                continue.
            ::
            nop.
        if eq /sid u32:2672
            do
                become /i skipBalancedFrame /tokens wrapSum /i u64:1 dc:310 dc:311.
                become /need wrapDiff /need u64:1.
                continue.
            ::
            nop.
        if or eq /sid u32:2673 eq /sid u32:2679
            do
                become /i wrapSum /i u64:1.
                if lt /i /n
                    do
                        if eq dcShortId dcAtOr /tokens /i /dcZero u32:270
                            do
                                be tup: b l/u8 u64 ::/id readIdentBytes /tokens /i.
                                become /i field /id u32:2.
                            ::
                            match readTokAtom /tokens /i
                                case some u128Step/st become /i field /st nextPos.
                                case none nop.
                            ::.
                    ::
                    nop.
                become /need wrapDiff /need u64:1.
                continue.
            ::
            nop.
        become /i wrapSum /i u64:1.
        become /need wrapDiff /need u64:1.
    ::.
    /i.

: Scans Token-Dc stream `tokens[start..end]` (stopping before module end) for
: external Dc symbol references (returns `l/u128`, raw global Dc IDs).
: @dc l8589992860
v/l/u128/scanDcRefsInRange l/dc/tokens u64/start u64/end
    hold buf/u128/refs bufNew u128 u64:16.
    hold u64/i /start.
    while lt /i /end do
        be dc/t dcAtOr /tokens /i /dcZero.
        be u32/sid dcShortId /t.
        if eq /sid u32:255
            do
                become /i wrapSum /i u64:2.
                if gt /i /end
                    become /i /end
                    nop.
                continue.
            ::
            nop.
        if or or eq /sid u32:246 eq /sid u32:247 or eq /sid u32:249 eq /sid u32:250
            do
                become /i skipAllComments /tokens /i.
                if gt /i /end
                    become /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:203
            do
                become /i wrapSum /i u64:1.
                while lt /i /end do
                    be u32/bsid dcShortId dcAtOr /tokens /i /dcZero.
                    become /i wrapSum /i u64:1.
                    if eq /bsid u32:204
                        break
                        nop.
                ::.
                continue.
            ::
            nop.
        if eq /sid u32:270
            do
                become /i skipBalancedFrame /tokens /i dc:270 dc:271.
                if gt /i /end
                    become /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:260
            do
                become /i skipBalancedFrame /tokens /i dc:260 dc:261.
                if gt /i /end
                    become /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:2211
            do
                become /i skipAllComments /tokens wrapSum /i u64:1.
                if lt /i /end
                    do
                        be u32/hsid dcShortId dcAtOr /tokens /i /dcZero.
                        if eq /hsid u32:2240
                            become /i wrapSum /i u64:1
                            if ne /hsid u32:270
                                match readTokAtom /tokens /i
                                    case some u128Step/st
                                        do
                                            if and ne field /st val u128:1116354 ne field /st val u128:1114711
                                                bufGain /refs field /st val
                                                nop.
                                            become /i field /st nextPos.
                                        ::
                                    case none nop.
                                ::
                                nop.
                    ::
                    nop.
                continue.
