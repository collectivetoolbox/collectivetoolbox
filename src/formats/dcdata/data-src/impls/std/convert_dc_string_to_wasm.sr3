: Computes declaration end and metadata for a single top-level declaration starting at `pos`.
: @dc l8589992861
v/tup: b b u8 u128 l/u8 l/dc u64 ::/inspectTopDeclMeta l/dc/tokens u64/pos
    : Returns `(isValid, wasPub, hasBuf, catRank, ownDcId, localDcs, cleanedDeclTokens, nextPos)`.
    : Actually packed cleanly into helpers below; this extracts header + end position.
    hold u64/i skipAllComments /tokens /pos.
    be u64/n len /tokens.
    if ge /i /n
        return tupNew: false false u8:2 u128:0 l/u8: :: l/dc: :: /pos ::
        nop.
    be dc/head dcAtOr /tokens /i dc:0.
    hold b/wasPub false.
    hold b/hasBuf false.
    hold u8/catRank u8:2.
    hold u128/ownDc u128:0.
    hold b/hasOwnDc false.
    hold u64/declEnd /i.
    if or eq /head dc:2199 eq /head dc:2200
        do
            become /wasPub eq /head dc:2200.
            become /catRank u8:1.
            hold u64/p wrapSum /i u64:1.
            be b/isNone and lt /p /n eq dcAtOr /tokens /p dc:0 dc:316.
            match readTokOptAtom /tokens /p
                case some u128Step/st
                    do
                        if not /isNone
                            do
                                become /hasOwnDc true.
                                become /ownDc field /st val.
                            ::
                            nop.
                        become /p field /st nextPos.
                    ::
                case none return tupNew: false false u8:2 u128:0 l/u8: :: l/dc: :: /pos ::.
            ::.
            become /p skipTokenDcType /tokens /p.
            if or ge /p /n ne dcAtOr /tokens /p dc:0 dc:270
                return tupNew: false false u8:2 u128:0 l/u8: :: l/dc: :: /pos ::
                nop.
            be tup: b l/u8 u64 ::/idr readIdentBytes /tokens /p.
            become /p field /idr u32:2.
            : Scan value expression until end of enclosing module or next top decl? Wait: single-decl nodes end at `len`, multi-decl module consts cannot easily be split unless balanced expr, so we scan whole module via `scanModuleDecls`.
            return tupNew: true /wasPub /catRank if /hasOwnDc /ownDc u128:0 l/u8: :: l/dc: :: /p ::
        ::
        nop.
    if or eq /head dc:2203 or eq /head dc:2217 or eq /head dc:2223 or eq /head dc:2224 eq /head dc:2230
        do
            hold u64/p wrapSum /i u64:1.
            if lt /p /n
                do
                    if eq dcAtOr /tokens /p dc:0 dc:517
                        become /wasPub true
                        nop.
                    become /p wrapSum /p u64:1.
                ::
                nop.
            if eq /head dc:2223
                become /p wrapSum /p u64:1
                nop.
            if or eq /head dc:2217 or eq /head dc:2223 or eq /head dc:2224 eq /head dc:2230
                become /catRank u8:0
                nop.
            be b/isNone and lt /p /n eq dcAtOr /tokens /p dc:0 dc:316.
            match readTokOptAtom /tokens /p
                case some u128Step/st
                    do
                        if not /isNone
                            do
                                become /hasOwnDc true.
                                become /ownDc field /st val.
                            ::
                            nop.
                        become /p field /st nextPos.
                    ::
                case none nop.
            ::.
            return tupNew: true /wasPub /catRank if /hasOwnDc /ownDc u128:0 l/u8: :: l/dc: :: /p ::
        ::
        nop.
    tupNew: false false u8:2 u128:0 l/u8: :: l/dc: :: /pos ::.

