                        foreach convStep/est /orderedElig do
                            const capBoolRes/prefQ isConverterPreferred /curCli field /est subj.
                            set /curCli field /prefQ cli.
                            if not field /prefQ ok
                                return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /prefQ errTokens ::
                                nop.
                            bufPush /withPref with /est preferred field /prefQ val.
                        ::.
                        set /orderedElig sortConverterSteps bufFreeze /withPref.
                    ::
                    nop.
                foreach convStep/candSt /orderedElig do
                    const convStepOptRes/lr resolveConverterStepBody /curCli /candSt.
                    set /curCli field /lr cli.
                    if eq field /lr tag u8:2
                        return structNew convListRes: cli /curCli ok false steps l/convStep: :: errTokens field /lr errTokens ::
                        nop.
                    if eq field /lr tag u8:0
                        continue
                        nop.
                    const convStep/st field /lr step.
                    const u64/loadedIdx len /loadedSteps.
                    bufPush /loadedSteps /st.
                    const u128/nextDst u128FromDc field /st dst.
                    if listContainsU128 /dstIds /nextDst
                        do
                            let buf/convStep/rev bufNew convStep u64:4.
                            bufPush /rev /st.
