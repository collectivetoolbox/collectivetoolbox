            do
                set /i skipAllComments /tokens /i.
                if gt /i /end
                    set /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:203
            do
                set /i wrapAdd /i u64:1.
                while lt /i /end do
                    const u32/bsid dcShortId dcAtOr /tokens /i /dcZero.
                    set /i wrapAdd /i u64:1.
                    if eq /bsid u32:204
                        break
                        nop.
                ::.
                continue.
            ::
            nop.
        if eq /sid u32:270
            do
                set /i skipBalancedFrame /tokens /i dc:270 dc:271.
                if gt /i /end
                    set /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:260
            do
                set /i skipBalancedFrame /tokens /i dc:260 dc:261.
                if gt /i /end
                    set /i /end
                    nop.
                continue.
            ::
            nop.
        if eq /sid u32:2211
            do
                set /i skipAllComments /tokens wrapAdd /i u64:1.
                if lt /i /end
