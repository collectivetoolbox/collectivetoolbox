            while lt /bp /n do
                become /bp skipAllComments /tokens /bp.
                if or ge /bp /n ne dcAtOr /tokens /bp dc:0 dc:2195
                    break
                    nop.
                become /bp skipBalancedFrame /tokens /bp dc:2195 dc:2196.
            ::.
            be l/dc/useSlice match slice /tokens /useStart /bp
                case some l/dc/s /s.
                case none l/dc: ::.
            ::.
            be l/dc/bodySlice match slice /tokens /bp wrapDiff /n u64:1
                case some l/dc/s stripRoutineTestBlocks /s.
                case none l/dc: ::.
            ::.
            be graphDeclItem/it structNew graphDeclItem:
                subj /subj
                subjId /sid
                isStager field /bm isStager
                wasPub true
                hasBuf field /bm hasBuf
                catRank u8:2
                useKeys field /bm useKeys
                useTokens /useSlice
                localDcs field /bm localDcs
                refDcs field /bm refDcs
                declTokens /bodySlice
            ::.
            return tupNew: true l/graphDeclItem: /it :: ::
        ::
        nop.
    be tup: b b u8 u128 l/u8 l/dc u64 ::/meta inspectTopDeclMeta /tokens u64:0.
    if not field /meta u32:0
        return tupNew: false l/graphDeclItem: :: ::
        nop.
    be tup: l/u128 b ::/locSt collectLocalDcsAndStagerFlag /tokens u64:0 /n.
    be b/isSr field /locSt u32:1.
    if and /needDialectFilter ne /isSr /wantStager
        return tupNew: true l/graphDeclItem: :: ::
        nop.
    hold l/u128/locs field /locSt u32:0.
    if not listContainsU128 /locs /sid
        become /locs appendUniqueU128 /locs /sid
        nop.
    be l/dc/cleaned stripRoutineTestBlocks /tokens.
    be graphDeclItem/it structNew graphDeclItem:
        subj /subj
        subjId /sid
        isStager /isSr
        wasPub field /meta u32:1
        hasBuf tokensHasBufDc /cleaned u64:0 len /cleaned
        catRank field /meta u32:2
        useKeys l/l/u8: ::
        useTokens l/dc: ::
        localDcs /locs
        refDcs scanDcRefsInRange /cleaned u64:0 len /cleaned
        declTokens /cleaned
