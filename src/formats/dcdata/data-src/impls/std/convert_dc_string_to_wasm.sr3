: @dc l8589992871
v/l/graphDeclItem/sortGraphDeclItems l/graphDeclItem/items
    be u64/n len /items.
    if le /n u64:1
        return /items
        nop.
    hold buf/graphDeclItem/arr bufNew graphDeclItem /n.
    bufGainAll /arr /items.
    hold u64/i u64:1.
    while lt /i /n do
        be graphDeclItem/key match at /arr /i
            case some graphDeclItem/s /s.
            case none break.
        ::.
        hold u64/j /i.
        while gt /j u64:0 do
            be u64/jm1 wrapDiff /j u64:1.
            be graphDeclItem/prev match at /arr /jm1
                case some graphDeclItem/s /s.
                case none break.
            ::.
            be b/earlier or lt field /key catRank field /prev catRank and eq field /key catRank field /prev catRank lt field /key subjId field /prev subjId.
            if not /earlier
                break
                nop.
            match bufBecomeAt /arr /j /prev
                case ok nop.
                case err error/_e break.
            ::.
            become /j /jm1.
        ::.
        match bufBecomeAt /arr /j /key
            case ok nop.
            case err error/_e break.
        ::.
        become /i wrapSum /i u64:1.
    ::.
    bufFrozen /arr.

: @dc l8589992872
v/l/dc/extractTopUseItems l/dc/useTokens l/u8/excludeNsKey
    hold buf/l/dc/seen bufNew l/dc u64:4.
    hold buf/dc/out bufNew dc len /useTokens.
    be u64/n len /useTokens.
    be b/checkExclude gt len /excludeNsKey u64:0.
    hold u64/i u64:0.
    while lt /i /n do
        become /i skipAllComments /useTokens /i.
        if or ge /i /n ne dcAtOr /useTokens /i dc:0 dc:2195
            break
            nop.
        be u64/endU skipBalancedFrame /useTokens /i dc:2195 dc:2196.
        match slice /useTokens /i /endU
            case some l/dc/oneUse
                do
                    hold b/skipSelf false.
                    if /checkExclude
                        do
                            be tup: b l/l/u8 u64 ::/ufp readFilePathSegs /oneUse u64:1.
                            if and field /ufp u32:0 u8ListEq joinNsSegs field /ufp u32:1 /excludeNsKey
                                become /skipSelf true
                                nop.
                        ::
                        nop.
                    if not /skipSelf
                        do
                            hold b/dup false.
                            hold u64/si u64:0.
                            while lt /si len /seen do
                                be b/matched match at /seen /si
                                    case some l/dc/ex dcListEq /ex /oneUse.
                                    case none false.
                                ::.
                                if /matched
                                    do
                                        become /dup true.
                                        break.
                                    ::
                                    nop.
                                become /si wrapSum /si u64:1.
                            ::.
                            if not /dup
                                do
                                    bufGain /seen /oneUse.
                                    bufGainAll /out /oneUse.
                                ::
                                nop.
                        ::
                        nop.
                ::
            case none nop.
        ::.
        become /i /endU.
    ::.
    be l/l/dc/_unusedSeen bufFrozen /seen.
    bufFrozen /out.

: Extracts ASCII bytes from an expanded string value node (`Dc 260..Dc 261` `Dc 264` or raw codepoints).
: @dc l8589998202
v/l/u8/extractAsciiStringFromNodeTokens l/dc/strToks
    be tup: b dc l/dc u64 ::/lit readEscapedLiteral /strToks u64:0.
    be l/dc/chars if and field /lit u32:0 eq field /lit u32:1 dc:264
        field /lit u32:2
        /strToks.
    hold buf/u8/out bufNew u8 len /chars.
    foreach dc/ch /chars do
        be u128/cu u128FromDc /ch.
        if and gt /cu u128:0 lt /cu u128:128
            match conv /cu u8
                case ok u8/b bufGain /out /b.
                case err error/_e nop.
            ::
            nop.
    ::.
    bufFrozen /out.

: @dc l8589998203
v/b/isValidRoutineIdentAscii l/u8/ident
    be u64/n len /ident.
    if eq /n u64:0
        return false
        nop.
    hold u64/i u64:0.
    while lt /i /n do
        be u8/c u8AtOr /ident /i u8:0.
        be b/alphaOrUnder or and ge /c u8:65 le /c u8:90 or and ge /c u8:97 le /c u8:122 eq /c u8:95.
        be b/digit and ge /c u8:48 le /c u8:57.
        if eq /i u64:0
            do
                if not /alphaOrUnder
                    return false
                    nop.
            ::
            do
                if and not /alphaOrUnder not /digit
                    return false
                    nop.
            ::.
        become /i wrapSum /i u64:1.
    ::.
    true.

