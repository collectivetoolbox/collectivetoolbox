                            set /i wrapAdd /i u64:1
                            do
                                const u64/typeStart /i.
                                const u64/typeEnd skipTokenDcType /tokens /typeStart.
                                const l/u128/typeRefs scanDcRefsInRange /tokens /typeStart /typeEnd.
                                bufExtend /refs /typeRefs.
                                set /i /typeEnd.
                            ::.
                        if and lt /i /end ne dcShortId dcAtOr /tokens /i /dcZero u32:270
                            match readTokAtom /tokens /i
                                case some u128Step/st
                                    do
                                        bufPush /refs field /st val.
                                        set /i field /st nextPos.
                                    ::
                                case none nop.
                            ::
                            nop.
                    ::
