        nop.

    : 6. Execute each converter step in the resolved chain via `Dc 1940`.
    let l/dc/curTokens /body.
    foreach convStep/step /chain do
        const l/dc/stripped stripLeadingComments /curTokens.
        const u32/curHeadSid dcShortId dcAtOr /stripped u64:0 /dcZero.
        const b/isWasmDst eq dcShortId field /step dst u32:1927.
        const b/isStagelInput eq /curHeadSid u32:2192.
        const b/isStagerSrc eq dcShortId field /step src u32:2221.
