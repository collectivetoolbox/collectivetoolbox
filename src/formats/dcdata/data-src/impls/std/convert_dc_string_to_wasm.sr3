    bufPush /out dc:f229.
    bufPush /out dc:310.
    if lt /hdrMode u8:2
        do
            bufPush /out dc:516.
            bufPush /out dc:f228.
        ::
        nop.
    if eq /hdrMode u8:0
        bufPush /out dc:513
        nop.
    let u64/i u64:0.
    while lt /i len /segs do
        if gt /i u64:0
            bufPush /out dc:513
            nop.
        bufPush /out dc:511.
        bufPush /out dc:f228.
        const l/u8/seg match get /segs /i
            case some l/u8/s /s.
            case none b"".
        ::.
        const u128/sid match get /internedSegIds /i
            case some u128/v /v.
            case none u128:0.
        ::.
        if and eq /segMode u8:1 gt /sid u128:0
            bufPush /out dcFromU128 /sid
            if and eq /segMode u8:2 gt /sid u128:0
                do
                    bufPush /out dc:260.
                    bufPush /out dc:262.
                    bufPush /out dc:264.
                    bufPush /out dc:263.
                    bufPush /out dcFromU128 /sid.
                    bufPush /out dc:261.
                ::
                bufExtend /out tokEscapedLiteral dc:264 u8sToUnicodeDcs /seg.
        bufPush /out dc:512.
        set /i wrapAdd /i u64:1.
    ::.
    bufPush /out dc:311.
    bufPush /out dc:512.
    bufFreeze /out.

