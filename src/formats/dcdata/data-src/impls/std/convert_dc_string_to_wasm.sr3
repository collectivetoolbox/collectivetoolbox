    tupNew: true l/graphDeclItem: /it :: ::.

: Flips visibility on a private non-`buf` top-level declaration (`518 -> 517` or `2199 -> 2200`).
: @dc l8589992868
v/l/dc/flipDeclTokensPub l/dc/tokens
    if eq len /tokens u64:0
        return /tokens
        nop.
    be dc/h dcAtOr /tokens u64:0 dc:0.
    if eq /h dc:2199
        do
            hold buf/dc/out bufNew dc len /tokens.
            bufGain /out dc:2200.
            match slice /tokens u64:1 len /tokens
                case some l/dc/rest bufGainAll /out /rest.
                case none nop.
            ::.
            return bufFrozen /out
        ::
        nop.
