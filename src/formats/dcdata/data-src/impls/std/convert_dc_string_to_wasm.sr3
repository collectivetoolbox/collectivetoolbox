                                    case ok nop.
                                    case err error/_e nop.
                                ::.
                                bufGain /edges /j.
                            ::
                            nop.
                    ::
                    nop.
            ::.
        ::.
        bufGain /adj bufFrozen /edges.
        become /i wrapSum /i u64:1.
    ::.
    bufFrozen /adj.

