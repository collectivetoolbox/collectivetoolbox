: @dc l8589992875
v/l/u8/formatDecimalU128 u128/val
    if eq /val u128:0
        return b"0"
        nop.
    hold u128/cur /val.
    hold buf/u8/rev bufNew u8 u64:40.
    while gt /cur u128:0 do
        be u128/rem match mod /cur u128:10
            case ok u128/r /r.
            case err error/_e u128:0.
        ::.
        be u8/dig match conv /rem u8
            case ok u8/d wrapSum u8:48 /d.
            case err error/_e u8:48.
        ::.
        bufGain /rev /dig.
        become /cur match quot /cur u128:10
            case ok u128/q /q.
            case err error/_e u128:0.
        ::.
    ::.
    be l/u8/revList bufFrozen /rev.
    hold buf/u8/out bufNew u8 len /revList.
    hold u64/i len /revList.
    while gt /i u64:0 do
        become /i wrapDiff /i u64:1.
        bufGain /out u8AtOr /revList /i u8:48.
    ::.
    bufFrozen /out.

: @dc l8589992876
