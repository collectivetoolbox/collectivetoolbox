#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Script to build historical tools and generate/verify all compression fixtures.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
while [ "$REPO_ROOT" != "/" ] && [ ! -f "$REPO_ROOT/AGENTS.md" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done

RAW_FILE="$REPO_ROOT/src/formats/compression/data/fixtures/example2 with lemurs.pan"
FIXTURES_DIR="$REPO_ROOT/src/formats/compression/data/fixtures"

mkdir -p "$REPO_ROOT/built"
TMP_DIR="$(mktemp -d "$REPO_ROOT/built/tmp_gen_fixtures_XXXXXX")"
cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

# 0. Locate ctoolbox binary
if [ -n "${CTB_BIN:-}" ]; then
    :
elif [ -f "$REPO_ROOT/target/release/ctoolbox" ]; then
    CTB_BIN="$REPO_ROOT/target/release/ctoolbox"
elif [ -f "$REPO_ROOT/target/debug/ctoolbox" ]; then
    CTB_BIN="$REPO_ROOT/target/debug/ctoolbox"
elif [ -f "$REPO_ROOT/built/linux-x64/ctoolbox" ]; then
    CTB_BIN="$REPO_ROOT/built/linux-x64/ctoolbox"
else
    export RUSTFLAGS="-Awarnings"
    CTB_BIN="cargo run --release -q -p ctoolbox --bin ctoolbox --"
fi

# 1. Compile historical tools using shared build script
"$SCRIPT_DIR/build-historic-compressors" "$TMP_DIR"

echo "=== Generating All Compression Fixtures ==="

# --- Historical Tools (from old/unix-tools) ---

# Compress 1.0 (July 1984 headerless LZW)
"$TMP_DIR/compress-1.0" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.1.0.Z"

# Compress 1.6 (August 1984 sorted chain headerless LZW)
"$TMP_DIR/compress-1.6" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.1.6.Z"

# Compress 2.0 (August 1984 non-block mode LZW, header: 1f 9d 10)
"$TMP_DIR/compress-2.0" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.2.0.Z"

# Compress 3.0 (January 1985 block mode LZW, header: 1f 9d 90)
"$TMP_DIR/compress-3.0" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.3.0.Z"

# Compress 4.0 (1986 maxbits 12 LZW, header: 1f 9d 8c)
"$TMP_DIR/compress-4.0" -c -b 12 < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.12.Z"

# ncompress (Modern standard 16-bit block LZW, header: 1f 9d 90)
"$TMP_DIR/ncompress" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.Z"

# AT&T System III / V pack
cp "$RAW_FILE" "$TMP_DIR/raw_sys3"
(cd "$TMP_DIR" && ./sys3-pack raw_sys3 >/dev/null 2>&1)
mv "$TMP_DIR/raw_sys3.z" "$FIXTURES_DIR/example2 with lemurs.pan.z"

# PDP-11 Zucker 1977 old-pack
cp "$RAW_FILE" "$TMP_DIR/raw_opack"
(cd "$TMP_DIR" && ./opack raw_opack >/dev/null 2>&1)
mv "$TMP_DIR/raw_opack.z" "$FIXTURES_DIR/example2 with lemurs.pan.old.z"

# 4.1cBSD McMaster compact
"$TMP_DIR/compact" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.C"

# Julian Seward bzip 0.21
"$TMP_DIR/bzip-0.21" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.bz"

# Leonid Broukhis freeze 2.5 (Freeze 2.0 format)
"$TMP_DIR/freeze" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.2.0.F"

# --- Dedicated System Tools ---

# GNU gzip
gzip -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.gz"

# bzip2
bzip2 -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.bz2"

# Brotli
brotli -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.br"

# XZ
xz -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.xz"

# --- Synthetic Formats (ctoolbox in-repo implementation due to lack of tools) ---

# SCO compress -H
$CTB_BIN compress sco-compress "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.sco" --force

# Freeze 1.0 (LZSS + Dynamic Huffman with fixed Table 1)
$CTB_BIN compress freeze1 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.1.0.F" --force

# --- Crate Library Wrappers (ctblib) ---

$CTB_BIN compress deflate "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.deflate" --force
$CTB_BIN compress zlib "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zz" --force
$CTB_BIN compress lz4 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz4" --force
$CTB_BIN compress lzma "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma" --force
$CTB_BIN compress lzma2 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma2" --force
$CTB_BIN compress lzip "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz" --force
$CTB_BIN compress zstd "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zst" --force
$CTB_BIN compress lzo "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzo" --force

echo "=== Verifying Fixture Decompressions ==="

verify_decomp() {
    local desc="$1" in_fixture="$2" dec_cmd="$3"
    echo "Verifying $desc..."
    eval "$dec_cmd" > "$TMP_DIR/verify.pan"
    if ! cmp "$RAW_FILE" "$TMP_DIR/verify.pan"; then
        echo "Error: Decompression verification failed for $desc" >&2
        exit 1
    fi
}

verify_decomp "compress 1.0" "$FIXTURES_DIR/example2 with lemurs.pan.1.0.Z" "\"$TMP_DIR/compress-2.0\" -c -d -n < \"$FIXTURES_DIR/example2 with lemurs.pan.1.0.Z\""
verify_decomp "compress 1.6" "$FIXTURES_DIR/example2 with lemurs.pan.1.6.Z" "\"$TMP_DIR/compress-2.0\" -c -d -n < \"$FIXTURES_DIR/example2 with lemurs.pan.1.6.Z\""
verify_decomp "compress 2.0" "$FIXTURES_DIR/example2 with lemurs.pan.2.0.Z" "\"$TMP_DIR/compress-2.0\" -c -d < \"$FIXTURES_DIR/example2 with lemurs.pan.2.0.Z\""
verify_decomp "compress 3.0" "$FIXTURES_DIR/example2 with lemurs.pan.3.0.Z" "\"$TMP_DIR/compress-3.0\" -c -d < \"$FIXTURES_DIR/example2 with lemurs.pan.3.0.Z\""
verify_decomp "compress 4.0" "$FIXTURES_DIR/example2 with lemurs.pan.12.Z" "\"$TMP_DIR/compress-4.0\" -c -d < \"$FIXTURES_DIR/example2 with lemurs.pan.12.Z\""
verify_decomp "ncompress" "$FIXTURES_DIR/example2 with lemurs.pan.Z" "\"$TMP_DIR/ncompress\" -c -d < \"$FIXTURES_DIR/example2 with lemurs.pan.Z\""

cp "$FIXTURES_DIR/example2 with lemurs.pan.z" "$TMP_DIR/dec_pack.z"
verify_decomp "sys3-pack" "$FIXTURES_DIR/example2 with lemurs.pan.z" "(cd \"$TMP_DIR\" && ./sys3-pcat dec_pack.z)"

verify_decomp "opack" "$FIXTURES_DIR/example2 with lemurs.pan.old.z" "\"$TMP_DIR/opcat\" \"$FIXTURES_DIR/example2 with lemurs.pan.old.z\""
verify_decomp "compact" "$FIXTURES_DIR/example2 with lemurs.pan.C" "\"$TMP_DIR/uncompact\" < \"$FIXTURES_DIR/example2 with lemurs.pan.C\""
verify_decomp "bzip 0.21" "$FIXTURES_DIR/example2 with lemurs.pan.bz" "\"$TMP_DIR/bzip-0.21\" -d < \"$FIXTURES_DIR/example2 with lemurs.pan.bz\""
verify_decomp "freeze 2.0" "$FIXTURES_DIR/example2 with lemurs.pan.2.0.F" "\"$TMP_DIR/freeze\" -d -c < \"$FIXTURES_DIR/example2 with lemurs.pan.2.0.F\""
verify_decomp "freeze 1.0 (melt)" "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.1.0.F" "\"$TMP_DIR/freeze\" -d -c < \"$FIXTURES_DIR/example2 with lemurs.pan.synthetic.1.0.F\""

verify_decomp "gzip" "$FIXTURES_DIR/example2 with lemurs.pan.gz" "gunzip -c < \"$FIXTURES_DIR/example2 with lemurs.pan.gz\""
verify_decomp "bzip2" "$FIXTURES_DIR/example2 with lemurs.pan.bz2" "bzip2 -d -c < \"$FIXTURES_DIR/example2 with lemurs.pan.bz2\""
verify_decomp "brotli" "$FIXTURES_DIR/example2 with lemurs.pan.br" "brotli -d -c < \"$FIXTURES_DIR/example2 with lemurs.pan.br\""
verify_decomp "xz" "$FIXTURES_DIR/example2 with lemurs.pan.xz" "xz -d -c < \"$FIXTURES_DIR/example2 with lemurs.pan.xz\""

verify_decomp "sco-compress" "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.sco" "$CTB_BIN decompress sco-compress \"$FIXTURES_DIR/example2 with lemurs.pan.synthetic.sco\" -o -"
verify_decomp "deflate" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.deflate" "$CTB_BIN decompress deflate \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.deflate\" -o -"
verify_decomp "zlib" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zz" "$CTB_BIN decompress zlib \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zz\" -o -"
verify_decomp "lz4" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz4" "$CTB_BIN decompress lz4 \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz4\" -o -"
verify_decomp "lzma" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma" "$CTB_BIN decompress lzma \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma\" -o -"
verify_decomp "lzma2" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma2" "$CTB_BIN decompress lzma2 \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma2\" -o -"
verify_decomp "lzip" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz" "$CTB_BIN decompress lzip \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz\" -o -"
verify_decomp "zstd" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zst" "$CTB_BIN decompress zstd \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zst\" -o -"
verify_decomp "lzo" "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzo" "$CTB_BIN decompress lzo \"$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzo\" -o -"

# Clean up any old renamed fixtures
rm -f "$FIXTURES_DIR/example2 with lemurs.pan.Z1.0" \
      "$FIXTURES_DIR/example2 with lemurs.pan.Z1.6" \
      "$FIXTURES_DIR/example2 with lemurs.pan.Z2.0" \
      "$FIXTURES_DIR/example2 with lemurs.pan.Z3.0" \
      "$FIXTURES_DIR/example2 with lemurs.pan.Z12" \
      "$FIXTURES_DIR/example2 with lemurs.pan.F" \
      "$FIXTURES_DIR/example2 with lemurs.pan.sco" \
      "$FIXTURES_DIR/example2 with lemurs.pan.deflate" \
      "$FIXTURES_DIR/example2 with lemurs.pan.zz" \
      "$FIXTURES_DIR/example2 with lemurs.pan.lz4" \
      "$FIXTURES_DIR/example2 with lemurs.pan.lzma" \
      "$FIXTURES_DIR/example2 with lemurs.pan.lzma2" \
      "$FIXTURES_DIR/example2 with lemurs.pan.lz" \
      "$FIXTURES_DIR/example2 with lemurs.pan.zst" \
      "$FIXTURES_DIR/example2 with lemurs.pan.lzo"

echo ""
echo "All 23 compression fixtures successfully generated and verified!"
