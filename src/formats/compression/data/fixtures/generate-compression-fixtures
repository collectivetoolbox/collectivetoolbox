#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Script to build historical tools and generate/verify all compression fixtures.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
while [ "$REPO_ROOT" != "/" ] && [ ! -f "$REPO_ROOT/AGENTS.md" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done

RAW_FILE="$REPO_ROOT/src/formats/compression/data/fixtures/example2 with lemurs.pan"
if [[ ! -f "$RAW_FILE" ]]; then
    echo "Error: Base fixture raw file not found at '$RAW_FILE'." >&2
    exit 1
fi

OUTPUT_DIR="$SCRIPT_DIR"
VERIFY_ONLY=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verify-only) VERIFY_ONLY=1; shift ;;
        --output-dir) OUTPUT_DIR="$(realpath -m "$2")"; shift 2 ;;
        -h|--help)
            echo "Usage: $0 [--verify-only] [--output-dir DIRECTORY]"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# Verify required system tools exist upfront; fail immediately if missing
for req_tool in gcc cmp gzip gunzip bzip2 brotli xz lzip lz4 zstd python3; do
    if ! command -v "$req_tool" >/dev/null 2>&1; then
        echo "Error: Required system tool '$req_tool' not found in PATH." >&2
        exit 1
    fi
done

if ! python3 -c "import ctypes.util, sys; sys.exit(0 if ctypes.util.find_library('lzo2') else 1)"; then
    echo "Error: Required library 'liblzo2' not found on system." >&2
    exit 1
fi

mkdir -p "$REPO_ROOT/built"
TMP_DIR="$(mktemp -d "$REPO_ROOT/built/tmp_gen_fixtures_XXXXXX")"
cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT
FIXTURES_DIR="$TMP_DIR/fixtures"
if [[ "$VERIFY_ONLY" -eq 1 ]]; then
    FIXTURES_DIR="$OUTPUT_DIR"
else
    mkdir "$FIXTURES_DIR"
fi

# 0. Locate ctoolbox binary
if [ -n "${CTB_BIN:-}" ]; then
    CTB_CMD=("$CTB_BIN")
elif [ -f "$REPO_ROOT/target/release/ctoolbox" ]; then
    CTB_CMD=("$REPO_ROOT/target/release/ctoolbox")
elif [ -f "$REPO_ROOT/target/debug/ctoolbox" ]; then
    CTB_CMD=("$REPO_ROOT/target/debug/ctoolbox")
elif [ -f "$REPO_ROOT/built/linux-x64/ctoolbox" ]; then
    CTB_CMD=("$REPO_ROOT/built/linux-x64/ctoolbox")
else
    export RUSTFLAGS="-Awarnings"
    CTB_CMD=(cargo run --release -q -p ctoolbox --bin ctoolbox --)
fi

# 1. Compile historical tools using shared build script
"$SCRIPT_DIR/build-historic-compressors" "$TMP_DIR"
for hist_tool in compress-1.0 compress-1.6 compress-2.0 compress-3.0 compress-4.0 ncompress compact uncompact sys3-pack sys3-pcat opack opcat bzip-0.21 freeze rzip; do
    if [[ ! -x "$TMP_DIR/$hist_tool" ]]; then
        echo "Error: Historical compression tool '$hist_tool' failed to build or is missing." >&2
        exit 1
    fi
done

if [[ "$VERIFY_ONLY" -eq 0 ]]; then
echo "=== Generating All Compression Fixtures Into Staging ==="

# --- Historical Tools (from old/unix-tools) ---

# Compress 1.0 (July 1984 headerless LZW)
"$TMP_DIR/compress-1.0" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.1.0.Z"

# Compress 1.6 (August 1984 sorted chain headerless LZW)
"$TMP_DIR/compress-1.6" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.1.6.Z"

# Compress 2.0 (August 1984 non-block mode LZW, header: 1f 9d 10)
"$TMP_DIR/compress-2.0" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.2.0.Z"

# Compress 3.0 (January 1985 block mode LZW, header: 1f 9d 90)
"$TMP_DIR/compress-3.0" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.3.0.Z"

# Compress 4.0 (1986 maxbits 12 LZW, header: 1f 9d 8c)
"$TMP_DIR/compress-4.0" -c -b 12 < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.12.Z"

# ncompress (Modern standard 16-bit block LZW, header: 1f 9d 90)
"$TMP_DIR/ncompress" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.Z"

# AT&T System III / V pack
cp "$RAW_FILE" "$TMP_DIR/raw_sys3"
(cd "$TMP_DIR" && ./sys3-pack raw_sys3 >/dev/null 2>&1)
mv "$TMP_DIR/raw_sys3.z" "$FIXTURES_DIR/example2 with lemurs.pan.z"

# PDP-11 Zucker 1977 old-pack
cp "$RAW_FILE" "$TMP_DIR/raw_opack"
(cd "$TMP_DIR" && ./opack raw_opack >/dev/null 2>&1)
mv "$TMP_DIR/raw_opack.z" "$FIXTURES_DIR/example2 with lemurs.pan.old.z"

# 4.1cBSD McMaster compact
"$TMP_DIR/compact" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.C"

# Julian Seward bzip 0.21
"$TMP_DIR/bzip-0.21" < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.bz"

# Leonid Broukhis freeze 2.5 (Freeze 2.0 format)
"$TMP_DIR/freeze" -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.2.0.F"

# Andrew Tridgell rzip 2.1
"$TMP_DIR/rzip" -k -f -o "$FIXTURES_DIR/example2 with lemurs.pan.rz" "$RAW_FILE"

# --- Dedicated System Tools ---

# GNU gzip
gzip -n -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.gz"

# bzip2
bzip2 -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.bz2"

# Brotli
brotli -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.br"

# XZ
xz -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.xz"

# --- Synthetic Formats (ctoolbox in-repo implementation due to lack of tools) ---

# SCO compress -H
"${CTB_CMD[@]}" compress sco-compress "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.sco" --force

# Freeze 1.0 (LZSS + Dynamic Huffman with fixed Table 1)
"${CTB_CMD[@]}" compress freeze1 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.synthetic.1.0.F" --force

# --- Crate Library Wrappers (ctblib) ---

"${CTB_CMD[@]}" compress deflate "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.deflate" --force
"${CTB_CMD[@]}" compress zlib "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zz" --force
"${CTB_CMD[@]}" compress lz4 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz4" --force
"${CTB_CMD[@]}" compress lzma "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma" --force
"${CTB_CMD[@]}" compress lzma2 "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzma2" --force
"${CTB_CMD[@]}" compress lzip "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lz" --force
"${CTB_CMD[@]}" compress zstd "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.zst" --force
"${CTB_CMD[@]}" compress lzo "$RAW_FILE" -o "$FIXTURES_DIR/example2 with lemurs.pan.ctblib.lzo" --force

python3 "$SCRIPT_DIR/codec-oracle.py" compress deflate < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.deflate"
python3 "$SCRIPT_DIR/codec-oracle.py" compress zlib < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.zz"
python3 "$SCRIPT_DIR/codec-oracle.py" compress lzo < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.lzo"
xz --format=lzma -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.lzma"
xz --format=raw --lzma2=dict=8MiB -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.lzma2"
lzip -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.lz"
lz4 -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.lz4"
zstd -c < "$RAW_FILE" > "$FIXTURES_DIR/example2 with lemurs.pan.external.zst"
fi

echo "=== Verifying Fixture Decompressions ==="

verify_decomp() {
    local format="$1" suffix="$2"
    shift 2
    local fixture="$FIXTURES_DIR/example2 with lemurs.pan.$suffix"
    echo "Verifying $suffix with ctoolbox and $1..."
    "${CTB_CMD[@]}" decompress "$format" "$fixture" -o "$TMP_DIR/verify.pan" --force
    cmp "$RAW_FILE" "$TMP_DIR/verify.pan"
    "$@" < "$fixture" > "$TMP_DIR/verify.pan"
    cmp "$RAW_FILE" "$TMP_DIR/verify.pan"
    VERIFIED=$((VERIFIED + 1))
}

VERIFIED=0
verify_decomp compress1 1.0.Z "$TMP_DIR/compress-1.0" -d
verify_decomp compress16 1.6.Z "$TMP_DIR/compress-1.6" -d
verify_decomp compress2 2.0.Z "$TMP_DIR/compress-2.0" -c -d
verify_decomp compress 3.0.Z "$TMP_DIR/compress-3.0" -c -d
verify_decomp compress 12.Z "$TMP_DIR/compress-4.0" -c -d
verify_decomp compress Z "$TMP_DIR/ncompress" -c -d

unpack_sys3() {
    (cd "$TMP_DIR" && ./sys3-pcat dec_pack.z)
}
cp "$FIXTURES_DIR/example2 with lemurs.pan.z" "$TMP_DIR/dec_pack.z"
verify_decomp pack z unpack_sys3
verify_decomp old-pack old.z "$TMP_DIR/opcat" "$FIXTURES_DIR/example2 with lemurs.pan.old.z"
verify_decomp compact C "$TMP_DIR/uncompact"
verify_decomp bzip bz "$TMP_DIR/bzip-0.21" -d
verify_decomp freeze2 2.0.F "$TMP_DIR/freeze" -d -c
verify_decomp freeze1 synthetic.1.0.F "$TMP_DIR/freeze" -d -c

unpack_rzip() {
    "$TMP_DIR/rzip" -d -k -f -o "$TMP_DIR/rzip_out.pan" "$FIXTURES_DIR/example2 with lemurs.pan.rz" >/dev/null
    cat "$TMP_DIR/rzip_out.pan"
}
verify_decomp rzip rz unpack_rzip
verify_decomp gzip gz gunzip -c
verify_decomp bzip2 bz2 bzip2 -d -c
verify_decomp brotli br brotli -d -c
verify_decomp xz xz xz -d -c
verify_decomp sco-compress synthetic.sco gunzip -c

for source in ctblib external; do
    verify_decomp deflate "$source.deflate" python3 "$SCRIPT_DIR/codec-oracle.py" decompress deflate
    verify_decomp zlib "$source.zz" python3 "$SCRIPT_DIR/codec-oracle.py" decompress zlib
    verify_decomp lzo "$source.lzo" python3 "$SCRIPT_DIR/codec-oracle.py" decompress lzo --raw-size "$(wc -c < "$RAW_FILE")"
    verify_decomp lz4 "$source.lz4" lz4 -d -c
    verify_decomp lzma "$source.lzma" xz --format=lzma -d -c
    verify_decomp lzma2 "$source.lzma2" xz --format=raw --lzma2=dict=8MiB -d -c
    verify_decomp lzip "$source.lz" lzip -d -c
    verify_decomp zstd "$source.zst" zstd -d -c
done

if [[ "$VERIFY_ONLY" -eq 0 ]]; then
    mkdir -p "$OUTPUT_DIR"
    for fixture in "$FIXTURES_DIR"/*; do
        mv "$fixture" "$OUTPUT_DIR/$(basename "$fixture")"
    done
fi

echo ""
echo "All $VERIFIED compression fixtures verified by ctoolbox and independent decoders!"
