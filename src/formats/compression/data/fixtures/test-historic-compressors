#!/usr/bin/env bash
set -euo pipefail

# Script to build historical unix compressors/decompressors and verify bidirectional
# roundtrip compatibility between ctoolbox and other implementations.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
while [ "$REPO_ROOT" != "/" ] && [ ! -f "$REPO_ROOT/AGENTS.md" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done

RAW_FILE="$REPO_ROOT/src/formats/compression/data/fixtures/example2 with lemurs.pan"
TMP_DIR="$REPO_ROOT/built/tmp_test_decompression"

FILTER="${FILTER:-}"
DATASET_FILTER="${DATASET_FILTER:-}"
FAST_MODE="${FAST:-${QUICK:-0}}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            echo "Usage: $0 [options] [format_or_tool_filter] [dataset_filter]"
            echo ""
            echo "Options:"
            echo "  -f, --filter FILTER     Filter test format or tool (e.g. 'compact', 'compress1', 'bzip')"
            echo "  -d, --dataset PATTERN   Filter datasets by filename substring (e.g. 'fox', 'mozilla')"
            echo "  -q, --quick, --fast     Only run synthetic datasets (skip full corpora)"
            echo "  -h, --help              Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0 compact                  # Run only compact/uncompact tests"
            echo "  $0 compact:uncompact        # Run only ctoolbox -> uncompact"
            echo "  $0 compact mozilla          # Run compact on mozilla dataset only"
            echo "  $0 --fast                   # Run all compressors on quick synthetic datasets"
            echo "  $0 --fast compact           # Run compact on quick synthetic datasets"
            exit 0
            ;;
        -q|--quick|--fast)
            FAST_MODE=1
            shift
            ;;
        -f|--filter)
            FILTER="$2"
            shift 2
            ;;
        -d|--dataset)
            DATASET_FILTER="$2"
            shift 2
            ;;
        *)
            if [ -z "$FILTER" ]; then
                FILTER="$1"
            elif [ -z "$DATASET_FILTER" ]; then
                DATASET_FILTER="$1"
            fi
            shift
            ;;
    esac
done

if [ -f "$REPO_ROOT/target/release/ctoolbox" ]; then
    CTB_BIN="$REPO_ROOT/target/release/ctoolbox"
else
    export RUSTFLAGS="-Awarnings"
    CTB_BIN="cargo run --release -q -p ctoolbox --bin ctoolbox --"
fi

mkdir -p "$REPO_ROOT/built"
TMP_DIR="$(mktemp -d "$REPO_ROOT/built/tmp_test_decompression_XXXXXX")"

cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

echo "=== 1. Preparing and Compiling Historical Tools in Temporary Directory ==="

# 1a. Prepare compress 1.0 (July 1984, Spencer W. Thomas)
TMP_C1="$TMP_DIR/compress-1.0.c"
python3 - "$REPO_ROOT" "$TMP_C1" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/compress/compress-1.0/compress.c")
with open(src_file, "r") as f:
    code = f.read()
masks = """
static char buf[BITS];
static unsigned char lmask[9] = {0xff, 0xfe, 0xfc, 0xf8, 0xf0, 0xe0, 0xc0, 0x80, 0x00};
static unsigned char rmask[9] = {0x00, 0x01, 0x03, 0x07, 0x0f, 0x1f, 0x3f, 0x7f, 0xff};
"""
vax_insv = """#ifndef vax\nYou lose\n#endif\nasm( "insv 4(ap),r11,r10,(r9)" );"""
c_insv = """bp += (r_off >> 3); r_off &= 7; *bp = (*bp & rmask[r_off]) | ((code << r_off) & lmask[r_off]); bp++; bits -= (8 - r_off); code >>= 8 - r_off; if ( bits >= 8 ) { *bp = code; bp++; bits -= 8; code >>= 8; } if ( bits > 0 ) *bp = code;"""
vax_extv = """#ifndef vax\nYou lose\n#endif\nasm( "extzv r10,r9,(r8),r11" );"""
c_extv = """bp += (r_off >> 3); code = ((unsigned char)bp[0] | ((unsigned char)bp[1] << 8) | ((unsigned char)bp[2] << 16)) >> (r_off & 7); code &= (1 << n_bits) - 1;"""
getopt_code = """
int ch_opt;
while ((ch_opt = getopt(argc, argv, "d")) != -1) {
    if (ch_opt == 'd') decompress_flg = 1;
}
"""
code = code.replace("static char buf[BITS];", masks)
code = code.replace(vax_insv, c_insv)
code = code.replace(vax_extv, c_extv)
code = code.replace("compress( infile );\nelse if", "{ compress( infile ); exit(0); }\nelse if")
code = code.replace("#endif\n\nif ( maxbits > BITS )", getopt_code + "\n#endif\n\nif ( maxbits > BITS )")
with open(out_file, "w") as f:
    f.write(code)
EOF

# 1b. Prepare compress 1.6 (August 1984, Joe Orost)
TMP_C16="$TMP_DIR/compress-1.6.c"
python3 - "$REPO_ROOT" "$TMP_C16" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/compress/compress-1.6/compress.c")
with open(src_file, "r") as f:
    code = f.read()
code = code.replace("compress( infile );\nelse", "{ compress( infile ); exit(0); }\nelse")
with open(out_file, "w") as f:
    f.write(code)
EOF

# 1c. Prepare compact & uncompact (4.1cBSD McMaster 1979)
TMP_COMPACT_DIR="$TMP_DIR/compact_src"
mkdir -p "$TMP_COMPACT_DIR"
python3 - "$REPO_ROOT" "$TMP_COMPACT_DIR" << 'EOF'
import sys, os
repo_root, out_dir = sys.argv[1], sys.argv[2]
hdr_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-compact.h")
cmp_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-compact.c")
unc_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-uncompact.c")
tree_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-tree.c")

with open(hdr_src, "r") as f: hdr_code = f.read()
with open(cmp_src, "r") as f: cmp_code = f.read()
with open(unc_src, "r") as f: unc_code = f.read()
with open(tree_src, "r") as f: tree_code = f.read()

hdr_code = hdr_code.replace("int ch;", "long ch;").replace("typedef int longint;", "typedef long longint;")
hdr_code = hdr_code.replace("dir [514]", "dir [1024]")
cmp_code = cmp_code.replace('#include "compact.h"', '#include "compact.h"\n#include <unistd.h>')
cmp_code = cmp_code.replace("dir [513] . next = NULL;", "dir [1023] . next = NULL;").replace("(j = 513)", "(j = 1023)")
unc_code = unc_code.replace('#include "compact.h"', '#include "compact.h"\n#include <unistd.h>')
unc_code = unc_code.replace("dir [513] . next = NULL;", "dir [1023] . next = NULL;").replace("(j = 513)", "(j = 1023)")
unc_code = unc_code.replace("if (d . integ == EF) break;", "if (d . integ == EF) { if (i >= argc) { fclose(cfp); fclose(uncfp); exit(0); } goto closeboth; }")

old_copy = """			q . ch = t -> sp [ts] . ch;	/*  {					*/
			s . ch = r -> sp [rs] . ch;	/*  {					*/
			t -> sp [ts] . ch = s . ch;	/*  { change code when Cory gets v. 7	*/
			r -> sp [rs] . ch = q . ch;	/*  {					*/"""
new_copy = """			q = t -> sp [ts];
			s = r -> sp [rs];
			t -> sp [ts] = s;
			r -> sp [rs] = q;"""
tree_code = tree_code.replace(old_copy, new_copy)
tree_code = tree_code.replace("exch (t, ts, q . ch, r, rs);", "exch (t, ts, q, r, rs);")
tree_code = tree_code.replace("exch (r, rs, s . ch, t, ts);", "exch (r, rs, s, t, ts);")

with open(os.path.join(out_dir, "compact.h"), "w") as f: f.write(hdr_code)
with open(os.path.join(out_dir, "compact.c"), "w") as f: f.write(cmp_code)
with open(os.path.join(out_dir, "uncompact.c"), "w") as f: f.write(unc_code)
with open(os.path.join(out_dir, "tree.c"), "w") as f: f.write(tree_code)
EOF

# 1d. Prepare opcat & opack (PDP-11 oldpack Zucker ~1977 / modernized port)
TMP_OPCAT_C="$TMP_DIR/opcat.c"
python3 - "$REPO_ROOT" "$TMP_OPCAT_C" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/pack-unpack-pcat/pts-opack-port/pcat.c")
with open(src_file, "r") as f: code = f.read()
code = code.replace("*a++rgv", "*++argv")
code = code.replace("short keysize, hi, lo;", "unsigned short keysize, hi, lo;")
with open(out_file, "w") as f: f.write(code)
EOF

# 1e. Prepare bzip 0.21 (August 1996, Julian Seward)
TMP_BZIP_C="$TMP_DIR/bzip-0.21.c"
python3 - "$REPO_ROOT" "$TMP_BZIP_C" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/bzip-0.21-ami/bzip.c")
with open(src_file, "r") as f:
    code = f.read()
code = code.replace("#define MY_S_IFREG  S_IFREG", "#define MY_S_IFREG(x)  S_ISREG(x)")
code = code.replace("void mySignalCatcher ( IntNative *n )", "void mySignalCatcher ( IntNative n )")
code = code.replace("void mySIGSEGVorSIGBUScatcher ( IntNative *n )", "void mySIGSEGVorSIGBUScatcher ( IntNative n )")
with open(out_file, "w") as f:
    f.write(code)
EOF

# Compile historical tools
echo "Compiling historical tools..."
gcc -w -std=gnu89 -fcommon -DNO_SCANARGS=1 -O2 -o "$TMP_DIR/compress-1.0" "$TMP_C1"
gcc -w -std=gnu89 -fcommon -DNO_SCANARGS=1 -O2 -o "$TMP_DIR/compress-1.6" "$TMP_C16"
gcc -w -std=gnu89 -fcommon -O2 -o "$TMP_DIR/compress-2.0" "$REPO_ROOT/old/unix-tools/compress/compress-2.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$TMP_DIR/compress-3.0" "$REPO_ROOT/old/unix-tools/compress/compress-3.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$TMP_DIR/compress-4.0" "$REPO_ROOT/old/unix-tools/compress/compress-4.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$TMP_DIR/compress-apollo" "$REPO_ROOT/old/unix-tools/compress/compress-apollo/compress.c"
gcc -w -std=gnu89 -O2 -o "$TMP_DIR/ncompress" "$REPO_ROOT/old/unix-tools/ncompress/compress.c"
gcc -w -std=gnu89 -O2 -o "$TMP_DIR/sys3-pack" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/sys3-pack.c"
gcc -w -std=gnu89 -O2 -o "$TMP_DIR/sys3-pcat" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/sys3-pcat.c"
gcc -w -O2 -o "$TMP_DIR/opack" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/pts-opack-port/pack.c"
gcc -w -O2 -o "$TMP_DIR/opcat" "$TMP_OPCAT_C"
gcc -w -std=gnu89 -fcommon -O2 -I "$TMP_COMPACT_DIR" -o "$TMP_DIR/compact" "$TMP_COMPACT_DIR/compact.c" "$TMP_COMPACT_DIR/tree.c"
gcc -w -std=gnu89 -fcommon -O2 -I "$TMP_COMPACT_DIR" -o "$TMP_DIR/uncompact" "$TMP_COMPACT_DIR/uncompact.c" "$TMP_COMPACT_DIR/tree.c"
gcc -w -O2 -o "$TMP_DIR/bzip-0.21" "$TMP_BZIP_C"

echo "=== 2. Preparing Test Datasets and Corpora ==="

# Synthetic datasets
echo -n "The quick brown fox jumps over the lazy dog. 1234567890!" > "$TMP_DIR/in_fox.txt"

python3 -c "
with open('$TMP_DIR/in_rep.txt', 'wb') as f:
    f.write(b'ABCDEFGH12345678\n' * 1500)
"

cp "$RAW_FILE" "$TMP_DIR/in_lemurs.pan"

python3 -c "
import random
random.seed(42)
with open('$TMP_DIR/in_rand.bin', 'wb') as f:
    f.write(bytes([random.randint(0, 255) for _ in range(3276800)]))
"

DATASETS=(
    "$TMP_DIR/in_fox.txt"
    "$TMP_DIR/in_rep.txt"
    "$TMP_DIR/in_lemurs.pan"
    "$TMP_DIR/in_rand.bin"
)

# Collect all files from old/corpora unless in fast mode
if [ "$FAST_MODE" -eq 0 ] && [ -d "$REPO_ROOT/old/corpora" ]; then
    while IFS= read -r -d '' cfile; do
        DATASETS+=("$cfile")
    done < <(find "$REPO_ROOT/old/corpora" -type f -print0 | sort -z)
fi

echo "Total test datasets: ${#DATASETS[@]}"

echo "=== 3. Helper Functions for Standardized Invocations ==="

ctb_compress() {
    local fmt="$1" in_file="$2" out_file="$3"
    $CTB_BIN compress "$fmt" "$in_file" -o "$out_file" --force
}

ctb_decompress() {
    local in_file="$1" out_file="$2" fmt="${3:-}"
    if [ -n "$fmt" ]; then
        $CTB_BIN decompress "$fmt" "$in_file" -o "$out_file" --force
    elif [[ "$in_file" == *.Z1.0 ]]; then
        $CTB_BIN decompress compress1 "$in_file" -o "$out_file" --force
    elif [[ "$in_file" == *.Z1.6 ]]; then
        $CTB_BIN decompress compress16 "$in_file" -o "$out_file" --force
    else
        $CTB_BIN decompress "$in_file" -o "$out_file" --force
    fi
}

historic_compress() {
    local tool="$1" in_file="$2" out_file="$3"
    case "$tool" in
        compress-1.0)
            "$TMP_DIR/compress-1.0" < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        compress-1.6)
            "$TMP_DIR/compress-1.6" < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        compress-2.0)
            "$TMP_DIR/compress-2.0" -f -c < "$in_file" > "$out_file" 2>/dev/null || [ $? -eq 2 ]
            ;;
        compress-3.0)
            "$TMP_DIR/compress-3.0" -f -c < "$in_file" > "$out_file" 2>/dev/null || [ $? -eq 2 ]
            ;;
        compress-4.0)
            "$TMP_DIR/compress-4.0" -f -c < "$in_file" > "$out_file" 2>/dev/null || [ $? -eq 2 ]
            ;;
        compress-apollo)
            "$TMP_DIR/compress-apollo" -f -c < "$in_file" > "$out_file" 2>/dev/null || [ $? -eq 2 ]
            ;;
        ncompress)
            "$TMP_DIR/ncompress" -f -c < "$in_file" > "$out_file" 2>/dev/null || [ $? -eq 2 ]
            ;;
        compact)
            "$TMP_DIR/compact" < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        sys3-pack)
            local stem="sp_$RANDOM"
            cp "$in_file" "$TMP_DIR/$stem"
            (cd "$TMP_DIR" && ./sys3-pack "$stem" >/dev/null 2>&1 || true)
            if [ -f "$TMP_DIR/$stem.z" ]; then
                mv "$TMP_DIR/$stem.z" "$out_file"
            else
                rm -f "$out_file"
            fi
            rm -f "$TMP_DIR/$stem"
            ;;
        opack)
            local stem="op_$RANDOM"
            cp "$in_file" "$TMP_DIR/$stem"
            (cd "$TMP_DIR" && ./opack "$stem" >/dev/null 2>&1 || true)
            if [ -f "$TMP_DIR/$stem.z" ]; then
                mv "$TMP_DIR/$stem.z" "$out_file"
            else
                rm -f "$out_file"
            fi
            rm -f "$TMP_DIR/$stem"
            ;;
        gzip)
            gzip -c < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        bzip-0.21)
            "$TMP_DIR/bzip-0.21" < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        bzip2)
            bzip2 -c < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        brotli)
            brotli -c < "$in_file" > "$out_file" 2>/dev/null || true
            ;;
        *)
            echo "Unknown historic compressor: $tool" >&2
            return 1
            ;;
    esac
}

historic_decompress() {
    local tool="$1" in_file="$2" out_file="$3"
    case "$tool" in
        compress-1.0)
            "$TMP_DIR/compress-1.0" -d < "$in_file" > "$out_file"
            ;;
        compress-1.6)
            "$TMP_DIR/compress-2.0" -c -d -n < "$in_file" > "$out_file"
            ;;
        compress-2.0)
            "$TMP_DIR/compress-2.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-3.0)
            "$TMP_DIR/compress-3.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-4.0)
            "$TMP_DIR/compress-4.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-apollo)
            "$TMP_DIR/compress-apollo" -c -d < "$in_file" > "$out_file"
            ;;
        ncompress)
            "$TMP_DIR/ncompress" -c -d < "$in_file" > "$out_file"
            ;;
        sys3-pcat)
            local stem="pc_$RANDOM.z"
            cp "$in_file" "$TMP_DIR/$stem"
            (cd "$TMP_DIR" && ./sys3-pcat "$stem" > "$out_file")
            rm -f "$TMP_DIR/$stem"
            ;;
        opcat)
            "$TMP_DIR/opcat" "$in_file" > "$out_file"
            ;;
        uncompact)
            "$TMP_DIR/uncompact" < "$in_file" > "$out_file" 2>/dev/null
            ;;
        bzip-0.21)
            "$TMP_DIR/bzip-0.21" -d < "$in_file" > "$out_file" 2>/dev/null
            ;;
        gunzip)
            gunzip -c < "$in_file" > "$out_file"
            ;;
        bzip2)
            bzip2 -d -c < "$in_file" > "$out_file"
            ;;
        brotli)
            brotli -d -c < "$in_file" > "$out_file"
            ;;
        *)
            echo "Unknown historic decompressor: $tool" >&2
            return 1
            ;;
    esac
}

tool_ext() {
    case "$1" in
        compress-1.0) echo ".Z1.0" ;;
        compress-1.6) echo ".Z1.6" ;;
        compress*|ncompress) echo ".Z" ;;
        compact) echo ".C" ;;
        sys3-pack) echo ".z" ;;
        opack) echo ".old.z" ;;
        bzip-0.21) echo ".bz" ;;
        gzip) echo ".gz" ;;
        bzip2) echo ".bz2" ;;
        brotli) echo ".br" ;;
        *) echo ".compressed" ;;
    esac
}

tool_fmt() {
    case "$1" in
        compress-1.0) echo "compress1" ;;
        compress-1.6) echo "compress16" ;;
        compress-2.0) echo "compress2" ;;
        compress-3.0) echo "compress3" ;;
        compress*|ncompress) echo "compress" ;;
        compact) echo "compact" ;;
        sys3-pack) echo "pack" ;;
        opack) echo "old-pack" ;;
        bzip-0.21) echo "bzip" ;;
        gzip) echo "gzip" ;;
        bzip2) echo "bzip2" ;;
        brotli) echo "brotli" ;;
        *) echo "" ;;
    esac
}

echo "=== 4. Testing ctoolbox -> Historical Decompressors (Forward Compatibility) ==="

FORWARD_TESTS=(
    "compress1:compress-1.0"
    "compress16:compress-1.6"
    "compress2:compress-2.0"
    "compress3:compress-3.0"
    "compress:compress-4.0"
    "compress:compress-apollo"
    "compress:ncompress"
    "pack:sys3-pcat"
    "old-pack:opcat"
    "compact:uncompact"
    "bzip:bzip-0.21"
)

if command -v gunzip >/dev/null 2>&1; then
    FORWARD_TESTS+=(
        "gzip:gunzip"
        "sco-compress:gunzip"
        "pack:gunzip"
        "compress:gunzip"
        "compress2:gunzip"
        "compress3:gunzip"
    )
else
    echo "gunzip not found!"
fi

if command -v bzip2 >/dev/null 2>&1; then
    FORWARD_TESTS+=("bzip2:bzip2")
else
    echo "bzip2 not found!"
fi

if command -v brotli >/dev/null 2>&1; then
    FORWARD_TESTS+=("brotli:brotli")
else
    echo "brotli not found!"
fi

for pair in "${FORWARD_TESTS[@]}"; do
    fmt="${pair%%:*}"
    tool="${pair##*:}"
    if [ -n "$FILTER" ]; then
        if [[ "$fmt" != *"$FILTER"* && "$tool" != *"$FILTER"* && "$pair" != *"$FILTER"* ]]; then
            continue
        fi
    fi
    for in_path in "${DATASETS[@]}"; do
        dataset="$(basename "$in_path")"
        if [ -n "$DATASET_FILTER" ]; then
            if [[ "$dataset" != *"$DATASET_FILTER"* ]]; then
                continue
            fi
        fi
        c_path="$TMP_DIR/fwd_${fmt}_${dataset}.compressed"
        d_path="$TMP_DIR/fwd_${fmt}_${tool}_${dataset}.decompressed"

        echo "Testing Forward: format '$fmt' -> tool '$tool' on '$dataset'..."
        ctb_compress "$fmt" "$in_path" "$c_path"
        historic_decompress "$tool" "$c_path" "$d_path"
        cmp "$in_path" "$d_path"
    done
done

echo "=== 5. Testing Compressors -> ctoolbox (Reverse Compatibility) ==="

REVERSE_COMPRESSORS=(
    "compress-1.0"
    "compress-2.0"
    "compress-3.0"
    "compress-4.0"
    "compress-apollo"
    "ncompress"
    "compact"
    "sys3-pack"
    "opack"
    "bzip-0.21"
)

if command -v gzip >/dev/null 2>&1; then
    REVERSE_COMPRESSORS+=("gzip")
fi

if command -v bzip2 >/dev/null 2>&1; then
    REVERSE_COMPRESSORS+=("bzip2")
fi

if command -v brotli >/dev/null 2>&1; then
    REVERSE_COMPRESSORS+=("brotli")
fi

for tool in "${REVERSE_COMPRESSORS[@]}"; do
    ext="$(tool_ext "$tool")"
    if [ -n "$FILTER" ]; then
        if [[ "$tool" != *"$FILTER"* ]]; then
            continue
        fi
    fi
    for in_path in "${DATASETS[@]}"; do
        dataset="$(basename "$in_path")"
        if [ -n "$DATASET_FILTER" ]; then
            if [[ "$dataset" != *"$DATASET_FILTER"* ]]; then
                continue
            fi
        fi
        c_path="$TMP_DIR/rev_${tool}_${dataset}${ext}"
        d_path="$TMP_DIR/rev_${tool}_${dataset}.decompressed"

        fmt="$(tool_fmt "$tool")"
        echo "Testing Reverse: tool '$tool' -> ctoolbox on '$dataset'..."
        historic_compress "$tool" "$in_path" "$c_path"
        if [ -s "$c_path" ]; then
            ctb_decompress "$c_path" "$d_path" "$fmt"
            cmp "$in_path" "$d_path"
        fi
    done
done

echo ""
echo "=== ALL HISTORICAL COMPATIBILITY TESTS (FORWARD & REVERSE ACROSS ALL CORPORA) PASSED CLEANLY! ==="
