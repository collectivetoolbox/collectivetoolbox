#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Unified compression test script: verifies bidirectional compatibility between
# ctoolbox and external/historical compression utilities across all supported formats.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
while [ "$REPO_ROOT" != "/" ] && [ ! -f "$REPO_ROOT/AGENTS.md" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done

RAW_FILE="$REPO_ROOT/src/formats/compression/data/fixtures/example2 with lemurs.pan"
if [[ ! -f "$RAW_FILE" ]]; then
    echo "Error: Base fixture raw file not found at '$RAW_FILE'." >&2
    exit 1
fi

FILTER="${FILTER:-}"
DATASET_FILTER="${DATASET_FILTER:-}"
FAST_MODE="${FAST:-${QUICK:-0}}"
JOBS="${JOBS:-12}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            echo "Usage: $0 [options] [format_or_tool_filter] [dataset_filter]"
            echo ""
            echo "Options:"
            echo "  -f, --filter FILTER     Filter test format or tool (e.g. 'compact', 'compress1', 'bzip')"
            echo "  -d, --dataset PATTERN   Filter datasets by filename substring (e.g. 'fox', 'mozilla')"
            echo "  -q, --quick, --fast     Only run synthetic datasets (skip full corpora)"
            echo "  -j, --jobs COUNT       Concurrent cases (default: JOBS or 4; use 1 for serial)"
            echo "  -h, --help              Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0 compact                  # Run only compact/uncompact tests"
            echo "  $0 bzip                     # Run only bzip tests"
            echo "  $0 compact mozilla          # Run compact on mozilla dataset only"
            echo "  $0 --fast                   # Run all compressors on quick synthetic datasets"
            exit 0
            ;;
        -q|--quick|--fast)
            FAST_MODE=1
            shift
            ;;
        -j|--jobs)
            JOBS="${2:-}"
            if [[ $# -lt 2 ]]; then
                echo "Error: --jobs requires a positive integer." >&2
                exit 1
            fi
            shift 2
            ;;
        -f|--filter)
            FILTER="$2"
            shift 2
            ;;
        -d|--dataset)
            DATASET_FILTER="$2"
            shift 2
            ;;
        *)
            if [ -z "$FILTER" ]; then
                FILTER="$1"
            elif [ -z "$DATASET_FILTER" ]; then
                DATASET_FILTER="$1"
            fi
            shift
            ;;
    esac
done

if [[ ! "$JOBS" =~ ^[1-9][0-9]{0,5}$ ]]; then
    echo "Error: JOBS/--jobs must be an integer between 1 and 999999." >&2
    exit 1
fi
if (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 1) )); then
    echo "Error: Parallel test scheduling requires Bash 5.1 or newer." >&2
    exit 1
fi

# Verify required system tools exist upfront; fail immediately if missing
for req_tool in gcc cmp gzip gunzip bzip2 brotli xz lzip lz4 zstd python3; do
    if ! command -v "$req_tool" >/dev/null 2>&1; then
        echo "Error: Required system tool '$req_tool' not found in PATH." >&2
        exit 1
    fi
done

if ! python3 -c "import ctypes.util, sys; sys.exit(0 if ctypes.util.find_library('lzo2') else 1)"; then
    echo "Error: Required library 'liblzo2' not found on system." >&2
    exit 1
fi

# Determine and validate ctoolbox binary
CANONICAL_BIN="$REPO_ROOT/built/linux-x64/ctoolbox"

get_binary_commit() {
    local bin="$1"
    "$bin" --version 2>/dev/null | sed -n 's/.*(build \([0-9a-f]\{7,\}\)).*/\1/p' || true
}

is_binary_stale() {
    local bin="$1"
    if ! command -v git >/dev/null 2>&1 || [ ! -d "$REPO_ROOT/.git" ]; then
        return 1
    fi
    local bin_commit
    bin_commit="$(get_binary_commit "$bin")"
    if [ -z "$bin_commit" ]; then
        return 0
    fi
    local behind_count
    behind_count="$(git -C "$REPO_ROOT" rev-list --count "${bin_commit}..HEAD" 2>/dev/null || echo 0)"
    if [ "$behind_count" -gt 0 ]; then
        return 0
    fi
    return 1
}

if [ -n "${CTB_BIN:-}" ]; then
    CTB_CMD=("$CTB_BIN")
    bin_ver="$(get_binary_commit "$CTB_BIN")"
    if is_binary_stale "$CTB_BIN"; then
        echo "Warning: Explicit CTB_BIN ($CTB_BIN, build ${bin_ver:-unknown}) is behind current git HEAD." >&2
    fi
else
    if [ ! -x "$CANONICAL_BIN" ] || is_binary_stale "$CANONICAL_BIN"; then
        if [ ! -x "$CANONICAL_BIN" ]; then
            echo "Canonical binary not found at $CANONICAL_BIN; building with ./build-quick --release..." >&2
        else
            bin_ver="$(get_binary_commit "$CANONICAL_BIN")"
            behind="$(git -C "$REPO_ROOT" rev-list --count "${bin_ver}..HEAD" 2>/dev/null || echo "?")"
            echo "Binary at $CANONICAL_BIN is stale (build ${bin_ver:-unknown}, $behind commit(s) behind HEAD); rebuilding with ./build-quick --release..." >&2
        fi
        "$REPO_ROOT/build-quick" --release || {
            echo "Error: Failed to rebuild ctoolbox with ./build-quick --release." >&2
            exit 1
        }
    fi
    CTB_CMD=("$CANONICAL_BIN")
fi

echo "Using ctoolbox binary: ${CTB_CMD[*]} ($("${CTB_CMD[@]}" --version 2>/dev/null || echo 'unknown version'))"

mkdir -p "$REPO_ROOT/built"
TMP_DIR="$(mktemp -d "$REPO_ROOT/built/tmp_test_compressors_XXXXXX")"
declare -A ACTIVE_JOBS=()
cleanup() {
    local worker_pid
    for worker_pid in "${!ACTIVE_JOBS[@]}"; do
        wait "$worker_pid" || true
    done
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

# 1. Compile historical tools using shared build script
"$SCRIPT_DIR/build-historic-compressors" "$TMP_DIR"
HIST_BINARIES=()
for hist_tool in compress-1.0 compress-1.6 compress-2.0 compress-3.0 compress-4.0 compress-apollo ncompress compact uncompact sys3-pack sys3-pcat opack opcat bzip-0.21 freeze rzip; do
    if [[ ! -x "$TMP_DIR/$hist_tool" ]]; then
        echo "Error: Historical compression tool '$hist_tool' failed to build or is missing." >&2
        exit 1
    fi
    HIST_BINARIES+=("$TMP_DIR/$hist_tool")
done

# 2. Prepare test datasets
echo "=== Preparing Test Datasets ==="
echo -n "The quick brown fox jumps over the lazy dog. 1234567890!" > "$TMP_DIR/in_fox.txt"

python3 -c "
with open('$TMP_DIR/in_rep.txt', 'wb') as f:
    f.write(b'ABCDEFGH12345678\n' * 1500)
"

cp "$RAW_FILE" "$TMP_DIR/in_lemurs.pan"

python3 -c "
import random
random.seed(42)
with open('$TMP_DIR/in_rand.bin', 'wb') as f:
    f.write(bytes([random.randint(0, 255) for _ in range(65536)]))
for size in (0, 1, 2, 3, 65535, 65536, 65537):
    with open('$TMP_DIR/in_boundary_%d.bin' % size, 'wb') as f:
        f.write(bytes(random.randrange(256) for _ in range(size)))
"

python3 -c "
import random
random.seed(42)
with open('$TMP_DIR/in_rand2.bin', 'wb') as f:
    f.write(bytes([random.randint(0, 255) for _ in range(3276800)]))
"
python3 -c "
import random
random.seed(42)
with open('$TMP_DIR/in_rand3.bin', 'wb') as f:
    f.write(bytes([random.randint(0, 255) for _ in range(67108864)]))
"
DATASETS=(
    "$TMP_DIR/in_fox.txt"
    "$TMP_DIR/in_rep.txt"
    "$TMP_DIR/in_lemurs.pan"
    "$TMP_DIR/in_ran"*".bin"
    "$TMP_DIR"/in_boundary_*.bin
)

if [[ "$FAST_MODE" -eq 0 ]]; then
    if [[ ! -d "$REPO_ROOT/old/corpora" ]]; then
        echo "Error: Full compatibility testing requires old/corpora; use --fast for synthetic datasets." >&2
        exit 1
    fi
    corpus_count=0
    while IFS= read -r -d '' cfile; do
        DATASETS+=("$cfile")
        corpus_count=$((corpus_count + 1))
    done < <(find "$REPO_ROOT/old/corpora" -type f -print0 | sort -z)
    if [[ "$corpus_count" -eq 0 ]]; then
        echo "Error: The compatibility corpus contains no files." >&2
        exit 1
    fi
fi

echo "Total test datasets: ${#DATASETS[@]}"
for ds_path in "${DATASETS[@]}"; do
    if [[ ! -f "$ds_path" ]]; then
        echo "Error: Test dataset file '$ds_path' not found." >&2
        exit 1
    fi
done

# 3. Invocation helpers
ctb_compress() {
    local fmt="$1" in_file="$2" out_file="$3"
    "${CTB_CMD[@]}" compress "$fmt" "$in_file" -o "$out_file" --force
}

ctb_decompress() {
    local fmt="$1" in_file="$2" out_file="$3"
    "${CTB_CMD[@]}" decompress "$fmt" "$in_file" -o "$out_file" --force
}

tool_compress() {
    local tool="$1" in_file="$2" out_file="$3"
    case "$tool" in
        compress-1.0)
            "$TMP_DIR/compress-1.0" < "$in_file" > "$out_file"
            ;;
        compress-1.6)
            "$TMP_DIR/compress-1.6" < "$in_file" > "$out_file"
            ;;
        compress-2.0)
            "$TMP_DIR/compress-2.0" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        compress-3.0)
            "$TMP_DIR/compress-3.0" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        compress-4.0)
            "$TMP_DIR/compress-4.0" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        compress-4.0-12)
            "$TMP_DIR/compress-4.0" -b 12 -f -c < "$in_file" > "$out_file" || [[ $? -eq 2 ]]
            ;;
        compress-apollo)
            "$TMP_DIR/compress-apollo" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        ncompress)
            "$TMP_DIR/ncompress" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        compact)
            "$TMP_DIR/compact" < "$in_file" > "$out_file"
            # Note that compact can say "Does not save bytes." but when using a pipe it still works
            if [[ "$(wc -c < "$in_file")" -eq 1 && ! -s "$out_file" ]]; then
                REVERSE_SKIP_REASON="BSD compact requires two input bytes to emit a stream"
            fi
            ;;
        sys3-pack)
            local stem="sp_$RANDOM"
            cp "$in_file" "$TMP_DIR/$stem"
            local status=0 message
            message="$(cd "$TMP_DIR" && ./sys3-pack "$stem" 2>&1)" || status=$?
            if [[ "$status" -eq 0 ]]; then
                mv "$TMP_DIR/$stem.z" "$out_file"
                # Historical sys3-pack (1978) lacks length-limited Huffman tree construction
                # and aborts when unconstrained tree depth exceeds 24 levels.
            elif [[ "$status" -eq 1 && ( "$message" == *": no saving - file unchanged" || "$message" == *": trivial file - file unchanged" || "$message" == *": Huffman tree has too many levels - file unchanged" ) ]]; then
                REVERSE_SKIP_REASON="$message"
            else
                echo "sys3-pack failed ($status): $message" >&2
                return 1
            fi
            if [[ -e "$TMP_DIR/$stem" ]]; then rm "$TMP_DIR/$stem"; fi
            ;;
        opack)
            local stem="op_$RANDOM"
            cp "$in_file" "$TMP_DIR/$stem"
            local status=0 message
            message="$(cd "$TMP_DIR" && ./opack -s "$stem" 2>&1)" || status=$?
            if [[ "$status" -eq 0 ]]; then
                mv "$TMP_DIR/$stem.z" "$out_file"
            elif [[ "$status" -eq 2 && "$message" == *": Trivial file" ]]; then
                REVERSE_SKIP_REASON="$message"
            else
                echo "opack failed ($status): $message" >&2
                return 1
            fi
            if [[ -e "$TMP_DIR/$stem" ]]; then rm "$TMP_DIR/$stem"; fi
            ;;
        bzip-0.21)
            "$TMP_DIR/bzip-0.21" < "$in_file" > "$out_file"
            ;;
        freeze)
            "$TMP_DIR/freeze" -f -c < "$in_file" > "$out_file" || [ $? -eq 2 ]
            ;;
        rzip)
            "$TMP_DIR/rzip" -k -f -o "$out_file" "$in_file"
            ;;
        gzip)
            gzip -n -c < "$in_file" > "$out_file"
            ;;
        bzip2)
            bzip2 -c < "$in_file" > "$out_file"
            ;;
        brotli)
            brotli -c < "$in_file" > "$out_file"
            ;;
        xz)
            xz -c < "$in_file" > "$out_file"
            ;;
        lzma)
            xz --format=lzma -c < "$in_file" > "$out_file"
            ;;
        lzma2)
            xz --format=raw --lzma2=dict=8MiB -c < "$in_file" > "$out_file"
            ;;
        lzip|lz4|zstd)
            "$tool" -c < "$in_file" > "$out_file"
            ;;
        deflate|zlib|lzo)
            python3 "$SCRIPT_DIR/codec-oracle.py" compress "$tool" < "$in_file" > "$out_file"
            ;;
        ctoolbox)
            # Self-compression for formats without external CLI
            ctb_compress "$CURRENT_FORMAT" "$in_file" "$out_file"
            ;;
        *)
            echo "Unknown tool for compression: $tool" >&2
            exit 1
            ;;
    esac
}

tool_decompress() {
    local tool="$1" in_file="$2" out_file="$3"
    case "$tool" in
        compress-1.0)
            "$TMP_DIR/compress-1.0" -d < "$in_file" > "$out_file"
            ;;
        compress-1.6)
            "$TMP_DIR/compress-1.6" -d < "$in_file" > "$out_file"
            ;;
        compress-2.0)
            "$TMP_DIR/compress-2.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-3.0)
            "$TMP_DIR/compress-3.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-4.0|compress-4.0-12)
            "$TMP_DIR/compress-4.0" -c -d < "$in_file" > "$out_file"
            ;;
        compress-apollo)
            "$TMP_DIR/compress-apollo" -c -d < "$in_file" > "$out_file"
            ;;
        ncompress)
            "$TMP_DIR/ncompress" -c -d < "$in_file" > "$out_file"
            ;;
        uncompact)
            "$TMP_DIR/uncompact" < "$in_file" > "$out_file"
            ;;
        sys3-pcat)
            local stem="pc_$RANDOM.z"
            cp "$in_file" "$TMP_DIR/$stem"
            (cd "$TMP_DIR" && ./sys3-pcat "$stem" > "$out_file")
            rm "$TMP_DIR/$stem"
            ;;
        opcat)
            "$TMP_DIR/opcat" "$in_file" > "$out_file"
            ;;
        bzip-0.21)
            "$TMP_DIR/bzip-0.21" -d < "$in_file" > "$out_file"
            ;;
        freeze)
            "$TMP_DIR/freeze" -d -c < "$in_file" > "$out_file"
            ;;
        rzip)
            "$TMP_DIR/rzip" -d -k -f -o "$out_file" "$in_file"
            ;;
        gunzip)
            gunzip -c < "$in_file" > "$out_file"
            ;;
        bzip2)
            bzip2 -d -c < "$in_file" > "$out_file"
            ;;
        brotli)
            brotli -d -c < "$in_file" > "$out_file"
            ;;
        xz)
            xz -d -c < "$in_file" > "$out_file"
            ;;
        lzma)
            xz --format=lzma -d -c < "$in_file" > "$out_file"
            ;;
        lzma2)
            xz --format=raw --lzma2=dict=8MiB -d -c < "$in_file" > "$out_file"
            ;;
        lzip|lz4|zstd)
            "$tool" -d -c < "$in_file" > "$out_file"
            ;;
        deflate|zlib|lzo)
            python3 "$SCRIPT_DIR/codec-oracle.py" decompress "$tool" --raw-size "$(wc -c < "$in_path")" < "$in_file" > "$out_file"
            ;;
        ctoolbox)
            # Self-decompression for formats without external CLI
            ctb_decompress "$CURRENT_FORMAT" "$in_file" "$out_file"
            ;;
        *)
            echo "Unknown tool for decompression: $tool" >&2
            exit 1
            ;;
    esac
}

# -----------------------------------------------------------------------------
# 4. Declarative Unified Test Matrix for Supported Formats
# Format: format|tool_name|ext|test_forward|test_reverse|comp_tool|decomp_tool
# -----------------------------------------------------------------------------
TEST_MATRIX=(
    # Historical LZW variants
    "compress1|compress-1.0|.1.0.Z|1|1|compress-1.0|compress-1.0"
    "compress16|compress-1.6|.1.6.Z|1|1|compress-1.6|compress-1.6"
    "compress2|compress-2.0|.2.0.Z|1|1|compress-2.0|compress-2.0"
    "compress2|gunzip|.2.0.Z|1|0||gunzip"
    "compress|compress-3.0|.3.0.Z|1|1|compress-3.0|compress-3.0"
    "compress|compress-4.0|.Z|1|1|compress-4.0|compress-4.0"
    "compress|compress-4.0-12|.12.Z|1|1|compress-4.0-12|compress-4.0-12"
    "compress|compress-apollo|.Z|1|1|compress-apollo|compress-apollo"
    "compress|ncompress|.Z|1|1|ncompress|ncompress"
    "compress|gunzip|.Z|1|0||gunzip"

    # Historical Huffman & BSD
    "pack|sys3-pack|.z|1|1|sys3-pack|sys3-pcat"
    "pack|gunzip|.z|1|0||gunzip"
    "old-pack|opack|.old.z|1|1|opack|opcat"
    "compact|compact|.C|1|1|compact|uncompact"

    # Historical Freeze, Bzip, and Rzip
    "bzip|bzip-0.21|.bz|1|1|bzip-0.21|bzip-0.21"
    "freeze2|freeze|.2.0.F|1|1|freeze|freeze"
    "freeze1|freeze|.synthetic.1.0.F|1|0||freeze"
    "rzip|rzip|.rz|1|1|rzip|rzip"

    # Modern System Tools
    "gzip|gzip|.gz|1|1|gzip|gunzip"
    "bzip2|bzip2|.bz2|1|1|bzip2|bzip2"
    "brotli|brotli|.br|1|1|brotli|brotli"
    "xz|xz|.xz|1|1|xz|xz"

    # In-repo synthetic / SCO
    "sco-compress|gunzip|.synthetic.sco|1|0||gunzip"
    "sco-compress|ctoolbox|.synthetic.sco|1|1|ctoolbox|ctoolbox"

    # Independent oracles for library-wrapped formats
    "deflate|zlib|.deflate|1|1|deflate|deflate"
    "zlib|zlib|.zz|1|1|zlib|zlib"
    "lz4|lz4|.lz4|1|1|lz4|lz4"
    "lzma|xz|.lzma|1|1|lzma|lzma"
    "lzma2|xz|.lzma2|1|1|lzma2|lzma2"
    "lzip|lzip|.lz|1|1|lzip|lzip"
    "zstd|zstd|.zst|1|1|zstd|zstd"
    "lzo|liblzo2|.lzo|1|1|lzo|lzo"
)

record_result() {
    local status="$1" reason="${2:-}" compressed_bytes="-"
    if [[ -f "$c_file" ]]; then
        compressed_bytes="$(wc -c < "$c_file")"
    fi
    printf '%s\0' "$status" "$direction" "$fmt" "$tool" "$input_label" \
        "$raw_bytes" "$compressed_bytes" "$elapsed" "$reason" >> "$TMP_DIR/results"
}

time_compression() {
    local TIMEFORMAT='%R'
    elapsed="-"
    { time "$@" 2>&3; } 3>&2 2> "$TMP_DIR/compression.time"
    read -r elapsed < "$TMP_DIR/compression.time"
}

run_case() (
    row="$1" in_path="$2" TMP_DIR="$3"
    raw_bytes="-" c_file="" direction="Case" elapsed="-"
    IFS="|" read -r fmt tool ext do_fwd do_rev comp_tool decomp_tool <<< "$row"
    CURRENT_FORMAT="$fmt"
    dataset="$(basename "$in_path")"
    input_label="${in_path#"$REPO_ROOT/"}"
    if [[ "$in_path" == "$RUN_DIR/"* ]]; then input_label="$dataset"; fi
    trap 'status=$?; if [[ "$status" -ne 0 ]]; then record_result FAIL "Command failed (exit $status); see case log"; fi' EXIT
    ln -s "${HIST_BINARIES[@]}" "$TMP_DIR/"
    raw_bytes="$(wc -c < "$in_path")"

    if [[ ! -s "$in_path" && ( "$fmt" == compact || "$fmt" == compress1 || "$fmt" == compress16 || "$fmt" == old-pack || "$fmt" == pack || "$fmt" == lzo || "$tool" == compress-2.0 || "$tool" == compress-3.0 ) ]]; then
        echo "[Skip] '$fmt' / '$tool': historical oracle or raw-stream convention does not support empty input"
        record_result SKIP "historical oracle or raw-stream convention does not support empty input"
        return
    fi

    # Forward Test: ctoolbox compress -> external tool decompress
    if [ "$do_fwd" -eq 1 ]; then
        direction="Forward"
        c_file="$TMP_DIR/forward${ext}"
        d_file="$TMP_DIR/forward.decompressed"

        echo "[Forward] ctoolbox compress '$fmt' -> '$decomp_tool' decompress on '$dataset'..."
        time_compression ctb_compress "$fmt" "$in_path" "$c_file"
        tool_decompress "$decomp_tool" "$c_file" "$d_file"
        if ! cmp "$in_path" "$d_file"; then
            echo "FAIL: Forward roundtrip mismatch: format '$fmt', decompressor '$decomp_tool', dataset '$dataset'" >&2
            exit 1
        fi
        record_result PASS
        rm "$c_file" "$d_file"
    fi

    # Reverse Test: external tool compress -> ctoolbox decompress
    if [ "$do_rev" -eq 1 ]; then
        direction="Reverse"
        c_file="$TMP_DIR/reverse${ext}"
        d_file="$TMP_DIR/reverse.decompressed"

        echo "[Reverse] '$comp_tool' compress -> ctoolbox decompress '$fmt' on '$dataset'..."
        REVERSE_SKIP_REASON=""
        time_compression tool_compress "$comp_tool" "$in_path" "$c_file"
        if [[ -n "$REVERSE_SKIP_REASON" ]]; then
            echo "  [Skip] $REVERSE_SKIP_REASON"
            record_result SKIP "$REVERSE_SKIP_REASON"
        elif [[ -f "$c_file" ]]; then
            ctb_decompress "$fmt" "$c_file" "$d_file"
            if ! cmp "$in_path" "$d_file"; then
                echo "FAIL: Reverse roundtrip mismatch: compressor '$comp_tool', ctb format '$fmt', dataset '$dataset'" >&2
                exit 1
            fi
            record_result PASS
            rm "$c_file" "$d_file"
        else
            echo "FAIL: '$comp_tool' produced no output file" >&2
            exit 1
        fi
    fi
)

run_archived_case() (
    fmt="$1" c_file="$2" in_path="$3" decomp_tool="$4" TMP_DIR="$5"
    tool="ctoolbox" direction="Archived" elapsed="-" raw_bytes="-"
    CURRENT_FORMAT="$fmt"
    input_label="$(basename "$c_file")"
    trap 'status=$?; if [[ "$status" -ne 0 ]]; then record_result FAIL "Command failed (exit $status); see case log"; fi' EXIT
    ln -s "${HIST_BINARIES[@]}" "$TMP_DIR/"
    if [[ ! -f "$c_file" || ! -f "$in_path" ]]; then
        echo "Error: Archived fixture '$c_file' or raw file '$in_path' not found." >&2
        exit 1
    fi
    raw_bytes="$(wc -c < "$in_path")"
    echo "[Archived] '$fmt' fixture '$input_label' -> ctoolbox and '$decomp_tool'..."
    ctb_decompress "$fmt" "$c_file" "$TMP_DIR/archived.pan"
    cmp "$in_path" "$TMP_DIR/archived.pan"
    record_result PASS
    tool="$decomp_tool"
    tool_decompress "$decomp_tool" "$c_file" "$TMP_DIR/archived.pan"
    cmp "$in_path" "$TMP_DIR/archived.pan"
    record_result PASS
)

RUN_DIR="$TMP_DIR"
CASE_COUNT=0
FAILED_CASES=0

wait_for_case() {
    local finished_pid status=0 case_dir
    wait -n -p finished_pid "${!ACTIVE_JOBS[@]}" || status=$?
    case_dir="${ACTIVE_JOBS[$finished_pid]}"
    cat "$case_dir/log"
    printf '%s\n' "$status" > "$case_dir/exit-status"
    if [[ "$status" -ne 0 ]]; then
        echo "FAIL: Case ${case_dir##*/} exited with status $status" >&2
        FAILED_CASES=$((FAILED_CASES + 1))
    fi
    unset 'ACTIVE_JOBS[$finished_pid]'
}

schedule_case() {
    local case_dir
    if [[ "${#ACTIVE_JOBS[@]}" -ge "$JOBS" ]]; then wait_for_case; fi
    CASE_COUNT=$((CASE_COUNT + 1))
    case_dir="$RUN_DIR/case_$CASE_COUNT"
    mkdir "$case_dir"
    "$@" "$case_dir" > "$case_dir/log" 2>&1 &
    ACTIVE_JOBS[$!]="$case_dir"
}

echo "=== Running Compression Compatibility Tests ($JOBS concurrent cases) ==="

for row in "${TEST_MATRIX[@]}"; do
    IFS="|" read -r fmt tool ext do_fwd do_rev comp_tool decomp_tool <<< "$row"

    # Filtering
    if [[ -n "$FILTER" && "$fmt" != *"$FILTER"* && "$tool" != *"$FILTER"* ]]; then continue; fi
    for in_path in "${DATASETS[@]}"; do
        dataset="$(basename "$in_path")"
        if [[ -n "$DATASET_FILTER" && "$dataset" != *"$DATASET_FILTER"* ]]; then continue; fi
        schedule_case run_case "$row" "$in_path"
    done

    fixture_suffixes=("$ext")
    case "$fmt" in
        deflate|zlib|lz4|lzma|lzma2|lzip|zstd|lzo)
            fixture_suffixes=(".ctblib$ext" ".external$ext")
            ;;
    esac
    for suffix in "${fixture_suffixes[@]}"; do
        fixture_path="$RAW_FILE$suffix"
        fixture_name="$(basename "$fixture_path")"
        if [[ -n "$DATASET_FILTER" && "$fixture_name" != *"$DATASET_FILTER"* ]]; then continue; fi
        schedule_case run_archived_case "$fmt" "$fixture_path" "$RAW_FILE" "$decomp_tool"
    done
done

if [[ -z "$FILTER" || sco-compress == *"$FILTER"* || gunzip == *"$FILTER"* ]]; then
    archive_dir="$REPO_ROOT/old/archivers/ancient/testing/test_files"
    if [[ ! -d "$archive_dir" ]]; then
        echo "Error: Archived SCO fixture corpus directory '$archive_dir' is not installed." >&2
        FAILED_CASES=$((FAILED_CASES + 1))
    else
        for pair in "test_C1_sco.Z|test_C1.raw" "test_C2_sco.Z|test_C2.xm"; do
            IFS='|' read -r compressed_name raw_name <<< "$pair"
            if [[ -n "$DATASET_FILTER" && "$compressed_name" != *"$DATASET_FILTER"* ]]; then continue; fi
            schedule_case run_archived_case sco-compress "$archive_dir/$compressed_name" "$archive_dir/$raw_name" gunzip
        done
    fi
fi

while [[ "${#ACTIVE_JOBS[@]}" -gt 0 ]]; do wait_for_case; done

python3 - "$RUN_DIR" "$CASE_COUNT" "$FAILED_CASES" <<'PY'
import csv
from decimal import Decimal
import pathlib
import sys

run_dir = pathlib.Path(sys.argv[1])
case_count, failures = map(int, sys.argv[2:])
passed = skipped = 0
summaries = {}
print("\n=== Compression Summary ===")
print("Compression wall seconds include process startup and I/O, under concurrent load.")
print("Ratio = compressed / input bytes (lower is smaller); '-' means unavailable.")
print("Forward: ctoolbox compression; Reverse: oracle compression; Archived: no compression run.")
print("Summary totals use successful compression runs only; archived decoding checks are excluded.")
writer = csv.writer(sys.stdout, lineterminator="\n")
writer.writerow(("Status", "Direction", "Format", "Tool", "Dataset", "Input B", "Compressed B", "Ratio", "Seconds", "Note"))
for case_id in range(1, case_count + 1):
    case_dir = run_dir / f"case_{case_id}"
    result_path = case_dir / "results"
    status = int((case_dir / "exit-status").read_text())
    if not result_path.is_file():
        writer.writerow(("FAIL", "Case", "-", "-", f"Case {case_id}", "-", "-", "-", "-", f"Worker returned {status} without results"))
        failures += status == 0
        continue
    fields = result_path.read_bytes().split(b"\0")
    if fields.pop() != b"" or len(fields) % 9:
        raise ValueError(f"Incomplete results for case {case_id}")
    reported_failure = False
    for offset in range(0, len(fields), 9):
        outcome, direction, fmt, tool, dataset, raw, compressed, elapsed, reason = (
            field.decode("utf-8", errors="backslashreplace") for field in fields[offset:offset + 9]
        )
        passed += outcome == "PASS"
        skipped += outcome == "SKIP"
        reported_failure |= outcome == "FAIL"
        ratio = "-"
        if outcome == "PASS" and raw != "-" and int(raw) > 0 and compressed != "-":
            ratio = f"{int(compressed) / int(raw):.4f}"
        values = (outcome, direction, fmt, tool, dataset, raw, compressed, ratio, elapsed, reason)
        writer.writerow(value.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") for value in values)
        if direction in ("Forward", "Reverse"):
            compressor = "ctoolbox" if direction == "Forward" else tool
            totals = summaries.setdefault((fmt, compressor), {
                "raw": 0, "compressed": 0, "seconds": Decimal(0),
                "PASS": 0, "SKIP": 0, "FAIL": 0,
            })
            totals[outcome] += 1
            if outcome == "PASS":
                totals["raw"] += int(raw)
                totals["compressed"] += int(compressed)
                totals["seconds"] += Decimal(elapsed)
    if status and not reported_failure:
        writer.writerow(("FAIL", "Case", "-", "-", f"Case {case_id}", "-", "-", "-", "-", f"Worker exited with status {status}; see case log"))
    elif reported_failure and not status:
        failures += 1
for (fmt, compressor), totals in sorted(summaries.items()):
    ratio = f'{totals["compressed"] / totals["raw"]:.4f}' if totals["raw"] else "-"
    writer.writerow((
        "SUMMARY", "Compression", fmt, compressor, "ALL",
        totals["raw"] if totals["PASS"] else "-",
        totals["compressed"] if totals["PASS"] else "-", ratio,
        f'{totals["seconds"]:.3f}' if totals["PASS"] else "-",
        f'{totals["PASS"]} passed; {totals["SKIP"]} skipped; {totals["FAIL"]} failed',
    ))
if not passed:
    print("Error: No compression compatibility tests ran; check the format and dataset filters.", file=sys.stderr)
print(f"\n=== {passed} COMPRESSION COMPATIBILITY TESTS PASSED; {skipped} explicit skips; {failures} failed cases ===")
sys.exit(1 if failures or not passed else 0)
PY
