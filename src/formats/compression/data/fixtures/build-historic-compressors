#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Shared build script for historical compression tools in old/unix-tools.
# Prepares source patches and compiles binaries into the specified directory.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
while [ "$REPO_ROOT" != "/" ] && [ ! -f "$REPO_ROOT/AGENTS.md" ]; do
    REPO_ROOT="$(dirname "$REPO_ROOT")"
done

DEST_DIR="${1:-$REPO_ROOT/built/bin_historic_tools}"
mkdir -p "$DEST_DIR"

WORK_DIR="$(mktemp -d "$DEST_DIR/build_historic_tools_XXXXXX")"
cleanup_work() {
    rm -rf "$WORK_DIR"
}
trap cleanup_work EXIT

echo "=== Preparing and Compiling Historical Tools in $DEST_DIR ==="

# -----------------------------------------------------------------------------
# 1. compress 1.0 (July 1984, Spencer W. Thomas)
# -----------------------------------------------------------------------------
TMP_C1="$WORK_DIR/compress-1.0.c"
python3 - "$REPO_ROOT" "$TMP_C1" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/compress/compress-1.0/compress.c")
with open(src_file, "r") as f:
    code = f.read()

masks = """
static char buf[BITS];
static unsigned char lmask[9] = {0xff, 0xfe, 0xfc, 0xf8, 0xf0, 0xe0, 0xc0, 0x80, 0x00};
static unsigned char rmask[9] = {0x00, 0x01, 0x03, 0x07, 0x0f, 0x1f, 0x3f, 0x7f, 0xff};
"""

vax_insv = """#ifndef vax\nYou lose\n#endif\nasm( "insv 4(ap),r11,r10,(r9)" );"""
c_insv = """bp += (r_off >> 3); r_off &= 7; *bp = (*bp & rmask[r_off]) | ((code << r_off) & lmask[r_off]); bp++; bits -= (8 - r_off); code >>= 8 - r_off; if ( bits >= 8 ) { *bp = code; bp++; bits -= 8; code >>= 8; } if ( bits > 0 ) *bp = code;"""
vax_extv = """#ifndef vax\nYou lose\n#endif\nasm( "extzv r10,r9,(r8),r11" );"""
c_extv = """bp += (r_off >> 3); code = ((unsigned char)bp[0] | ((unsigned char)bp[1] << 8) | ((unsigned char)bp[2] << 16)) >> (r_off & 7); code &= (1 << n_bits) - 1;"""

getopt_code = """
int ch_opt;
while ((ch_opt = getopt(argc, argv, "d")) != -1) {
    if (ch_opt == 'd') decompress_flg = 1;
}
"""

code = code.replace("static char buf[BITS];", masks)
code = code.replace(vax_insv, c_insv)
code = code.replace(vax_extv, c_extv)
code = code.replace("compress( infile );\nelse if", "{ compress( infile ); exit(0); }\nelse if")
code = code.replace("#endif\n\nif ( maxbits > BITS )", getopt_code + "\n#endif\n\nif ( maxbits > BITS )")

with open(out_file, "w") as f:
    f.write(code)
EOF

gcc -w -std=gnu89 -fcommon -DNO_SCANARGS=1 -O2 -o "$DEST_DIR/compress-1.0" "$TMP_C1"

# -----------------------------------------------------------------------------
# 2. compress 1.6 (August 1984, Joe Orost)
# -----------------------------------------------------------------------------
TMP_C16="$WORK_DIR/compress-1.6.c"
python3 - "$REPO_ROOT" "$TMP_C16" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/compress/compress-1.6/compress.c")
with open(src_file, "r") as f:
    code = f.read()

masks = """
static char buf[BITS];
static unsigned char lmask[9] = {0xff, 0xfe, 0xfc, 0xf8, 0xf0, 0xe0, 0xc0, 0x80, 0x00};
static unsigned char rmask[9] = {0x00, 0x01, 0x03, 0x07, 0x0f, 0x1f, 0x3f, 0x7f, 0xff};
"""

c_insv = """
int r_off = offset, bits = n_bits;
char * bp = buf;
bp += (r_off >> 3);
r_off &= 7;
*bp = (*bp & rmask[r_off]) | ((code << r_off) & lmask[r_off]);
bp++;
bits -= (8 - r_off);
code >>= 8 - r_off;
if ( bits >= 8 ) {
    *bp++ = code;
    code >>= 8;
    bits -= 8;
}
if ( bits > 0 ) *bp = code;
"""

code = code.replace("compress( infile );\nelse", "{ compress( infile ); exit(0); }\nelse")
# Fix operator precedence bug in original compress 1.6 where 1 << INIT_BITS - 1 was 1 << (9-1) = 256 instead of 511
code = code.replace("long int maxcode = 1 << INIT_BITS - 1;", "long int maxcode = (1 << INIT_BITS) - 1;")
# Replace non-portable int buffer and insert_bit with standard byte buffer and portable bit insertion
code = code.replace("""#if vax
static char buf[BITS];
#else
static int buf[(BITS+sizeof(int)-sizeof(char))/sizeof(int)];
#endif""", masks)
code = code.replace("insert_bit(code);", c_insv)

with open(out_file, "w") as f:
    f.write(code)
EOF

gcc -w -std=gnu89 -fcommon -DNO_SCANARGS=1 -O2 -o "$DEST_DIR/compress-1.6" "$TMP_C16"

# -----------------------------------------------------------------------------
# 3. compress 2.0, 3.0, 4.0, apollo, and ncompress
# -----------------------------------------------------------------------------
gcc -w -std=gnu89 -fcommon -O2 -o "$DEST_DIR/compress-2.0" "$REPO_ROOT/old/unix-tools/compress/compress-2.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$DEST_DIR/compress-3.0" "$REPO_ROOT/old/unix-tools/compress/compress-3.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$DEST_DIR/compress-4.0" "$REPO_ROOT/old/unix-tools/compress/compress-4.0/compress.c"
gcc -w -std=gnu89 -fcommon -O2 -o "$DEST_DIR/compress-apollo" "$REPO_ROOT/old/unix-tools/compress/compress-apollo/compress.c"
gcc -w -std=gnu89 -O2 -o "$DEST_DIR/ncompress" "$REPO_ROOT/old/unix-tools/ncompress/compress.c"

# -----------------------------------------------------------------------------
# 4. compact & uncompact (4.1cBSD McMaster 1979)
# -----------------------------------------------------------------------------
TMP_COMPACT_DIR="$WORK_DIR/compact_src"
mkdir -p "$TMP_COMPACT_DIR"
python3 - "$REPO_ROOT" "$TMP_COMPACT_DIR" << 'EOF'
import sys, os
repo_root, out_dir = sys.argv[1], sys.argv[2]
hdr_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-compact.h")
cmp_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-compact.c")
unc_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-uncompact.c")
tree_src = os.path.join(repo_root, "old/unix-tools/compact-uncompact/4.1cBSD-tree.c")

with open(hdr_src, "r") as f: hdr_code = f.read()
with open(cmp_src, "r") as f: cmp_code = f.read()
with open(unc_src, "r") as f: unc_code = f.read()
with open(tree_src, "r") as f: tree_code = f.read()

hdr_code = hdr_code.replace("int ch;", "long ch;").replace("typedef int longint;", "typedef long longint;")
hdr_code = hdr_code.replace("dir [514]", "dir [1024]")
cmp_code = cmp_code.replace('#include "compact.h"', '#include "compact.h"\n#include <unistd.h>')
cmp_code = cmp_code.replace("dir [513] . next = NULL;", "dir [1023] . next = NULL;").replace("(j = 513)", "(j = 1023)")
unc_code = unc_code.replace('#include "compact.h"', '#include "compact.h"\n#include <unistd.h>')
unc_code = unc_code.replace("dir [513] . next = NULL;", "dir [1023] . next = NULL;").replace("(j = 513)", "(j = 1023)")
unc_code = unc_code.replace("if (d . integ == EF) break;", "if (d . integ == EF) { if (i >= argc) { fclose(cfp); fclose(uncfp); exit(0); } goto closeboth; }")

old_copy = """			q . ch = t -> sp [ts] . ch;	/*  {					*/
			s . ch = r -> sp [rs] . ch;	/*  {					*/
			t -> sp [ts] . ch = s . ch;	/*  { change code when Cory gets v. 7	*/
			r -> sp [rs] . ch = q . ch;	/*  {					*/"""
new_copy = """			q = t -> sp [ts];
			s = r -> sp [rs];
			t -> sp [ts] = s;
			r -> sp [rs] = q;"""
tree_code = tree_code.replace(old_copy, new_copy)
tree_code = tree_code.replace("exch (t, ts, q . ch, r, rs);", "exch (t, ts, q, r, rs);")
tree_code = tree_code.replace("exch (r, rs, s . ch, t, ts);", "exch (r, rs, s, t, ts);")

with open(os.path.join(out_dir, "compact.h"), "w") as f: f.write(hdr_code)
with open(os.path.join(out_dir, "compact.c"), "w") as f: f.write(cmp_code)
with open(os.path.join(out_dir, "uncompact.c"), "w") as f: f.write(unc_code)
with open(os.path.join(out_dir, "tree.c"), "w") as f: f.write(tree_code)
EOF

gcc -w -std=gnu89 -fcommon -O2 -I "$TMP_COMPACT_DIR" -o "$DEST_DIR/compact" "$TMP_COMPACT_DIR/compact.c" "$TMP_COMPACT_DIR/tree.c"
gcc -w -std=gnu89 -fcommon -O2 -I "$TMP_COMPACT_DIR" -o "$DEST_DIR/uncompact" "$TMP_COMPACT_DIR/uncompact.c" "$TMP_COMPACT_DIR/tree.c"

# -----------------------------------------------------------------------------
# 5. sys3-pack, sys3-pcat, opack, opcat (AT&T System III / PDP-11 Zucker 1977)
# -----------------------------------------------------------------------------
TMP_OPCAT_C="$WORK_DIR/opcat.c"
python3 - "$REPO_ROOT" "$TMP_OPCAT_C" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/pack-unpack-pcat/pts-opack-port/pcat.c")
with open(src_file, "r") as f: code = f.read()
code = code.replace("*a++rgv", "*++argv")
code = code.replace("short keysize, hi, lo;", "unsigned short keysize, hi, lo;")
with open(out_file, "w") as f: f.write(code)
EOF

gcc -w -std=gnu89 -O2 -o "$DEST_DIR/sys3-pack" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/sys3-pack.c"
gcc -w -std=gnu89 -O2 -o "$DEST_DIR/sys3-pcat" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/sys3-pcat.c"
gcc -w -O2 -o "$DEST_DIR/opack" "$REPO_ROOT/old/unix-tools/pack-unpack-pcat/pts-opack-port/pack.c"
gcc -w -O2 -o "$DEST_DIR/opcat" "$TMP_OPCAT_C"

# -----------------------------------------------------------------------------
# 6. bzip 0.21 (August 1996, Julian Seward)
# -----------------------------------------------------------------------------
TMP_BZIP_C="$WORK_DIR/bzip-0.21.c"
python3 - "$REPO_ROOT" "$TMP_BZIP_C" << 'EOF'
import sys, os
repo_root, out_file = sys.argv[1], sys.argv[2]
src_file = os.path.join(repo_root, "old/unix-tools/bzip-0.21-ami/bzip.c")
with open(src_file, "r") as f:
    code = f.read()
code = code.replace("#define MY_S_IFREG  S_IFREG", "#define MY_S_IFREG(x)  S_ISREG(x)")
code = code.replace("void mySignalCatcher ( IntNative *n )", "void mySignalCatcher ( IntNative n )")
code = code.replace("void mySIGSEGVorSIGBUScatcher ( IntNative *n )", "void mySIGSEGVorSIGBUScatcher ( IntNative n )")
with open(out_file, "w") as f:
    f.write(code)
EOF

gcc -w -O2 -o "$DEST_DIR/bzip-0.21" "$TMP_BZIP_C"

# -----------------------------------------------------------------------------
# 7. freeze 2.5.0 (Leonid A. Broukhis 1990-1993, with 1.0 COMPAT)
# -----------------------------------------------------------------------------
mkdir -p "$WORK_DIR/freeze_inc"
cat << 'EOF' > "$WORK_DIR/freeze_inc/config.h"
#define SEGMENTED 1
#define HAVE_LONG_FILE_NAMES 1
#define DIRENT 1
#define UTIME 1
#define COMPAT 1
EOF
FREEZE_SRC="$REPO_ROOT/old/unix-tools/freeze-2.5.0-44.fc45.src/freeze-2.5.0/freeze-2.5.0"
gcc -w -std=gnu89 -fcommon -O2 \
    -I"$WORK_DIR/freeze_inc" \
    -I"$FREEZE_SRC" \
    -DCOMPAT=1 \
    -DDEFFILE=\"/dev/null\" \
    -Dgetc=fgetc \
    -Dputc=fputc \
    -o "$DEST_DIR/freeze" \
    "$FREEZE_SRC/freeze.c" \
    "$FREEZE_SRC/encode.c" \
    "$FREEZE_SRC/decode.c" \
    "$FREEZE_SRC/huf.c" \
    "$FREEZE_SRC/lz.c" \
    "$FREEZE_SRC/bitio.c" \
    "$FREEZE_SRC/default.c"

# -----------------------------------------------------------------------------
# 8. rzip 2.1 (Andrew Tridgell 1998-2003)
# -----------------------------------------------------------------------------
mkdir -p "$WORK_DIR/rzip_inc"
cat << 'EOF' > "$WORK_DIR/rzip_inc/config.h"
#define SIZEOF_INT 4
#define SIZEOF_LONG 8
#define SIZEOF_SHORT 2
#define HAVE_STRING_H 1
#define HAVE_MMAP 1
#define HAVE_STRERROR 1
#define HAVE_GETOPT_LONG 1
#define HAVE_LARGE_FILES 1
#define _FILE_OFFSET_BITS 64
#include <ctype.h>
EOF
RZIP_SRC="$REPO_ROOT/old/unix-tools/rzip-2.1"
gcc -w -O2 \
    -I"$WORK_DIR/rzip_inc" \
    -I"$RZIP_SRC" \
    -o "$DEST_DIR/rzip" \
    "$RZIP_SRC/rzip.c" \
    "$RZIP_SRC/runzip.c" \
    "$RZIP_SRC/main.c" \
    "$RZIP_SRC/stream.c" \
    "$RZIP_SRC/util.c" \
    "$RZIP_SRC/crc32.c" \
    -lbz2

echo "All historical tools compiled successfully into $DEST_DIR"
