async function dcaFromAscii(intArrayContent) {
      let intArrayReturn;

    StageL_assertIsByteArray(intArrayContent);
    let intArrayRes = [];
    let intL = 0;
    intL = StageL_count(intArrayContent);
    let intC = 0;
    intC = 0;
    while (StageL_lt(intC, intL)) {
        intArrayRes = StageL_append(intArrayRes, StageL_dcFromFormat('ascii', StageL_anFromN(StageL_get(intArrayContent, intC))));
        intC = StageL_add(intC, 1);
    }
    StageL_assertIsDcArray(intArrayRes);

    intArrayReturn = intArrayRes; return intArrayReturn;
}

async function dcaToAscii(intArrayContent) {
      let intArrayReturn;

    StageL_assertIsDcArray(intArrayContent);
    let intArrayRes = [];
    let intL = 0;
    intL = StageL_count(intArrayContent);
    let intC = 0;
    intC = 0;
    let intArrayTemp = [];
    let intDcAtIndex = 0;
    while (StageL_lt(intC, intL)) {
        intDcAtIndex = StageL_get(intArrayContent, intC);
        intArrayTemp = StageL_dcToFormat('utf8', intDcAtIndex);
        if (StageL_arrNonempty(intArrayTemp)) {
            if (StageL_isAsciiByte(StageL_get(intArrayTemp, 0))) {
                intArrayRes = StageL_append(intArrayRes, intArrayTemp);
            }
            else {
                StageL_exportWarningUnmappable(intC, intDcAtIndex);
            }
        }
        else {
            StageL_exportWarningUnmappable(intC, intDcAtIndex);
        }
        intC = StageL_add(intC, 1);
    }
    StageL_assertIsByteArray(intArrayRes);

    intArrayReturn = intArrayRes; return intArrayReturn;
}

async function isAsciiByte(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_intIsBetween(intN, 0, 127);

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsDigit(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_intIsBetween(intN, 48, 57);

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsPrintable(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_intIsBetween(intN, 32, 126);

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsSpace(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_eq(intN, 32);

