}

async function asciiIsNewline(intN) {
      let boolReturn;

    let boolT1 = false;
    boolT1 = StageL_eq(intN, 10);
    let boolT2 = false;
    boolT2 = StageL_or(boolT1, StageL_eq(intN, 13));

    boolReturn = boolT2; return boolReturn;
}

async function asciiIsLetterUpper(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_intIsBetween(intN, 65, 90);

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsLetterLower(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_intIsBetween(intN, 97, 122);

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsLetter(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_asciiIsLetterLower(intN);
    boolTemp = StageL_or(boolTemp, StageL_asciiIsLetterUpper(intN));

    boolReturn = boolTemp; return boolReturn;
}

async function asciiIsAlphanum(intN) {
      let boolReturn;

    let boolTemp = false;
    boolTemp = StageL_asciiIsLetter(intN);
    boolTemp = StageL_or(boolTemp, StageL_asciiIsDigit(intN));

    boolReturn = boolTemp; return boolReturn;
}

