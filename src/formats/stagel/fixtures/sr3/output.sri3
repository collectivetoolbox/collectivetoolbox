: STAGER N:D: FIXTURE :CHAR:EA:SEE SRC/FORMATS/STAGEL/DOCS/SRN:D:.MD FOR FULL SPECIFICATION:CHAR:EB:.
: EXERCISES STAGER N:D: TYPES :CHAR:EA:S:CHAR:EE: DC:CHAR:EE: DCS:CHAR:EE: IN:B:N:C:N:I::CHAR:EE: UN:B:N:C:N:I::CHAR:EE: INT:CHAR:EE: RAT:CHAR:EE: VIEW:CHAR:EE: CURSOR:CHAR:EE: OPTION/T:CHAR:EE: RESULT/T:CHAR:EB: AND BARE :CHAR:DE:...:CHAR:DE: DCTS LITERALS.

V/B/ZL S/IN
    TEST WORKS WITH ZERO LENGTH STRING
        IN ""
        OUT TRUE
    TEST WORKS WITH NONZERO LENGTH STRING
        IN "/XGB"
        OUT FALSE
    EQ UN:G:N:E::N:A: BYTELEN S/IN.

V/RESULT/IN:G:N:E:/ADDCHECKED IN:G:N:E:/A IN:G:N:E:/B :: TRYADD IN:G:N:E:/A IN:G:N:E:/B.

V/S/DEFAULT S/A S/B :: IF ZL S/A S/B S/A.

V/IN:B:N:C:N:I:/PASSWIDE IN:B:N:C:N:I:/X
    TEST PRESERVES NEGATIVE WIDE INTEGER
        IN IN:B:N:C:N:I::N:M:N:E:N:C:
        OUT IN:B:N:C:N:I::N:M:N:E:N:C:
    IN:B:N:C:N:I:/X.

V/OPTION/UN:D:N:C:/NONZEROORNONE UN:D:N:C:/X
    TEST WRAPS NONZERO VALUE
        IN UN:D:N:C::N:F:
        OUT OPTION/UN:D:N:C::SOME UN:D:N:C::N:F:
    IF EQ UN:D:N:C::N:A: UN:D:N:C:/X
        OPTION/UN:D:N:C::NONE
        OPTION/UN:D:N:C::SOME UN:D:N:C:/X.

V/S/GETFORMATIMPORTSETTING S/A S/B :: UNIMPLEMENTED "I/XGN/XHA/XGP/XHC/XHE /XHD/XGF/XHE/XHE/XGJ/XGO/XGH/XHD".
V/OPTION/S/DCGETMAPPINGTOFORMAT DC/A S/B :: UNIMPLEMENTED "D/XGD /XGN/XGB/XHA/XHA/XGJ/XGO/XGH".
V/S/GETENVCODELANGUAGE :: UNIMPLEMENTED "E/XGO/XHG/XGJ/XHC/XGP/XGO/XGN/XGF/XGO/XHE /XGM/XGB/XGO/XGH/XHF/XGB/XGH/XGF".

V/S/GETTARGETLANGUAGEFORDCTCODETOTEXT
    CONST S/TARGETLANGUAGE GETFORMATIMPORTSETTING "/XGD/XGP/XGE/XGF/XHE/XGP/XHE/XGF/XHI/XHE" "/XGM/XGB/XGO/XGH/XHF/XGB/XGH/XGF".
    IF ZL S/TARGETLANGUAGE GETENVCODELANGUAGE S/TARGETLANGUAGE.

V/L/S/SPLITDCTS S/SEP S/INPUT
    TEST SPLITS MIXED MODE STRING WITH EMBEDDED DC TOKEN
        IN ":" "/XGB/XGM/XHA/XGI/XGB:/XEA/XDC/XDF/XDG/XEA:/XGC/XGF/XHE/XGB"
        OUT L/S: "/XGB/XGM/XHA/XGI/XGB" "/XEA/XDC/XDF/XDG/XEA" "/XGC/XGF/XHE/XGB" ::
    EXPLODE S/SEP S/INPUT.
