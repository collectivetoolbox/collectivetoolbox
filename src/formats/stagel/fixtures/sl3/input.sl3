: StageL 3 core fixture (see src/formats/stagel/docs/sl3.md for full specification).
: Exercises comments, "." / ";" terminators, "}" -> "::", let/set/const, literals, lexical capture, and mutual tail calls.

v/b/isEmpty l/u32/items
    test works with empty list
        in l/u32: ::
        out true
    test works with nonempty list
        in l/u32: u32:7 ::
        out false
    eq u64:0 len l/u32/items.

v/b/nne i64/a i64/b :: ne i64/a i64/b.
v/b/nneSemicolon i64/a i64/b :: ne i64/a i64/b;
v/u32/braceBlock u32/x :: do u32/x. }

v/u32/modStep u32/a u32/b
    test computes unsigned modulus
        in u32:17 u32:5
        out u32:2
    mod u32/a u32/b.

v/l/u32/appendU32 l/u32/a l/u32/b
    test concatenates two lists
        in l/u32: u32:0 u32:1 :: l/u32: u32:2 u32:3 ::
        out l/u32: u32:0 u32:1 u32:2 u32:3 ::
    concat l/u32/a l/u32/b.

v/l/t/splitLetters t/sep t/input
    test splits case normalized letters
        in t"b" t"aBc"
        out l/t: t"A" t"C" ::
    explode t/sep t/input.

v/l/u8/roundTripBytes l/u8/sep l/u8/input
    test splits and rejoins case preserving byte slices
        in b"//" b"Abc//def/x5c/n"
        out b"Abc//def/x5c/n"
    const l/l/u8/parts explode l/u8/sep l/u8/input.
    implode l/u8/sep l/l/u8/parts.

: Uninitialized let must be definitely assigned via set before any read; const is immutable.
v/u32/definiteInit b/pickFirst u32/a u32/b
    test initializes in both branches before reading
        in false u32:3 u32:8
        out u32:18
    const u32/bonus u32:10.
    let u32/chosen.
    if b/pickFirst
        set u32/chosen u32/a
        set u32/chosen u32/b.
    add u32/chosen u32/bonus.

: Nested verb captures definition-site mutable let binding even when called from a sibling verb.
v/u32/lexicalCapture u32/initial
    test reads shared binding after mutation
        in u32:7
        out u32:9
    let u32/captured u32/initial.
    v/u32/readCaptured :: u32/captured.
    v/u32/callFromSibling
        const u32/callerLocal u32:99.
        readCaptured.
    set u32/captured u32:9.
    callFromSibling.

: Both directions of this mutual recursion are tail calls, including through if branches.
v/b/tailFirst b/stop
    test takes mutual tail call
        in false
        out false
    if b/stop true tailSecond true.
v/b/tailSecond b/stop :: if b/stop false tailFirst true.

: let, set, and foreach return unit of type void; the final expression returns the copied list.
v/l/u32/copyList l/u32/items
    test copies list snapshot
        in l/u32: u32:2 u32:3 ::
        out l/u32: u32:2 u32:3 ::
    let l/u32/copied l/u32: ::.
    foreach l/u32/items do
        set l/u32/copied concat l/u32/copied l/u32: u32/this ::.
    ::.
    l/u32/copied.

: Empty do blocks return unit of type void.
v/void/unitChoice b/condition :: if b/condition do :: do ::.
