<div class="w-full h-full mx-auto flex flex-col justify-evenly content-center items-center">
    {{#if is_debug_build}}
    <div class="alert-banner alert-banner-warning mb-4" role="alert">
        <div class="alert-banner-icon">
            {{> icons._icon name="warning" alt="Warning" }}
        </div>
        <div class="alert-banner-content">
            <strong>Debug Mode Active:</strong> Do not log in with your real account.
        </div>
    </div>
    {{/if}}
    <h2>Hi, {{ username }}! Please enter your password to log in.</h2>
    <form action="/login-password" method="POST" class="w-80 flex flex-col gap-4">
        <table>
            <tbody>
                <tr class="border-b-[1rem] border-b-transparent">
                    <input type="hidden" name="username" value="{{ username }}">
                    <td>
                        <label>Password:</label>
                    </td>
                    <td>
                        <input type="password" name="password" class="w-full ml-2" required>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="flex justify-between">
            <a href="/login" class="btn">
                {{> icons._icon name="arrow-left" alt="" }}
                <span>Back</span>
            </a>
            <button type="submit" class="btn-primary">
                {{> icons._icon name="home" alt="" }}
                <span>Log In</span>
            </button>
        </div>
    </form>
</div>