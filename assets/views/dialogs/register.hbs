<div class="w-full h-full mx-auto flex flex-col justify-evenly content-center items-center">
    <form action="/registration" method="POST" class="w-80 flex flex-col gap-4">
        <table>
            <tbody>
                <tr class="border-b-[1rem] border-b-transparent">
                    <td>
                        <label>Username:</label>
                    </td>
                    <td>
                        <input type="text" name="username" class="w-full ml-2" value="{{ username }}" required>
                    </td>
                </tr>
                <tr class="border-b-[1rem] border-b-transparent">
                    <td>
                        <label>Password:</label>
                    </td>
                    <td>
                        <input type="password" name="password" class="w-full ml-2" required>
                    </td>
                </tr>
                <tr class="border-b-[1rem] border-b-transparent">
                    <td>
                        <label>Confirm password:</label>
                    </td>
                    <td>
                        <input type="password" name="password_confirm" class="w-full ml-2" required>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="flex justify-between">
            <a href="/" class="btn">
                {{> icons._icon name="arrow-left" alt="" }}
                <span>Cancel</span>
            </a>
            <button type="submit" class="btn-primary">
                {{> icons._icon name="home" alt="" }}
                <span>Register</span>
            </button>
        </div>
    </form>
</div>