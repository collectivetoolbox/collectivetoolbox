<div class="w-full h-full mx-auto flex flex-col justify-evenly content-center items-center">
    {{#if is_debug_build}}
    <div class="alert-banner alert-banner-warning mb-4" role="alert">
        <div class="alert-banner-icon">
            {{> icons._icon name="warning" alt="Warning" }}
        </div>
        <div class="alert-banner-content">
            <strong>Debug Mode Active:</strong> Do not log in with your real account.
        </div>
    </div>
    {{/if}}
    <form action="/login" method="POST" class="w-80 flex flex-col gap-4">
        <table>
            <tbody>
                <tr class="border-b-[1rem] border-b-transparent">
                    <td>
                        <label>Username:</label>
                    </td>
                    <td>
                        <input type="text" name="username" class="w-full ml-2" required>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="flex justify-between">
            <a href="/" class="btn">
                {{> icons._icon name="arrow-left" alt="" }}
                <span>Cancel</span>
            </a>
            <button type="submit" class="btn-primary">
                {{> icons._icon name="home" alt="" }}
                <span>Register or Log In</span>
            </button>
        </div>
    </form>

    <br><br>

    <a href="/pc-settings" class="btn">
        {{> icons._icon name="settings" alt="" }}
        <span>PC Settings</span>
    </a>
</div>