<div class="calculator-pane calculator-prime-pane">
    <div class="calculator-input-row">
        <label for="txtNum1">Enter candidate integer:</label>
        <input type="text" id="txtNum1" placeholder="e.g. 29" autocomplete="off" />
        <button type="button" id="btn1" class="btn btn-primary">Test</button>
    </div>

    <div class="calculator-result-box">
        <div id="lbl1" class="calculator-status-message">Enter a number above to test for primality.</div>
        <div id="lblFactors" class="calculator-factor-details"></div>
    </div>
</div>
