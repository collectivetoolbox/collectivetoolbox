<div id="diaRps" class="hidden modal-box">
    <div class="modal-header">
        <h3 class="modal-title">Rock, Paper, and Scissor</h3>
        <button type="button" class="modal-close-btn" aria-label="Close" data-modal-close>&times;</button>
    </div>

    <div class="modal-body flex flex-col gap-4">
        <fieldset class="flex flex-col gap-2 p-4">
            <legend>Choose Your Play:</legend>
            <div class="flex items-center gap-2">
                <button type="button" data-choice="1">Rock</button>
                <button type="button" data-choice="2">Paper</button>
                <button type="button" data-choice="3">Scissors</button>
            </div>
        </fieldset>

        <div class="flex flex-col gap-2">
            <div id="lblRpsDecision">Select a play to challenge the computer.</div>
            <div><strong><output id="lblRpsOutcome"></output></strong></div>
        </div>

        <div class="flex items-center gap-4">
            <span id="lblRpsWins">0 Wins</span> |
            <span id="lblRpsDraws">0 Draws</span> |
            <span id="lblRpsLosses">0 Losses</span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" id="btnRpsNewSession">New Session</button>
        <button type="button" data-modal-close>Close</button>
    </div>
</div>
