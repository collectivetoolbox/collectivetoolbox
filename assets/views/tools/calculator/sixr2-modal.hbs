<dialog id="diaSixR2" class="calculator-modal">
    <div class="calculator-modal-content">
        <header class="calculator-modal-header">
            <h3>Unique Random Number Generator</h3>
            <button type="button" class="btn btn-close-modal" data-close-modal="diaSixR2">&times;</button>
        </header>

        <div class="calculator-modal-body">
            <div class="calculator-sixr2-numbers">
                <div class="calculator-sixr2-box" id="lblSixR2Num1">-</div>
                <div class="calculator-sixr2-box" id="lblSixR2Num2">-</div>
                <div class="calculator-sixr2-box" id="lblSixR2Num3">-</div>
            </div>

            <div class="calculator-sixr2-counter">
                <span>Iteration: </span>
                <span id="lblSixR2Iteration">0</span>
            </div>

            <div class="calculator-action-row">
                <button type="button" id="btnSixR2Generate" class="btn btn-primary">Generate unique random numbers</button>
            </div>
        </div>

        <footer class="calculator-modal-footer">
            <button type="button" class="btn btn-secondary" data-close-modal="diaSixR2">Close</button>
        </footer>
    </div>
</dialog>
