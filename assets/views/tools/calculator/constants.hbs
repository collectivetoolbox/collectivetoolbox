<div class="calculator-pane calculator-constants-pane">
    <div class="calculator-constants-description">
        Click a constant to copy it to the clipboard or insert into the active calculator field:
    </div>

    <div class="calculator-constants-buttons">
        <button type="button" id="btnPi" class="btn" data-const="pi">&pi; (Pi &approx; 3.14159265)</button>
        <button type="button" id="btneconst" class="btn" data-const="e">e (Euler &approx; 2.71828182)</button>
        <button type="button" id="btnRadical13" class="btn" data-const="radical13">&radic;13 (&approx; 3.60555127)</button>
    </div>

    <div id="lblConstantStatus" class="calculator-status-message"></div>
</div>
