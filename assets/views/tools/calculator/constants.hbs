<div class="flex flex-col gap-4">
    <p>Click a constant to copy it to the clipboard or insert into the active calculator field:</p>

    <div class="flex items-center gap-4 flex-wrap">
        <button type="button" id="btnPi" data-const="pi">&pi; (Pi &approx; 3.14159265)</button>
        <button type="button" id="btneconst" data-const="e">e (Euler &approx; 2.71828182)</button>
        <button type="button" id="btnRadical13" data-const="radical13">&radic;13 (&approx; 3.60555127)</button>
    </div>

    <div id="lblConstantStatus" class="pt-2"></div>
</div>
