<div class="calculator-pane calculator-temperature-pane">
    <div class="calculator-input-row">
        <label for="txtTemp">Enter temperature:</label>
        <input type="text" id="txtTemp" placeholder="e.g. 100" autocomplete="off" />
    </div>

    <div class="calculator-action-row">
        <button type="button" id="btnToFahrenheit" class="btn">Change to Fahrenheit</button>
        <button type="button" id="btnToCelsius" class="btn">Change to Celsius</button>
    </div>

    <div class="calculator-answer-box">
        <div id="lblTempResult" class="calculator-status-message">Enter a temperature above.</div>
    </div>
</div>
