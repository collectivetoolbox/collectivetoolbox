<div class="calculator-pane calculator-sqrt-pane">
    <div class="calculator-input-row">
        <label for="txtSqRt">Enter number (supports negative inputs):</label>
        <input type="text" id="txtSqRt" placeholder="e.g. 16 or -4" autocomplete="off" />
        <button type="button" id="btnSqRt" class="btn btn-primary">Find Square Root</button>
    </div>

    <div class="calculator-answer-box">
        <span class="calculator-answer-label">Result:</span>
        <span id="lblSqRtAnswer" class="calculator-answer-display">{ }</span>
    </div>
</div>
