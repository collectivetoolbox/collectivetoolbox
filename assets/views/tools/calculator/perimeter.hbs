<div class="calculator-pane calculator-perimeter-pane">
    <div class="calculator-geometry-inputs">
        <label for="txtRectPeri1">Base length:</label>
        <input type="text" id="txtRectPeri1" placeholder="e.g. 5" autocomplete="off" />

        <label for="txtRectPeri2">Height:</label>
        <input type="text" id="txtRectPeri2" placeholder="e.g. 10" autocomplete="off" />

        <button type="button" id="btnGetperi" class="btn btn-primary">Get perimeter</button>
    </div>

    <div class="calculator-answer-box">
        <span class="calculator-answer-label">Perimeter:</span>
        <span id="lblPeriAnswer" class="calculator-answer-display">{ }</span>
    </div>
</div>
