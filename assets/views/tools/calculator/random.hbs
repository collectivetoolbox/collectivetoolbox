<div class="calculator-pane calculator-random-pane">
    <fieldset class="calculator-random-fieldset">
        <legend>Random Numbers:</legend>
        <div class="calculator-random-grid">
            <div class="calculator-random-item">
                <span class="calculator-random-scale">Base [0, 1):</span>
                <span id="lblRan1" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 5:</span>
                <span id="lblRan2" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 10:</span>
                <span id="lblRan3" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 50:</span>
                <span id="lblRan4" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 100:</span>
                <span id="lblRan5" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 500:</span>
                <span id="lblRan6" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 1000:</span>
                <span id="lblRan7" class="calculator-random-value">0.0000</span>
            </div>
            <div class="calculator-random-item">
                <span class="calculator-random-scale">&times; 5000:</span>
                <span id="lblRan8" class="calculator-random-value">0.0000</span>
            </div>
        </div>
    </fieldset>

    <div class="calculator-action-row">
        <button type="button" id="btnRand" class="btn btn-primary">Refresh random numbers</button>
    </div>
</div>
