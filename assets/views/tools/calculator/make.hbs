<div class="flex flex-col gap-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-start">
        <div class="flex flex-col gap-4">
            <input type="text" id="txtN1" placeholder="N1" autocomplete="off" />
            <input type="text" id="txtN2" placeholder="N2" autocomplete="off" />
        </div>

        <fieldset id="grpChooseOne" class="flex flex-col gap-2 p-2">
            <legend>Choose One:</legend>
            <ctb-segmented-control class="flex flex-col gap-1 w-full">
                <div class="grid grid-cols-4 gap-1 w-full">
                    <button type="button" selected data-op="+">+</button>
                    <button type="button" data-op="-">-</button>
                    <button type="button" data-op="*">&times;</button>
                    <button type="button" data-op="/">/</button>
                </div>
                <div class="grid grid-cols-4 gap-1 w-full">
                    <button type="button" data-op="\">\</button>
                    <button type="button" data-op="^">^</button>
                    <button type="button" data-op="Mod">Mod</button>
                    <button type="button" data-op="AC">AC</button>
                </div>
            </ctb-segmented-control>
        </fieldset>
    </div>

    <div class="flex items-center gap-4">
        <input type="text" id="txtFormula" class="flex-grow" placeholder="Enter formula..." autocomplete="off" />
        <button type="button" id="btnEvaluate">Evaluate</button>
    </div>
</div>
